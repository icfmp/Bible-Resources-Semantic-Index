{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BRSI reviewed external-resource crosswalk v1 (edition pinned, metadata only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "resource",
    "provenance",
    "links"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "edition",
        "source_url",
        "license",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "dictionary",
            "encyclopedia"
          ]
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bsi_version",
        "bsi_source_commit",
        "review_policy"
      ],
      "properties": {
        "bsi_version": {
          "type": "string",
          "minLength": 1
        },
        "bsi_source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "minLength": 40,
          "maxLength": 40
        },
        "review_policy": {
          "const": "manual_source_verified"
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "entry_id",
          "relation",
          "review_status",
          "evidence"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^(person|place|group|deity|fauna|flora|realia|work):[^ ]+$"
          },
          "entry_id": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "same_subject",
              "related_subject",
              "broader_topic",
              "narrower_topic"
            ]
          },
          "review_status": {
            "const": "reviewed"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "abstentions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "reason",
          "candidate_entry_ids",
          "review_status",
          "evidence"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^(person|place|group|deity|fauna|flora|realia|work):[^ ]+$"
          },
          "reason": {
            "enum": [
              "ambiguous_entries",
              "identity_unresolved",
              "source_entry_missing",
              "source_rights_unverified",
              "edition_unverified"
            ]
          },
          "candidate_entry_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "review_status": {
            "const": "withheld"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "reason": {
                  "const": "ambiguous_entries"
                }
              },
              "required": [
                "reason"
              ]
            },
            "then": {
              "properties": {
                "candidate_entry_ids": {
                  "minItems": 2
                }
              }
            }
          }
        ]
      }
    }
  }
}
