  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "تيس بري كبير عندو قرون طويلة ومعقوفة، بيعيش في قطعان في الجبال وبياكل الشجيرات الفي الجروف الصخرية.",
          "source": "acai"
        }
      ],
      "preferred_label": "الوعل"
    },
    "arb": {
      "descriptions": [
        {
          "description": "ماعز بري ضخم ذو قرون طويلة منحنية، يعيش في قطعان جبلية ويتغذى على الشجيرات النامية على المنحدرات الصخرية.",
          "source": "acai"
        }
      ],
      "preferred_label": "وَعْل"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan bigfala wael nani we i gat longfala kaved kom, we i stap laef long hil wetem ol narafala nani mo i stap kakae smolsmol tri long ol klif.",
          "source": "acai"
        }
      ],
      "preferred_label": "wael nani"
    },
    "eng": {
      "alternate_labels": [
        "Wild Goat",
        "Mountain Goat"
      ],
      "descriptions": [
        {
          "article": "fauna:Ibex",
          "description": "A large wild goat with long, curved horns, living in mountain herds and eating bushes on cliffs.",
          "gloss": "Ibex",
          "source": "acai"
        }
      ],
      "preferred_label": "Ibex"
    },
    "fas": {
      "descriptions": [
        {
          "description": "بز وحشی بزرگی با شاخ‌های بلند و خمیده که در گله‌های کوهستانی زندگی می‌کند و از بوته‌های روی صخره‌ها تغذیه می‌نماید.",
          "source": "acai"
        }
      ],
      "preferred_label": "بز کوهی"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Grande chèvre sauvage aux longues cornes courbées, vivant en hardes montagnardes et se nourrissant de buissons sur les falaises.",
          "source": "acai"
        }
      ],
      "preferred_label": "bouquetin"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Babban akuyar jeji mai dogayen ƙaho masu lankwasa, mai zama a garken kan duwatsu da cin ƙananan bishiyoyi a kan ƙibiyoyi.",
          "source": "acai"
        }
      ],
      "preferred_label": "Akuyar dutse"
    },
    "hin": {
      "descriptions": [
        {
          "description": "लंबे, मुड़े हुए सींगों वाली एक बड़ी जंगली बकरी, जो पहाड़ी झुंडों में रहती है और चट्टानों पर झाड़ियाँ खाती है।",
          "source": "acai"
        }
      ],
      "preferred_label": "जंगली बकरा"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Nnukwu ewu ọhịa nwere mpi toro ogologo, gbagọrọ agbagọ, nke na-ebi nʼìgwè nʼugwu ma na-ata ahịhịa dị nʼelu ugwu nkume.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ewu ọhịa"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Kambing liar besar dengan tanduk melengkung panjang, hidup berkelompok di pegunungan dan memakan semak-semak di tebing.",
          "source": "acai"
        }
      ],
      "preferred_label": "kambing gunung"
    },
    "nep": {
      "descriptions": [
        {
          "description": "लामा, घुम्रिएका सिङहरू भएको ठूलो जङ्गली बाख्रा, जो हिमाली वा पहाडी बथानमा बस्छ र भीरहरूका झाडी-बुट्यान खान्छ।",
          "source": "acai"
        }
      ],
      "preferred_label": "घोरल"
    },
    "por": {
      "descriptions": [
        {
          "description": "Grande cabra selvagem com chifres longos e curvados, que vive em rebanhos nas montanhas e come arbustos nos despenhadeiros.",
          "source": "acai"
        }
      ],
      "preferred_label": "íbis"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Крупный дикий козел с длинными изогнутыми рогами, живущий стадами в горах и питающийся кустарником на скалах.",
          "source": "acai"
        }
      ],
      "preferred_label": "Горный козел"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Cabra salvaje grande con cuernos largos y curvados, que vive en manadas en las montañas y se alimenta de arbustos en los acantilados.",
          "source": "acai"
        }
      ],
      "preferred_label": "cabra montés"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mbuzi-mwitu mkubwa mwenye pembe ndefu zilizopinda, anayeishi katika makundi milimani na kula vichaka kwenye majabali.",
          "source": "acai"
        }
      ],
      "preferred_label": "Mbuzi-mwitu"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela bikpela wel meme i gat longpela kruket kom, em i save stap wantaim ol arapela long ples maunten na kaikai ol liklik diwai long ol klip.",
          "source": "acai"
        }
      ],
      "preferred_label": "wel meme"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một loài dê rừng lớn có đôi sừng dài uốn cong, sống thành bầy trên núi và ăn cây bụi trên các vách đá.",
          "source": "acai"
        }
      ],
      "preferred_label": "dê rừng"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "一种大型野山羊，长有弯曲的长角，生活在山地群落中，以悬崖上的灌木为食。",
          "source": "acai"
        }
      ],
      "preferred_label": "野山羊"
    },
    "zht": {
      "descriptions": [
        {
          "description": "一種大型野山羊，長有長而彎曲的角，在山地群居，以懸崖上的灌木為食。",
          "source": "acai"
        }
      ],
      "preferred_label": "野山羊"
    }
  },
