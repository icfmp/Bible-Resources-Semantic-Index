  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "سحلية حركتها بطيئة بتقدر تغير لونها وتصيد الحشرات بلسانها الدبق؛ وكانت بتعتبر نجسة للأكل حسب الشريعة.",
          "source": "acai"
        }
      ],
      "preferred_label": "حرباية"
    },
    "arb": {
      "descriptions": [
        {
          "description": "سحلية بطيئة الحركة يمكنها تغيير لونها وصيد الحشرات بلسانها اللزج؛ وكانت تُعد نجسة طقسيًا للأكل.",
          "source": "acai"
        }
      ],
      "preferred_label": "حِرْبَاء"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan kaen lised we i wokbaot slo we i save jenisim kala blong hem mo kasem ol bebet wetem tang blong hem we i stiki; Loa blong ol Isrel i talem se hem i no klin blong kakae.",
          "source": "acai"
        }
      ],
      "preferred_label": "kamileon"
    },
    "eng": {
      "alternate_labels": [
        "Lizard"
      ],
      "descriptions": [
        {
          "article": "fauna:Chameleon",
          "description": "A slow-moving lizard that can change colors and catch insects with its sticky tongue; It was considered ceremonially unclean to eat.",
          "gloss": "Chameleon",
          "source": "acai"
        }
      ],
      "preferred_label": "Chameleon"
    },
    "fas": {
      "descriptions": [
        {
          "description": "مارمولکی با حرکت آهسته که می‌تواند تغییر رنگ دهد و با زبان چسبنده‌اش حشرات را شکار کند؛ خوردن آن از نظر آیینی ناپاک شمرده می‌شد.",
          "source": "acai"
        }
      ],
      "preferred_label": "آفتاب‌پرست"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Lézard lent capable de changer de couleur et d'attraper des insectes grâce à sa langue gluante ; il était considéré comme rituellement impur à la consommation.",
          "source": "acai"
        }
      ],
      "preferred_label": "caméléon"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani ƙadangare mai tafiya a hankali wanda zai iya sauya launin jikinsa kuma ya kamo ƙwari da dogon harshensa mai ɗaurewa; an ɗauke shi marar tsarki a tsarin addini don a ci.",
          "source": "acai"
        }
      ],
      "preferred_label": "Hawainiya"
    },
    "hin": {
      "descriptions": [
        {
          "description": "धीमी गति से चलने वाली एक छिपकली जो रंग बदल सकती है और अपनी चिपचिपी जीभ से कीड़े-मकोड़े पकड़ती है; इसे खाने के लिए धार्मिक रूप से अशुद्ध माना जाता था।",
          "source": "acai"
        }
      ],
      "preferred_label": "गिरगिट"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ngwere na-eje nwayọọ nwayọọ nke pụrụ ịgbanwe ụcha ahụ ya ma were ire ya na-arapara ararapara jide ụmụ ahụhụ; e weere ya dị ka anụ rụrụ arụ n'ememe iri nri.",
          "source": "acai"
        }
      ],
      "preferred_label": "ogumagala"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Kadal yang bergerak lambat dan dapat berubah warna serta menangkap serangga dengan lidahnya yang lengket; hewan ini dianggap haram secara upacara untuk dimakan.",
          "source": "acai"
        }
      ],
      "preferred_label": "bunglon"
    },
    "nep": {
      "descriptions": [
        {
          "description": "रङ्ग बदल्न सक्ने र आफ्नो टाँसिने जिब्रोले किरा-फट्याङ्ग्राहरू समात्न सक्ने सुस्त गतिमा हिँड्ने छेपारो; यसलाई खानका लागि विधिपूर्वक अशुद्ध मानिन्थ्यो।",
          "source": "acai"
        }
      ],
      "preferred_label": "रङ्ग बदल्ने छेपारो"
    },
    "por": {
      "descriptions": [
        {
          "description": "Um lagarto de movimentos lentos que pode mudar de cor e capturar insetos com sua língua pegajosa; era considerado cerimonialmente impuro para comer.",
          "source": "acai"
        }
      ],
      "preferred_label": "camaleão"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Малоподвижная ящерица, способная менять окраску и ловить насекомых липким языком; считалась ритуально нечистой для употребления в пищу.",
          "source": "acai"
        }
      ],
      "preferred_label": "Хамелеон"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Lagarto de movimientos lentos que puede cambiar de color y atrapar insectos con su lengua pegajosa; se consideraba ceremonialmente impuro para comer.",
          "source": "acai"
        }
      ],
      "preferred_label": "camaleón"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mjusi aendaye polepole anayeweza kubadili rangi na kukamata wadudu kwa ulimi wake wenye kunata; alichukuliwa kuwa najisi kiseremoni kuliwa.",
          "source": "acai"
        }
      ],
      "preferred_label": "Kinyonga"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela kain palai i save wokabaut isi isi na senisim kala bilong skin bilong en na yusim stiki tang bilong en bilong kisim ol binatang; lo bilong ol Juda i tambuim ol long kaikai em.",
          "source": "acai"
        }
      ],
      "preferred_label": "kamelion"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một loài thằn lằn di chuyển chậm chạp, có thể đổi màu và bắt côn trùng bằng chiếc lưỡi dính; loài này bị coi là ô uế theo nghi lễ, không được ăn.",
          "source": "acai"
        }
      ],
      "preferred_label": "Tắc kè hoa"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "一种行动缓慢的蜥蜴，能够变色并用带有黏性的舌头捕捉昆虫；在礼仪上被视为不洁净不可食用的动物。",
          "source": "acai"
        }
      ],
      "preferred_label": "变色龙"
    },
    "zht": {
      "descriptions": [
        {
          "description": "一種行動緩慢的蜥蜴，能夠改變體色並用有黏性的舌頭捕食昆蟲；在禮儀上被視為不潔淨不可食用的動物。",
          "source": "acai"
        }
      ],
      "preferred_label": "變色龍"
    }
  },
