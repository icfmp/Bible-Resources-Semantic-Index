        }
      ],
      "preferred_label": "Elephant"
    },
    "fas": {
      "descriptions": [
        {
          "description": "جانور خشکی‌زی بزرگی با خرطومی دراز و گوش‌هایی بزرگ، که در آفریقا و آسیا یافت می‌شود.",
          "source": "acai"
        }
      ],
      "preferred_label": "فیل"
    },
    "fra": {
      "descriptions": [
