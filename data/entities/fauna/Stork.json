  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "طير كبير عندو كرعين طوال ورقبة طويلة، وغالباً بشوفوه بفتش على الأكل في الموية الخفيفة.",
          "source": "acai"
        }
      ],
      "preferred_label": "لقلق"
    },
    "arb": {
      "descriptions": [
        {
          "description": "طائر كبير ذو أرجل طويلة وعنق طويل، غالبًا ما يُرى باحثًا عن الطعام في المياه الضحلة.",
          "source": "acai"
        }
      ],
      "preferred_label": "لقلق"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan bigfala pijin we i gat longfala leg mo longfala nek, we plante taem oli stap luk hem i stap lukaot kakae long ples we wota i no dip.",
          "source": "acai"
        }
      ],
      "preferred_label": "stok"
    },
    "eng": {
      "descriptions": [
        {
          "article": "fauna:Stork",
          "description": "A large bird with long legs and a long neck, often seen searching for food in shallow water.",
          "gloss": "Stork",
          "source": "acai"
        }
      ],
      "preferred_label": "Stork"
    },
    "fas": {
      "descriptions": [
        {
          "description": "پرنده‌ای بزرگ با پاها و گردنی بلند که اغلب در حال جستجوی غذا در آب‌های کم‌عمق دیده می‌شود.",
          "source": "acai"
        }
      ],
      "preferred_label": "لک‌لک"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Un grand oiseau aux longues pattes et au long cou, souvent aperçu à la recherche de nourriture dans les eaux peu profondes.",
          "source": "acai"
        }
      ],
      "preferred_label": "cigogne"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Babban tsuntsu mai dogayen ƙafafu da dogon wuya, sau da yawa ana ganinsa yana neman abinci a cikin ruwa marar zurfi.",
          "source": "acai"
        }
      ],
      "preferred_label": "Shamuwa"
    },
    "hin": {
      "descriptions": [
        {
          "description": "लंबी टांगों और लंबी गर्दन वाला एक बड़ा पक्षी, जो अक्सर उथले पानी में भोजन तलाशते हुए देखा जाता है।",
          "source": "acai"
        }
      ],
      "preferred_label": "सारस"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Nnukwu nnụnụ nwere ogologo ụkwụ na ogologo olu, nke a na-ahụkarị ka ọ na-achọ nri n'ime mmiri na-adịghị omimi.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ụgbala"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Burung besar dengan kaki dan leher yang panjang, sering terlihat mencari makan di air dangkal.",
          "source": "acai"
        }
      ],
      "preferred_label": "burung ranggung"
    },
    "nep": {
      "descriptions": [
        {
          "description": "लामो खुट्टा र लामो घाँटी भएको ठूलो चरा, जसलाई प्रायः उथ्लो पानीमा आहारा खोजिरहेको देखिन्छ।",
          "source": "acai"
        }
      ],
      "preferred_label": "सारस"
    },
    "por": {
      "descriptions": [
        {
          "description": "Uma ave grande com pernas e pescoço compridos, frequentemente vista buscando alimento em águas rasas.",
          "source": "acai"
        }
      ],
      "preferred_label": "cegonha"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Крупная птица с длинными ногами и длинной шеей, часто добывающая пищу на мелководье.",
          "source": "acai"
        }
      ],
      "preferred_label": "Аист"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Ave grande de patas y cuello largos, que a menudo se observa buscando alimento en aguas poco profundas.",
          "source": "acai"
        }
      ],
      "preferred_label": "cigüeña"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Ndege mkubwa mwenye miguu mirefu na shingo ndefu, anayeonekana mara nyingi akitafuta chakula katika maji yasiyo na kina kirefu.",
          "source": "acai"
        }
      ],
      "preferred_label": "korongo"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela bikpela pisin i gat longpela lek na longpela nek, na em i save painim kaikai long ol wara i no dip tumas.",
          "source": "acai"
        }
      ],
      "preferred_label": "stok"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một loài chim lớn có chân dài và cổ dài, thường được thấy khi đang kiếm ăn ở vùng nước nông.",
          "source": "acai"
        }
      ],
      "preferred_label": "cò"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "一种长腿长颈的大型鸟类，常在浅水中觅食。",
