        }
      ],
      "preferred_label": "蛀虫"
    },
    "zht": {
      "descriptions": [
        {
          "description": "一種小型昆蟲，因毀壞衣物而為人所知，在聖經中象徵朽壞與毀滅。",
          "source": "acai"
        }
      ],
      "preferred_label": "蛀蟲"
    }
