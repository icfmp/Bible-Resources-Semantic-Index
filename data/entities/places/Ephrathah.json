        }
      ],
      "preferred_label": "Efrata"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một thị trấn thuộc địa phận Giu-đa nơi Gia-cốp chôn cất Ra-chên, vợ mình; còn được gọi là Ép-rát và Bết-lê-hem.",
