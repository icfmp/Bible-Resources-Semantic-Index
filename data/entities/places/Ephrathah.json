    "apd": {
      "descriptions": [
        {
          "description": "بلدة في أرض يهوذا دفن فيها يعقوب مرته راحيل؛ ومعروفة كمان باسم أفرات وبيت لحم.",
          "source": "acai"
        }
      ],
      "preferred_label": "أفراتة"
    },
    "arb": {
      "descriptions": [
        {
          "description": "بلدة في أرض يهوذا حيث دفن يعقوب زوجته راحيل؛ وتُعرف أيضًا بأفرات وبيت لحم.",
          "source": "acai"
        }
      ],
      "preferred_label": "أَفْرَاتَةَ"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan taon long graon blong Juda we Jekob i berem Rejel, woman blong hem; oli save long hem tu olsem Efrat mo Betlehem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Efrata"
    },
    "eng": {
      "alternate_labels": [
        "Bethlehem",
        "Ephratah"
      ],
      "descriptions": [
        {
          "article": "place:Ephrathah",
          "description": "A town in the territory of Judah where Jacob buried Rachel, his wife; also known as Ephrath and Bethlehem.",
          "gloss": "Ephrathah",
          "source": "acai"
        }
      ],
      "preferred_label": "Ephrathah"
    },
    "fas": {
      "descriptions": [
        {
          "description": "شهری در قلمرو یهودا که یعقوب همسرش راحیل را در آنجا دفن کرد؛ همچنین به عنوان افرات و بیت‌لحم شناخته می‌شود.",
          "source": "acai"
        }
      ],
      "preferred_label": "افراته"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Ville du territoire de Juda où Jacob enterra Rachel, sa femme ; également connue sous le nom d'Éphrath et de Bethléhem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Éphrata"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani gari a yankin Yahuda inda Yaƙub ya binne Rahila matarsa; wanda kuma aka sani da Efrat da Betlehem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Efrata"
    },
    "hin": {
      "descriptions": [
        {
          "description": "यहूदा के क्षेत्र का एक नगर जहाँ याकूब ने अपनी पत्नी राहेल को दफनाया था; इसे एप्रात और बैतलहम भी कहा जाता है।",
          "source": "acai"
        }
      ],
      "preferred_label": "एप्राता"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Otu obodo nʼoke ala Juda ebe Jekọb liri Rechel, bụ nwunye ya; nke a na-akpọkwa Efrat na Betlehem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Efrata"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sebuah kota di wilayah Yehuda tempat Yakub menguburkan Rahel, istrinya; dikenal juga sebagai Efrata dan Betlehem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Efrata"
    },
    "nep": {
      "descriptions": [
        {
          "description": "यहूदाको इलाकामा रहेको एक सहर जहाँ याकूबले आफ्नी पत्नी राहेललाई गाडेका थिए; यसलाई एप्रात र बेथलेहेम पनि भनिन्छ।",
          "source": "acai"
        }
      ],
      "preferred_label": "एप्राता"
    },
    "por": {
      "descriptions": [
        {
          "description": "Uma cidade no território de Judá onde Jacó sepultou Raquel, sua esposa; também conhecida como Efrata e Belém.",
          "source": "acai"
        }
      ],
      "preferred_label": "Efrata"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Город в уделе Иуды, где Иаков похоронил свою жену Рахиль; также известен как Ефрафа и Вифлеем.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ефрафа"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Pueblo en el territorio de Judá donde Jacob sepultó a Raquel, su esposa; también conocido como Efrat y Belén.",
          "source": "acai"
        }
      ],
      "preferred_label": "Efrata"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mji katika eneo la Yuda ambapo Yakobo alimzika Raheli, mkewe; unajulikana pia kama Efrathi na Bethlehemu.",
          "source": "acai"
        }
      ],
      "preferred_label": "Efratha"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela taun long graun bilong Juda em Jekop i bin planim meri bilong en Resel long en; narapela nem bilong en em Efrata na Betlehem.",
