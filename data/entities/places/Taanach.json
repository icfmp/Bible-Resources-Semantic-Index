          "source": "acai"
        }
      ],
      "preferred_label": "Taanach"
    },
    "fas": {
      "descriptions": [
        {
          "description": "شهری لاوی در قلمرو مَنَسّی، در غرب رود اردن؛ واگذارشده به خاندان قَهات.",
          "source": "acai"
        }
      ],
      "preferred_label": "تَعنَک"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Ville lévitique sur le territoire de Manassé, à l'ouest du Jourdain ; attribuée au clan de Kehath.",
