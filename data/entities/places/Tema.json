    "apd": {
      "descriptions": [
        {
          "description": "منطقة في شمال الجزيرة العربية، مطابقة لتيماء، وهي واحة؛ أسسها واحد من أبناء إبراهيم.",
          "source": "acai"
        }
      ],
      "preferred_label": "تيماء"
    },
    "arb": {
      "descriptions": [
        {
          "description": "منطقة في شمال الجزيرة العربية، تُطابق واحة تيماء؛ أسسها أحد أبناء إبراهيم.",
          "source": "acai"
        }
      ],
      "preferred_label": "تَيْمَاء"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan rijen long not blong Arebia, we oli luksave se hem i Taema, wan ples wetem wota long draeples; we wan long ol boe blong Ebraham i bin statem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Tema"
    },
    "eng": {
      "descriptions": [
        {
          "article": "place:Tema",
          "description": "A region in northern Arabia, identified with Tayma, an oasis; founded by one of Abraham's sons.",
          "gloss": "Tema",
          "source": "acai"
        }
      ],
      "preferred_label": "Tema"
    },
    "fas": {
      "descriptions": [
        {
          "description": "منطقه‌ای در شمال عربستان که با تیما (واحه‌ای در آن ناحیه) یکی دانسته می‌شود؛ بنیان‌گذاری‌شده توسط یکی از پسران ابراهیم.",
          "source": "acai"
        }
      ],
      "preferred_label": "تیما"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Une région du nord de l'Arabie, identifiée à Tayma, une oasis ; fondée par l'un des fils d'Abraham.",
          "source": "acai"
        }
      ],
      "preferred_label": "Théma"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani yanki a arewacin Arabiya, da aka bayyana a matsayin Tayma, wani maroƙi; wanda ɗaya daga cikin ’ya’yan Ibrahim ya kafa.",
          "source": "acai"
        }
      ],
      "preferred_label": "Tema"
    },
    "hin": {
      "descriptions": [
        {
          "description": "उत्तरी अरब का एक क्षेत्र, जिसकी पहचान तैमा नामक मरुद्यान (ओएसिस) से की जाती है; जिसकी स्थापना इब्राहीम के एक पुत्र ने की थी।",
          "source": "acai"
        }
      ],
      "preferred_label": "तेमा"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Mpaghara dị nʼebe ugwu Arebịa, nke a maara dị ka Tayma, ebe mmiri na-agbọpụta nʼọzara; otu nʼime ụmụ Ebreham guzobere ya.",
          "source": "acai"
        }
      ],
      "preferred_label": "Tema"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sebuah wilayah di sebelah utara Arab, diidentifikasi dengan Tayma, suatu oasis; didirikan oleh salah seorang anak laki-laki Abraham.",
          "source": "acai"
        }
      ],
      "preferred_label": "Tema"
    },
    "nep": {
      "descriptions": [
        {
          "description": "उत्तरी अरबको एउटा क्षेत्र, जसलाई तैमा नामक मरुद्यान भनी पहिचान गरिएको छ; अब्राहामका एक छोराद्वारा स्थापित।",
          "source": "acai"
        }
      ],
      "preferred_label": "तेमा"
    },
    "por": {
      "descriptions": [
        {
          "description": "Uma região no norte da Arábia, identificada com Taima, um oásis; fundada por um dos filhos de Abraão.",
          "source": "acai"
        }
      ],
      "preferred_label": "Temá"
    },
    "rus": {
      "descriptions": [
        {
