          "source": "acai"
        }
      ],
      "preferred_label": "Фема"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Región en el norte de Arabia, identificada con Tayma, un oasis; fundada por uno de los hijos de Abraham.",
          "source": "acai"
        }
      ],
      "preferred_label": "Tema"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Eneo lililoko kaskazini mwa Arabia, linalotambuliwa kama Tayma, chemchemi ya jangwani; lililoanzishwa na mmoja wa wana wa Ibrahimu.",
          "source": "acai"
        }
      ],
      "preferred_label": "Tema"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela hap graun long not bilong Arebia, ol i save tok em i wankain olsem Taima, wanpela oesis; wanpela pikinini man bilong Abraham i bin kamapim.",
          "source": "acai"
        }
      ],
      "preferred_label": "Tema"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một khu vực ở miền bắc Ả-rập, được xác định với Tayma, một ốc đảo; do một người con trai của Áp-ra-ham lập nên.",
          "source": "acai"
        }
      ],
      "preferred_label": "Thê-ma"
    },
    "zhs": {
      "descriptions": [
