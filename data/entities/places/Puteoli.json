        }
      ],
      "preferred_label": "Futeyoli"
    },
    "hin": {
      "descriptions": [
        {
          "description": "रोम के दक्षिण में इटली के तट पर स्थित एक नगर; रोम की अपनी यात्रा के दौरान पौलुस वहाँ गया था।",
          "source": "acai"
        }
      ],
      "preferred_label": "पुतियुली"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Obodo dị n'ụsọ oké osimiri Itali, n'akụkụ ndịda Rom; Pọl letara ya na njem ya na-aga Rom.",
