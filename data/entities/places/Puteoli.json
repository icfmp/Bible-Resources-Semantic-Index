        }
      ],
      "preferred_label": "Pọteọlị"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sebuah kota di pesisir Italia, sebelah selatan Roma; dikunjungi oleh Paulus dalam perjalanannya ke Roma.",
