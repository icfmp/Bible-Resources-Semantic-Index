  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "مدينة على ساحل إيطاليا، جنوب روما؛ زارها بولس في رحلته لروما.",
          "source": "acai"
        }
      ],
      "preferred_label": "بوتيولي"
    },
    "arb": {
      "descriptions": [
        {
          "description": "مَدِينَةٌ عَلَى سَاحِلِ إِيطَالِيَا جَنُوبَ رُومَا؛ زَارَهَا بُولُسُ فِي رِحْلَتِهِ إِلَى رُومَا.",
          "source": "acai"
        }
      ],
      "preferred_label": "بُوطِيُولِي"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan taon long so blong Itali, long saot blong Rom; Pol i bin go luk taem hem i stap mekem rod blong hem i go long Rom.",
          "source": "acai"
        }
      ],
      "preferred_label": "Puteoli"
    },
    "eng": {
      "descriptions": [
        {
          "article": "place:Puteoli",
          "description": "A city on the coast of Italy, south of Rome; visited by Paul on his journey to Rome.",
          "gloss": "Puteoli",
          "source": "acai"
        }
      ],
      "preferred_label": "Puteoli"
    },
    "fas": {
      "descriptions": [
        {
          "description": "شهری در سواحل ایتالیا، در جنوب روم؛ پولس در سفر خود به روم از آنجا بازدید کرد.",
          "source": "acai"
        }
      ],
      "preferred_label": "پوطیولی"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Une ville sur la côte de l’Italie, au sud de Rome ; visitée par Paul lors de son voyage vers Rome.",
          "source": "acai"
        }
      ],
      "preferred_label": "Pouzzoles"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Birni a bakin tekun Italiya, a kudu da Roma; Bulus ya ziyarce shi a kan tafiyarsa zuwa Roma.",
