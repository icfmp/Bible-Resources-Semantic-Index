      "preferred_label": "Myra"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani birni a gaɓar kudu ta Lisiya a Asiya Ƙarama inda Bulus ya shiga jirgin ruwa na Iskandariya a kan hanyarsa ta zuwa Roma.",
