          "source": "acai"
        }
      ],
      "preferred_label": "میرا"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Une ville sur la côte sud de la Lycie en Asie Mineure où Paul est monté à bord d'un navire alexandrin en route pour Rome.",
