          "source": "acai"
        }
      ],
      "preferred_label": "Sitna"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Kisima kilichochimbwa na wachungaji wa Isaka, ambacho kikawa chanzo cha ugomvi kati yao na wachungaji wa Gerari.",
