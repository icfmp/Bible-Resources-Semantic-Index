  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "مدينة شرق نهر الأردن، قريبة من صَرَتَان، قريبة من المحل العبروا فيهو بني إسرائيل النهر (يشوع 3: 16).",
          "source": "acai"
        }
      ],
      "preferred_label": "أَدَام"
    },
    "arb": {
      "descriptions": [
        {
          "description": "بلدة تقع شرقي نهر الأردن، بالقرب من صَرتان، قريباً من المكان الذي عبر منه بنو إسرائيل النهر (يشوع 3: 16).",
          "source": "acai"
        }
      ],
      "preferred_label": "أَدَام"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan taon long is saed long Jodan Reva, klosap long Jaretan, klosap long ples we ol man Isrel oli kros long reva ya (Josua 3:16).",
          "source": "acai"
        }
      ],
      "preferred_label": "Adam"
    },
    "eng": {
      "descriptions": [
        {
          "article": "place:Adam",
          "description": "A town east of the Jordan River, near Zarethan, close to where the Israelites crossed the river (Joshua 3:16).",
          "gloss": "Adam",
          "source": "acai"
        }
      ],
      "preferred_label": "Adam"
    },
    "fas": {
      "descriptions": [
        {
          "description": "شهری در شرق رود اردن، نزدیک صَرتان، نزدیک جایی که بنی‌اسرائیل از رود عبور کردند (یوشع ۳: ۱۶).",
          "source": "acai"
        }
      ],
      "preferred_label": "آدم"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Ville située à l'est du Jourdain, près de Tsarthan, non loin de l'endroit où les Israélites traversèrent le fleuve (Josué 3.16).",
          "source": "acai"
        }
      ],
      "preferred_label": "Adam"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani gari gabashin Kogin Urdun, kusa da Zaretan, kusa da inda Isra'ilawa suka ƙetare kogin (Joshuwa 3:16).",
          "source": "acai"
        }
      ],
      "preferred_label": "Adam"
    },
    "hin": {
      "descriptions": [
        {
          "description": "यरदन नदी के पूर्व में, सारतान के निकट एक नगर, जहाँ से होकर इस्राएलियों ने नदी पार की थी (यहोशू 3:16)।",
          "source": "acai"
        }
      ],
      "preferred_label": "आदाम"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Otu obodo dị nʼakụkụ ọwụwa anyanwụ nke Osimiri Jọdan, nso Zaretan, dị nso nʼebe ndị Izrel gafere osimiri ahụ (Joshua 3:16).",
          "source": "acai"
        }
      ],
      "preferred_label": "Adam"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sebuah kota di sebelah timur Sungai Yordan, dekat Sartan, dekat tempat orang Israel menyeberangi sungai itu (Yosua 3:16).",
          "source": "acai"
        }
      ],
      "preferred_label": "Adam"
    },
    "nep": {
      "descriptions": [
        {
          "description": "यरदन नदीको पूर्वपट्टि, सारेतान नजिकै रहेको एउटा सहर, जहाँ इस्राएलीहरूले नदी पार गरेका ठाउँ नजिक पर्छ (यहोशू ३:१६)।",
          "source": "acai"
        }
      ],
      "preferred_label": "आदाम"
    },
    "por": {
      "descriptions": [
        {
          "description": "Uma cidade a leste do rio Jordão, perto de Zaretã, próxima de onde os israelitas atravessaram o rio (Josué 3:16).",
          "source": "acai"
        }
      ],
      "preferred_label": "Adã"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Город к востоку от реки Иордан, близ Цартана, недалеко от места, где израильтяне перешли реку (Иисус Навин 3:16).",
          "source": "acai"
        }
      ],
      "preferred_label": "Адам"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Una ciudad al este del río Jordán, cerca de Zaretán, próxima al lugar donde los israelitas cruzaron el río (Josué 3:16).",
          "source": "acai"
        }
      ],
      "preferred_label": "Adán"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mji ulio mashariki mwa Mto Yordani, karibu na Sarethani, karibu na mahali Waisraeli walipovuka mto huo (Yoshua 3:16).",
          "source": "acai"
        }
      ],
      "preferred_label": "Adamu"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela taun long hap sankamap bilong Wara Jordan, klostu long Saretan, na klostu long hap ol Israel i bin brukim wara (Josua 3:16).",
          "source": "acai"
        }
      ],
      "preferred_label": "Adam"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một thị trấn ở phía đông sông Giô-đan, gần Xát-than, gần nơi dân Y-sơ-ra-ên vượt qua sông (Giô-suê 3:16).",
          "source": "acai"
        }
      ],
      "preferred_label": "A-đam"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "约旦河东靠近撒拉他拿的一座城，靠近以色列人过河之处（约书亚记 3:16）。",
          "source": "acai"
        }
      ],
      "preferred_label": "亚当"
    },
    "zht": {
      "descriptions": [
        {
          "description": "約旦河東面的一座城鎮，靠近撒拉但，鄰近以色列人過河之處（約書亞記 3:16）。",
          "source": "acai"
        }
      ],
      "preferred_label": "亞當"
    }
  },
