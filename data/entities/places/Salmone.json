  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "رأس بحري في الركن الشمالي الشرقي حق كريت؛ سفينة بولس أبحرت قريب من هنا أثناء رحلته لروما.",
          "source": "acai"
        }
      ],
      "preferred_label": "سلمونة"
    },
    "arb": {
      "descriptions": [
        {
          "description": "رأس ساحلي في الطرف الشمالي الشرقي من كريت؛ أبحرت سفينة بولس بالقرب منه أثناء رحلته إلى روما.",
          "source": "acai"
        }
      ],
      "preferred_label": "سَلْمُونِي"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan poen blong aelan long notis kona blong Krit; sip blong Pol i sel klosap long ples ya long taem we hem i stap go long Rom.",
          "source": "acai"
        }
      ],
      "preferred_label": "Salmone"
    },
    "eng": {
      "descriptions": [
        {
          "article": "place:Salmone",
          "description": "A promontory on the northeast corner of Crete; Paul's ship sailed near here during his journey to Rome.",
          "gloss": "Salmone",
          "source": "acai"
        }
      ],
      "preferred_label": "Salmone"
    },
    "fas": {
      "descriptions": [
        {
          "description": "دماغه‌ای در گوشهٔ شمال شرقی کریت؛ کشتی پولس در سفرش به روم از نزدیکی آن عبور کرد.",
          "source": "acai"
        }
      ],
      "preferred_label": "سلمونی"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Un promontoire à l'extrémité nord-est de la Crète ; le navire de Paul navigua près d'ici pendant son voyage vers Rome.",
          "source": "acai"
        }
      ],
      "preferred_label": "Salmone"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani tudu a kusurwar arewa maso gabashin Kirit; jirgin ruwan Bulus ya bi kusa da nan a lokacin tafiyarsa zuwa Roma.",
          "source": "acai"
        }
      ],
      "preferred_label": "Salmone"
    },
    "hin": {
      "descriptions": [
        {
          "description": "क्रेते के उत्तर-पूर्वी कोने पर एक अंतरीप; रोम की अपनी यात्रा के दौरान पौलुस का जहाज़ यहाँ के निकट से होकर गया था।",
          "source": "acai"
        }
      ],
      "preferred_label": "सलमोने"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ọnụ ọnụ ugwu dị nʼakụkụ ugwu ọwụwa anyanwụ nke Kriit; ụgbọ mmiri Pọl gbara nso nʼebe a nʼoge njem ya na-aga Rom.",
          "source": "acai"
        }
      ],
      "preferred_label": "Salmone"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Tanjung di ujung timur laut Kreta; kapal Paulus berlayar di dekat sini dalam perjalanannya menuju Roma.",
          "source": "acai"
        }
      ],
      "preferred_label": "Salmone"
    },
    "nep": {
      "descriptions": [
        {
          "description": "क्रेटको उत्तर-पूर्वी कुनामा रहेको एउटा अन्तरीप; रोमको यात्राको क्रममा पावलको जहाज यसको नजिक भएर गएको थियो।",
          "source": "acai"
        }
      ],
      "preferred_label": "सल्मोन"
    },
    "por": {
      "descriptions": [
        {
          "description": "Um promontório no extremo nordeste de Creta; o navio de Paulo navegou perto dali durante sua viagem para Roma.",
          "source": "acai"
        }
      ],
      "preferred_label": "Salmona"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Мыс на северо-восточной оконечности Крита; мимо него проплывал корабль Павла во время его путешествия в Рим.",
          "source": "acai"
        }
      ],
      "preferred_label": "Салмон"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Promontorio en el extremo noreste de Creta; el barco de Pablo navegó cerca de aquí durante su viaje a Roma.",
          "source": "acai"
        }
      ],
      "preferred_label": "Salmona"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Rasi iliyo kwenye ncha ya kaskazini-mashariki ya Krete; meli ya Paulo ilisafiri karibu na hapa wakati wa safari yake ya kwenda Rumi.",
          "source": "acai"
        }
      ],
      "preferred_label": "Salmone"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela poin bilong graun i go long solwara long not-is bilong Krit; sip bilong Pol i bin ron klostu long dispela hap long taim em i wokabaut i go long Rom.",
          "source": "acai"
        }
      ],
      "preferred_label": "Salmone"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một mũi đất ở góc đông bắc của đảo Cơ-rết; tàu của Phao-lô đã đi gần nơi này trong chuyến hành trình đến La Mã.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sanh-môn"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "克里特东北角的一处海岬；保罗前往罗马的航程中，船只曾在此附近航行。",
          "source": "acai"
        }
      ],
      "preferred_label": "撒摩尼"
    },
    "zht": {
      "descriptions": [
        {
          "description": "克里特東北角的一處海岬；保羅的船在前往羅馬的航程中曾駛經此處附近。",
          "source": "acai"
        }
      ],
      "preferred_label": "撒摩尼"
    }
