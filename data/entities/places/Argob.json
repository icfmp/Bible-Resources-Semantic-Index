      "descriptions": [
        {
          "description": "منطقة في باشان أخدوها بني إسرائيل من مملكة عوج؛ واتخصصت لنص سبط منسى.",
          "source": "acai"
        }
      ],
      "preferred_label": "أرجوب"
    },
    "arb": {
      "descriptions": [
        {
          "description": "مِنْطَقَةٌ فِي بَاشَانَ أَخَذَهَا بَنُو إِسْرَائِيلَ مِنْ مَمْلَكَةِ عُوجٍ؛ وَخُصِّصَتْ لِنِصْفِ سِبْطِ مَنَسَّى.",
          "source": "acai"
        }
      ],
      "preferred_label": "أَرْجُوبُ"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan eria long Basan we ol man Isrel oli tekem long kingdom blong Og; mo we oli givim long haf blong laen blong Manase.",
          "source": "acai"
        }
