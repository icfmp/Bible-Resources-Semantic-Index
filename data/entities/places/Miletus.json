  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "مدينة ميناء في كاريا، على الساحل الغربي لآسيا الصغرى؛ بولس اتقابل فيها مع شيوخ أفسس.",
          "source": "acai"
        }
      ],
      "preferred_label": "ميليتس"
    },
    "arb": {
      "descriptions": [
        {
          "description": "مدينة ساحلية في كاريا، على الساحل الغربي لآسيا الصغرى؛ التقى بولس فيها بشيوخ أفسس.",
          "source": "acai"
        }
      ],
      "preferred_label": "مِيلِيتُس"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan taon we i gat pot blong sip long Karia, long wes kos blong Esia Maena; Pol i mit wetem ol elda blong Efesas long ples ya.",
          "source": "acai"
        }
      ],
      "preferred_label": "Maelitas"
    },
    "eng": {
      "alternate_labels": [
        "Miletum"
      ],
      "descriptions": [
        {
          "article": "place:Miletus",
          "description": "A seaport city of Caria, on the west coast of Asia Minor; Paul met with the Ephesian elders here.",
          "gloss": "Miletus",
          "source": "acai"
        }
      ],
      "preferred_label": "Miletus"
    },
    "fas": {
      "descriptions": [
        {
          "description": "شهری بندری در کاریا، در ساحل غربی آسیای صغیر؛ پولس در اینجا با مشایخ افسس دیدار کرد.",
          "source": "acai"
        }
      ],
      "preferred_label": "میلیتوس"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Une ville portuaire de Carie, sur la côte ouest de l'Asie Mineure ; Paul y rencontra les anciens d'Éphèse.",
          "source": "acai"
        }
      ],
      "preferred_label": "Milet"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani birnin tashar jiragen ruwa na Kariya, a bakin tekun yamma na Asiya Ƙarama; a nan Bulus ya haɗu da dattawan Afisa.",
          "source": "acai"
        }
      ],
      "preferred_label": "Miletus"
    },
    "hin": {
      "descriptions": [
        {
          "description": "एशिया माइनर के पश्चिमी तट पर कारिया का एक बंदरगाह नगर; पौलुस यहाँ इफिसुस के प्राचीनों से मिला था।",
          "source": "acai"
        }
      ],
      "preferred_label": "मीलेतुस"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Otu obodo ọdụ ụgbọ mmiri dị na Karia, nʼụsọ oké osimiri ọdịda anyanwụ nke Eshia Maịnọ; Pọl zutere ndị okenye Efesọs nʼebe a.",
          "source": "acai"
        }
      ],
      "preferred_label": "Melitọs"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sebuah kota pelabuhan di Karia, di pesisir barat Asia Kecil; Paulus bertemu dengan para penatua dari Efesus di sini.",
          "source": "acai"
        }
      ],
      "preferred_label": "Miletus"
    },
    "nep": {
      "descriptions": [
        {
          "description": "एसिया माइनरको पश्चिमी तटमा अवस्थित कारियाको एउटा बन्दरगाह सहर; पावलले यहाँ एफिससका एल्डरहरूसँग भेटेका थिए।",
          "source": "acai"
        }
      ],
      "preferred_label": "मिलेटस"
    },
    "por": {
      "descriptions": [
        {
          "description": "Uma cidade portuária da Cária, na costa ocidental da Ásia Menor; Paulo reuniu-se com os presbíteros de Éfeso aqui.",
          "source": "acai"
        }
      ],
      "preferred_label": "Mileto"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Портовый город в Карии, на западном побережье Малой Азии; здесь Павел встретился с ефесскими старейшинами.",
          "source": "acai"
        }
      ],
      "preferred_label": "Милит"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Una ciudad portuaria de Caria, en la costa occidental de Asia Menor; Pablo se reunió aquí con los ancianos de Éfeso.",
          "source": "acai"
        }
      ],
      "preferred_label": "Mileto"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mji wa bandari wa Karia, katika pwani ya magharibi ya Asia Ndogo; Paulo alikutana na wazee wa Efeso hapa.",
          "source": "acai"
        }
      ],
      "preferred_label": "Mileto"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela taun i gat pasis bilong sip long Karia, long nambis long hap wes bilong Esia Maina; Pol i bin bung wantaim ol hetman bilong Efesus long dispela hap.",
          "source": "acai"
        }
      ],
      "preferred_label": "Miletus"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một thành phố cảng thuộc Ca-ri, ở bờ biển phía tây Tiểu Á; Phao-lô đã gặp các trưởng lão Ê-phê-sô tại đây.",
          "source": "acai"
        }
      ],
      "preferred_label": "Mi-lê"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "卡利亚的海港城市，位于小亚细亚西岸；保罗曾在此与以弗所的长老会面。",
          "source": "acai"
        }
      ],
      "preferred_label": "米利都"
    },
    "zht": {
      "descriptions": [
        {
          "description": "小亞細亞西岸卡利亞的一座海港城市；保羅曾在此與以弗所的長老會面。",
          "source": "acai"
        }
      ],
      "preferred_label": "米利都"
    }
