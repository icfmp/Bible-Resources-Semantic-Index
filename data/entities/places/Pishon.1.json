  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "نهر بيجري في أرض الحويلة؛ واحد من الأنهار الأربعة الجارية من جنة عدن.",
          "source": "acai"
        }
      ],
      "preferred_label": "فيشون"
    },
    "arb": {
      "descriptions": [
        {
          "description": "نهر يجري في أرض الحويلة؛ أحد الأنهار الأربعة النابعة من جنة عدن.",
          "source": "acai"
        }
      ],
      "preferred_label": "فِيشُونُ"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan reva we i ron i go tru long kantri ya Havila; wan long fofala reva we oli ron aot long garen ya Iden.",
          "source": "acai"
        }
      ],
      "preferred_label": "Pison"
    },
    "eng": {
      "alternate_labels": [
        "Pison",
        "Phison River"
      ],
      "descriptions": [
        {
          "article": "place:Pishon.1",
          "description": "A river running through the land of Havila; one of the four rivers flowing from the Garden of Eden.",
          "gloss": "Pishon",
          "source": "acai"
        }
      ],
      "preferred_label": "Pishon"
    },
    "fas": {
      "descriptions": [
        {
          "description": "رودی که در سرزمین حویله جاری بود؛ یکی از چهار رودی که از باغ عدن سرچشمه می‌گرفتند.",
          "source": "acai"
        }
      ],
      "preferred_label": "فیشون"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Fleuve traversant le pays de Havila ; l'un des quatre fleuves issus du jardin d'Éden.",
          "source": "acai"
        }
      ],
      "preferred_label": "Pischon"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Kogi ne da yake bi ta ƙasar Hawila; ɗaya daga cikin koguna huɗu da suka fito daga Lambun Adan.",
          "source": "acai"
        }
      ],
      "preferred_label": "Fishon"
    },
    "hin": {
      "descriptions": [
        {
          "description": "हवीला के देश से होकर बहने वाली एक नदी; अदन की वाटिका से निकलने वाली चार नदियों में से एक।",
          "source": "acai"
        }
      ],
      "preferred_label": "पीशोन"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Osimiri na-asọfe nʼala Havila; otu nʼime osimiri anọ na-asọpụta nʼUbi Idin.",
          "source": "acai"
        }
      ],
      "preferred_label": "Paịshọn"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sebuah sungai yang mengalir melintasi tanah Hawila; salah satu dari empat sungai yang mengalir dari Taman Eden.",
          "source": "acai"
        }
      ],
      "preferred_label": "Pison"
    },
    "nep": {
      "descriptions": [
        {
          "description": "हवीलाको भूमि भएर बग्ने एउटा नदी; अदनको बगैँचाबाट बग्ने चारवटा नदीहरूमध्ये एउटा।",
          "source": "acai"
        }
      ],
      "preferred_label": "पीशोन"
    },
    "por": {
      "descriptions": [
        {
          "description": "Um rio que atravessa a terra de Havilá; um dos quatro rios que fluíam do Jardim do Éden.",
          "source": "acai"
        }
      ],
      "preferred_label": "Pisom"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Река, протекающая через землю Хавила; одна из четырех рек, вытекавших из Эдемского сада.",
          "source": "acai"
        }
      ],
      "preferred_label": "Фисон"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Río que recorre la tierra de Havila; uno de los cuatro ríos que fluían del jardín del Edén.",
          "source": "acai"
        }
      ],
      "preferred_label": "Pisón"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mto unaopita katika nchi ya Havila; mmojawapo ya mito minne inayotiririka kutoka Bustani ya Edeni.",
          "source": "acai"
        }
      ],
      "preferred_label": "Pishoni"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela wara i ron i go namel long graun Havila; wanpela bilong foapela wara i kamap long Gaden Iden.",
          "source": "acai"
        }
      ],
      "preferred_label": "Pison"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một dòng sông chảy qua xứ Ha-vi-la; một trong bốn dòng sông bắt nguồn từ Vườn Ê-đen.",
          "source": "acai"
        }
      ],
      "preferred_label": "Bi-sôn"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "流经哈腓拉地的一条河流；是从伊甸园流出的四条河之一。",
          "source": "acai"
        }
      ],
      "preferred_label": "比逊"
    },
    "zht": {
      "descriptions": [
        {
          "description": "流經哈腓拉全地的一條河；是從伊甸園流出的四道河之一。",
          "source": "acai"
        }
      ],
      "preferred_label": "比遜"
    }
  },
