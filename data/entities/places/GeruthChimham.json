      ],
      "descriptions": [
        {
          "article": "place:GeruthChimham",
          "description": "A location near Bethlehem where the Judeans, who were on their way to Egypt in the time of Jeremiah, broke their journey.",
          "gloss": "Geruth Chimham",
          "source": "acai"
        }
      ],
      "preferred_label": "Geruth Chimham"
    },
    "fas": {
      "descriptions": [
        {
          "description": "مکانی در نزدیکی بیت‌لحم که یهودیان در زمان ارمیا در مسیر خود به مصر، در آنجا توقف کردند.",
          "source": "acai"
        }
      ],
      "preferred_label": "جیروت کمهام"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Un lieu près de Bethléhem où les Judéens, qui étaient en route pour l'Égypte à l'époque de Jérémie, firent une halte.",
          "source": "acai"
        }
      ],
      "preferred_label": "hôtellerie de Kimham"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani wuri kusa da Betlehem inda mutanen Yahuda, waɗanda suke kan hanyarsu ta zuwa Masar a zamanin Irmiya, suka tsaya suka huta.",
          "source": "acai"
        }
      ],
      "preferred_label": "Gerut Kimham"
    },
    "hin": {
      "descriptions": [
        {
          "description": "बैतलहम के निकट एक स्थान जहाँ यिर्मयाह के समय में यहूदी लोग, जो मिस्र की ओर जा रहे थे, अपनी यात्रा रोककर ठहरे थे।",
          "source": "acai"
        }
      ],
      "preferred_label": "गेरूत किम्हाम"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ebe dị nso na Betlehem ebe ndị Judia, bụ́ ndị na-aga Ijipt nʼoge Jeremaya, kwụsịtụrụ nʼije ha.",
          "source": "acai"
        }
      ],
      "preferred_label": "Gerut Kimham"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sebuah lokasi dekat Betlehem tempat orang-orang Yudea, yang sedang dalam perjalanan menuju Mesir pada zaman Yeremia, berhenti menginap.",
          "source": "acai"
        }
      ],
      "preferred_label": "Gerut-Kimham"
    },
    "nep": {
      "descriptions": [
        {
          "description": "बेथलेहेम नजिकैको एउटा ठाउँ जहाँ यर्मियाको समयमा मिश्रतर्फ जाँदै गरेका यहूदीहरूले आफ्नो यात्रा रोकेका थिए।",
          "source": "acai"
        }
      ],
      "preferred_label": "गेरूथ-किम्हाम"
    },
    "por": {
      "descriptions": [
        {
          "description": "Um local perto de Belém onde os judeus, que estavam a caminho do Egito na época de Jeremias, interromperam sua viagem.",
