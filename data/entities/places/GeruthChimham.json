  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "مكان قريب من بيت لحم قعدوا فيه أهل يهوذا الكانوا مسافرين لمصر في زمن إرميا ووقفوا رحلتهم هناك.",
          "source": "acai"
        }
      ],
      "preferred_label": "جيروت كمهام"
    },
    "arb": {
      "descriptions": [
        {
          "description": "موقع بالقرب من بيت لحم نزل فيه يهوذا الذين كانوا في طريقهم إلى مصر في زمن إرميا.",
          "source": "acai"
        }
      ],
      "preferred_label": "جَيْرُوتَ كِمْهَامَ"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan ples klosap long Betlehem we ol man Juda, we oli stap go long Ijip long taem blong Jeremaea, oli bin stop smoltaem long hem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Gerut Kimam"
    },
    "eng": {
      "alternate_labels": [
        "Geruth like.them",
