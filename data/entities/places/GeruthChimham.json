          "source": "acai"
        }
      ],
      "preferred_label": "Gerut Quimham"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Eneo karibu na Bethlehemu ambapo Wayahudi, waliokuwa njiani kuelekea Misri wakati wa Yeremia, walitua na kukatiza safari yao.",
          "source": "acai"
        }
      ],
      "preferred_label": "Geruth-Kimhamu"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela ples klostu long Betlehem em ol manmeri bilong Juda, em ol i wokabaut i go long Isip long taim bilong Jeremaia, i bin malolo long en.",
