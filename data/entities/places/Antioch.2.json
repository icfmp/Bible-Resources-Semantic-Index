  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "مدينة في بيسيدية، واقعة على طريق سيباستي، سافر ليها بولس في رحلته التبشيرية الأولى.",
          "source": "acai"
        }
      ],
      "preferred_label": "أنطاكية (حق بيسيدية)"
    },
    "arb": {
      "descriptions": [
        {
          "description": "مَدِينَةٌ فِي بِيسِيدِيَّةَ تَقَعُ عَلَى طَرِيقِ فِيا سِبَاسْتِي، سَافَرَ إِلَيْهَا بُولُسُ خِلَالَ رِحْلَتِهِ ٱلتَّبْشِيرِيَّةِ ٱلْأُولَى.",
          "source": "acai"
        }
      ],
      "preferred_label": "أَنْطَاكِيَة (بِيسِيدِيَّة)"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan bigfala taon long Pisidia, we i stap long rod ya Via Sebaste, we Pol i bin travel i go long hem long faswan misinari trip blong hem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Antiok (blong Pisidia)"
    },
    "eng": {
      "alternate_labels": [
        "Antioch (Pisidia)",
        "Antioch"
      ],
      "descriptions": [
        {
          "article": "place:Antioch.2",
          "description": "A city in Pisidia, located on the Via Sebaste, where Paul traveled to during his first missionary journey.",
          "gloss": "Antioch (of Pisidia)",
          "source": "acai"
        }
      ],
      "preferred_label": "Antioch (of Pisidia)"
    },
    "fas": {
      "descriptions": [
        {
          "description": "شهری در پیسیدیه، واقع بر جادهٔ سباسته، که پولس در اولین سفر میسیونری خود به آنجا سفر کرد.",
          "source": "acai"
        }
      ],
      "preferred_label": "انطاکیه (پیسیدیه)"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Une ville de Pisidie, située sur la Via Sebaste, où Paul se rendit lors de son premier voyage missionnaire.",
          "source": "acai"
        }
      ],
      "preferred_label": "Antioche (de Pisidie)"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani birni a Fisidiya, da ke kan hanyar Via Sebaste, inda Bulus ya je a lokacin tafiyarsa ta farko ta wa'azi.",
          "source": "acai"
        }
      ],
      "preferred_label": "Antiyok (na Fisidiya)"
    },
    "hin": {
      "descriptions": [
        {
          "description": "पिसिदिया का एक नगर, जो वाया सेबास्ते पर स्थित था, जहाँ पौलुस अपनी पहली प्रचार-यात्रा के दौरान गया था।",
          "source": "acai"
        }
