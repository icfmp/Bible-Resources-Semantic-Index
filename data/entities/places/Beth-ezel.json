      ],
      "descriptions": [
        {
          "article": "place:Beth-ezel",
          "description": "A town in the territory of Judah. The name is probably a pun on the Hebrew אצל (English: withhold).",
          "gloss": "Beth-ezel",
          "source": "acai"
        }
      ],
      "preferred_label": "Beth-ezel"
    },
    "fas": {
      "descriptions": [
        {
          "description": "شهری در قلمرو یهودا. نام آن احتمالاً جناسی با واژه عبرانی אצל (به معنای دریغ داشتن یا مضایقه کردن) است.",
          "source": "acai"
        }
      ],
      "preferred_label": "بیت‌ایصل"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Une ville située sur le territoire de Juda. Le nom est probablement un jeu de mots sur l'hébreu אצל (en français : retenir ou refuser).",
          "source": "acai"
        }
      ],
      "preferred_label": "Beth-Haëtsel"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani gari a yankin Yahuda. Sunan wataƙila wasan kalma ne a kan Ibraniyanci אצל (da Hausa: hana/riƙe).",
          "source": "acai"
        }
      ],
      "preferred_label": "Bet-Ezel"
    },
    "hin": {
      "descriptions": [
        {
          "description": "यहूदा के क्षेत्र में एक नगर। यह नाम संभवतः इब्रानी शब्द אצל (रोकना/सहारा) पर एक श्लेष है।",
          "source": "acai"
        }
      ],
      "preferred_label": "बेतसेल"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Otu obodo dị nʼókèala Juda. Aha ya nwere ike ịbụ egwuregwu okwu nʼasụsụ Hibru bụ́ אצל (nʼasụsụ Bekee: withhold).",
          "source": "acai"
        }
      ],
      "preferred_label": "Bet-Ezel"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sebuah kota di wilayah Yehuda. Namanya kemungkinan merupakan permainan kata dari bahasa Ibrani אצל (menahan).",
          "source": "acai"
        }
      ],
      "preferred_label": "Bet-Haezel"
    },
    "nep": {
      "descriptions": [
        {
          "description": "यहूदाको इलाकामा रहेको एक सहर। यसको नाम सम्भवतः हिब्रू शब्द אצל (अङ्ग्रेजी: withhold) सँग सम्बन्धित शब्द-खेल हो।",
          "source": "acai"
        }
      ],
      "preferred_label": "बेथ-एजेल"
    },
    "por": {
      "descriptions": [
        {
          "description": "Uma cidade no território de Judá. O nome é provavelmente um trocadilho com o hebraico אצל (em português: reter).",
          "source": "acai"
        }
      ],
      "preferred_label": "Bete-Ezel"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Город на территории колена Иуды. Название, вероятно, представляет собой игру слов с еврейским «эцель» (удерживать).",
          "source": "acai"
        }
      ],
      "preferred_label": "Бет-Ецель"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Poblado en el territorio de Judá. El nombre probablemente sea un juego de palabras con el hebreo אצל (en español: retener o reservar).",
          "source": "acai"
        }
      ],
      "preferred_label": "Bet-esel"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mji katika eneo la Yuda. Huenda jina hilo ni mchezo wa maneno unaotokana na neno la Kiebrania אצל (kuzuia).",
          "source": "acai"
        }
      ],
      "preferred_label": "Beth-eseli"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela taun long teritori bilong Juda. Ating nem bilong en i kam long wanpela tok Hibru i gat tupela mining (long Tok Inglis: withhold).",
          "source": "acai"
        }
      ],
      "preferred_label": "Betesel"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một thị trấn thuộc lãnh thổ Giu-đa. Tên này có lẽ là một cách chơi chữ với từ tiếng Hê-bơ-rơ אצל (nghĩa là: giữ lại, rút lại).",
          "source": "acai"
        }
      ],
      "preferred_label": "Bết-hê-xen"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "犹大领地的一座城镇。该名称可能取自希伯来语 אצל（意为“扣住/留下”）的双关语。",
          "source": "acai"
        }
      ],
      "preferred_label": "伯·以薛"
    },
    "zht": {
      "descriptions": [
        {
          "description": "猶大領地的一座城鎮。其名可能是希伯來語 אצל（保留、扣住）的雙關語。",
          "source": "acai"
        }
      ],
      "preferred_label": "伯‧以薛"
    }
