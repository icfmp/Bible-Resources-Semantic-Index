  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "مدينة، وتُعرف كمان بإعوا؛ ملك أشور نقل سكانها للسامرة (٢ ملوك ١٧: ٢٤).",
          "source": "acai"
        }
      ],
      "preferred_label": "عَوَّا"
    },
    "arb": {
      "descriptions": [
        {
          "description": "بلدة تُعرف أيضاً باسم عِوّا؛ قام ملك أشور بنقل سكانها إلى السامرة (2 ملوك 17: 24).",
          "source": "acai"
        }
      ],
      "preferred_label": "عَوَّا"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan taon, we oli kolem tu Iva; king blong Asiria i tekem ol man blong hem oli go stap long Sameria (2 King 17:24).",
          "source": "acai"
        }
      ],
      "preferred_label": "Iva"
    },
    "eng": {
      "alternate_labels": [
        "Ava",
        "Arva"
      ],
      "descriptions": [
        {
          "article": "place:Avva",
          "description": "A town, also known as Ivvah; its inhabitants were relocated to Samaria by the king of Assyria (2 Kings 17:24).",
          "gloss": "Avva",
          "source": "acai"
        }
      ],
      "preferred_label": "Avva"
    },
    "fas": {
      "descriptions": [
        {
          "description": "شهری که با نام عِوّه نیز شناخته می‌شود؛ ساکنان آن توسط پادشاه آشور به سامره منتقل شدند (دوم پادشاهان ۱۷:۲۴).",
          "source": "acai"
        }
      ],
      "preferred_label": "عوا"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Une ville, également connue sous le nom d'Ivva ; ses habitants furent déportés en Samarie par le roi d'Assyrie (2 Rois 17:24).",
          "source": "acai"
        }
      ],
      "preferred_label": "Avva"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani gari, wanda aka fi sani da Iwwa; sarkin Assuriya ya ƙaura da mazaunansa zuwa Samariya (2 Sarakuna 17:24).",
          "source": "acai"
        }
      ],
      "preferred_label": "Afa"
    },
    "hin": {
      "descriptions": [
        {
          "description": "एक नगर, जिसे इव्वा के नाम से भी जाना जाता है; इसके निवासियों को अश्शूर के राजा द्वारा सामरिया में बसाया गया था (2 राजा 17:24)।",
          "source": "acai"
        }
      ],
      "preferred_label": "अव्वा"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Otu obodo, nke a makwaara dịka Iva; eze Asịrịa kpọpụrụ ndị bi na ya gaa biri na Sameria (2 Ndị Eze 17:24).",
          "source": "acai"
        }
      ],
      "preferred_label": "Ava"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sebuah kota, juga dikenal sebagai Iwa; penduduknya dipindahkan ke Samaria oleh raja Asyur (2 Raja-raja 17:24).",
          "source": "acai"
        }
      ],
      "preferred_label": "Awa"
    },
    "nep": {
      "descriptions": [
        {
          "description": "एउटा सहर, जसलाई इव्वाह पनि भनिन्छ; यसका बासिन्दाहरूलाई अश्शूरका राजाले सामरियामा स्थानान्तरण गरेका थिए (२ राजा १७:२४)।",
          "source": "acai"
        }
      ],
      "preferred_label": "अव्वा"
    },
    "por": {
      "descriptions": [
        {
          "description": "Uma cidade, também conhecida como Iva; seus habitantes foram transferidos para Samaria pelo rei da Assíria (2 Reis 17:24).",
          "source": "acai"
        }
      ],
      "preferred_label": "Ava"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Город, также известный как Ивва; его жители были переселены в Самарию ассирийским царем (4 Цар. 17:24).",
          "source": "acai"
        }
      ],
      "preferred_label": "Авва"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Una ciudad, también conocida como Ivah; sus habitantes fueron reubicados en Samaria por el rey de Asiria (2 Reyes 17:24).",
          "source": "acai"
        }
      ],
      "preferred_label": "Ava"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mji, unaojulikana pia kama Iva; wakazi wake walihamishiwa Samaria na mfalme wa Ashuru (2 Wafalme 17:24).",
          "source": "acai"
        }
      ],
      "preferred_label": "Ava"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela taun, ol i save kolim tu olsem Iva; king bilong Asiria i bin kisim ol manmeri bilong en i go sindaun long Samaria (2 King 17:24).",
          "source": "acai"
        }
      ],
      "preferred_label": "Iva"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một thị trấn, còn được gọi là Y-va; dân cư nơi đây đã bị vua A-si-ri đưa đến tái định cư tại Sa-ma-ri (2 Các Vua 17:24).",
          "source": "acai"
        }
      ],
      "preferred_label": "A-va"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "一座城镇，又称以瓦；其居民被亚述王迁居到撒玛利亚（列王纪下 17:24）。",
          "source": "acai"
        }
      ],
      "preferred_label": "亚瓦"
    },
    "zht": {
      "descriptions": [
        {
          "description": "一座城鎮，也稱作「以瓦」；其居民被亞述王遷徙到撒馬利亞（王下 17:24）。",
          "source": "acai"
        }
      ],
      "preferred_label": "亞瓦"
    }
  },
