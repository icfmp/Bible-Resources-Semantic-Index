      "descriptions": [
        {
          "article": "place:Arvad",
          "description": "A town on a small island off the coast of Phoenicia; its people are considered descendants of Canaan (ABD).",
          "gloss": "Arvad",
          "source": "acai"
        }
      ],
      "preferred_label": "Arvad"
    },
    "fas": {
      "descriptions": [
        {
          "description": "شهری در جزیره‌ای کوچک در نزدیکی ساحل فنیقیه؛ ساکنان آن از نوادگان کنعان به شمار می‌روند.",
          "source": "acai"
        }
      ],
      "preferred_label": "ارواد"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Une ville située sur une petite île au large des côtes de Phénicie ; ses habitants sont considérés comme des descendants de Canaan (ABD).",
          "source": "acai"
        }
      ],
      "preferred_label": "Arvad"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani gari a wani ƙaramin tsibiri kusa da gaɓar tekun Funisiya; ana ɗaukar mutanensa zuriyar Kan’ana ne (ABD).",
          "source": "acai"
        }
      ],
      "preferred_label": "Arfad"
    },
    "hin": {
      "descriptions": [
        {
          "description": "फीनीके के तट के पास एक छोटे द्वीप पर स्थित एक नगर; इसके निवासियों को कनान का वंशज माना जाता है।",
          "source": "acai"
        }
      ],
      "preferred_label": "अर्वद"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Otu obodo dị nʼobere agwaetiti nʼakụkụ mmiri Fonisia; a na-ewere ndị ya dị ka ụmụ ụmụ Kenan (ABD).",
          "source": "acai"
        }
      ],
      "preferred_label": "Avad"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sebuah kota di sebuah pulau kecil di lepas pantai Fenisia; penduduknya dianggap sebagai keturunan Kanaan (ABD).",
          "source": "acai"
        }
      ],
      "preferred_label": "Arwad"
    },
    "nep": {
      "descriptions": [
        {
          "description": "फिनिसियाको तट नजिकैको एउटा सानो टापुमा अवस्थित सहर; यहाँका मानिसहरू कनानका सन्तान मानिन्छन् (एबीडी)।",
          "source": "acai"
        }
      ],
      "preferred_label": "अर्वाद"
    },
    "por": {
      "descriptions": [
        {
          "description": "Uma cidade em uma pequena ilha na costa da Fenícia; seus habitantes são considerados descendentes de Canaã (ABD).",
          "source": "acai"
        }
      ],
      "preferred_label": "Arvade"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Город на небольшом острове у побережья Финикии; его жители считаются потомками Ханаана (ABD).",
          "source": "acai"
        }
      ],
      "preferred_label": "Арвад"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Una ciudad en una pequeña isla frente a la costa de Fenicia; sus habitantes son considerados descendientes de Canaán (ABD).",
          "source": "acai"
        }
      ],
      "preferred_label": "Arvad"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mji kwenye kisiwa kidogo karibu na pwani ya Foinike; watu wake wanachukuliwa kuwa wazao wa Kanaani (ABD).",
          "source": "acai"
        }
      ],
      "preferred_label": "Arvadi"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela taun long wanpela liklik ailan klostu long nambis bilong Fonisia; ol i tingim ol manmeri bilong en olsem ol tumbuna pikinini bilong Kanan (ABD).",
          "source": "acai"
        }
      ],
      "preferred_label": "Arvat"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một thị trấn trên một hòn đảo nhỏ ngoài khơi bờ biển Phê-ni-xi; dân cư ở đó được xem là dòng dõi của Ca-na-an (ABD).",
          "source": "acai"
        }
      ],
      "preferred_label": "A-vát"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "位于腓尼基海岸外一座小岛上的城镇；其居民被视为迦南的后裔（《安克尔圣经词典》）。",
          "source": "acai"
        }
      ],
      "preferred_label": "亚发"
    },
    "zht": {
      "descriptions": [
        {
          "description": "腓尼基海岸外小島上的一座城鎮；其居民被視為迦南的後裔（ABD）。",
          "source": "acai"
        }
      ],
      "preferred_label": "亞發"
    }
