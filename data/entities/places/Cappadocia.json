  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "ولاية في داخل آسيا الصغرى؛ بعض الناس الكانوا في يوم الخمسين كانوا من هناك (أعمال ٢: ٥-١٣).",
          "source": "acai"
        }
      ],
      "preferred_label": "كبدوكية"
    },
    "arb": {
      "descriptions": [
        {
          "description": "مُقَاطَعَةٌ فِي دَاخِلِ آسِيَا ٱلصُّغْرَى؛ كَانَ بَعْضُ ٱلْجَمْعِ ٱلَّذِينَ حَضَرُوا يَوْمَ ٱلْخَمْسِينَ مِنْهَا (أَعْمَال ٢: ٥–١٣).",
          "source": "acai"
        }
      ],
      "preferred_label": "كَبَّدُوكِيَّةُ"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan provins long medel blong Esia Maena; sam long ol man we oli stap long lafet blong Pentekos oli kamaot long ples ya (Wok 2:5–13).",
          "source": "acai"
        }
      ],
      "preferred_label": "Kapadosia"
    },
    "eng": {
      "descriptions": [
        {
          "article": "place:Cappadocia",
          "description": "A province in the interior of Asia Minor; some of the crowd who were at Pentecost were from here (Acts 2:5–13).",
          "gloss": "Cappadocia",
          "source": "acai"
        }
      ],
      "preferred_label": "Cappadocia"
    },
    "fas": {
      "descriptions": [
        {
          "description": "ولایتی در داخل آسیای صغیر؛ برخی از جمعیتی که در روز پنطیکاست حضور داشتند از این منطقه بودند (اعمال ۲: ۵–۱۳).",
          "source": "acai"
        }
      ],
      "preferred_label": "کپدوکیه"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Une province de l'intérieur de l'Asie Mineure ; une partie de la foule présente à la Pentecôte en était originaire (Actes 2.5–13).",
          "source": "acai"
        }
      ],
      "preferred_label": "Cappadoce"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Lardi a cikin ƙasar Asiya Ƙarama; wasu daga cikin taron da suke wurin Fentikos sun fito daga nan (A. M. 2:5–13).",
          "source": "acai"
        }
      ],
      "preferred_label": "Kaffadokiya"
    },
    "hin": {
      "descriptions": [
        {
          "description": "एशिया माइनर के भीतरी भाग का एक प्रांत; पिन्तेकुस्त के दिन उपस्थित भीड़ में से कुछ लोग यहाँ के थे (प्रेरितों 2:5-13)।",
          "source": "acai"
        }
      ],
      "preferred_label": "कप्पदूकिया"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Otu ógbè dị nʼime ime Eshịa Maịnọ; ụfọdụ nʼime igwe mmadụ ahụ nọ na Pentikọst sitere nʼebe a (Ọrụ 2:5–13).",
          "source": "acai"
        }
      ],
      "preferred_label": "Kapadosia"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sebuah provinsi di pedalaman Asia Kecil; beberapa orang di antara orang banyak yang hadir pada hari Pentakosta berasal dari sini (Kis. 2:5–13).",
          "source": "acai"
        }
      ],
      "preferred_label": "Kapadokia"
    },
    "nep": {
      "descriptions": [
        {
          "description": "एसिया माइनरको भित्री भागमा रहेको एउटा प्रान्त; पेन्तेकोस्‍तको दिनमा भेला भएको भीडमध्ये केही मानिसहरू यहाँका थिए (प्रेरित २:५–१३)।",
          "source": "acai"
        }
      ],
      "preferred_label": "कापाडोकिया"
    },
    "por": {
      "descriptions": [
        {
          "description": "Uma província no interior da Ásia Menor; algumas pessoas da multidão que estava no Pentecostes eram de lá (Atos 2:5–13).",
          "source": "acai"
        }
      ],
      "preferred_label": "Capadócia"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Провинция во внутренних районах Малой Азии; некоторые из людей, собравшихся в день Пятидесятницы, были родом отсюда (Деян 2:5–13).",
          "source": "acai"
        }
      ],
      "preferred_label": "Каппадокия"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Provincia del interior de Asia Menor; algunas de las personas presentes en Pentecostés procedían de aquí (Hch 2:5-13).",
          "source": "acai"
        }
      ],
      "preferred_label": "Capadocia"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Jimbo katika eneo la bara la Asia Ndogo; baadhi ya umati waliokuwepo wakati wa Pentekoste walitoka huko (Mdo 2:5–13).",
          "source": "acai"
        }
      ],
      "preferred_label": "Kapadokia"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela provins i stap insait long Esia Maina; sampela bilong ol manmeri i bin i stap long Pentikos i bilong dispela hap (Aposel 2:5–13).",
          "source": "acai"
        }
      ],
      "preferred_label": "Kapadosia"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một tỉnh ở sâu trong nội địa Tiểu Á; một số người trong đám đông vào ngày Lễ Ngũ Tuần đến từ nơi này (Công vụ 2:5–13).",
          "source": "acai"
        }
      ],
      "preferred_label": "Cáp-ba-đốc"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "小亚细亚内陆的一个行省；五旬节聚集的人群中有些人来自这里（徒2:5–13）。",
          "source": "acai"
        }
      ],
      "preferred_label": "加帕多家"
    },
    "zht": {
      "descriptions": [
        {
          "description": "小亞細亞內陸的一個省；在五旬節聚集的人群中，有些人來自這裡（徒 2:5-13）。",
          "source": "acai"
        }
      ],
      "preferred_label": "加帕多家"
    }
  },
