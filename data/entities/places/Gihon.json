    "fas": {
      "descriptions": [
        {
          "description": "رودی که در سرزمین کوش جریان دارد؛ یکی از چهار رودی که از باغ عدن سرچشمه می‌گیرند.",
          "source": "acai"
        }
      ],
      "preferred_label": "جیحون (عدن)"
    },
    "fra": {
      "descriptions": [
        {
