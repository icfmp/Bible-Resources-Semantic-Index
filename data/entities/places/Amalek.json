  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "المنطقة في النقب السكنوها العمالقة، جماعة رُحل يعتبروا من نسل عيسو، وكانوا أعداء لإسرائيل وفي النهاية دمرهم شاول (1 صموئيل 15: 7).",
          "source": "acai"
        }
      ],
      "preferred_label": "عماليق (مكان)"
    },
    "arb": {
      "descriptions": [
        {
          "description": "إقليم في النقب سكنه العمالقة، وهم جماعة بدوية من نسل عيسو، كانوا أعداء لإسرائيل وقضى عليهم شاول في النهاية (1 صموئيل 15: 7).",
          "source": "acai"
        }
      ],
      "preferred_label": "عَمَالِيق (مكان)"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Graon long Negev we ol man Amalek oli laef long hem, we oli wan grup blong ol no-gat-stamba-ples we oli ting se oli laen blong Iso, we oli ol enemi blong Isrel mo biaen Sol i spolem olgeta finis (1 Samuel 15:7).",
          "source": "acai"
        }
      ],
      "preferred_label": "Amalek (Ples)"
    },
    "eng": {
      "alternate_labels": [
        "Amalekites",
        "Amalekite",
        "Amalek"
      ],
      "descriptions": [
        {
          "article": "place:Amalek",
          "description": "The territory in the Negev inhabited by the Amalekites, a nomadic group regarded as descendants of Esau, who were enemies of Israel and ultimately destroyed by Saul (1 Samuel 15:7).",
          "gloss": "Amalek (Place)",
          "source": "acai"
        }
      ],
      "preferred_label": "Amalek (Place)"
    },
    "fas": {
      "descriptions": [
        {
          "description": "سرزمینی در نگب که محل سکونت عمالیقیان بود، گروهی کوچ‌نشین که از نوادگان عیسو به شمار می‌رفتند، دشمنان اسرائیل بودند و در نهایت توسط شائول نابود شدند (۱ سموئیل ۱۵:۷).",
          "source": "acai"
        }
      ],
      "preferred_label": "عمالیق (مکان)"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Le territoire du Néguev habité par les Amalécites, un groupe nomade considéré comme descendant d’Ésaü, ennemis d’Israël et finalement détruits par Saül (1 Samuel 15:7).",
          "source": "acai"
        }
      ],
      "preferred_label": "Amalek (lieu)"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Yankin da ke cikin Negeb inda Amalekawa suka zauna, ƙungiyar makiyaya da ake ɗauka a matsayin zuriyar Isuwa, waɗanda suka kasance maƙiyan Isra’ila kuma a ƙarshe Shawulu ya hallaka su (1 Sama’ila 15:7).",
          "source": "acai"
        }
      ],
      "preferred_label": "Amalek (Wuri)"
    },
    "hin": {
      "descriptions": [
        {
          "description": "नेगेव का वह क्षेत्र जहाँ अमालेकी रहते थे—जो एसाव के वंशज माने जाने वाले घुमंतू लोग थे, इस्राएल के शत्रु थे और अंततः शाऊल द्वारा पराजित/नष्ट किए गए (1 शमूएल 15:7)।",
          "source": "acai"
        }
      ],
      "preferred_label": "अमालेक (स्थान)"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ókèala dị na Negev ebe ndị Amalek bi, bụ ndị na-akwagharị akwagharị a na-ewere dịka ụmụ ụmụ Isọ, ndị bụ ndị iro Izrel ma Sọl bibiri ha nʼikpeazụ (1 Samuel 15:7).",
          "source": "acai"
        }
      ],
      "preferred_label": "Amalek (Ebe)"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Wilayah di Negeb yang dihuni oleh orang Amalek, suatu kelompok pengembara yang dianggap sebagai keturunan Esau, yang merupakan musuh Israel dan akhirnya dihancurkan oleh Saul (1 Samuel 15:7).",
          "source": "acai"
        }
      ],
      "preferred_label": "Amalek (Tempat)"
    },
    "nep": {
      "descriptions": [
        {
          "description": "नेगेभको एउटा इलाका जहाँ अमालेकीहरू बसोबास गर्दथे। तिनीहरू एसावका सन्तान मानिने फिरन्ते जाति थिए र इस्राएलका शत्रु थिए, जसलाई पछि शाऊलले विनाश गरेका थिए (१ शमूएल १५:७)।",
          "source": "acai"
        }
      ],
      "preferred_label": "अमालेक (स्थान)"
    },
    "por": {
      "descriptions": [
        {
          "description": "O território no Neguebe habitado pelos amalequitas, um grupo nômade considerado descendente de Esaú, que eram inimigos de Israel e foram finalmente destruídos por Saul (1 Samuel 15:7).",
          "source": "acai"
        }
      ],
      "preferred_label": "Amaleque (lugar)"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Территория в Негеве, населенная амаликитянами — кочевым народом, считавшимся потомками Исава, враждовавшим с Израилем и окончательно истребленным Саулом (1 Царств 15:7).",
          "source": "acai"
        }
      ],
      "preferred_label": "Амалик (местность)"
    },
    "spa": {
      "descriptions": [
        {
          "description": "El territorio en el Néguev habitado por los amalecitas, un grupo nómada considerado descendiente de Esaú, que fueron enemigos de Israel y finalmente destruidos por Saúl (1 Samuel 15:7).",
          "source": "acai"
        }
      ],
      "preferred_label": "Amalec (lugar)"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Eneo lililoko Negebu lililokaliwa na Waamaleki, kundi la wahamaji lililohesabiwa kuwa wazao wa Esau, ambao walikuwa maadui wa Israeli na hatimaye waliangamizwa na Sauli (1 Samweli 15:7).",
          "source": "acai"
        }
      ],
      "preferred_label": "Amaleki (Mahali)"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Graun long Negev em ol Amalek i bin stap long en, wanpela lain i save raun nabaut em ol i bilip ol i ol tumbuna bilong Iso, ol i bin stap birua bilong ol Israel na bihain Sol i bin bagarapim ol (1 Samuel 15:7).",
          "source": "acai"
        }
      ],
      "preferred_label": "Amalek (Ples)"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Vùng lãnh thổ ở Nê-gép là nơi cư ngụ của người A-ma-léc, một nhóm du mục được coi là hậu duệ của Ê-sau, vốn là kẻ thù của Y-sơ-ra-ên và cuối cùng bị Sau-lơ tiêu diệt (1 Sa-mu-ên 15:7).",
          "source": "acai"
        }
      ],
      "preferred_label": "A-ma-léc (địa danh)"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "内革夫境内亚玛力人居住的地区；亚玛力人是被视为以扫后裔的游牧民族，是以色列人的仇敌，最终被扫罗消灭（撒母耳记上 15:7）。",
          "source": "acai"
        }
      ],
      "preferred_label": "亚玛力 (地名)"
    },
    "zht": {
      "descriptions": [
        {
          "description": "內革夫境內亞瑪力人居住的地區。亞瑪力人為游牧民族，被視為以掃的後裔，是以色列人的仇敵，最終被掃羅擊潰（撒母耳記上 15:7）。",
          "source": "acai"
        }
      ],
      "preferred_label": "亞瑪力（地方）"
    }
  },
