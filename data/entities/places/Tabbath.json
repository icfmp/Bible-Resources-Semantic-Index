      "descriptions": [
        {
          "description": "مدينة في وادي الأردن، المنطقة الفيها هربوا عساكر المديانيين من جيش جدعون.",
          "source": "acai"
        }
      ],
      "preferred_label": "طابة"
    },
    "arb": {
      "descriptions": [
        {
          "description": "مَدينَةٌ في وادي الأُرْدُنِّ، في المَنْطِقَةِ الَّتي هَرَبَ إِلَيْها جُنودُ المِدْيَانِيِّينَ مِنْ جَيْشِ جِدْعونَ.",
          "source": "acai"
        }
      ],
      "preferred_label": "طَبَّاةُ"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan taon long Lebon blong Jodan, eria we ol soldia blong Midian oli ronwe i go long hem from ami blong Gideon.",
          "source": "acai"
        }
      ],
      "preferred_label": "Tabat"
    },
    "eng": {
      "descriptions": [
        {
