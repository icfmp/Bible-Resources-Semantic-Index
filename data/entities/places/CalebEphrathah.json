          "article": "place:CalebEphrathah",
          "description": "The place where Caleb's father, Hezron, died; possibly not a place but a person.",
          "gloss": "Caleb-ephrathah",
          "source": "acai"
        }
      ],
      "preferred_label": "Caleb-ephrathah"
    },
    "fas": {
      "descriptions": [
        {
          "description": "مکانی که در آن حصرون، پدر کالیب، درگذشت؛ شاید به جای مکان، اشاره به یک شخص باشد.",
          "source": "acai"
        }
      ],
      "preferred_label": "کالیب افراته"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Lieu où mourut Hetsron, le père de Caleb ; possiblement une personne plutôt qu'un lieu.",
          "source": "acai"
        }
      ],
      "preferred_label": "Caleb-Éphratha"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wurin da mahaifin Kaleb, Hezron, ya mutu; mai yiwuwa ba wuri ba ne amma mutum ne.",
          "source": "acai"
        }
      ],
      "preferred_label": "Kaleb Efrata"
    },
    "hin": {
      "descriptions": [
        {
          "description": "वह स्थान जहाँ कालेब का पिता हेस्रोन मरा था; संभवतः यह कोई स्थान नहीं बल्कि कोई व्यक्ति है।",
          "source": "acai"
        }
      ],
      "preferred_label": "कालेब एप्राता"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ebe nna Kaleb bụ Hezrọn nwụrụ; ma eleghị anya ọ bụghị ebe kama ọ bụ mmadụ.",
          "source": "acai"
        }
      ],
      "preferred_label": "Kaleb Efrata"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Tempat Hezron, ayah Kaleb, meninggal; kemungkinan bukan tempat melainkan orang.",
          "source": "acai"
        }
      ],
      "preferred_label": "Kaleb-Efrata"
    },
    "nep": {
      "descriptions": [
        {
          "description": "कालेबका पिता हेस्रोनको मृत्यु भएको ठाउँ; सम्भवतः कुनै ठाउँ नभएर एक व्यक्ति।",
          "source": "acai"
        }
