    "hin": {
      "descriptions": [
        {
          "description": "एशिया माइनर के लुकाउनिया का एक नगर, जो दिरबे के उत्तर-पश्चिम में स्थित था; पौलुस की भेंट वहाँ तीमुथियुस से हुई थी।",
          "source": "acai"
        }
      ],
      "preferred_label": "लुस्त्रा"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Otu obodo dị na Laikonia nʼime Asia Minor, nʼebe ugwu ọdịda anyanwụ nke Debi; Pọl zutere Timoti nʼebe ahụ.",
