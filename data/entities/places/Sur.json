  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "باب في أورشليم، جايز كان بيودي من القصر الملكي للهيكل؛ وهو اسم تاني لباب الأساس.",
          "source": "acai"
        }
      ],
      "preferred_label": "باب سور"
    },
    "arb": {
      "descriptions": [
        {
          "description": "بَابٌ فِي أُورُشَلِيمَ، رُبَّمَا كَانَ يُؤَدِّي مِنَ ٱلْقَصْرِ ٱلْمَلَكِيِّ إِلَى ٱلْهَيْكَلِ؛ وَهُوَ ٱسْمٌ آخَرُ لِبَابِ ٱلْأَسَاسِ.",
          "source": "acai"
        }
      ],
      "preferred_label": "بَاب سُور"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan doa long Jerusalem, we maet i lidim man aot long palis blong king i go long haos tempol; wan narafala nem blong hem Doa blong Fandesen.",
          "source": "acai"
        }
      ],
      "preferred_label": "Suru Doa"
    },
    "eng": {
      "alternate_labels": [
        "Foundation Gate",
        "Sur"
      ],
      "descriptions": [
        {
          "article": "place:Sur",
          "description": "A gate in Jerusalem, possibly leading from the royal palace to the temple; another name for the Gate of the Foundation.",
          "gloss": "Sur Gate",
          "source": "acai"
        }
      ],
      "preferred_label": "Sur Gate"
    },
    "fas": {
      "descriptions": [
        {
          "description": "دروازه‌ای در اورشلیم، احتمالاً راهی از کاخ سلطنتی به هیکل؛ نام دیگری برای دروازهٔ بنیاد.",
          "source": "acai"
        }
      ],
      "preferred_label": "دروازهٔ سور"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Une porte à Jérusalem, menant peut-être du palais royal au temple ; un autre nom pour la porte de Jesod.",
          "source": "acai"
        }
      ],
      "preferred_label": "porte de Sur"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wata ƙofa a Urushalima, wadda wataƙila ta tashi daga fadar sarki zuwa haikali; wani suna ne kuma na Ƙofar Tushe.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ƙofar Sur"
    },
    "hin": {
      "descriptions": [
        {
          "description": "यरूशलेम का एक फाटक, जो संभवतः राजमहल से मंदिर की ओर जाता था; नींव के फाटक का दूसरा नाम।",
          "source": "acai"
        }
      ],
      "preferred_label": "सूर फाटक"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ọnụ ụzọ dị na Jeruselem, nke nwere ike isi nʼobí eze gaa nʼụlọnsọ ukwu; aha ọzọ maka Ọnụ Ụzọ Ntọala.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ọnụ Ụzọ Sua"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sebuah pintu gerbang di Yerusalem, kemungkinan menuju dari istana kerajaan ke bait suci; nama lain untuk Pintu Gerbang Dasar.",
          "source": "acai"
        }
      ],
      "preferred_label": "Pintu Gerbang Sur"
    },
    "nep": {
      "descriptions": [
        {
          "description": "यरूशलेमको एउटा ढोका, जुन सायद राजदरबारबाट मन्दिरतर्फ जान्थ्यो; जगको ढोकाको अर्को नाम।",
          "source": "acai"
        }
      ],
      "preferred_label": "सुर ढोका"
    },
    "por": {
      "descriptions": [
        {
          "description": "Um portão em Jerusalém, possivelmente levando do palácio real ao templo; outro nome para a Porta do Fundamento.",
          "source": "acai"
        }
      ],
      "preferred_label": "Porta de Sur"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Ворота в Иерусалиме, возможно, ведущие из царского дворца в храм; другое название ворот Основания.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ворота Сур"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Una puerta en Jerusalén, que posiblemente conducía desde el palacio real hasta el templo; otro nombre para la puerta del Cimiento.",
          "source": "acai"
        }
      ],
      "preferred_label": "Puerta de Sur"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Lango huko Yerusalemu, ambalo huenda lilitoka kwenye jumba la kifalme kuelekea hekaluni; jina jingine la Lango la Msingi.",
          "source": "acai"
        }
      ],
      "preferred_label": "Lango la Suri"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela geit long Jerusalem, ating em i rot bilong lusim haus bilong king na go long tempel; narapela nem bilong Geit Bilong Faundesen.",
          "source": "acai"
        }
      ],
      "preferred_label": "Geit Sur"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một cánh cổng tại Giê-ru-sa-lem, có thể dẫn từ hoàng cung vào đền thờ; một tên gọi khác của Cổng Nền (Foundation Gate).",
          "source": "acai"
        }
      ],
      "preferred_label": "Cổng Su-rơ"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "耶路撒冷的一座城门，可能通往王宫至圣殿；是基址门的别名。",
          "source": "acai"
        }
      ],
      "preferred_label": "苏珥门"
    },
    "zht": {
      "descriptions": [
        {
          "description": "耶路撒冷的一座城門，可能從王宮通往聖殿；是基址門的另一個名稱。",
          "source": "acai"
        }
      ],
      "preferred_label": "蘇珥門"
    }
  },
