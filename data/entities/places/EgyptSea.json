      ],
      "descriptions": [
        {
          "article": "place:SeaOfEgypt",
          "description": "Possibly a reference to the Red Sea which is shaped like a tongue; literally \"sea of Egypt.\"",
          "gloss": "Sea of Egypt",
          "source": "acai"
        }
      ],
      "preferred_label": "Sea of Egypt"
    },
    "fas": {
      "descriptions": [
        {
          "description": "احتمالاً اشاره‌ای به دریای سرخ که شبیه یک زبان است؛ به‌طور تحت‌اللفظی «دریای مصر».",
          "source": "acai"
        }
      ],
      "preferred_label": "دریای مصر"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Probablement une référence à la mer Rouge qui a la forme d’une langue ; littéralement « mer d’Égypte ».",
          "source": "acai"
        }
      ],
      "preferred_label": "mer d’Égypte"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wataƙila nuni ne ga Jar Teku wadda take da siffa kamar harshe; a zahiri \\\"tekun Masar.\\\"",
          "source": "acai"
        }
      ],
      "preferred_label": "Tekun Masar"
    },
    "hin": {
      "descriptions": [
        {
          "description": "संभवतः लाल सागर का एक संदर्भ जो जीभ के आकार का है; शाब्दिक रूप से \\\"मिस्र का समुद्र।\\\"",
          "source": "acai"
        }
      ],
      "preferred_label": "मिस्र का समुद्र"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "O nwere ike ịbụ ntụaka maka Osimiri Uhie nke dị ka ire; nʼụzọ nkịtị \\\"osimiri Ijipt.\\\"",
          "source": "acai"
        }
      ],
      "preferred_label": "Osimiri Ijipt"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Kemungkinan merujuk pada Laut Merah yang berbentuk seperti lidah; secara harfiah \\\"laut Mesir.\\\"",
          "source": "acai"
        }
      ],
      "preferred_label": "Laut Mesir"
    },
    "nep": {
      "descriptions": [
        {
          "description": "सम्भवतः जिब्रो आकारको लाल समुद्रलाई जनाइएको; शाब्दिक रूपमा \\\"मिश्रको समुद्र\\\"।",
          "source": "acai"
        }
      ],
      "preferred_label": "मिश्रको समुद्र"
    },
    "por": {
      "descriptions": [
        {
          "description": "Possivelmente uma referência ao mar Vermelho, que tem o formato de uma língua; literalmente \\\"mar do Egito\\\".",
          "source": "acai"
        }
      ],
      "preferred_label": "Mar do Egito"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Возможно, указание на Красное море, имеющее форму языка; буквально «море Египетское».",
          "source": "acai"
        }
      ],
      "preferred_label": "Море Египетское"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Posiblemente una referencia al mar Rojo, que tiene forma de lengua; literalmente «mar de Egipto».",
          "source": "acai"
        }
      ],
      "preferred_label": "mar de Egipto"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Yamkini inarejelea Bahari ya Shamu yenye umbo kama la ulimi; kihalisi \\\"bahari ya Misri.\\\"",
          "source": "acai"
        }
      ],
      "preferred_label": "Bahari ya Misri"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Ating em i makim Retsi em i luk olsem tang bilong dok; long tok Hibru em i olsem \\\"solwara bilong Isip.\\\"",
          "source": "acai"
        }
      ],
      "preferred_label": "Solwara bilong Isip"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Có thể chỉ về Biển Đỏ vốn có hình dạng như một lưỡi gà; nghĩa đen là \\\"biển của Ai Cập.\\\"",
          "source": "acai"
        }
      ],
      "preferred_label": "Biển Ai Cập"
    },
    "zhs": {
