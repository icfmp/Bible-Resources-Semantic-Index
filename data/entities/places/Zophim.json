      "descriptions": [
        {
          "description": "حقل في قمة جبل الفسجة في موآب؛ واحد من الأماكن الكان بلعام مفروض يلعن منها إسرائيل.",
          "source": "acai"
        }
      ],
      "preferred_label": "صوفيم"
    },
    "arb": {
      "descriptions": [
        {
          "description": "حقل على قمة جبل الفسجة في موآب؛ أحد الأماكن التي كان بلعام سيلعن إسرائيل منها.",
          "source": "acai"
        }
      ],
      "preferred_label": "صُوفِيمَ"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan open ples long top blong Hil Pisga long Moab; wan long ol ples we Balak i karem Balam i go long hem blong i tok nogud long Isrel blong spolem olgeta.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jofim"
    },
    "eng": {
      "alternate_labels": [
        "Lookout Field"
      ],
      "descriptions": [
        {
          "article": "place:Zophim",
          "description": "A field at the top of Mount Pisgah in Moab; one of the places from where Balaam was to curse Israel.",
          "gloss": "Zophim",
          "source": "acai"
        }
      ],
      "preferred_label": "Zophim"
    },
    "fas": {
      "descriptions": [
        {
          "description": "مزرعه‌ای بر فراز کوه پیسگاه در موآب؛ یکی از مکان‌هایی که بلعام قرار بود از آنجا اسرائیل را نفرین کند.",
          "source": "acai"
        }
      ],
      "preferred_label": "صوفیم"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Un champ au sommet du mont Pisga en Moab ; l'un des lieux d'où Balaam devait maudire Israël.",
          "source": "acai"
        }
      ],
      "preferred_label": "Tsophim"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani fili a ƙwanƙolin Dutsen Fisga a Mowab; ɗaya daga cikin wuraren da Balak ya kai Bala’am don yă la’anci Isra’ila.",
          "source": "acai"
        }
      ],
      "preferred_label": "Zofim"
    },
    "hin": {
      "descriptions": [
        {
          "description": "मोआब में पिसगा पर्वत की चोटी पर स्थित एक मैदान; उन स्थानों में से एक जहाँ से बिलाम को इस्राएल को शाप देना था।",
          "source": "acai"
        }
      ],
      "preferred_label": "सोपीम"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ọhịa dị nʼelu Ugwu Pisga na Moab; otu nʼime ebe ndị e si chọọ ka Belam bụọ Izrel ọnụ.",
          "source": "acai"
        }
      ],
      "preferred_label": "Zofim"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sebuah padang di puncak Gunung Pisga di Moab; salah satu tempat dari mana Bileam diminta mengutuk Israel.",
          "source": "acai"
        }
      ],
      "preferred_label": "Zofim"
    },
    "nep": {
      "descriptions": [
        {
          "description": "मोआबको पिसगा डाँडाको टाकुरामा रहेको एउटा मैदान; जहाँबाट बालामले इस्राएललाई सराप दिनुपर्ने स्थानहरूमध्ये एक।",
          "source": "acai"
        }
      ],
      "preferred_label": "सोफीम"
    },
    "por": {
      "descriptions": [
        {
          "description": "Um campo no topo do monte Pisga, em Moabe; um dos lugares de onde Balaão deveria amaldiçoar Israel.",
          "source": "acai"
        }
      ],
      "preferred_label": "Zofim"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Поле на вершине горы Фасга в Моаве; одно из мест, откуда Валаам должен был проклясть Израиль.",
          "source": "acai"
        }
      ],
      "preferred_label": "Цофим"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Campo en la cumbre del monte Pisga en Moab; uno de los lugares desde donde Balac llevó a Balaam para maldecir a Israel.",
          "source": "acai"
        }
      ],
      "preferred_label": "Zofim"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Shamba lililoko juu ya kilele cha Mlima Pisga huko Moabu; mojawapo ya maeneo ambayo Balaamu alipaswa kuilaani Israeli.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sofimu"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela hap graun i stap antap long maunten Pisga long Moap; wanpela bilong ol dispela ples we Balak i kisim Balam i go long en bai em i ken tok bilas na singautim hevi i kam long Israel.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sofim"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một cánh đồng trên đỉnh núi Phích-ga ở Mô-áp; một trong những nơi Ba-la-am định rủa sả dân Y-sơ-ra-ên.",
          "source": "acai"
        }
      ],
      "preferred_label": "Xô-phim"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "摩押境内毗斯迦山顶的一块田地；是巴兰准备咒诅以色列人的地方之一。",
          "source": "acai"
        }
      ],
      "preferred_label": "琐腓"
    },
    "zht": {
      "descriptions": [
        {
          "description": "摩押境內毗斯迦山頂的一處田地；巴蘭曾在此處要咒詛以色列。",
          "source": "acai"
        }
      ],
      "preferred_label": "瑣腓"
    }
  },
