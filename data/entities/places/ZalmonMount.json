  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "جبل قريب من شكيم، مشى ليه أبيمالك ورجاله وقطعوا حطب عشان يحرقوا برج شكيم (قضاة 9: 48).",
          "source": "acai"
        }
      ],
      "preferred_label": "جبل صلمون"
    },
    "arb": {
      "descriptions": [
        {
          "description": "جبل بالقرب من شكيم حيث قطع أبيمالك ورجاله خشبًا لإحراق برج شكيم (قضاة 9: 48).",
          "source": "acai"
        }
      ],
      "preferred_label": "جَبَل صَلْمون"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan hil klosap long Sekem we Abimelek wetem ol man blong hem oli katemaot wud long hem blong bonem taoa blong Sekem (Jajes 9:48).",
          "source": "acai"
        }
      ],
      "preferred_label": "Hil ya Jalmon"
    },
    "eng": {
      "alternate_labels": [
        "Mount Ebal",
        "Zalmon",
        "Zalmon Mount"
      ],
      "descriptions": [
        {
          "article": "place:MountZalmon",
          "description": "A mountain near Shechem where Abimelech and his men cut wood to burn the tower of Shechem (Judges 9:48).",
          "gloss": "Mount Zalmon",
          "source": "acai"
        }
      ],
      "preferred_label": "Mount Zalmon"
    },
    "fas": {
      "descriptions": [
        {
          "description": "کوهی در نزدیکی شکیم که ابی‌ملک و مردانش در آنجا چوب بریدند تا برج شکیم را به آتش بکشند (داوران ۹:۴۸).",
          "source": "acai"
        }
      ],
      "preferred_label": "کوه صلمون"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Une montagne près de Sichem où Abimélec et ses hommes coupèrent du bois pour brûler la tour de Sichem (Juges 9.48).",
          "source": "acai"
        }
      ],
      "preferred_label": "mont Tsalmon"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani dutse kusa da Shekem inda Abimelek da mutanensa suka sari itace don su ƙone hasumiyar Shekem (Alƙalawa 9:48).",
          "source": "acai"
        }
      ],
      "preferred_label": "Dutsen Zalmon"
    },
    "hin": {
      "descriptions": [
        {
          "description": "शेकेम के निकट स्थित एक पर्वत जहाँ अबीमेलेक और उसके लोगों ने शेकेम के गुम्मट को जलाने के लिए लकड़ियाँ काटी थीं (न्यायियों 9:48)।",
          "source": "acai"
        }
      ],
      "preferred_label": "सल्मोन पर्वत"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ugwu dị nso na Shekem ebe Abimelek na ndị agha ya gbuturu osisi iji gbaa ụlọ elu Shekem ọkụ (Ndị Ikpe 9:48).",
          "source": "acai"
        }
      ],
      "preferred_label": "Ugwu Zalmon"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sebuah gunung dekat Sekhem tempat Abimelekh dan pasukannya memotong kayu untuk membakar menara Sekhem (Hakim-hakim 9:48).",
          "source": "acai"
        }
      ],
      "preferred_label": "Gunung Zalmon"
    },
    "nep": {
      "descriptions": [
        {
          "description": "शेकेम नजिकैको एउटा पर्वत, जहाँ अबीमेलेक र तिनका मानिसहरूले शेकेमको धरहरा जलाउन काठ काटेका थिए (न्यायकर्ता ९:४८)।",
          "source": "acai"
        }
      ],
      "preferred_label": "सल्मोन डाँडा"
    },
    "por": {
      "descriptions": [
        {
          "description": "Um monte perto de Siquém onde Abimeleque e seus homens cortaram lenha para queimar a torre de Siquém (Juízes 9:48).",
          "source": "acai"
        }
      ],
      "preferred_label": "Monte Zalmom"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Гора близ Сихема, где Авимелех и его люди рубили сучья, чтобы сжечь башню Сихемскую (Судей 9:48).",
          "source": "acai"
        }
      ],
      "preferred_label": "гора Селмон"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Un monte cerca de Siquem donde Abimelec y sus hombres cortaron leña para quemar la torre de Siquem (Jueces 9:48).",
          "source": "acai"
        }
      ],
      "preferred_label": "Monte Zalmón"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mlima karibu na Shekemu ambapo Abimeleki na watu wake walikata kuni ili kuuchoma mnara wa Shekemu (Waamuzi 9:48).",
          "source": "acai"
        }
      ],
      "preferred_label": "Mlima Salmoni"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela maunten klostu long Sekem em Abimelek wantaim ol man bilong en i bin katim diwai long en bilong kukim strongpela taua bilong Sekem (Hetman 9:48).",
          "source": "acai"
        }
      ],
      "preferred_label": "Maunten Salmon"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một ngọn núi gần Si-kêm nơi A-bi-mê-léc và quân của ông chặt cây để phóng hỏa thiêu rụi tháp Si-kêm (Các Quan Xét 9:48).",
          "source": "acai"
        }
      ],
      "preferred_label": "Núi Sanh-môn"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "示剑附近的一座山，亚比米勒和跟从他的人曾在那里砍下树枝去焚烧示剑楼（士师记9:48）。",
          "source": "acai"
        }
      ],
      "preferred_label": "撒们山"
    },
    "zht": {
      "descriptions": [
        {
          "description": "示劍附近的一座山，亞比米勒和跟隨他的人曾在那裡砍伐樹枝焚燒示劍樓（士師記9:48）。",
          "source": "acai"
        }
      ],
      "preferred_label": "撒們山"
    }
  },
