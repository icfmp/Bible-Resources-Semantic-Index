  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "جزيرة صغيرة جنوب كريت مرّ بيها بولس في رحلته لروما، قبل انكسار السفينة.",
          "source": "acai"
        }
      ],
      "preferred_label": "كلودي"
    },
    "arb": {
      "descriptions": [
        {
          "description": "جَزِيرَةٌ صَغِيرَةٌ جَنُوبَ كِرِيتَ مَرَّ بِهَا بُولُسُ فِي رِحْلَتِهِ إِلَى رُومَا قَبْلَ غَرَقِ ٱلسَّفِينَةِ.",
          "source": "acai"
        }
      ],
      "preferred_label": "كَلَوْدِي"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan smol aelan long saot blong Krit we Pol i pas long hem long sip taem hem i stap go long Rom, bifo we sip i brok.",
          "source": "acai"
        }
      ],
      "preferred_label": "Kaoda"
    },
    "eng": {
      "alternate_labels": [
        "Clauda"
      ],
      "descriptions": [
        {
          "article": "place:Cauda",
          "description": "A small island south of Crete which Paul passed on his voyage to Rome, prior to the shipwreck.",
          "gloss": "Cauda",
          "source": "acai"
        }
      ],
      "preferred_label": "Cauda"
    },
    "fas": {
      "descriptions": [
        {
          "description": "جزیرهٔ کوچکی در جنوب کرت که پولس در سفر دریایی‌اش به روم، پیش از شکستن کشتی، از کنار آن گذشت.",
          "source": "acai"
        }
      ],
      "preferred_label": "کائودا"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Une petite île au sud de la Crète près de laquelle Paul passa lors de son voyage vers Rome, avant le naufrage.",
          "source": "acai"
        }
      ],
      "preferred_label": "Cauda"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani ƙaramin tsibiri a kudancin Kireta wanda Bulus ya bi ta kusa da shi a tafiyarsa zuwa Roma, kafin jirginsu ya fashe.",
          "source": "acai"
        }
      ],
      "preferred_label": "Kauda"
    },
    "hin": {
      "descriptions": [
        {
          "description": "क्रेते के दक्षिण में स्थित एक छोटा द्वीप जिसके पास से पौलुस जहाज टूटने से पहले रोम की अपनी यात्रा के दौरान गुजरा था।",
          "source": "acai"
        }
      ],
      "preferred_label": "कौदा"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Otu agwaetiti nta dị nʼebe ndịda Krit nke Pọl gabigara na njem ya na-aga Rom, tupu ụgbọ mmiri ahụ emebie.",
          "source": "acai"
        }
      ],
      "preferred_label": "Kọda"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sebuah pulau kecil di sebelah selatan Kreta yang dilewati Paulus dalam perjalanannya ke Roma sebelum terjadinya kapal karam.",
          "source": "acai"
        }
      ],
      "preferred_label": "Kauda"
    },
    "nep": {
      "descriptions": [
        {
          "description": "क्रीटको दक्षिणमा रहेको एउटा सानो टापु जहाँबाट जहाज फुट्नुअघि पावल रोमको यात्रामा जाँदा भएर गएका थिए।",
          "source": "acai"
        }
      ],
      "preferred_label": "क्लौडा"
    },
    "por": {
      "descriptions": [
        {
          "description": "Uma pequena ilha ao sul de Creta pela qual Paulo passou em sua viagem a Roma, antes do naufrágio.",
          "source": "acai"
        }
      ],
      "preferred_label": "Cauda"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Небольшой остров к югу от Крита, мимо которого Павел проплывал на пути в Рим перед кораблекрушением.",
          "source": "acai"
        }
      ],
      "preferred_label": "Клавда"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Pequeña isla al sur de Creta junto a la cual pasó Pablo en su viaje a Roma, antes del naufragio.",
          "source": "acai"
        }
      ],
      "preferred_label": "Cauda"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Kisiwa kidogo kusini mwa Krete ambacho Paulo alipita karibu nacho katika safari yake ya kuelekea Rumi, kabla ya merikebu kuvunjika.",
          "source": "acai"
        }
      ],
      "preferred_label": "Kauda"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela liklik ailan long saut bilong Krit em Pol i bin go paslain long sip i bagarap, long taim em i mekim raun i go long Rom.",
          "source": "acai"
        }
      ],
      "preferred_label": "Kauda"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một hòn đảo nhỏ ở phía nam đảo Cơ-rết mà Phao-lô đã đi ngang qua trong chuyến hải hành đến La Mã, trước khi bị đắm tàu.",
          "source": "acai"
        }
      ],
      "preferred_label": "Cơ-lô-đa"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "克里特以南的一座小岛，保罗在遭遇海难前前往罗马的航程中曾经过此地。",
          "source": "acai"
        }
      ],
      "preferred_label": "高大"
    },
    "zht": {
      "descriptions": [
        {
          "description": "克里特島以南的一個小島，保羅在前往羅馬遭遇船難前曾航經此地。",
          "source": "acai"
        }
      ],
      "preferred_label": "高大"
    }
  },
