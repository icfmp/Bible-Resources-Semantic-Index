        "Eder"
      ],
      "descriptions": [
        {
          "article": "place:Eder.1",
          "description": "A location near Jerusalem and Bethlehem, possibly a somewhat elevated place from which one could overlook a relatively large area of land. ",
          "gloss": "Tower of Eder",
          "source": "acai"
        }
      ],
      "preferred_label": "Tower of Eder"
    },
    "fas": {
      "descriptions": [
        {
          "description": "مکانی در نزدیکی اورشلیم و بیت‌لحم، احتمالاً مکانی نسبتاً مرتفع که از آنجا می‌شد منطقهٔ وسیعی از زمین را زیر نظر داشت.",
          "source": "acai"
        }
      ],
      "preferred_label": "برج عیدر"
    },
    "fra": {
      "descriptions": [
