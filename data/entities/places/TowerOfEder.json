  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "مكان قريب من أورشليم وبيت لحم، يمكن كان مكان مرتفع شوية الواحد بيقدر يعاين منه لمساحة كبيرة من الأرض.",
          "source": "acai"
        }
      ],
      "preferred_label": "برج عدر"
    },
    "arb": {
      "descriptions": [
        {
          "description": "موقع قرب أورشليم وبيت لحم، ربما كان مكاناً مرتفعاً يشرف على رقعة أرض واسعة نسبياً.",
          "source": "acai"
        }
      ],
      "preferred_label": "مَجْدَل عِدْر"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan ples klosap long Jerusalem mo Betlehem, ating wan ples we i hae lelebet we man i save lukluk aot long wan bigfala haf blong graon.",
          "source": "acai"
        }
      ],
      "preferred_label": "Wajhaos blong Eda"
    },
    "eng": {
