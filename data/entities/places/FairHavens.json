      ],
      "descriptions": [
        {
          "article": "place:FairHavens",
          "description": "A bay on the south coast of Crete; Paul's ship sought refuge from the windy sea on his voyage to Rome.",
          "gloss": "Fair Havens",
          "source": "acai"
        }
      ],
      "preferred_label": "Fair Havens"
    },
    "fas": {
      "descriptions": [
        {
          "description": "خلیجی در ساحل جنوبی کرت؛ کشتی پولس در سفر او به روم از بادهای دریا به آنجا پناه برد.",
          "source": "acai"
        }
      ],
      "preferred_label": "بندر زیبا"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Baie située sur la côte sud de la Crète ; le navire de Paul y a cherché refuge contre la mer agitée lors de son voyage vers Rome.",
          "source": "acai"
        }
      ],
      "preferred_label": "Beaux Ports"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani ƙoƙo a gaɓar kudu ta Kireta; jirgin Bulus ya nemi mafaka daga iskar teku a tafiyarsa zuwa Roma.",
          "source": "acai"
        }
      ],
      "preferred_label": "Kyakkyawan Mafaka"
    },
    "hin": {
      "descriptions": [
        {
          "description": "क्रेते के दक्षिणी तट पर स्थित एक खाड़ी; रोम की अपनी यात्रा के दौरान पौलुस के जहाज़ ने तूफ़ानी समुद्र से बचने के लिए यहाँ शरण ली थी।",
          "source": "acai"
        }
      ],
      "preferred_label": "शुभलंगरबारी"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ọdụ ụgbọ mmiri dị n'ụsọ osimiri ndịda nke Krit; ụgbọ mmiri Pọl chọrọ ebe mgbaba site na oke ifufe dị n'oké osimiri na njem ya na-aga Rom.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ọnụ Mmiri Ọma"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sebuah teluk di pantai selatan Kreta; kapal Paulus mencari perlindungan dari laut yang berangin dalam pelayarannya ke Roma.",
          "source": "acai"
        }
      ],
      "preferred_label": "Pelabuhan Indah"
    },
    "nep": {
      "descriptions": [
        {
          "description": "क्रेटको दक्षिणी तटमा रहेको एउटा खाडी; पावलको जहाजले रोमतर्फको यात्रामा हावाहुरीबाट शरण लिएको ठाउँ।",
          "source": "acai"
        }
      ],
      "preferred_label": "सुन्दर बन्दरगाह"
    },
    "por": {
      "descriptions": [
        {
          "description": "Uma baía na costa sul de Creta; o navio de Paulo buscou refúgio ali do mar agitado em sua viagem a Roma.",
          "source": "acai"
        }
      ],
      "preferred_label": "Bons Portos"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Бухта на южном побережье Крита; корабль Павла искал здесь укрытия от бурного моря во время плавания в Рим.",
          "source": "acai"
        }
      ],
      "preferred_label": "Хорошие Пристани"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Una bahía en la costa sur de Creta; el barco de Pablo buscó refugio del viento en su viaje a Roma.",
          "source": "acai"
        }
      ],
      "preferred_label": "Buenos Puertos"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Ghuba iliyo kwenye pwani ya kusini ya Krete; meli ya Paulo ilitafuta hifadhi humo dhidi ya upepo wa bahari katika safari yake ya kwenda Rumi.",
          "source": "acai"
        }
      ],
      "preferred_label": "Bandari Nzuri"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela pasis long nambis long hap saut bilong Krit; sip bilong Pol i bin go hait long en bilong abrusim bikpela win long raun bilong en i go long Rom.",
          "source": "acai"
        }
      ],
      "preferred_label": "Gutpela Pasis"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một vịnh ở bờ biển phía nam đảo Cơ-rết; tàu của Phao-lô đã tìm nơi trú ẩn khỏi biển động trên hành trình đến La Mã.",
          "source": "acai"
        }
      ],
      "preferred_label": "Mỹ Cảng"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "克里特岛南岸的一个海湾；保罗在前往罗马的航程中，船只曾在此躲避风浪。",
          "source": "acai"
        }
      ],
      "preferred_label": "佳澳"
