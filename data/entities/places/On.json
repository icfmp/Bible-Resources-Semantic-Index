      ],
      "descriptions": [
        {
          "article": "place:On",
          "description": "A town in Lower-Egypt, to be identified with Heliopolis; center of worship of solar deities such as Re and Atum (ABD).",
          "gloss": "On",
          "source": "acai"
        }
      ],
      "preferred_label": "On"
    },
    "fas": {
      "descriptions": [
        {
          "description": "شهری در مصر سفلی که با هلیوپولیس یکی دانسته می‌شود؛ مرکز پرستش خدایان خورشیدی مانند رع و آتوم.",
          "source": "acai"
        }
      ],
      "preferred_label": "اون"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Une ville de Basse-Égypte, à identifier avec Héliopolis ; centre de culte de divinités solaires telles que Rê et Atoum (ABD).",
          "source": "acai"
        }
      ],
      "preferred_label": "On"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani gari ne a Ƙananan Masar, wanda ake danganta shi da Heliopolis; cibiyar bauta wa allolin rana irin su Re da Atum (ABD).",
          "source": "acai"
        }
      ],
      "preferred_label": "On"
    },
    "hin": {
      "descriptions": [
        {
          "description": "निचले मिस्र का एक नगर, जिसकी पहचान हेलियोपोलिस से की जाती है; रे और अतुम जैसे सूर्य देवताओं की उपासना का केंद्र।",
          "source": "acai"
        }
      ],
      "preferred_label": "ओन"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Obodo dị na Ndịda Ijipt (Lower Egypt), nke a na-amata dị ka Heliopolis; isi ebe ife chi anyanwụ dị iche iche dị ka Re na Atum.",
          "source": "acai"
        }
      ],
      "preferred_label": "On"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sebuah kota di Mesir Hilir, yang disamakan dengan Heliopolis; pusat penyembahan dewa-dewa matahari seperti Re dan Atum (ABD).",
          "source": "acai"
        }
      ],
      "preferred_label": "On"
    },
    "nep": {
      "descriptions": [
        {
          "description": "तल्लो मिश्रको एउटा सहर, जसलाई हेलियोपोलिस भनी पहिचान गर्न सकिन्छ; रे र अतुमजस्ता सूर्य देवताहरूको उपासनाको केन्द्र।",
          "source": "acai"
        }
      ],
      "preferred_label": "ओन"
    },
    "por": {
      "descriptions": [
        {
          "description": "Uma cidade no Baixo Egito, identificada com Heliópolis; centro de adoração de divindades solares como Rá e Atum (ABD).",
          "source": "acai"
        }
      ],
      "preferred_label": "Om"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Город в Нижнем Египте, отождествляемый с Илиополем; центр поклонения солярным божествам, таким как Ра и Атум (ABD).",
          "source": "acai"
        }
      ],
      "preferred_label": "Он"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Ciudad en el Bajo Egipto, identificada con Heliópolis; centro de adoración de deidades solares como Ra y Atum (ABD).",
          "source": "acai"
        }
      ],
      "preferred_label": "On"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mji ulioko Misri ya Chini, unaotambuliwa kama Heliopoli; kitovu cha ibada ya miungu ya jua kama vile Re na Atum (ABD).",
          "source": "acai"
        }
      ],
      "preferred_label": "Oni"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela taun long Daunbilo Isip, ol i save makim wantaim Heliopolis; em i bikpela ples bilong lotu long ol god bilong san olsem Re na Atum.",
          "source": "acai"
        }
      ],
      "preferred_label": "Heliopolis"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một thị trấn ở Hạ Ai Cập, được đồng nhất với Heliopolis; trung tâm thờ phượng các thần mặt trời như Re và Atum (ABD).",
          "source": "acai"
        }
      ],
      "preferred_label": "Ôn"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "下埃及的一座城镇，即赫利奥波利斯（太阳城）；是敬拜拉（Re）和阿图姆（Atum）等太阳神祇的中心。",
          "source": "acai"
        }
      ],
      "preferred_label": "安城"
    },
    "zht": {
      "descriptions": [
        {
          "description": "下埃及的一座城鎮，即希利奧波利斯（太陽城）；是敬拜拉（Re）和亞圖姆（Atum）等太陽神祇的中心（見《安克聖經辭典》）。",
          "source": "acai"
        }
      ],
      "preferred_label": "安城"
    }
