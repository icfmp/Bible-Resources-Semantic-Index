  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "حِلّة لاوية في أراضي يساكر، مخصصة لعشيرة جرشون؛ وتُعرف كمان باسم عين جنيم.",
          "source": "acai"
        }
      ],
      "preferred_label": "عانيم"
    },
    "arb": {
      "descriptions": [
        {
          "description": "بَلْدَةٌ لِلَّاوِيِّينَ فِي أَرْضِ يَسَّاكَرَ، خُصِّصَتْ لِعَشِيرَةِ جَرْشُونَ؛ وَتُعْرَفُ أَيْضًا بِعَيْنِ جَنِّيمَ.",
          "source": "acai"
        }
      ],
      "preferred_label": "عَانِيم"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan taon blong ol Livaet long teritori blong Isakar, we oli givim i go long laen blong Gerson; we oli singaotem tu se En-Ganim.",
          "source": "acai"
        }
      ],
      "preferred_label": "Anem"
    },
    "eng": {
      "alternate_labels": [
        "En-Gannim"
      ],
      "descriptions": [
        {
          "article": "place:Anem",
          "description": "A Levitical town in the territory of Issachar, assigned to the clan of Gershon; also known as En-Gannim.",
          "gloss": "Anem",
          "source": "acai"
        }
      ],
      "preferred_label": "Anem"
    },
    "fas": {
      "descriptions": [
        {
          "description": "شهری لاوی در قلمرو یساکار، اختصاص‌یافته به خاندان جرشون؛ همچنین معروف به عین‌جنیم.",
          "source": "acai"
        }
      ],
      "preferred_label": "عانیم"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Une ville lévitique située sur le territoire d'Issacar, attribuée au clan de Guerschon ; également connue sous le nom d'En-Gannim.",
          "source": "acai"
        }
      ],
      "preferred_label": "Anem"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani garin Lawiyawa a yankin Issakar, wanda aka ba wa dangin Gershon; wanda kuma aka sani da En-Gannim.",
          "source": "acai"
        }
      ],
      "preferred_label": "Anem"
    },
    "hin": {
      "descriptions": [
        {
          "description": "इस्साकार के क्षेत्र में एक लेवीय नगर, जिसे गेर्शोन के कुल को सौंपा गया था; इसे एनगन्नीम के नाम से भी जाना जाता है।",
          "source": "acai"
        }
      ],
      "preferred_label": "आनेम"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Otu obodo ndị Livaị dị nʼókèala ndị Isaka, nke e kenyere ezinụlọ Geashọn; nke a makwaara dị ka En-Ganim.",
          "source": "acai"
        }
      ],
      "preferred_label": "Anem"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sebuah kota orang Lewi di wilayah Isakhar, yang diberikan kepada kaum Gerson; juga dikenal sebagai En-Ganim.",
          "source": "acai"
        }
      ],
      "preferred_label": "Anem"
    },
    "nep": {
      "descriptions": [
        {
          "description": "गेर्शोनको कुललाई दिइएको इश्शाकारको इलाकाको एउटा लेवीहरूको सहर; एन-गन्नीम भनेर पनि चिनिने।",
          "source": "acai"
        }
      ],
      "preferred_label": "अनेम"
    },
    "por": {
      "descriptions": [
        {
          "description": "Uma cidade levítica no território de Issacar, designada ao clã de Gérson; também conhecida como En-Ganim.",
          "source": "acai"
        }
      ],
      "preferred_label": "Aném"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Левитский город в уделе Иссахара, выделенный роду Гирсона; также известен как Ен-Ганним.",
          "source": "acai"
        }
      ],
      "preferred_label": "Анем"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Un pueblo levítico en el territorio de Isacar, asignado al clan de Gersón; también conocido como En-gannim.",
          "source": "acai"
        }
      ],
      "preferred_label": "Anem"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mji wa Walawi katika eneo la Isakari, uliogawiwa ukoo wa Gershoni; pia unajulikana kama Enganimu.",
          "source": "acai"
        }
      ],
      "preferred_label": "Anemu"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela taun bilong ol Livai long graun bilong Isakar, em ol i bin givim long famili bilong Gerson; narapela nem bilong en Enganim.",
          "source": "acai"
        }
      ],
      "preferred_label": "Anem"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một thị trấn của người Lê-vi trong lãnh thổ Y-sa-ca, được chỉ định cho thị tộc Ghẹt-sôn; còn được gọi là Ên-Ga-nim.",
          "source": "acai"
        }
      ],
      "preferred_label": "A-nem"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "以萨迦境内的利未人城镇，分给革顺宗族；又称隐干宁。",
          "source": "acai"
        }
      ],
      "preferred_label": "亚年"
    },
    "zht": {
      "descriptions": [
        {
          "description": "以薩迦境內的一座利未人城鎮，分給革順家族；又名隱干寧。",
          "source": "acai"
        }
      ],
      "preferred_label": "亞年"
    }
  },
