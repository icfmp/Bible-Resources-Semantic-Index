  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "إقليم في الجزء الجنوبي من آسيا الصغرى؛ بولس ورفاقه سافروا ليه في رحلته التبشيرية الأولى.",
          "source": "acai"
        }
      ],
      "preferred_label": "بمفيلية"
    },
    "arb": {
      "descriptions": [
        {
          "description": "مُقَاطَعَةٌ فِي الْجُزْءِ الْجَنُوبِيِّ مِنْ آسِيَا الصُّغْرَى؛ سَافَرَ إِلَيْهَا بُولُسُ وَرُفَقَاؤُهُ خِلَالَ رِحْلَتِهِ التَّبْشِيرِيَّةِ الْأُولَى.",
          "source": "acai"
        }
      ],
      "preferred_label": "بَمْفِيلِيَّةُ"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan provins long saot blong Esia Maena; Pol mo ol fren blong hem oli travel i go long ples ya long faswan misinari trip blong hem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Pamfilia"
    },
    "eng": {
      "descriptions": [
        {
          "article": "place:Pamphylia",
          "description": "A province in the southern part of Asia Minor; Paul and his companions traveled here during his first missionary journey.",
          "gloss": "Pamphylia",
          "source": "acai"
        }
      ],
      "preferred_label": "Pamphylia"
    },
    "fas": {
      "descriptions": [
        {
          "description": "ولایتی در بخش جنوبی آسیای صغیر؛ پولس و همراهانش در نخستین سفر میسیونری او به اینجا سفر کردند.",
          "source": "acai"
        }
      ],
      "preferred_label": "پمفلیه"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Une province de la partie méridionale de l'Asie Mineure ; Paul et ses compagnons s'y sont rendus au cours de son premier voyage missionnaire.",
          "source": "acai"
        }
      ],
      "preferred_label": "Pamphylie"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani lardi ne a kudancin Asiya Ƙarama; Bulus da abokan tafiyarsa sun yi tafiya a nan a lokacin tafiyarsa ta farko ta wa’azi.",
          "source": "acai"
        }
      ],
      "preferred_label": "Famfiliya"
    },
    "hin": {
      "descriptions": [
        {
          "description": "एशिया माइनर के दक्षिणी भाग में एक प्रांत; अपनी पहली मिशनरी यात्रा के दौरान पौलुस और उसके साथियों ने यहाँ यात्रा की थी।",
          "source": "acai"
        }
      ],
      "preferred_label": "पंफूलिया"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ógbè dị nʼakụkụ ndịda nke Eshia Maịnọ; Pọl na ndị ya na ha so mere njem nʼebe a nʼoge njem mgbasa ozi ọma mbụ ya.",
          "source": "acai"
        }
      ],
      "preferred_label": "Pamfilia"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sebuah provinsi di bagian selatan Asia Kecil; Paulus dan rekan-rekannya melakukan perjalanan ke sini selama perjalanan misi pertamanya.",
          "source": "acai"
        }
      ],
      "preferred_label": "Pamfilia"
    },
    "nep": {
      "descriptions": [
        {
          "description": "एसिया माइनरको दक्षिणी भागमा रहेको एक प्रान्त; पावल र उनका साथीहरूले आफ्नो पहिलो मिसनरी यात्राको क्रममा यहाँ भ्रमण गरेका थिए।",
          "source": "acai"
        }
      ],
      "preferred_label": "पाम्फिलिया"
    },
    "por": {
