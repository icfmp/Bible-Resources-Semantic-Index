  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "مدينة في بمفيلية، قريبة من الساحل الجنوبي لآسيا الصغرى؛ بولس سافر ليها في رحلتو التبشيرية الأولى.",
          "source": "acai"
        }
      ],
      "preferred_label": "بيرجة"
    },
    "arb": {
      "descriptions": [
        {
          "description": "مدينة في بمفيلية، بالقرب من الساحل الجنوبي لآسيا الصغرى؛ سافر إليها بولس خلال رحلته التبشيرية الأولى.",
          "source": "acai"
        }
      ],
      "preferred_label": "بَرْجَةُ"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan taon long Pamfilia, klosap long saot solwota blong Esia Maena; Pol i bin travel i go long ples ya long fas misinari trip blong hem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Pega"
    },
    "eng": {
      "descriptions": [
        {
          "article": "place:Perga",
          "description": "A city in Pamphylia, near the south coast of Asia Minor; Paul traveled here during his first missionary journey.",
          "gloss": "Perga",
          "source": "acai"
        }
      ],
      "preferred_label": "Perga"
    },
    "fas": {
      "descriptions": [
        {
          "description": "شهری در پامفیلیه در نزدیکی ساحل جنوبی آسیای صغیر؛ پولس در طول نخستین سفر بشارتی خود به اینجا سفر کرد.",
          "source": "acai"
        }
      ],
      "preferred_label": "پِرجه"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Une ville de Pamphylie, près de la côte sud de l'Asie mineure ; Paul s'y rendit au cours de son premier voyage missionnaire.",
          "source": "acai"
        }
      ],
      "preferred_label": "Perge"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani birni a Famfiliya, kusa da gaɓar tekun kudu ta Asiya Ƙarama; Bulus ya yi tafiya zuwa nan a lokacin tafiyarsa ta farko ta wa’azi.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ferga"
    },
    "hin": {
      "descriptions": [
        {
          "description": "पंफूलिया का एक नगर, जो एशिया माइनर के दक्षिणी तट के निकट था; अपनी पहली मिशनरी यात्रा के दौरान पौलुस यहाँ आया था।",
          "source": "acai"
        }
      ],
      "preferred_label": "पिरगा"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Otu obodo dị na Pamfilia, dị nso nʼụsọ oké osimiri ndịda nke Eshia Maịnọ; Pọl mere njem gaa ebe a nʼoge njem ozi ala ọzọ mbụ ya.",
          "source": "acai"
        }
      ],
      "preferred_label": "Pega"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sebuah kota di Pamfilia, dekat pesisir selatan Asia Kecil; Paulus bepergian ke tempat ini dalam perjalanan misi pertamanya.",
          "source": "acai"
        }
      ],
      "preferred_label": "Perga"
    },
    "nep": {
      "descriptions": [
        {
          "description": "एसिया माइनरको दक्षिणी तट नजिकै पाम्फिलियाको एउटा सहर; पावलले आफ्नो पहिलो मिसनरी यात्राको क्रममा यहाँ यात्रा गरेका थिए।",
          "source": "acai"
        }
      ],
      "preferred_label": "पर्गा"
    },
    "por": {
      "descriptions": [
        {
          "description": "Uma cidade na Panfília, perto da costa sul da Ásia Menor; Paulo viajou para cá durante sua primeira viagem missionária.",
          "source": "acai"
        }
      ],
      "preferred_label": "Perge"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Город в Памфилии, недалеко от южного побережья Малой Азии; Павел посетил его во время своего первого миссионерского путешествия.",
          "source": "acai"
        }
      ],
      "preferred_label": "Пергия"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Una ciudad en Panfilia, cerca de la costa sur de Asia Menor; Pablo viajó aquí durante su primer viaje misionero.",
          "source": "acai"
        }
      ],
      "preferred_label": "Perge"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mji ulioko Pamfilia, karibu na pwani ya kusini ya Asia Ndogo; Paulo alisafiri hapa wakati wa safari yake ya kwanza ya kimisionari.",
          "source": "acai"
        }
      ],
      "preferred_label": "Perga"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela taun long Pamfilia, klostu long saut nambis bilong Esia Maina; Pol i bin go long dispela taun long namba wan raun bilong em bilong autim tok bilong Bikpela.",
          "source": "acai"
        }
      ],
      "preferred_label": "Perga"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một thành phố ở Bam-phi-ly, gần bờ biển phía nam Tiểu Á; Phao-lô đã đến nơi này trong chuyến hành trình truyền giáo thứ nhất.",
          "source": "acai"
        }
      ],
      "preferred_label": "Bẹt-ga"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "旁非利亚的一座城市，靠近小亚细亚南海岸；保罗在第一次宣教旅程中曾来到这里。",
          "source": "acai"
        }
      ],
      "preferred_label": "别加"
    },
    "zht": {
      "descriptions": [
        {
          "description": "小亞細亞南岸附近旁非利亞的一座城；保羅在第一次傳道旅程中曾前往此地。",
          "source": "acai"
        }
      ],
      "preferred_label": "別加"
    }
