  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "مكان قريب من بيدر ناكون، وين ما الرب كتَل عُزّة عشان لَمَس تابوت العهد.",
          "source": "acai"
        }
      ],
      "preferred_label": "فارص عُزّة"
    },
    "arb": {
      "descriptions": [
        {
          "description": "موضع بالقرب من بيدر ناخون، حيث أمات الرب عُزَّة لأنه لمس تابوت العهد.",
          "source": "acai"
        }
      ],
      "preferred_label": "فَارِصُ عُزَّةَ"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan ples klosap long ples blong Nacon we oli stap kilim wit long hem, we Yawe i kilim Usaha i ded from we hem i tajem bokis blong agrimen.",
          "source": "acai"
        }
      ],
      "preferred_label": "Peres Usaha"
    },
    "eng": {
      "alternate_labels": [
        "Perez-Uzza",
        "Outburst Against Uzzah"
      ],
      "descriptions": [
        {
          "article": "place:Perez-uzzah",
          "description": "A location near the threshing floor of Nacon, where Yahweh killed Uzzah because he touched the ark of the covenant.",
          "gloss": "Perez-Uzzah",
          "source": "acai"
        }
      ],
      "preferred_label": "Perez-uzzah"
    },
    "fas": {
      "descriptions": [
        {
          "description": "مکانی در نزدیکی خرمنگاه ناکون، جایی که یهوه عُزّه را به این دلیل که دست به صندوق عهد زد، هلاک ساخت.",
          "source": "acai"
        }
      ],
      "preferred_label": "فارَص عُزّه"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Un lieu près de l'aire de Nacon, où Yahvé tua Uzza parce qu'il avait touché l'arche de l'alliance.",
          "source": "acai"
        }
      ],
      "preferred_label": "Pérets-Uzza"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani wuri kusa da masussukar Nakon, inda Yahweh ya kashe Uzza domin ya taɓa akwatin alkawari.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ferez Uzza"
    },
    "hin": {
      "descriptions": [
        {
          "description": "नाकोन के खलिहान के पास का एक स्थान, जहाँ यहोवा ने उज्जा को मार डाला क्योंकि उसने वाचा के सन्दूक को छू लिया था।",
          "source": "acai"
        }
      ],
      "preferred_label": "पेरेसुज्जा"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ebe dị nso nʼala nzọcha ọka Nekọn, ebe Yahweh gburu Ụza nʼihi na o bitụrụ igbe ọgbụgba ndụ ahụ aka.",
          "source": "acai"
        }
      ],
      "preferred_label": "Perez Ụza"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sebuah lokasi di dekat tempat pengirikan Nakon, tempat Yahweh menewaskan Uza karena menyentuh tabut perjanjian.",
          "source": "acai"
        }
      ],
      "preferred_label": "Peres-Uza"
    },
    "nep": {
      "descriptions": [
        {
          "description": "नाकोनको खलो नजिकैको एउटा ठाउँ, जहाँ उज्‍जाहले करारको सन्दुक छोएको कारण परमप्रभुले उसलाई मार्नुभयो।",
          "source": "acai"
        }
      ],
      "preferred_label": "फारेस-उज्‍जाह"
    },
    "por": {
      "descriptions": [
        {
          "description": "Um local próximo à eira de Nacom, onde Yahweh feriu Uzá porque ele tocou na arca da aliança.",
          "source": "acai"
        }
      ],
      "preferred_label": "Perez-Uzá"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Местность возле гумна Нахонова, где Яхве поразил Озу за то, что тот коснулся ковчега завета.",
          "source": "acai"
        }
      ],
      "preferred_label": "Поражение Озы"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Un lugar cerca de la era de Nacón, donde Yahvé mató a Uza por tocar el arca del pacto.",
          "source": "acai"
        }
      ],
      "preferred_label": "Pérez-uza"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mahali karibu na uwanja wa kupuria nafaka wa Nakoni, ambapo Yahweh alimuua Uza kwa sababu aliugusa sanduku la agano.",
          "source": "acai"
        }
      ],
      "preferred_label": "Peres-Uza"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela hap klostu long ples bilong mekim wit i kamap klin bilong Nakon, em ples Bikpela i bin kilim Usa i dai long en, long wanem, em i bin tatsim bokis kontrak.",
          "source": "acai"
        }
      ],
      "preferred_label": "God I Mekim Save Long Usa"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một địa điểm gần sân đập lúa Na-côn, nơi Đức Giê-hô-va đánh chết U-xa vì ông đã chạm vào hòm giao ước.",
          "source": "acai"
        }
      ],
      "preferred_label": "Phê-rết U-xa"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "靠近拿艮禾场的一个地方，雅威因乌撒触摸约柜而击杀了他。",
          "source": "acai"
        }
      ],
      "preferred_label": "毗列斯·乌撒"
    },
    "zht": {
      "descriptions": [
        {
          "description": "靠近拿艮禾場的一處地點，因烏撒觸摸約櫃，耶和華在此將他擊殺。",
          "source": "acai"
        }
      ],
      "preferred_label": "毗列斯‧烏撒"
    }
