  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "مدينة ميناء على ساحل فينيقية، شمال صور؛ كانت بتحدد الحد الشمالي لأرض الموعد.",
          "source": "acai"
        }
      ],
      "preferred_label": "صيدا"
    },
    "arb": {
      "descriptions": [
        {
          "description": "مدينة ساحلية على الساحل الفينيقي، شمال صور؛ حددت الحدود الشمالية لأرض الموعد.",
          "source": "acai"
        }
      ],
      "preferred_label": "صَيْدونُ"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan taon we i gat pot blong sip long kos blong Fonisia, long not blong Taea; hem i makem maonteri long not blong promes lan.",
          "source": "acai"
        }
      ],
      "preferred_label": "Saedon"
    },
    "eng": {
      "alternate_labels": [
        "Zidon",
        "Sidonian",
        "Sidon the Great",
        "Greater Sidon",
        "great Zidon",
        "Sidonians",
        "Zidonians",
        "Great Sidon"
      ],
      "descriptions": [
        {
          "article": "place:Sidon",
          "description": "A seaport town on the Phoenician coast, north of Tyre; marked the northern boundary of the promised land.",
          "gloss": "Sidon",
          "source": "acai"
        }
      ],
      "preferred_label": "Sidon"
    },
    "fas": {
      "descriptions": [
        {
          "description": "شهری بندری در سواحل فنیقیه، در شمال صور؛ که مرز شمالی سرزمین موعود را مشخص می‌کرد.",
          "source": "acai"
        }
      ],
      "preferred_label": "صیدون"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Une ville portuaire sur la côte phénicienne, au nord de Tyr ; elle marquait la frontière septentrionale de la terre promise.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sidon"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani birni mai tashar jiragen ruwa a gabar tekun Funisiya, arewacin Taya; ya nuna iyakar arewa ta ƙasar alkawari.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sidon"
    },
    "hin": {
      "descriptions": [
        {
          "description": "फ़ोनीके तट पर स्थित एक बंदरगाह नगर, जो सोर के उत्तर में था; इसने प्रतिज्ञा किए हुए देश की उत्तरी सीमा को चिह्नित किया।",
          "source": "acai"
        }
      ],
      "preferred_label": "सीदोन"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Obodo ọdụ ụgbọ mmiri dị nʼụsọ osimiri Fonishia, nʼebe ugwu Taịa; ọ mara oke ala e kwere na nkwa nʼakụkụ ugwu.",
          "source": "acai"
        }
      ],
      "preferred_label": "Saịdọn"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sebuah kota pelabuhan di pesisir Fenisia, sebelah utara Tirus; menandai batas utara tanah perjanjian.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sidon"
    },
    "nep": {
      "descriptions": [
        {
          "description": "टुरोसको उत्तरमा फोनिसियाली तटमा अवस्थित एउटा बन्दरगाह सहर; जसले प्रतिज्ञा गरिएको देशको उत्तरी सिमानालाई चिन्हित गरेको थियो।",
          "source": "acai"
        }
      ],
      "preferred_label": "सीदोन"
    },
    "por": {
      "descriptions": [
        {
          "description": "Uma cidade portuária na costa fenícia, ao norte de Tiro; marcava a fronteira norte da terra prometida.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sidom"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Приморский портовый город на побережье Финикии к северу от Тира; обозначал северную границу обетованной земли.",
          "source": "acai"
        }
      ],
      "preferred_label": "Сидон"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Ciudad portuaria en la costa fenicia, al norte de Tiro; marcaba el límite norte de la tierra prometida.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sidón"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mji wa bandari kwenye pwani ya Foinike, kaskazini mwa Tiro; uliweka alama ya mpaka wa kaskazini wa nchi ya ahadi.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sidoni"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela taun bilong seiklostu long solwara long nambis bilong Fonisia, long hap not bilong Tair; em i makim mak bilong hap not bilong graun promis.",
          "source": "acai"
        }
      ],
      "preferred_label": "Saidon"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một thành phố cảng trên bờ biển Phe-ni-xi, phía bắc Ty-rơ; từng đánh dấu ranh giới phía bắc của vùng đất hứa.",
          "source": "acai"
        }
      ],
      "preferred_label": "Si-đôn"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "位于腓尼基沿岸、推罗以北的海港城镇；标志着应许之地的北部边界。",
          "source": "acai"
        }
      ],
      "preferred_label": "西顿"
    },
    "zht": {
      "descriptions": [
        {
          "description": "腓尼基海岸泰爾以北的一座海港城鎮；標誌著應許之地的北部邊界。",
          "source": "acai"
        }
      ],
      "preferred_label": "西頓"
    }
  },
