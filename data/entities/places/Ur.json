  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "بلدة على نهر الفرات في جنوب بلاد ما بين النهرين، حيث كان يعيش إبراهيم وعائلته قبل أن ينتقلوا إلى حاران.",
          "source": "acai"
        }
      ],
      "preferred_label": "أور (بلدة)"
    },
    "arb": {
      "descriptions": [
        {
          "description": "مدينة على نهر الفرات في جنوب بلاد ما بين النهرين (أَرَامَ)، حيث كان إبراهيم وعائلته يعيشون قبل انتقالهم إلى حاران.",
          "source": "acai"
        }
      ],
      "preferred_label": "أور (مدينة)"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan taon long Reva Yufretis long saot blong Mesopotemia, we Ebraham wetem famle blong hem oli bin stap long hem bifo oli muv i go long Haran.",
          "source": "acai"
        }
      ],
      "preferred_label": "Uru (Taon)"
    },
    "eng": {
      "alternate_labels": [
        "Ur of the Chaldees",
        "Ur"
      ],
      "descriptions": [
        {
          "article": "place:Ur.1",
          "description": "A town on the Euphrates River in southern Mesopotamia, where Abraham and his family used to live before moving to Haran.",
          "gloss": "Ur (Town)",
          "source": "acai"
        }
      ],
      "preferred_label": "Ur (Town)"
    },
    "fas": {
      "descriptions": [
        {
          "description": "شهری در کنار رود فرات در جنوب میان‌رودان، که ابراهیم و خانواده‌اش پیش از نقل مکان به حران در آنجا زندگی می‌کردند.",
          "source": "acai"
        }
      ],
      "preferred_label": "اور (شهر)"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Une ville située sur l'Euphrate dans le sud de la Mésopotamie, où habitaient Abraham et sa famille avant de partir pour Charan.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ur (ville)"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani gari a Kogin Yufiretis a kudancin Aram-Naharayim, inda Ibrahim da iyalinsa suka taɓa zama kafin su ƙaura zuwa Haran.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ur (Gari)"
    },
    "hin": {
      "descriptions": [
        {
          "description": "दक्षिणी मेसोपोटामिया में फरात नदी पर स्थित एक नगर, जहाँ हारान जाने से पहले इब्राहीम और उसका परिवार रहा करते थे।",
          "source": "acai"
        }
      ],
      "preferred_label": "ऊर (नगर)"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Otu obodo dị nʼakụkụ Osimiri Yufretis na ndịda Mesopotemịa, ebe Ebreham na ezinụlọ ya bi na mbụ tupu ha enwee njem gawa Haran.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ụọ (Obodo)"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sebuah kota di tepi Sungai Efrat di Mesopotamia selatan, tempat tinggal Abraham dan keluarganya sebelum pindah ke Haran.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ur (Kota)"
    },
    "nep": {
      "descriptions": [
        {
          "description": "दक्षिणी मेसोपोटामियाको युफ्रेटिस नदी किनारमा रहेको एउटा सहर, जहाँ हारान सर्नुभन्दा अघि अब्राहाम र तिनको परिवार बस्ने गर्थे।",
          "source": "acai"
        }
      ],
      "preferred_label": "ऊर (सहर)"
    },
    "por": {
      "descriptions": [
        {
          "description": "Uma cidade no rio Eufrates, no sul da Mesopotâmia, onde Abraão e sua família viviam antes de se mudarem para Harã.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ur (cidade)"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Город на реке Евфрат в южной Месопотамии, где жили Авраам и его семья до переселения в Харран.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ур (город)"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Una ciudad junto al río Éufrates en el sur de Mesopotamia, donde vivían Abraham y su familia antes de trasladarse a Harán.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ur (ciudad)"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mji ulioko kando ya Mto Frati kusini mwa Mesopotamia, ambapo Abrahamu na familia yake waliishi kabla ya kuhamia Harani.",
          "source": "acai"
        }
      ],
      "preferred_label": "Uru (Mji)"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela taun long wara Yufretis long hap saut bilong Mesopotemia, ples Abraham wantaim famili bilong em i bin stap bipo long ol i muv i go long Haran.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ur (Taun)"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một thị trấn bên bờ sông Ơ-phơ-rát ở miền nam Lưỡng Hà, nơi Áp-ra-ham và gia đình từng sinh sống trước khi chuyển đến Ha-ran.",
          "source": "acai"
        }
      ],
      "preferred_label": "U-rơ (Thị trấn)"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "位于美索不达米亚南部幼发拉底河畔的一座城镇，亚伯拉罕及其家人迁居哈兰之前曾居住于此。",
          "source": "acai"
        }
      ],
      "preferred_label": "吾珥 (城)"
    },
    "zht": {
      "descriptions": [
        {
          "description": "美索不達米亞南部幼發拉底河畔的一座城鎮，是亞伯拉罕及其家族在遷往哈蘭之前曾居住的地方。",
          "source": "acai"
        }
      ],
      "preferred_label": "吾珥 (城鎮)"
    }
  },
