        }
      ],
      "preferred_label": "Ấn Độ"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "位于波斯以东的一片土地，构成了亚哈随鲁所统治王国的东部边界（以斯帖记 1:1）。",
          "source": "acai"
        }
      ],
      "preferred_label": "印度"
    },
    "zht": {
      "descriptions": [
        {
