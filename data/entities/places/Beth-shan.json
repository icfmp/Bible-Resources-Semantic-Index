          "source": "acai"
        }
      ],
      "preferred_label": "Beth-shan"
    },
    "fas": {
      "descriptions": [
        {
          "description": "شهری مرزی در قلمرو منسی غربی، نزدیک صارِتان، جایی که جسد شائول پس از کشته شدنش آویزان شد.",
          "source": "acai"
        }
      ],
      "preferred_label": "بیت‌شان"
    },
    "fra": {
      "descriptions": [
        {
