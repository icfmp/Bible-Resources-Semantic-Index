  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "سلسلة جبال في إسرائيل، جنوب شرق وادي يزرعيل، ماتوا فيها شاول وتلاتة من أولاده (1 صموئيل 31: 1-6).",
          "source": "acai"
        }
      ],
      "preferred_label": "جبل جلبوع"
    },
    "arb": {
      "descriptions": [
        {
          "description": "سلسلة جبلية في إسرائيل، جنوب شرقي مرج ابن عامر (وادي يزرعيل)، حيث مات شاول وثلاثة من بنيه (1 صموئيل 31: 1–6).",
          "source": "acai"
        }
      ],
      "preferred_label": "جَبَلُ جِلْبُوعَ"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan hil long Isrel, saotis long Vale blong Jesril, we Sol wetem trifala pikinini boe blong hem oli ded long hem (1 Samuel 31:1–6).",
          "source": "acai"
        }
      ],
      "preferred_label": "Hil ya Gilboa"
    },
    "eng": {
      "alternate_labels": [
        "Mountains of Gilboa",
        "Gilboa",
        "Mount Gilead"
      ],
      "descriptions": [
        {
          "article": "place:MountGilboa",
          "description": "A mountain range in Israel, southeast of the Jezreel Valley, where Saul and three of his sons died (1 Samuel 31:1–6). ",
          "gloss": "Mount Gilboa",
          "source": "acai"
        }
      ],
      "preferred_label": "Mount Gilboa"
    },
    "fas": {
      "descriptions": [
        {
          "description": "رشته‌کوهی در اسرائیل، در جنوب شرقی درهٔ یزرعیل، جایی که شائول و سه پسرش در آنجا کشته شدند (۱ سموئیل ۳۱: ۱–۶).",
          "source": "acai"
        }
      ],
      "preferred_label": "کوه جلبوع"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Chaîne de montagnes en Israël, au sud-est de la vallée de Jizreel, où Saül et trois de ses fils sont morts (1 Samuel 31.1–6).",
          "source": "acai"
        }
      ],
      "preferred_label": "mont Guilboa"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani jerin duwatsu a Isra'ila, a kudu maso gabashin Filin Yezreyel, inda Shawulu da 'ya'yansa maza uku suka mutu (1 Samuwila 31:1–6).",
          "source": "acai"
        }
      ],
      "preferred_label": "Dutsen Gilbowa"
    },
    "hin": {
      "descriptions": [
        {
          "description": "इस्राएल में यिज्रेल घाटी के दक्षिण-पूर्व में स्थित एक पर्वतमाला, जहाँ शाऊल और उसके तीन पुत्र मारे गए (1 शमूएल 31:1–6)।",
          "source": "acai"
        }
      ],
      "preferred_label": "गिलबो पर्वत"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ugwu dị nʼIzrel, nʼakụkụ ndịda ọwụwa anyanwụ nke Ndagwurugwu Jezril, ebe Sọl na ụmụ ya ndị nwoke atọ nwụrụ (1 Samuel 31:1–6).",
          "source": "acai"
        }
      ],
      "preferred_label": "Ugwu Gilboa"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Pegunungan di Israel, sebelah tenggara Lembah Yizreel, tempat Saul dan tiga putranya tewas (1 Samuel 31:1–6).",
          "source": "acai"
        }
      ],
      "preferred_label": "Pegunungan Gilboa"
    },
    "nep": {
      "descriptions": [
        {
          "description": "इस्राएलमा यिज्रेल उपत्यकाको दक्षिण-पूर्वमा रहेको एउटा पहाडी शृङ्खला, जहाँ शाऊल र उनका तीन छोराहरूको मृत्यु भयो (१ शमूएल ३१:१–६)।",
          "source": "acai"
        }
      ],
      "preferred_label": "गिल्बो पर्वत"
    },
    "por": {
      "descriptions": [
        {
          "description": "Uma cadeia montanhosa em Israel, a sudeste do Vale de Jezreel, onde Saul e três de seus filhos morreram (1 Samuel 31:1–6).",
          "source": "acai"
        }
      ],
      "preferred_label": "Monte Gilboa"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Горный хребет в Израиле, к юго-востоку от Изреельской долины, где погибли Саул и трое его сыновей (1 Цар. 31:1–6).",
          "source": "acai"
        }
      ],
      "preferred_label": "гора Гелвуй"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Cordillera en Israel, al sureste del valle de Jezreel, donde murieron Saúl y tres de sus hijos (1 Samuel 31:1-6).",
          "source": "acai"
        }
      ],
      "preferred_label": "Monte Guilboa"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Safu ya milima huko Israeli, kusinimashariki mwa Bonde la Yezreeli, ambapo Sauli na wanawe watatu walikufa (1 Samweli 31:1–6).",
          "source": "acai"
        }
      ],
      "preferred_label": "Mlima Gilboa"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela lain maunten long Israel, long hap saut-is bilong Walis bilong Jesril, we Sol wantaim tripela pikinini man bilong en i bin i dai (1 Samuel 31:1–6).",
          "source": "acai"
        }
      ],
      "preferred_label": "Maunten Gilboa"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một dãy núi tại Y-sơ-ra-ên, ở phía đông nam Thung lũng Ghi-xê-rê-ên, nơi Sau-lơ và ba con trai của ông đã qua đời (1 Sa-mu-ên 31:1–6).",
          "source": "acai"
        }
      ],
      "preferred_label": "Núi Ghinh-bô-a"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "以色列的一座山脉，位于耶斯列平原东南，扫罗和他三个儿子死于此地（撒母耳记上 31:1–6）。",
          "source": "acai"
        }
      ],
      "preferred_label": "基利波山"
    },
    "zht": {
      "descriptions": [
        {
          "description": "以色列境內、耶斯列谷東南面的一處山脈，掃羅和他的三個兒子曾在那裡陣亡（撒母耳記上 31:1–6）。",
          "source": "acai"
        }
      ],
      "preferred_label": "基利波山"
    }
  },
