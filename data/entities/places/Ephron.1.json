      "descriptions": [
        {
          "description": "مستوطنة على الحدود بين بنيامين ويهوذا؛ ويُحتمل إنو معناها \\\"غرباً\\\".",
          "source": "acai"
        }
      ],
      "preferred_label": "عفرون (يشوع 18:15)"
    },
    "arb": {
      "descriptions": [
        {
          "description": "مُسْتَوْطَنَةٌ عَلَى ٱلْحُدُودِ بَيْنَ بِنْيَامِينَ وَيَهُوذَا؛ رُبَّمَا تَعْنِي «غَرْبًا».",
          "source": "acai"
        }
      ],
      "preferred_label": "عِفْرُون (يشوع 18:15)"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan ples we i stap long boda long medel blong Benjamin mo Juda; maet mining blong nem ya se \\\"i go long wes.\\\"",
          "source": "acai"
        }
      ],
      "preferred_label": "Efron (Josua 18:15)"
    },
    "eng": {
      "descriptions": [
        {
          "article": "place:Ephron.1",
          "description": "A settlement on the border between Benjamin and Judah; possibly meaning \"westward.\"",
