  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "ناس كانو عايشين في بوز. أليهو، واحد من أصحاب أيوب الكانو بتكلمو معاهو، كان من نسل البوزيين.",
          "source": "acai"
        }
      ],
      "preferred_label": "البوزيين"
    },
    "arb": {
      "descriptions": [
        {
          "description": "شعب كان يسكن في بوز. وينحدر أليهو، أحد محاوري أيوب، من بوزي.",
          "source": "acai"
        }
      ],
      "preferred_label": "البوزيون"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Ol man we oli stap laef long Bus. Elihu, we i wan long ol fren blong Job we i tokbaot trabol wetem hem, hem i kamaot biaen long wan man Bus.",
          "source": "acai"
        }
      ],
      "preferred_label": "ol man Bus"
    },
    "eng": {
      "alternate_labels": [
        "Buzite"
      ],
      "descriptions": [
        {
          "article": "group:Buzites",
          "description": "People who lived in Buz. One of Job's conversation partners, Elihu, descended from a Buzite.",
          "gloss": "Buzites",
          "source": "acai"
        }
      ],
      "preferred_label": "Buzites"
    },
    "fas": {
      "descriptions": [
        {
          "description": "مردمی که در بوز زندگی می‌کردند. یکی از هم‌صحبتان ایوب به نام الیهو، از نسل یک بوزی بود.",
          "source": "acai"
        }
      ],
      "preferred_label": "بوزی‌ها"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Personnes qui vivaient à Buz. L’un des interlocuteurs de Job, Élihu, descendait d’un Buzite.",
          "source": "acai"
        }
      ],
      "preferred_label": "Buzites"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Mutanen da suka zauna a Buz. Elihu, ɗaya daga cikin abokan tattaunawar Ayuba, ya fito ne daga zuriyar mutumin Buz.",
          "source": "acai"
        }
      ],
      "preferred_label": "Buzawa"
    },
    "hin": {
      "descriptions": [
        {
          "description": "वे लोग जो बूज में रहते थे। अय्यूब के साथ वार्तालाप करने वालों में से एक, एलीहू, एक बूजी का वंशज था।",
          "source": "acai"
        }
      ],
      "preferred_label": "बूजी"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ndị bi na Buz. Otu nʼime ndị ya na Job kparịtara ụka, bụ Elihu, si nʼagbụrụ onye Buz.",
          "source": "acai"
        }
      ],
      "preferred_label": "ndị Buz"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Orang-orang yang tinggal di Bus. Salah satu rekan bicara Ayub, Elihu, adalah keturunan orang Bus.",
          "source": "acai"
        }
      ],
      "preferred_label": "orang Bus"
    },
    "nep": {
      "descriptions": [
        {
          "description": "बूजमा बस्ने मानिसहरू। अय्यूबका संवाद साथीहरूमध्ये एक, एलीहू, बुजीका सन्तान थिए।",
          "source": "acai"
        }
      ],
      "preferred_label": "बुजीहरू"
    },
    "por": {
      "descriptions": [
        {
          "description": "Pessoas que viviam em Buz. Um dos interlocutores de Jó, Eliú, descendia de um buzita.",
          "source": "acai"
        }
      ],
      "preferred_label": "buzitas"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Жители Вуза. Один из собеседников Иова, Елиуй, происходил из вузитян.",
          "source": "acai"
        }
      ],
      "preferred_label": "Вузитяне"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Personas que vivían en Buz. Eliú, uno de los interlocutores de Job, descendía de un buzita.",
          "source": "acai"
        }
      ],
      "preferred_label": "buzita"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Watu walioishi Buzi. Mmoja wa washirika wa maongezi wa Ayubu, Elihu, alikuwa mzao wa Mbuzi.",
          "source": "acai"
        }
      ],
      "preferred_label": "Wabuzi"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Ol manmeri i bin i stap long Bus. Elihu, wanpela bilong ol man i bin toktok wantaim Jop, em i tumbuna pikinini bilong wanpela man bilong Bus.",
          "source": "acai"
        }
      ],
      "preferred_label": "lain Bus"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Những người sống ở Bu-xơ. Một trong những người bạn đối thoại của Gióp là Ê-li-hu, là hậu duệ của một người Bu-xi.",
          "source": "acai"
        }
      ],
      "preferred_label": "người Bu-xi"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "居住在布斯的人。约伯的对话者之一以利户是布斯人的后代。",
          "source": "acai"
        }
      ],
      "preferred_label": "布西人"
    },
    "zht": {
      "descriptions": [
        {
          "description": "居住在布西的人。約伯的對話者之一以利戶是布西人的後裔。",
          "source": "acai"
        }
      ],
      "preferred_label": "布西人"
    }
  },
