  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "ناس ساكنين في مناحة، وكانوا برضو من نسل يهوذا، ولد يعقوب.",
          "source": "acai"
        }
      ],
      "preferred_label": "المناحتيين"
    },
    "arb": {
      "descriptions": [
        {
          "description": "قوم يسكنون مَنَاحَة، وكانوا أيضاً من نسل يهوذا بن يعقوب.",
          "source": "acai"
        }
      ],
      "preferred_label": "المَنُوحِيّون"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Ol man we oli stap laef long Manahat, we oli ol laen blong Juta tu, pikinini blong Jekob.",
          "source": "acai"
        }
      ],
      "preferred_label": "ol man Manahat"
    },
    "eng": {
      "alternate_labels": [
        "Manahath"
      ],
      "descriptions": [
        {
          "article": "group:Manahath",
          "description": "People who live in Manahath, who were also descended from Judah, son of Jacob.",
          "gloss": "Manahathites",
          "source": "acai"
        }
      ],
      "preferred_label": "Manahathites"
    },
    "fas": {
      "descriptions": [
        {
          "description": "مردمی که در مانَحَت زندگی می‌کنند و همچنین از نوادگان یهودا، پسر یعقوب بودند.",
          "source": "acai"
        }
      ],
      "preferred_label": "مانحتیان"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Personnes qui vivent à Manahath, également descendantes de Juda, fils de Jacob.",
          "source": "acai"
        }
      ],
      "preferred_label": "Manahathites"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Mutanen da ke zaune a Manahat, waɗanda kuma suka fito daga zuriyar Yahuda, ɗan Yakubu.",
          "source": "acai"
        }
      ],
      "preferred_label": "Manahatiyawa"
    },
    "hin": {
      "descriptions": [
        {
          "description": "मानहत में रहने वाले लोग, जो याकूब के पुत्र यहूदा के भी वंशज थे।",
          "source": "acai"
        }
      ],
      "preferred_label": "मानहती"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ndị bi na Manaha, ndị sokwa nʼagbụrụ Juda, nwa Jekọb.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ndị Manaha"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Orang-orang yang tinggal di Manahat, yang juga merupakan keturunan Yehuda, anak Yakub.",
          "source": "acai"
        }
      ],
      "preferred_label": "orang Manahti"
    },
    "nep": {
      "descriptions": [
        {
          "description": "मानहतमा बस्ने मानिसहरू, जो याकूबका छोरा यहूदाका सन्तान पनि थिए।",
          "source": "acai"
        }
      ],
      "preferred_label": "मानहतीहरू"
    },
    "por": {
      "descriptions": [
        {
          "description": "Pessoas que vivem em Manaate, que também eram descendentes de Judá, filho de Jacó.",
          "source": "acai"
        }
      ],
      "preferred_label": "manaatitas"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Жители Манахафа, происходившие от Иуды, сына Иакова.",
          "source": "acai"
        }
      ],
      "preferred_label": "Манахафяне"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Personas que viven en Manajat, quienes también descendían de Judá, hijo de Jacob.",
          "source": "acai"
        }
      ],
      "preferred_label": "manajatita"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Watu wanaoishi Manahathi, ambao pia walikuwa wazao wa Yuda mwana wa Yakobo.",
          "source": "acai"
        }
      ],
      "preferred_label": "Wamanahathi"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Ol manmeri i stap long Manahat, em ol i kam long lain bilong Juda tu, pikinini man bilong Jekop.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ol Manahat"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Những người sống ở Ma-na-hát, cũng thuộc dòng dõi Giu-đa, con trai của Gia-cốp.",
          "source": "acai"
        }
      ],
      "preferred_label": "Người Ma-na-ha-tít"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "居住在玛拿辖的人，也是雅各之子犹大的后裔。",
          "source": "acai"
        }
      ],
      "preferred_label": "玛拿哈人"
    },
    "zht": {
      "descriptions": [
        {
          "description": "居住在瑪拿哈的人，他們也是雅各之子猶大的後裔。",
          "source": "acai"
        }
      ],
      "preferred_label": "瑪拿哈人"
    }
