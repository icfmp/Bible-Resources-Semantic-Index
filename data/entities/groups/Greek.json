  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "الناس العايشين في بلاد اليونان. وفي العهد الجديد، كلمة اليونانيين ممكن تتفهم بمعنى الناس الما يهود.",
          "source": "acai"
        }
      ],
      "preferred_label": "يونانيين"
    },
    "arb": {
      "descriptions": [
        {
          "description": "أشخاص يعيشون في بلاد اليونان. وفي العهد الجديد، يمكن أن يُفهم اليونانيون على أنهم أشخاص غير يهود.",
          "source": "acai"
        }
      ],
      "preferred_label": "اليونانيون"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Ol man we oli stap laef long Gris. Long Niutesteman, tok ya ol man Gris i save minim tu ol man we oli no Jiu.",
          "source": "acai"
        }
      ],
      "preferred_label": "ol man Gris"
    },
    "eng": {
      "alternate_labels": [
        "Javan",
        "Gentile"
      ],
      "descriptions": [
        {
          "article": "group:Greek",
          "description": "People who live in Greece. In the New Testament Greeks can be understood as people who are not Jewish.",
          "gloss": "Greeks",
          "source": "acai"
        }
      ],
      "preferred_label": "Greeks"
    },
    "fas": {
      "descriptions": [
        {
          "description": "مردمی که در یونان زندگی می‌کنند. در عهد جدید، یونانیان می‌توانند به معنای افراد غیریهودی نیز فهمیده شوند.",
          "source": "acai"
        }
      ],
      "preferred_label": "یونانیان"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Personnes qui vivent en Grèce. Dans le Nouveau Testament, les Grecs peuvent être compris comme des personnes non juives.",
          "source": "acai"
        }
      ],
      "preferred_label": "Grecs"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Mutanen da suke zaune a Girka. A cikin Sabon Alkawari ana iya ɗaukar Helenawa a matsayin mutanen da ba Yahudawa ba.",
          "source": "acai"
        }
      ],
      "preferred_label": "Hellenawa"
    },
    "hin": {
      "descriptions": [
        {
          "description": "यूनान (ग्रीस) में रहने वाले लोग। नए नियम में यूनानियों को उन लोगों के रूप में भी समझा जा सकता है जो यहूदी नहीं हैं।",
          "source": "acai"
        }
      ],
      "preferred_label": "यूनानी"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ndị bi na Gris. Nʼime Agba Ọhụrụ, a pụkwara ịghọta ndị Griik dị ka ndị na-abụghị ndị Juu.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ndị Griik"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Orang-orang yang tinggal di Yunani. Dalam Perjanjian Baru, orang Yunani dapat dipahami sebagai orang-orang yang bukan Yahudi.",
          "source": "acai"
        }
      ],
      "preferred_label": "orang Yunani"
    },
    "nep": {
      "descriptions": [
        {
          "description": "ग्रीस देशमा बसोबास गर्ने मानिसहरू। नयाँ नियममा ग्रीकहरूलाई यहूदी नभएका गैर-यहूदी मानिसहरूको रूपमा बुझ्न सकिन्छ।",
          "source": "acai"
        }
      ],
      "preferred_label": "ग्रीकहरू"
    },
    "por": {
      "descriptions": [
        {
          "description": "Pessoas que vivem na Grécia. No Novo Testamento, os gregos podem ser entendidos como pessoas que não são judias.",
          "source": "acai"
        }
      ],
      "preferred_label": "gregos"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Люди, живущие в Греции. В Новом Завете греками также могут называться неевреи (язычники).",
          "source": "acai"
        }
      ],
      "preferred_label": "Греки"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Personas que viven en Grecia. En el Nuevo Testamento, los griegos pueden entenderse como personas no judías.",
          "source": "acai"
        }
      ],
      "preferred_label": "griegos"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Watu wanaoishi Ugiriki. Katika Agano Jipya Wayunani wanaweza kueleweka kama watu wasio Wayahudi.",
          "source": "acai"
        }
      ],
      "preferred_label": "Wayunani"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Ol manmeri i save stap long Gris. Long Nupela Testamen, ol Grik em i ken makim tu ol manmeri i no bilong lain Juda.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ol Grik"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Những người sống ở Hy Lạp. Trong Tân Ước, người Hy Lạp có thể được hiểu là những người không phải gốc Do Thái.",
          "source": "acai"
        }
      ],
      "preferred_label": "Người Hy Lạp"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "住在希腊的人。在新约圣经中，希腊人也可以指非犹太人。",
          "source": "acai"
        }
      ],
      "preferred_label": "希腊人"
    },
    "zht": {
      "descriptions": [
        {
          "description": "居住在希臘的人。在新約聖經中，希臘人也可以指非猶太人。",
          "source": "acai"
        }
      ],
      "preferred_label": "希臘人"
    }
  },
