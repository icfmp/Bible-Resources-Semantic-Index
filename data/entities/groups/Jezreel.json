          "source": "acai"
        }
      ],
      "preferred_label": "耶斯列人（犹大）"
    },
    "zht": {
      "descriptions": [
        {
          "description": "居住在（猶大的）耶斯列的人，該地是大衛王妻子之一亞希暖的故鄉。",
          "source": "acai"
        }
      ],
      "preferred_label": "耶斯列人（猶大）"
    }
