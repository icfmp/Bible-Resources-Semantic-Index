  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "ناس عايشين في يزرعيل (حقت يهوذا)، بلد أخينوعم، واحدة من نسوان الملك داود.",
          "source": "acai"
        }
      ],
      "preferred_label": "يزرعيل (حقت يهوذا)"
    },
    "arb": {
      "descriptions": [
        {
          "description": "أهل يزرعيل (التي في يهوذا)، موطن أخينوعم إحدى زوجات الملك داود.",
          "source": "acai"
        }
      ],
      "preferred_label": "أهل يزرعيل (يهوذا)"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Ol man we oli stap long Jisrehel (blong Juda), asples blong Ahinoam, wan long ol waef blong King Deved.",
          "source": "acai"
        }
      ],
      "preferred_label": "ol man Jisrehel (blong Juda)"
    },
    "eng": {
      "alternate_labels": [
        "Jezreel",
        "Jezreelitess",
        "Jezreelite"
      ],
      "descriptions": [
        {
          "article": "group:Jezreel",
          "description": "People who live in Jezreel (of Judah), the home of Ahinoam, one of King David's wives.",
          "gloss": "Jezreel (of Judah)",
          "source": "acai"
        }
      ],
      "preferred_label": "Jezreel (of Judah)"
    },
    "fas": {
      "descriptions": [
        {
          "description": "مردمی که در یزرعیل (یهودا)، موطن اخینوعم، یکی از همسران داوود پادشاه، زندگی می‌کنند.",
          "source": "acai"
        }
      ],
      "preferred_label": "یزرعیلیان (یهودا)"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Habitants de Jizreel (en Juda), patrie d’Achinoam, l’une des femmes du roi David.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jizreel (de Juda)"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Mutanen da suke zaune a Yezireyel (ta Yahuda), garin Ahinowam, ɗaya daga cikin matan Sarki Dawuda.",
          "source": "acai"
        }
      ],
      "preferred_label": "Yezireyel (ta Yahuda)"
    },
    "hin": {
      "descriptions": [
        {
          "description": "यिज्रेल (यहूदा) में रहनेवाले लोग, जो राजा दाऊद की पत्नियों में से एक, अहीनोअम का गृहनगर था।",
          "source": "acai"
        }
      ],
      "preferred_label": "यिज्रेल (यहूदा का)"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ndị bi na Jezril (nke Juda), bụ́ obodo Ahinoam, otu nʼime ndị nwunye Eze Devid.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jezril (nke Juda)"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Orang-orang yang tinggal di Yizreel (di Yehuda), tempat asal Ahinoam, salah satu istri Raja Daud.",
          "source": "acai"
        }
      ],
      "preferred_label": "orang Yizreel (di Yehuda)"
    },
    "nep": {
      "descriptions": [
        {
          "description": "राजा दाऊदकी एक पत्नी अहीनोअमको घर रहेको यिजरेल (यहूदाको) मा बस्ने मानिसहरू।",
          "source": "acai"
        }
      ],
      "preferred_label": "यिजरेली (यहूदाको)"
    },
    "por": {
      "descriptions": [
        {
          "description": "Pessoas que vivem em Jezreel (de Judá), a terra natal de Ainoã, uma das esposas do rei Davi.",
          "source": "acai"
        }
      ],
      "preferred_label": "jezreelitas (de Judá)"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Жители Изрееля (в Иудее), родины Ахиноамы, одной из жен царя Давида.",
          "source": "acai"
        }
      ],
      "preferred_label": "Изреель (в Иудее)"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Personas que viven en Jezreel (de Judá), la tierra natal de Ahinoam, una de las esposas del rey David.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jezreel (de Judá)"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Watu wanaoishi Yezreeli (ya Yuda), nyumbani kwa Ahinoamu, mmoja wa wake wa Mfalme Daudi.",
          "source": "acai"
        }
      ],
      "preferred_label": "Yezreeli (ya Yuda)"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Ol manmeri i stap long Jesril (bilong Juda), asples bilong Ahinoam, wanpela meri bilong King Devit.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jesril (bilong Juda)"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Những người sống ở Giê-rê-ên (thuộc Giu-đa), quê hương của A-hi-nô-am, một trong các người vợ của Vua Đa-vít.",
          "source": "acai"
        }
      ],
      "preferred_label": "người Giê-rê-ên (thuộc Giu-đa)"
    },
    "zhs": {
      "descriptions": [
