    "apd": {
      "descriptions": [
        {
          "description": "الناس المنحدرين من أخواخ، من نسل بنيامين بن يعقوب.",
          "source": "acai"
        }
      ],
      "preferred_label": "الأخوخيين"
    },
    "arb": {
      "descriptions": [
        {
          "description": "ٱلْمُنْحَدِرُونَ مِنْ أَخُوخَ، مِنْ نَسْلِ بَنْيَامِينَ بْنِ يَعْقُوبَ.",
          "source": "acai"
        }
      ],
      "preferred_label": "ٱلْأَخُوخِيُّونَ"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Ol man we oli kamaot long Ahoho, we hem i wan laen blong Benjamin, pikinini blong Jekob.",
          "source": "acai"
        }
      ],
      "preferred_label": "ol laen blong Ahoho"
    },
    "eng": {
      "alternate_labels": [
        "Ahoah",
        "Ahohite"
      ],
      "descriptions": [
        {
          "article": "group:Ahoah",
          "description": "People descended from Ahoah, a descendant of Benjamin, a son of Jacob.",
          "gloss": "Ahohites",
          "source": "acai"
        }
      ],
      "preferred_label": "Ahohites"
    },
    "fas": {
      "descriptions": [
        {
          "description": "نوادگان اخوح، از نوادگان بنیامین، پسر یعقوب.",
          "source": "acai"
        }
      ],
      "preferred_label": "اخوخی‌ها"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Personnes descendant d’Achoach, descendant de Benjamin, fils de Jacob.",
          "source": "acai"
        }
      ],
      "preferred_label": "Achochites"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Mutanen da suka fito daga zuriyar Aho, wani daga zuriyar Benyamin, ɗan Yaƙub.",
