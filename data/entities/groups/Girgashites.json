          "source": "acai"
        }
      ],
      "preferred_label": "Girgashites"
    },
    "fas": {
      "descriptions": [
        {
          "description": "مردمی از یکی از قوم‌هایی که پیش از فتح کنعان توسط بنی‌اسرائیل، در آن سرزمین سکونت داشتند.",
          "source": "acai"
        }
      ],
      "preferred_label": "جرجاشی‌ها"
    },
    "fra": {
      "descriptions": [
        {
