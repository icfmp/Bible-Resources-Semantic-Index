  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "المجلس القضائي الأعلى لليهودية، وكان مقره في أورشليم.",
          "source": "acai"
        }
      ],
      "preferred_label": "مجمع السَّنْهَدْرِيم"
    },
    "arb": {
      "descriptions": [
        {
          "description": "المجلس القضائي الأعلى لليهودية، ومقره في أورشليم.",
          "source": "acai"
        }
      ],
      "preferred_label": "سنهدريم"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Hae Kaonsel blong ol jif jaj blong rilijin blong ol man Jiu, we i stap long Jerusalem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sanhedrin"
    },
    "eng": {
      "descriptions": [
        {
          "description": "Supreme judicial council of Judaism, located in Jerusalem.",
          "gloss": "Sanhedrin",
          "source": "acai"
        }
      ],
      "preferred_label": "Sanhedrin"
    },
    "fas": {
      "descriptions": [
        {
          "description": "شورای عالی قضایی یهودیت واقع در اورشلیم.",
          "source": "acai"
        }
      ],
      "preferred_label": "سنهدرین"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Conseil judiciaire suprême du judaïsme, siégeant à Jérusalem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sanhédrin"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Majalisar shari'a mafi girma ta addinin Yahudanci, da ke a Urushalima.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sanhedrin"
    },
    "hin": {
      "descriptions": [
        {
          "description": "यरूशलेम में स्थित यहूदी धर्म की सर्वोच्च न्यायिक परिषद।",
          "source": "acai"
        }
      ],
      "preferred_label": "महासभा (सन्हेद्रिन)"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ụlọikpe kachasị elu nke okpukpe ndị Juu, nke dị na Jerusalem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sanhedrin"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Dewan peradilan tertinggi agama Yahudi, yang bertempat di Yerusalem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Mahkamah Agama"
    },
    "nep": {
      "descriptions": [
        {
          "description": "यरूशलेममा रहेको यहूदी धर्मको सर्वोच्च न्यायिक परिषद्।",
          "source": "acai"
        }
      ],
      "preferred_label": "महासभा"
    },
    "por": {
      "descriptions": [
        {
          "description": "Supremo conselho judicial do judaísmo, localizado em Jerusalém.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sinédrio"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Верховный судебный и религиозный совет в иудаизме, заседавший в Иерусалиме.",
          "source": "acai"
        }
      ],
      "preferred_label": "Синедрион"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Consejo judicial supremo del judaísmo, ubicado en Jerusalén.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sanedrín"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Baraza kuu la mahakama ya Kiyahudi, lililokuwa Yerusalemu.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sanhedrini"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Nambawan kaunsil bilong kot bilong ol Juda, i stap long Jerusalem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sanhedrin"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Tòa công luận hay hội đồng xét xử tối cao của Do Thái giáo, đặt tại Giê-ru-sa-lem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Tòa Công Luận"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "犹太教设在耶路撒冷的最高司法公会。",
          "source": "acai"
        }
      ],
      "preferred_label": "公会"
    },
    "zht": {
      "descriptions": [
        {
          "description": "猶太教設於耶路撒冷的最高司法公會。",
          "source": "acai"
        }
      ],
      "preferred_label": "猶太公會"
    }
  },
