      ],
      "preferred_label": "الصِّفُونِيُّونَ"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Ol man we oli kamaot long Sifion, pikinini boe blong Gad, we hem i pikinini boe blong Josef, we hem i pikinini boe blong Jekob.",
          "source": "acai"
        }
      ],
      "preferred_label": "ol laen blong Jefon"
    },
