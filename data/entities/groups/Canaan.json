  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "الشعوب المجتمعة في أرض كنعان قبل وأثناء فتح بني إسرائيل ليها.",
          "source": "acai"
        }
      ],
      "preferred_label": "الكنعانيين"
    },
    "arb": {
      "descriptions": [
        {
          "description": "الشعوب المجتمعة لأرض كنعان قبل الغزو الإسرائيلي وأثناءه.",
          "source": "acai"
        }
      ],
      "preferred_label": "الكنعانيون"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Evri neson we oli joen wanples long graon blong Kenan bifo mo long taem we ol man Isrel oli tekem graon ya.",
          "source": "acai"
        }
      ],
      "preferred_label": "ol laen blong Kenan"
    },
    "eng": {
      "alternate_labels": [
        "Canaan",
        "Canaanites"
      ],
      "descriptions": [
        {
          "article": "group:Canaan",
          "description": "The combined nations of the land of Canaan before and during the Israelite conquest.",
          "gloss": "Canaanites",
          "source": "acai"
        }
      ],
      "preferred_label": "Canaanites"
    },
    "fas": {
      "descriptions": [
        {
          "description": "مجموعهٔ اقوام سرزمین کنعان قبل از تسخیر بنی‌اسرائیل و در جریان آن.",
          "source": "acai"
        }
      ],
      "preferred_label": "کنعانی‌ها"
    },
    "fra": {
      "descriptions": [
        {
          "description": "L’ensemble des nations du pays de Canaan avant et pendant la conquête israélite.",
          "source": "acai"
        }
      ],
      "preferred_label": "Cananéens"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Haɗaɗɗun al’umman ƙasar Kan’ana kafin lokacin cin nasarar Isra’ilawa da kuma a lokacinta.",
          "source": "acai"
        }
      ],
      "preferred_label": "Kan’aniyawa"
    },
    "hin": {
      "descriptions": [
        {
          "description": "इस्राएलियों की विजय से पहले और उस दौरान कनान देश की संयुक्त जातियाँ।",
          "source": "acai"
        }
      ],
      "preferred_label": "कनानी"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Mba niile gbakọtara ọnụ nke ala Kenan tupu ụmụ Izrel emerie ha na nʼoge ha na-emeri ha.",
          "source": "acai"
        }
      ],
      "preferred_label": "ndị Kenan"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Gabungan bangsa-bangsa di tanah Kanaan sebelum dan selama penaklukan oleh bangsa Israel.",
          "source": "acai"
        }
      ],
      "preferred_label": "orang Kanaan"
    },
    "nep": {
      "descriptions": [
        {
          "description": "इस्राएली विजयभन्दा पहिले र विजयको समयमा कनान देशका संयुक्त जातिहरू।",
          "source": "acai"
        }
      ],
      "preferred_label": "कनानीहरू"
    },
    "por": {
      "descriptions": [
        {
          "description": "O conjunto de nações da terra de Canaã antes e durante a conquista israelita.",
          "source": "acai"
        }
      ],
      "preferred_label": "cananeus"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Народы земли Ханаанской до и во время завоевания ее израильтянами.",
          "source": "acai"
        }
      ],
      "preferred_label": "Хананеи"
    },
    "spa": {
      "descriptions": [
        {
          "description": "El conjunto de naciones de la tierra de Canaán antes y durante la conquista israelita.",
          "source": "acai"
        }
      ],
      "preferred_label": "cananeo"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mataifa yaliyoungana ya nchi ya Kanaani kabla na wakati wa kutekwa na Waisraeli.",
          "source": "acai"
        }
      ],
      "preferred_label": "Wakanaani"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Ol lain manmeri bilong graun Kenan paslain na long taim ol Israel i bin pait na kisim graun.",
          "source": "acai"
        }
      ],
      "preferred_label": "ol Kenan"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Các dân tộc hợp lại tại xứ Ca-na-an trước và trong cuộc chinh phục của dân Y-sơ-ra-ên.",
          "source": "acai"
        }
      ],
      "preferred_label": "người Ca-na-an"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "以色列人征服迦南地之前及期间迦南地的各族联合体。",
          "source": "acai"
        }
      ],
      "preferred_label": "迦南人"
    },
    "zht": {
      "descriptions": [
        {
          "description": "在以色列人征服之前及期間，迦南地的諸民族統稱。",
          "source": "acai"
        }
      ],
      "preferred_label": "迦南人"
    }
  },
