        }
      ],
      "preferred_label": "Temanites"
    },
    "fas": {
      "descriptions": [
        {
          "description": "افرادی که در تیمان زندگی می‌کنند، منطقه‌ای از آنِ الیفاز، یکی از مشاوران ایوب.",
          "source": "acai"
        }
      ],
      "preferred_label": "تیمانیان"
    },
    "fra": {
      "descriptions": [
