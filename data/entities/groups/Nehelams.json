  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "شمعيا، نبي كذاب عارض إرميا، كان من نحلام ووُصف بأنه نحلامي.",
          "source": "acai"
        }
      ],
      "preferred_label": "نحلاميين"
    },
    "arb": {
      "descriptions": [
        {
          "description": "شمعيا، وهو نبي كاذب قاوم إرميا، كان من نحلام ووُصف بأنه نحلامي.",
          "source": "acai"
        }
      ],
      "preferred_label": "النحلاميون"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Semaea, we i wan giaman profet we i bin agensem Jeremaea, hem i man Nehelam mo oli singaot hem se man Nehelam.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ol man Nehelam"
    },
    "eng": {
      "alternate_labels": [
        "Nehelam"
      ],
      "descriptions": [
        {
          "article": "group:Nehelams",
          "description": "Shemaiah, a false prophet who opposed Jeremiah, was from Nehelam and described as a Nehelamite.",
          "gloss": "Nehelamites",
          "source": "acai"
        }
      ],
      "preferred_label": "Nehelamites"
    },
    "fas": {
      "descriptions": [
        {
          "description": "شمعیا، نبی کذابی که با ارمیا مخالفت می‌کرد، اهل نحلام بود و نحلامی خوانده می‌شد.",
          "source": "acai"
        }
      ],
      "preferred_label": "نحلامی‌ها"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Schemaeja, un faux prophète qui s'opposait à Jérémie, était originaire de Néchélam et qualifié de Néchélamite.",
          "source": "acai"
        }
      ],
      "preferred_label": "Néchélamites"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Shemahiya, wani annabin ƙarya wanda ya yi hamayya da Irmiya, ya fito ne daga Nehelam kuma an kwatanta shi a matsayin mutumin Nehelam.",
          "source": "acai"
        }
      ],
      "preferred_label": "Mutanen Nehelam"
    },
    "hin": {
      "descriptions": [
        {
          "description": "शमायाह, एक झूठा भविष्यद्वक्ता जिसने यिर्मयाह का विरोध किया था, नेहेलाम का रहनेवाला था और उसे नेहेलामी कहा गया है।",
          "source": "acai"
        }
      ],
      "preferred_label": "नेहेलामी"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Shemaya, onye amụma ụgha nke megidere Jeremaya, bụ onye Nehelam ma kọwaa ya dịka onye Nehelam.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ndị Nehelam"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Semaya, seorang nabi palsu yang menentang Yeremia, berasal dari Nehelam dan digambarkan sebagai orang Nehelam.",
          "source": "acai"
        }
      ],
      "preferred_label": "orang Nehelam"
    },
    "nep": {
      "descriptions": [
        {
          "description": "यर्मियाको विरोध गर्ने झूटा अगमवक्ता शमायाह नेहेलामका थिए र तिनलाई नेहेलामवासी भनी वर्णन गरिएको थियो।",
          "source": "acai"
        }
      ],
      "preferred_label": "नेहेलामवासीहरू"
    },
    "por": {
      "descriptions": [
        {
          "description": "Semaías, um falso profeta que se opôs a Jeremias, era de Neelam e descrito como neelamita.",
          "source": "acai"
        }
      ],
      "preferred_label": "neelamitas"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Шемаия, лжепророк, противостоявший Иеремии, происходил из Нехелама и назывался Нехеламитянином.",
          "source": "acai"
        }
      ],
      "preferred_label": "Нехеламитяне"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Semaías, un falso profeta que se opuso a Jeremías, era de Nejelam y fue descrito como nejelamita.",
          "source": "acai"
        }
      ],
      "preferred_label": "nejelamita"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Shemaya, nabii wa uongo aliyempinga Yeremia, alikuwa mtu wa Nehelamu na alielezwa kuwa Mnehelami.",
          "source": "acai"
        }
      ],
      "preferred_label": "Wanehelami"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Semaia, wanpela giaman profet em i bin birua long Jeremaia, em i bilong ples Nehelam na ol i kolim em olsem man Nehelam.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ol lain Nehelam"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Sê-ma-gia, một kẻ tiên tri giả chống đối Giê-rê-mi, đến từ Nê-hê-lam và được gọi là người Nê-hê-lam.",
          "source": "acai"
        }
      ],
      "preferred_label": "người Nê-hê-lam"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "反对耶利米的假先知示玛雅来自尼希兰，被称为尼希兰人。",
          "source": "acai"
        }
      ],
      "preferred_label": "尼希兰人"
    },
    "zht": {
      "descriptions": [
        {
          "description": "反對耶利米的假先知示瑪雅來自尼希蘭，被稱為尼希蘭人。",
          "source": "acai"
        }
      ],
      "preferred_label": "尼希蘭人"
    }
  },
