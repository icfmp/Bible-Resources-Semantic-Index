          "article": "group:Midian",
          "description": "People who live in Midian, a region associated with Midian, a son of Abraham by Keturah.",
          "gloss": "Midianites",
          "source": "acai"
        }
      ],
      "preferred_label": "Midianites"
    },
    "fas": {
      "descriptions": [
        {
          "description": "مردمی که در مدیان زندگی می‌کنند، منطقه‌ای منسوب به مدیان، پسر ابراهیم از قطوره.",
          "source": "acai"
        }
      ],
      "preferred_label": "مدیانی‌ها"
    },
    "fra": {
      "descriptions": [
