  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "ناس من نسل ماكير، أبو جلعاد وولد منسى، الكان ولد يوسف، ولد يعقوب.",
          "source": "acai"
        }
      ],
      "preferred_label": "الماكيريين"
    },
    "arb": {
      "descriptions": [
        {
          "description": "شعب ينحدر من ماكير أبي جلعاد وابن منسى بن يوسف بن يعقوب.",
          "source": "acai"
        }
      ],
      "preferred_label": "الماكيريون"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Ol man we oli kamaot long laen blong Makiri, papa blong Gilead mo pikinini boe blong Manase, we hem i pikinini boe blong Josef, pikinini boe blong Jekob.",
          "source": "acai"
        }
      ],
      "preferred_label": "ol laen blong Makiri"
    },
    "eng": {
      "alternate_labels": [
        "Machir",
        "Makirite"
      ],
      "descriptions": [
        {
          "article": "group:Machir",
          "description": "People descended from Machir, father of Gilead and son of Manasseh, who was son of Joseph, son of Jacob.",
          "gloss": "Machirites",
          "source": "acai"
        }
      ],
      "preferred_label": "Machirites"
    },
    "fas": {
      "descriptions": [
        {
          "description": "مردمی از نسل ماخیر، پدر جلعاد و پسر منسی، پسر یوسف، پسر یعقوب.",
          "source": "acai"
        }
      ],
      "preferred_label": "ماخیری‌ها"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Personnes descendant de Makir, père de Galaad et fils de Manassé, qui était fils de Joseph, fils de Jacob.",
          "source": "acai"
        }
      ],
      "preferred_label": "Makirites"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Mutanen da suka fito daga zuriyar Makir, mahaifin Gileyad kuma ɗan Manasse, wanda yake ɗan Yusuf, ɗan Yaƙub.",
          "source": "acai"
        }
      ],
      "preferred_label": "Makiriyawa"
    },
    "hin": {
      "descriptions": [
        {
          "description": "माकीर के वंशज लोग, जो गिलाद का पिता और मनश्शे का पुत्र था, जो याकूब के पुत्र यूसुफ का पुत्र था।",
          "source": "acai"
        }
      ],
      "preferred_label": "माकीरी"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ndị sitere na Makia, bụ nna Gilead na nwa Manase, onye bụ nwa Josef, nwa Jekọb.",
          "source": "acai"
        }
      ],
      "preferred_label": "ndị Makia"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Keturunan Makhir, ayah Gilead dan anak Manasye, yang adalah anak Yusuf bin Yakub.",
          "source": "acai"
        }
      ],
      "preferred_label": "orang Makhir"
    },
    "nep": {
      "descriptions": [
        {
          "description": "याकूबका छोरा योसेफ, योसेफका छोरा मनश्शे, र मनश्शेका छोरा तथा गिलादका बुबा माकीरबाट उत्‍पन्‍न भएका मानिसहरू।",
          "source": "acai"
        }
      ],
      "preferred_label": "माकीरीहरू"
    },
    "por": {
      "descriptions": [
        {
          "description": "Pessoas descendentes de Maquir, pai de Gileade e filho de Manassés, que era filho de José, filho de Jacó.",
          "source": "acai"
        }
      ],
      "preferred_label": "maquiritas"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Потомки Махира, отца Галаада и сына Манассии, сына Иосифа, сына Иакова.",
          "source": "acai"
        }
      ],
      "preferred_label": "Потомки Махира"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Personas que descienden de Maquir, padre de Galaad e hijo de Manasés, quien fue hijo de José, hijo de Jacob.",
          "source": "acai"
        }
      ],
      "preferred_label": "maquirita"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Watu waliotokana na Makiri, baba ya Gileadi na mwana wa Manase, aliyekuwa mwana wa Yusufu, mwana wa Yakobo.",
          "source": "acai"
        }
      ],
      "preferred_label": "Wamakiri"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Ol lain manmeri i kamap long Makir, papa bilong Gileat na pikinini man bilong Manase, em pikinini man bilong Josep, em pikinini man bilong Jekop.",
          "source": "acai"
        }
      ],
      "preferred_label": "ol lain Makir"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Những người là hậu duệ của Ma-ki, cha của Ga-la-át và con trai của Ma-na-se, người vốn là con của Giô-sép, con trai Gia-cốp.",
          "source": "acai"
        }
      ],
      "preferred_label": "Dân Ma-ki"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "玛吉的后裔；玛吉是基列的父亲，玛拿西的儿子，玛拿西是雅各之子约瑟的儿子。",
          "source": "acai"
        }
      ],
      "preferred_label": "玛吉族"
    },
    "zht": {
      "descriptions": [
        {
          "description": "雅各的兒子約瑟之子瑪拿西的兒子、基列之父瑪吉的後代。",
          "source": "acai"
        }
      ],
      "preferred_label": "瑪吉族"
    }
  },
