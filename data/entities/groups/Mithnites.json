  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "ناس من بلدة مِثْنى. يوشافاط، واحد من أبطال الملك داود، كان من مِثْنى.",
          "source": "acai"
        }
      ],
      "preferred_label": "المِثنيين"
    },
    "arb": {
      "descriptions": [
        {
          "description": "أهل مدينة مَثْنِي. وكان يوشافاط، أحد أبطال الملك داود، من مَثْنِي.",
          "source": "acai"
        }
      ],
      "preferred_label": "المثنيون"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Ol man we oli blong taon ya Mitan. Josafat, we i wan long ol strong soldia blong King Deved, hem i man Mitan.",
          "source": "acai"
        }
      ],
      "preferred_label": "ol man Mitan"
    },
    "eng": {
      "alternate_labels": [
        "Mithnite"
      ],
      "descriptions": [
        {
          "article": "group:Mithnites",
          "description": "People from the town of Mithna. Joshaphat, one of King David's mighty men, was from Mithna.",
          "gloss": "Mithnites",
          "source": "acai"
        }
      ],
      "preferred_label": "Mithnites"
    },
    "fas": {
      "descriptions": [
        {
          "description": "مردمی از شهر متنه. یوشافاط، یکی از دلاوران داوود پادشاه، اهل متنه بود.",
          "source": "acai"
        }
      ],
      "preferred_label": "متنی‌ها"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Personnes originaires de la ville de Mithna. Josaphat, l'un des vaillants guerriers du roi David, était originaire de Mithna.",
          "source": "acai"
        }
      ],
      "preferred_label": "Mithnites"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Mutanen garin Mitna. Yoshafat, ɗaya daga cikin jaruman Sarki Dawuda, ya fito daga Mitna.",
          "source": "acai"
        }
      ],
      "preferred_label": "Mitnawa"
    },
    "hin": {
      "descriptions": [
        {
          "description": "मिथना नगर के निवासी। राजा दाऊद के शूरवीरों में से एक, योशापात, मिथना से था।",
          "source": "acai"
        }
      ],
      "preferred_label": "मेतेनी"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ndị si nʼobodo Mitna. Joshafat, otu nʼime ndị dike Eze Devid, si na Mitna.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ndị Mitna"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Orang-orang dari kota Mitna. Yosafat, salah seorang pahlawan Raja Daud, berasal dari Mitna.",
          "source": "acai"
        }
      ],
      "preferred_label": "orang Mitni"
    },
    "nep": {
      "descriptions": [
        {
          "description": "मित्‍ना सहरका बासिन्दाहरू। राजा दाऊदका शक्तिशाली योद्धाहरूमध्येका एक योशापात मित्‍नाका थिए।",
          "source": "acai"
        }
      ],
      "preferred_label": "मित्‍नीहरू"
    },
    "por": {
      "descriptions": [
        {
