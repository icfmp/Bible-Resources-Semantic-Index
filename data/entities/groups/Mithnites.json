          "source": "acai"
        }
      ],
      "preferred_label": "mitnitas"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Жители города Мифна. Иосафат, один из храбрых воинов царя Давида, происходил из Мифны.",
          "source": "acai"
        }
      ],
      "preferred_label": "Мифнияне"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Personas de la ciudad de Mitna. Josafat, uno de los valientes del rey David, era de Mitna.",
          "source": "acai"
        }
      ],
      "preferred_label": "mitnita"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Watu kutoka mji wa Mithna. Yoshafati, mmoja wa mashujaa wa Mfalme Daudi, alitoka Mithna.",
          "source": "acai"
        }
      ],
      "preferred_label": "Wamithni"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Ol manmeri bilong taun Mitna. Josafat, wanpela bilong ol strongpela soldia bilong King Devit, em i bilong Mitna.",
          "source": "acai"
        }
      ],
      "preferred_label": "lain Mitna"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Những người đến từ thị trấn Mê-then. Giô-sa-phát, một trong các dũng sĩ của Vua Đa-vít, là người Mê-then.",
          "source": "acai"
        }
      ],
      "preferred_label": "người Mê-then"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "来自弥特尼城的人。大卫王的勇士之一约沙法就是弥特尼人。",
          "source": "acai"
        }
      ],
      "preferred_label": "弥特尼人"
    },
    "zht": {
      "descriptions": [
        {
          "description": "來自彌特尼城的人。大衛王的大能勇士之一約沙法來自彌特尼。",
          "source": "acai"
        }
      ],
      "preferred_label": "彌特尼人"
    }
  },
