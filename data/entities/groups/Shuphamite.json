        }
      ],
      "preferred_label": "الشفوفاميين"
    },
    "arb": {
      "descriptions": [
        {
          "description": "قوم ينحدرون من مفيم (المعروف أيضًا بشفوفام)، من سبط بنيامين.",
          "source": "acai"
        }
      ],
      "preferred_label": "الشفوفاميون"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Ol man we oli kamaot long laen blong Mupim, we oli singaotem hem tu se Sefufam, blong laen blong Benjamin.",
