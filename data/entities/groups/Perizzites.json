      "descriptions": [
        {
          "article": "group:Perizzites",
          "description": "People from one of the nations that inhabited the land of Canaan before the Israelite conquest.",
          "gloss": "Perizzites",
          "source": "acai"
        }
      ],
      "preferred_label": "Perizzites"
    },
    "fas": {
      "descriptions": [
        {
          "description": "مردمی از یکی از قوم‌هایی که پیش از تسخیر اسرائیل در سرزمین کنعان ساکن بودند.",
          "source": "acai"
        }
      ],
      "preferred_label": "فَرِزّیان"
    },
    "fra": {
      "descriptions": [
        {
