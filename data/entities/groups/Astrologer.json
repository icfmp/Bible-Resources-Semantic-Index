  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "المنجمين الكانوا بيخدموا الملك في كلدان، منطقة مرتبطة ببابل.",
          "source": "acai"
        }
      ],
      "preferred_label": "المنجمين"
    },
    "arb": {
      "descriptions": [
        {
          "description": "مُنَجِّمون خَدَمُوا المَلِك في الكلدانيين، وهي مَنطِقة مُرتَبِطة ببابِل.",
          "source": "acai"
        }
      ],
      "preferred_label": "المنجمون"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Ol man blong lukluk long ol sta we oli mekem wok blong king long Kaldea, wan rijen we i joen wetem Babilon.",
          "source": "acai"
        }
      ],
      "preferred_label": "ol man blong lukluk long ol sta"
    },
    "eng": {
      "alternate_labels": [
        "astrologers",
        "Chaldean",
        "Babylonians"
      ],
      "descriptions": [
        {
          "article": "group:Astrologer",
          "description": "Astrologers who served the king in Chaldea, a region associated with Babylon.",
          "gloss": "Astrologers",
          "source": "acai"
        }
      ],
      "preferred_label": "Astrologers"
    },
    "fas": {
      "descriptions": [
        {
          "description": "طالع‌بینانی که به پادشاه در کلدانیه، منطقه‌ای مرتبط با بابل، خدمت می‌کردند.",
          "source": "acai"
        }
      ],
      "preferred_label": "طالع‌بینان"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Astrologues qui servaient le roi en Chaldée, une région associée à Babylone.",
          "source": "acai"
        }
      ],
      "preferred_label": "astrologues"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Masanan taurari da suka yi wa sarki hidima a Kaldiyawa, wani yanki da ke da alaƙa da Babilon.",
          "source": "acai"
        }
      ],
      "preferred_label": "Masanan taurari"
    },
    "hin": {
      "descriptions": [
        {
          "description": "ज्योतिषी जो कसदिया में राजा की सेवा करते थे, जो बाबेल से जुड़ा एक क्षेत्र है।",
          "source": "acai"
        }
      ],
      "preferred_label": "कसदी"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ndị na-enyocha kpakpando ndị jere ozi nʼihu eze na Kaldịa, bụ mpaghara jikọtara ya na Babilọn.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ndị na-enyocha kpakpando"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Para ahli nujum atau Kasdim yang melayani raja di Kasdim, suatu wilayah yang terkait dengan Babel.",
          "source": "acai"
        }
      ],
      "preferred_label": "orang Kasdim"
    },
    "nep": {
      "descriptions": [
        {
          "description": "बेबिलोनसँग सम्बन्धित कल्दिया क्षेत्रमा राजाको सेवा गर्ने ज्योतिषीहरू",
          "source": "acai"
        }
      ],
      "preferred_label": "ज्योतिषीहरू"
    },
    "por": {
      "descriptions": [
        {
          "description": "Astrólogos que serviam o rei na Caldeia, uma região associada à Babilônia.",
          "source": "acai"
        }
      ],
      "preferred_label": "Astrólogos"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Астрологи, служившие царю в Халдее, области, связанной с Вавилоном.",
          "source": "acai"
        }
      ],
      "preferred_label": "Халдеи"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Astrólogos que servían al rey en Caldea, una región asociada con Babilonia.",
          "source": "acai"
        }
      ],
      "preferred_label": "astrólogos"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Wanajimu waliomtumikia mfalme katika Ukaldayo, eneo linalohusishwa na Babeli.",
          "source": "acai"
        }
      ],
      "preferred_label": "Wanajimu"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Ol saveman bilong lukim sta em ol i bin mekim wok bilong king long Kaldea, em wanpela hap i pas wantaim Babilon.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ol saveman bilong lukim sta"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Các nhà chiêm tinh phục vụ vua ở Canh-đê, một vùng đất gắn liền với Ba-by-lôn.",
          "source": "acai"
        }
      ],
      "preferred_label": "các nhà chiêm tinh"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "在迦勒底（与巴比伦相关的地区）服侍君王的占星家。",
          "source": "acai"
        }
      ],
      "preferred_label": "占星家"
    },
    "zht": {
      "descriptions": [
        {
          "description": "在迦勒底服事君王的占星家（術士），迦勒底是與巴比倫相關的地區。",
          "source": "acai"
        }
      ],
      "preferred_label": "迦勒底人"
    }
  },
