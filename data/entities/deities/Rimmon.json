  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "إله للآراميين (السوريين)، كان بيعبده نعمان السرياني اللي شفاه أليشع من البرص.",
          "source": "acai"
        }
      ],
      "preferred_label": "رمون"
    },
    "arb": {
      "descriptions": [
        {
          "description": "إله للآراميين (السوريين)، كان يعبده نعمان الذي شفاه أليشع من البرص.",
          "source": "acai"
        }
      ],
      "preferred_label": "رِمّون"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan god blong ol man Siria, we Naman we Elisa i bin hilim hem long lepra i stap wosipim.",
          "source": "acai"
        }
      ],
      "preferred_label": "Rimon"
    },
    "eng": {
      "descriptions": [
        {
          "article": "deity:Rimmon",
          "description": "A god of the Syrians, worshiped by Naaman whom Elisha healed of leprosy.",
          "gloss": "Rimmon",
          "source": "acai"
        }
      ],
      "preferred_label": "Rimmon"
    },
    "fas": {
      "descriptions": [
        {
          "description": "خدای آرامیان (سوریان) که نعمان، که ایلیشع او را از جذام شفا داد، او را می‌پرستید.",
          "source": "acai"
        }
      ],
      "preferred_label": "رمون"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Dieu des Syriens, adoré par Naaman qu’Élisée guérit de la lèpre.",
          "source": "acai"
        }
      ],
      "preferred_label": "Rimmon"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani allahn mutanen Siriya, wanda Na’aman wanda Elisha ya warkar da shi daga kuturta ya bauta masa.",
          "source": "acai"
        }
      ],
      "preferred_label": "Rimmon"
    },
    "hin": {
      "descriptions": [
        {
          "description": "अरामियों (सीरियाइयों) का एक देवता, जिसकी उपासना नामान करता था जिसे एलीशा ने कोढ़ से चंगा किया था।",
          "source": "acai"
        }
      ],
      "preferred_label": "रिम्मोन"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Chi nke ndị Siria, nke Neeman onye Elisha gwọrọ ekpenta fere.",
          "source": "acai"
        }
      ],
      "preferred_label": "Rimọn"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Dewa orang Aram (Siria), yang disembah oleh Naaman yang disembuhkan Elisa dari kusta.",
          "source": "acai"
        }
      ],
      "preferred_label": "Rimon"
    },
    "nep": {
      "descriptions": [
        {
          "description": "सिरियालीहरूका एक देवता, जसलाई एलीशाद्वारा कुष्ठरोग निको पारिएका नामानले पूजा गर्थे।",
          "source": "acai"
        }
      ],
      "preferred_label": "रिम्मोन"
    },
    "por": {
      "descriptions": [
        {
          "description": "Um deus dos sírios, adorado por Naamã, a quem Eliseu curou da lepra.",
          "source": "acai"
        }
      ],
      "preferred_label": "Rimom"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Бог сирийцев, которому поклонялся Нееман, исцеленный Елисеем от проказы.",
          "source": "acai"
        }
      ],
      "preferred_label": "Риммон"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Dios de los sirios, adorado por Naamán, a quien Eliseo sanó de lepra.",
          "source": "acai"
        }
      ],
      "preferred_label": "Rimón"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mungu wa Washami, aliyeabudiwa na Naamani ambaye Elisha alimponya ukoma.",
          "source": "acai"
        }
      ],
      "preferred_label": "Rimoni"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela god bilong ol Siria, em Naman i bin lotu long en, em man Elisa i bin oraitim sik lepra bilong en.",
          "source": "acai"
        }
      ],
      "preferred_label": "Rimon"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một vị thần của người Sy-ri, được Na-a-man thờ phượng trước khi được Ê-li-sê chữa lành bệnh phong hủi.",
          "source": "acai"
        }
      ],
      "preferred_label": "Rim-môn"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "叙利亚人的一个神明，被以利沙治好大麻风的乃缦曾敬拜它。",
          "source": "acai"
        }
      ],
      "preferred_label": "临门"
    },
    "zht": {
      "descriptions": [
        {
          "description": "敘利亞人的神祇，由被以利沙治好大麻風的乃縵所敬拜。",
          "source": "acai"
        }
      ],
      "preferred_label": "臨門"
    }
  },
