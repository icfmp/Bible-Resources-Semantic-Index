  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "الإله الرئيسي عند اليونانيين. في أعمال الرسل 14: 12، افتكر الناس بالغلط إن برنابا هو زفس.",
          "source": "acai"
        }
      ],
      "preferred_label": "زفس"
    },
    "arb": {
      "descriptions": [
        {
          "description": "كَبِيرُ آلِهَةِ ٱلْيُونَانِ. فِي أَعْمَالِ ٱلرُّسُلِ ١٤: ١٢، ظَنَّ ٱلنَّاسُ خَطَأً أَنَّ بَرْنَابَا هُوَ زَفْسُ.",
          "source": "acai"
        }
      ],
      "preferred_label": "زَفْس"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Nambawan god blong ol man Gris. Long Ol Wok 14:12, oli rongling tingbaot Banabas se hem i Sus.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sus"
    },
    "eng": {
      "alternate_labels": [
        "Jupiter"
      ],
      "descriptions": [
        {
          "article": "deity:Zeus",
          "description": "The primary god of the Greeks. In Acts 14:12, Barnabas is mistakenly identified as Zeus.",
          "gloss": "Zeus",
          "source": "acai"
        }
      ],
      "preferred_label": "Zeus"
    },
    "fas": {
      "descriptions": [
        {
          "description": "خدای ارشد یونانیان. در اعمال رسولان ۱۴:۱۲، برنابا به اشتباه زئوس پنداشته می‌شود.",
          "source": "acai"
        }
      ],
      "preferred_label": "زئوس"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Le dieu principal des Grecs. Dans Actes 14.12, Barnabas est pris pour Zeus.",
          "source": "acai"
        }
      ],
      "preferred_label": "Zeus"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Babban allan Helenawa. A Ayyukan Manzanni 14:12, an yi kuskuren ɗaukar Barnabas a matsayin Zeyus.",
