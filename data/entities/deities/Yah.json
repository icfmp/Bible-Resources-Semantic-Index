  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "صيغة مختصرة لاسم يهوه بتظهر في النصوص الشعرية.",
          "source": "acai"
        }
      ],
      "preferred_label": "ياه (الرب)"
    },
    "arb": {
      "descriptions": [
        {
          "description": "صِيغَةٌ مُخْتَصَرَةٌ لِاسْمِ «يَهْوَه» تَرِدُ فِي ٱلنُّصُوصِ ٱلشِّعْرِيَّةِ.",
          "source": "acai"
        }
      ],
      "preferred_label": "يَاه (ٱلرَّبّ)"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan sot nem blong Yahweh we i stap long ol buk blong powetri.",
          "source": "acai"
        }
      ],
      "preferred_label": "Yah (Hae God)"
    },
    "eng": {
      "alternate_labels": [
        "LORD"
      ],
      "descriptions": [
        {
          "article": "deity:Yah",
          "description": "A shortened form of Yahweh that is found in poetic texts.",
          "gloss": "LORD",
          "source": "acai"
        }
      ],
      "preferred_label": "Yah (Lord)"
    },
    "fas": {
      "descriptions": [
        {
          "description": "صورت کوتاه‌شده‌ای از یهوه که در متون شعری یافت می‌شود.",
          "source": "acai"
        }
      ],
      "preferred_label": "یاه (خداوند)"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Forme abrégée de Yahvé que l'on trouve dans les textes poétiques.",
          "source": "acai"
        }
      ],
      "preferred_label": "Yah (Éternel)"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Gajeriyar sigar Yahweh da ake samu a cikin rubuce-rubucen waƙa.",
          "source": "acai"
        }
      ],
      "preferred_label": "Yah (Ubangiji)"
    },
    "hin": {
      "descriptions": [
        {
          "description": "काव्य ग्रंथों में पाया जाने वाला याहवेह का एक संक्षिप्त रूप।",
          "source": "acai"
        }
      ],
      "preferred_label": "याह (यहोवा)"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ụdị dị mkpirikpi nke aha Yahweh nke a na-ahụkarị nʼabụ uri.",
          "source": "acai"
        }
      ],
      "preferred_label": "Yah (Onyenwe anyị)"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Bentuk singkat dari Yahweh yang ditemukan dalam teks-teks puisi.",
          "source": "acai"
        }
      ],
      "preferred_label": "Yah (Tuhan)"
    },
    "nep": {
      "descriptions": [
        {
          "description": "काव्यात्मक पदहरूमा पाइने याहवेको संक्षिप्त रूप।",
