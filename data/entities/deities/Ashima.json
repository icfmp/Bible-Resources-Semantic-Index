        }
      ],
      "preferred_label": "Aschima"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Allahn da mutanen Hamat waɗanda sarkin Assuriya ya ƙaura da su zuwa Samariya suka bauta masa.",
