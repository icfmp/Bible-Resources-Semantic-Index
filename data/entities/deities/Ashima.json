      "preferred_label": "Asima"
    },
    "nep": {
      "descriptions": [
        {
          "description": "अश्शूरका राजाद्वारा सामरियामा बसाइँ सारिएका हमातका मानिसहरूले पूजा गर्ने एक देवता।",
