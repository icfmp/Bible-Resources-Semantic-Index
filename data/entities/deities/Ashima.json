    "fas": {
      "descriptions": [
        {
          "description": "خدایی که توسط مردم حمات که به دست پادشاه آشور به سامره منتقل شده بودند، پرستش می‌شد.",
          "source": "acai"
        }
      ],
      "preferred_label": "اشیما"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Divinité vénérée par le peuple de Hamath qui avait été déporté en Samarie par le roi d’Assyrie.",
