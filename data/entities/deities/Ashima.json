        }
      ],
      "preferred_label": "Ashima"
    },
    "hin": {
      "descriptions": [
        {
          "description": "हमात के लोगों द्वारा पूजा जाने वाला एक देवता, जिन्हें अश्शूर के राजा द्वारा सामरिया में बसाया गया था।",
          "source": "acai"
        }
      ],
      "preferred_label": "अशीमा"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Chi ndị si Hamat fere, bụ ndị eze Asirịa kpọfere na Sameria.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ashima"
    },
    "ind": {
      "descriptions": [
        {
