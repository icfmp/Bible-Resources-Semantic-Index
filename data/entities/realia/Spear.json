  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "عود خشب طويل عندو سنّة حادة من حديد أو معدن، بيستعملوهو للطعن.",
          "source": "acai"
        }
      ],
      "preferred_label": "حربة"
    },
    "arb": {
      "descriptions": [
        {
          "description": "قضيب خشبي طويل ذو رأس حاد من الحديد أو المعدن، يُستخدَم للطعن والاختراق.",
          "source": "acai"
        }
      ],
      "preferred_label": "رُمْح"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan longfala wud we i gat wan sap aean no narafala kopa/metel long poen blong hem, we oli yusum blong stikim man no animol.",
          "source": "acai"
        }
      ],
      "preferred_label": "spia"
    },
    "eng": {
      "alternate_labels": [
        "Spearhead",
        "Short Spear"
      ],
      "descriptions": [
        {
          "article": "realia:Spear",
          "description": "A long wooden rod with a sharp iron or metal point, used for piercing by thrusting.",
          "gloss": "Spear",
          "source": "acai"
        }
      ],
      "preferred_label": "Spear"
    },
    "fas": {
      "descriptions": [
        {
          "description": "میله‌ای چوبی و بلند با نوک تیز آهنی یا فلزی که برای فرو کردن و ضربه زدن به کار می‌رفت.",
          "source": "acai"
        }
      ],
      "preferred_label": "نیزه"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Longue hampe de bois munie d'une pointe acérée en fer ou en métal, utilisée pour percer d'estoc.",
          "source": "acai"
        }
      ],
      "preferred_label": "lance"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Doguwar sandar itace mai tsini da aka yi da ƙarfe, da ake amfani da ita wajen sōka ko jifa.",
          "source": "acai"
        }
      ],
      "preferred_label": "Māshi"
    },
    "hin": {
      "descriptions": [
        {
          "description": "एक लंबी लकड़ी की छड़ जिसके सिरे पर लोहे या धातु की नुकीली नोक होती है, जिसका उपयोग भोंकने या छेदने के लिए किया जाता है।",
          "source": "acai"
        }
      ],
      "preferred_label": "भाला"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ogologo osisi nwere ọnụ ígwè dị nkọ nʼisi ya, nke a na-eji amụ maọbụ adụ mmadụ maọbụ anụmanụ.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ùbe"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Batang kayu panjang dengan mata runcing dari besi atau logam, digunakan untuk menusuk dengan cara menikamkannya.",
          "source": "acai"
        }
      ],
      "preferred_label": "tombak"
    },
    "nep": {
      "descriptions": [
        {
          "description": "काठको लामो डन्डा भएको र टुप्पोमा फलाम वा धातुको तिखो भाग जोडिएको हतियार, जुन घोपेर छेड्न प्रयोग गरिन्छ।",
          "source": "acai"
        }
      ],
      "preferred_label": "भाला"
    },
    "por": {
      "descriptions": [
        {
          "description": "Uma vara longa de madeira com uma ponta afiada de ferro ou outro metal, usada para perfurar por meio de estocada.",
          "source": "acai"
        }
      ],
      "preferred_label": "lança"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Длинное деревянное древко с острым железным или металлическим наконечником, используемое для нанесения колющих ударов.",
          "source": "acai"
        }
      ],
      "preferred_label": "Копье"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Vara larga de madera con una punta afilada de hierro o metal, utilizada para traspasar o clavar arrojándola o empujándola.",
          "source": "acai"
        }
      ],
      "preferred_label": "lanza"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Kipande kirefu cha mti chenye ncha kali ya chuma au metali, kinachotumiwa kuchoma kwa kusukuma.",
          "source": "acai"
        }
      ],
      "preferred_label": "Mkuki"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela longpela stik diwai i gat sap ain o ain aian long het bilong en, ol i save sutim o sutim i go insait bilong sutim man o abus.",
          "source": "acai"
        }
      ],
      "preferred_label": "spia"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Cây gậy dài bằng gỗ có đầu nhọn bằng sắt hoặc kim loại, dùng để đâm.",
          "source": "acai"
        }
      ],
      "preferred_label": "Giáo"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "带有锋利的铁制或金属尖头的长木杆，用于刺击。",
          "source": "acai"
        }
      ],
      "preferred_label": "矛"
    },
    "zht": {
      "descriptions": [
        {
          "description": "一種長木桿，頂端帶有鋒利的鐵或金屬尖頭，用於刺擊。",
          "source": "acai"
        }
      ],
      "preferred_label": "槍"
    }
  },
