  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "في الكتاب المقدس، قطعة مسطحة من معدن مصقول زي النحاس أو البرونز، بتستعمل لعكس الصورة.",
          "source": "acai"
        }
      ],
      "preferred_label": "مراية"
    },
    "arb": {
      "descriptions": [
        {
          "description": "في الكتاب المقدس، قطعة مسطحة من معدن مصقول، كالنحاس، تُستخدم لعكس الصورة.",
          "source": "acai"
        }
      ],
      "preferred_label": "مِرآة"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Long Baebol, hem i wan flat pis kopa no bras we oli polisemgud, we oli yusum blong lukluk fes blong olgeta long hem.",
          "source": "acai"
        }
      ],
      "preferred_label": "lukingglas"
    },
    "eng": {
      "descriptions": [
        {
          "article": "realia:Mirror",
          "description": "In the Bible, a flat piece of polished metal, like copper or bronze, used to reflect an image.",
          "gloss": "Mirror",
          "source": "acai"
        }
      ],
      "preferred_label": "Mirror"
    },
    "fas": {
      "descriptions": [
        {
          "description": "در کتاب‌مقدس، تکه‌ای مسطح از فلز صیقل‌داده‌شده مانند مس یا برنز که برای انعکاس تصویر به کار می‌رفت.",
          "source": "acai"
        }
      ],
      "preferred_label": "آینه"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Dans la Bible, pièce plate de métal poli, comme le cuivre ou le bronze, utilisée pour refléter une image.",
          "source": "acai"
        }
      ],
      "preferred_label": "miroir"
    },
    "hau": {
      "descriptions": [
        {
          "description": "A cikin Littafi Mai Tsarki, fafeffen ƙarfe ne mai sheƙi, kamar jan ƙarfe ko tagulla, da ake amfani da shi don duba sura.",
          "source": "acai"
        }
      ],
      "preferred_label": "Madubi"
    },
    "hin": {
      "descriptions": [
        {
          "description": "बाइबिल में, छवि को प्रतिबिंबित करने के लिए उपयोग किया जाने वाला पॉलिश की हुई धातु (जैसे तांबा या पीतल) का एक समतल टुकड़ा।",
          "source": "acai"
        }
      ],
      "preferred_label": "दर्पण"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Nʼime Baịbụl, otu mbadamba ígwè e gbuworo maramara, dị ka ọla kọpa maọbụ bronz, nke e ji ele inyogho onyinyo onwe onye.",
          "source": "acai"
        }
      ],
      "preferred_label": "Enyo"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Dalam Alkitab, sepotong logam rata yang digosok berkilap, seperti tembaga atau perunggu, yang digunakan untuk memantulkan bayangan.",
          "source": "acai"
        }
      ],
      "preferred_label": "cermin"
    },
    "nep": {
      "descriptions": [
        {
          "description": "बाइबलमा, आकृति देखाउन प्रयोग गरिने तामा वा काँसजस्ता धातुलाई चिल्लो पारेर बनाइएको एक चेप्टो टुक्रा।",
          "source": "acai"
        }
      ],
      "preferred_label": "ऐना"
    },
    "por": {
      "descriptions": [
        {
          "description": "Na Bíblia, uma peça plana de metal polido, como cobre ou bronze, usada para refletir uma imagem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Espelho"
    },
    "rus": {
      "descriptions": [
        {
          "description": "В Библии — плоский кусок полированного металла, например меди или бронзы, использовавшийся для отражения изображения.",
          "source": "acai"
        }
      ],
      "preferred_label": "Зеркало"
    },
    "spa": {
      "descriptions": [
        {
          "description": "En la Biblia, pieza plana de metal pulido, como cobre o bronce, utilizada para reflejar una imagen.",
          "source": "acai"
        }
      ],
      "preferred_label": "espejo"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Katika Biblia, kipande bapa cha chuma kilichong'arishwa, kama vile shaba au shaba nyeupe, kilichotumiwa kuakisi sura.",
          "source": "acai"
        }
      ],
      "preferred_label": "Kioo"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Long Baibel, em wanpela bapa kopa o bras ol i polisim na em i klier bilong lukim pes long en.",
          "source": "acai"
        }
      ],
      "preferred_label": "Glas bilong lukim pes"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Trong Kinh Thánh, một tấm kim loại dát phẳng được đánh bóng, như đồng đỏ hoặc đồng thiếc, dùng để soi bóng.",
          "source": "acai"
        }
      ],
      "preferred_label": "Gương soi"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "在圣经中，指一块用于映照影像的打磨光滑的金属平片，如红铜或青铜。",
          "source": "acai"
        }
      ],
      "preferred_label": "镜子"
    },
    "zht": {
      "descriptions": [
        {
          "description": "在聖經中，指一面打磨光滑的扁平金屬片（如銅或青銅），用於映照影像。",
          "source": "acai"
        }
      ],
      "preferred_label": "鏡子"
    }
  },
