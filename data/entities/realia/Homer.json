      ],
      "preferred_label": "贺梅珥"
    },
    "zht": {
      "descriptions": [
        {
          "description": "聖經中的一種乾量計量單位，約等於220公升或6蒲式耳。",
          "source": "acai"
        }
      ],
      "preferred_label": "賀梅珥"
