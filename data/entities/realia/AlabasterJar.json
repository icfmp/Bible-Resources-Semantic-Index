  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "قارورة مصنوعة من حجر المرمر (الألباستر)، كانت بتستعمل في العادة لحفظ المراهم والعطور.",
          "source": "acai"
        }
      ],
      "preferred_label": "قارورة مرمر"
    },
    "arb": {
      "descriptions": [
        {
          "description": "قارُورَةٌ مَصنوعَةٌ مِن حَجَرِ الرُّخامِ الأَبيَضِ (الأَلَبَسْترِ)، كَانَت تُستَخدَمُ غالِبًا لِحِفظِ الطِّيبِ والعُطورِ.",
          "source": "acai"
        }
      ],
      "preferred_label": "قارُورَةُ أَلَبَسْتَر"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan botel we oli wokem long ston ya alabasta, we plante taem oli stap yusum blong putum pomad mo senta.",
          "source": "acai"
        }
      ],
      "preferred_label": "Botel alabasta"
    },
    "eng": {
      "descriptions": [
        {
          "article": "realia:AlabasterJar",
          "description": "A jar made of alabaster stone, often used for storing ointments and perfumes.",
          "gloss": "Alabaster Jar",
          "source": "acai"
        }
      ],
      "preferred_label": "Alabaster Jar"
    },
    "fas": {
      "descriptions": [
        {
          "description": "ظرف یا شیشه‌ای ساخته‌شده از سنگ مرمر سفید (آلاباستر) که اغلب برای نگهداری پمادها و عطریات استفاده می‌شد.",
          "source": "acai"
        }
      ],
      "preferred_label": "شیشه مرمرین عطر"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Récipient fait d'albâtre, souvent utilisé pour conserver des onguents et des parfums.",
          "source": "acai"
        }
      ],
      "preferred_label": "vase d'albâtre"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani tulu da aka yi da dutsen alabasta, wanda galibi ake amfani da shi wajen ajiye man shafawa da turare.",
          "source": "acai"
        }
      ],
      "preferred_label": "Tulun alabasta"
    },
    "hin": {
      "descriptions": [
        {
          "description": "संगमरमर (अलाबस्तर) के पत्थर से बना एक पात्र, जिसका उपयोग अक्सर इत्र और सुगंधित तेल रखने के लिए किया जाता था।",
          "source": "acai"
        }
      ],
      "preferred_label": "संगमरमर का पात्र"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Karama e ji nkume alabasta mee, nke a na-ejikarị echekwa mmanụ otite na mmanụ na-esi ísì ụtọ.",
          "source": "acai"
        }
      ],
      "preferred_label": "Karama alabasta"
    },
    "ind": {
      "descriptions": [
