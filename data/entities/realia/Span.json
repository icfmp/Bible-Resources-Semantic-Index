  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "المسافة بين طرف الإبهام وطرف الخنصر لما اليد تكون ممدودة، حوالي نص ذراع.",
          "source": "acai"
        }
      ],
      "preferred_label": "شبر"
    },
    "arb": {
      "descriptions": [
        {
          "description": "المسافة بين طرف الإبهام وطرف الخنصر في اليد المبسوطة، وتساوي نحو نصف ذراع.",
          "source": "acai"
        }
      ],
      "preferred_label": "شبر"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Distans bitwin poen blong nambawan fingga (tam) mo smolfingga taem wan man i stretem han blong hem, we i olsem haf kiubik.",
          "source": "acai"
        }
      ],
      "preferred_label": "han"
    },
    "eng": {
      "descriptions": [
        {
          "article": "realia:Span",
          "description": "The distance between the tip of the thumb and the tip of the little finger of an outstretched hand, about half a cubit.",
          "gloss": "Span",
          "source": "acai"
        }
      ],
      "preferred_label": "Span"
    },
    "fas": {
      "descriptions": [
        {
          "description": "فاصله میان نوک انگشت شست و نوک انگشت کوچک در دستی کاملاً باز، حدود نیم ذراع.",
          "source": "acai"
        }
      ],
      "preferred_label": "وجب"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Distance entre l'extrémité du pouce et celle du petit doigt d'une main tendue, soit environ une demi-coudée.",
          "source": "acai"
        }
      ],
      "preferred_label": "empan"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Tazarar da ke tsakanin ƙarshen babban yatsa da ƙarshen ƙaramin yatsa na hannun da aka buɗe, kusan rabin kamu.",
          "source": "acai"
        }
      ],
      "preferred_label": "Kamu"
    },
    "hin": {
      "descriptions": [
        {
          "description": "फैले हुए हाथ के अँगूठे की नोक से लेकर कनिष्ठिका (छोटी उँगली) की नोक तक की दूरी, जो लगभग आधे हाथ के बराबर होती है।",
          "source": "acai"
        }
      ],
      "preferred_label": "बित्ता"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Anya dị n'etiti ọnụ mkpịsị aka ukwu na ọnụ mkpịsị aka nta mgbe agbatịrị aka, nke dị ihe dị ka ọkara kubit.",
          "source": "acai"
        }
      ],
      "preferred_label": "ntụ-aka"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Jarak antara ujung ibu jari dan ujung kelingking dari tangan yang direntangkan, kira-kira setengah hasta.",
          "source": "acai"
        }
      ],
      "preferred_label": "jengkal"
    },
    "nep": {
      "descriptions": [
        {
          "description": "हात पसार्दा बूढीऔँलाको टुप्पोदेखि कान्छीऔँलाको टुप्पोसम्मको दूरी, जुन लगभग आधा हात बराबर हुन्छ।",
          "source": "acai"
        }
      ],
      "preferred_label": "बित्ता"
    },
    "por": {
      "descriptions": [
        {
          "description": "A distância entre a ponta do polegar e a ponta do dedo mínimo de uma mão estendida, cerca de meio côvado.",
          "source": "acai"
        }
      ],
      "preferred_label": "palmo"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Расстояние между кончиком большого пальца и кончиком мизинца вытянутой руки, примерно пол-локтя.",
          "source": "acai"
        }
      ],
      "preferred_label": "пядь"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Distancia entre la punta del pulgar y la punta del meñique con la mano extendida, aproximadamente medio codo.",
          "source": "acai"
        }
      ],
      "preferred_label": "palmo"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Umbali kati ya ncha ya kidole gumba na ncha ya kidole kidogo cha mkono ulionyooshwa, karibu nusu ya dhiraa.",
          "source": "acai"
        }
      ],
      "preferred_label": "shibiri"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Mak bilong skelim longpela, kirap long het bilong bikpela pinga i go inap long liklik pinga bilong han i op olgeta, klostu inap hap kiubit.",
          "source": "acai"
        }
      ],
      "preferred_label": "mak bilong han i op"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Khoảng cách từ đầu ngón tay cái đến đầu ngón tay út của bàn tay khi xòe ra, khoảng nửa thước (cù-bít).",
          "source": "acai"
        }
      ],
      "preferred_label": "Gang tay"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "张开手掌时拇指尖到小指尖的距离，约为半肘长。",
          "source": "acai"
        }
      ],
      "preferred_label": "虎口"
    },
    "zht": {
      "descriptions": [
        {
          "description": "手張開時大拇指尖到小指尖之間的距離，約為半肘。",
          "source": "acai"
        }
      ],
      "preferred_label": "虎口"
    }
