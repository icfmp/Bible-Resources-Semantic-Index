        }
      ],
      "preferred_label": "Ụgbọ mmiri"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Kendaraan yang digunakan untuk bepergian di atas air, seperti bangunan besar menyerupai kotak (Bahtera) yang dibangun oleh Nuh.",
