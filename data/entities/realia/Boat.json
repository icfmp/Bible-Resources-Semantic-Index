          "description": "مركبة تُستخدم للتنقل فوق الماء، كالبناء الضخم الشبيه بالصندوق (الفُلك) الذي بناه نوح.",
          "source": "acai"
        }
      ],
      "preferred_label": "فُلْك"
    },
    "bis": {
      "descriptions": [
