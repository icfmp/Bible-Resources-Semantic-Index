      "descriptions": [
        {
          "article": "realia:Boat",
          "description": "A vessel used for traveling on water, like the large box-like structure (Ark) built by Noah.",
          "gloss": "Boat",
          "source": "acai"
        }
      ],
      "preferred_label": "Boat"
    },
    "fas": {
      "descriptions": [
        {
          "description": "شناوری که برای سفر روی آب به کار می‌رود، مانند سازهٔ بزرگ جعبه‌مانندی (کشتی) که نوح ساخت.",
          "source": "acai"
        }
      ],
      "preferred_label": "کشتی"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Embarcation utilisée pour se déplacer sur l'eau, comme la grande structure semblable à un coffre (l'Arche) construite par Noé.",
          "source": "acai"
        }
      ],
      "preferred_label": "bateau"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Jirgin da ake tafiya a kan ruwa da shi, kamar babban jirgi mai siffar akwati (Jirgin Safina) wanda Nuhu ya gina.",
          "source": "acai"
        }
      ],
      "preferred_label": "jirgin ruwa"
    },
    "hin": {
      "descriptions": [
        {
          "description": "पानी पर यात्रा करने के लिए इस्तेमाल किया जाने वाला एक बड़ा जलयान, जैसे नूह द्वारा निर्मित बक्से जैसी बड़ी संरचना (जहाज)।",
          "source": "acai"
        }
      ],
      "preferred_label": "जहाज"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ihe a na-eji eme njem nʼelu mmiri, dị ka nnukwu igbe (ụgbọ) Noa rụrụ.",
