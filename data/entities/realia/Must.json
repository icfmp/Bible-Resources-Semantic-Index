  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "عصير عنب معصور جديد، وأحياناً بيبدأ يتخمر، وبيتشرب.",
          "source": "acai"
        }
      ],
      "preferred_label": "خمرة جديدة"
    },
    "arb": {
      "descriptions": [
        {
          "description": "عصير عنب طازج معصور، يبدأ أحيانًا في التخمّر، يُستخدم كشراب.",
          "source": "acai"
        }
      ],
      "preferred_label": "مسطار"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Jus blong greps we oli jes skwisim aot, we samtaem i stat blong kam strong, we oli dring olsem wan dring.",
          "source": "acai"
        }
      ],
      "preferred_label": "niu waen"
    },
    "eng": {
      "alternate_labels": [
        "Fresh Wine",
        "Wine",
        "New Wine",
        "Grape Juice"
      ],
      "descriptions": [
        {
          "article": "realia:Must",
          "description": "Freshly pressed grape juice, sometimes starting to ferment, used as a drink.",
          "gloss": "Must",
          "source": "acai"
        }
      ],
      "preferred_label": "Must"
    },
    "fas": {
      "descriptions": [
        {
          "description": "آب انگور تازه‌فشرده‌شده، که گاهی شروع به تخمیر می‌کرد و به عنوان نوشیدنی استفاده می‌شد.",
          "source": "acai"
        }
      ],
      "preferred_label": "شیره انگور (شراب تازه)"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Jus de raisin fraîchement pressé, commençant parfois à fermenter, consommé comme boisson.",
          "source": "acai"
        }
      ],
      "preferred_label": "moût"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Sabuwar matsattsiyar ruwan ’ya’yan inabi, wadda wani lokaci takan fara dāsuwa, da ake sha a matsayin abin sha.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sabon ruwan inabi"
    },
    "hin": {
      "descriptions": [
        {
          "description": "अंगूरों का ताजा निचोड़ा हुआ रस, जिसमें कभी-कभी खमीर उठना शुरू हो जाता है, और जिसे पेय के रूप में उपयोग किया जाता है।",
          "source": "acai"
        }
      ],
      "preferred_label": "नया दाखमधु"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Mkpụrụ vaịn a gbakasịrị ọhụrụ, nke na-amalite ịgba ụka mgbe ụfọdụ, a na-aṅụ ya dị ka ihe ọṅụṅụ.",
          "source": "acai"
        }
      ],
      "preferred_label": "Mmanya ọhụrụ"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Air perasan buah anggur yang segar, yang terkadang mulai berfermentasi, digunakan sebagai minuman.",
          "source": "acai"
        }
      ],
      "preferred_label": "anggur baru"
    },
    "nep": {
      "descriptions": [
        {
          "description": "भर्खरै निचोरेको अङ्गुरको रस, कहिलेकाहीँ अमिलिन थाल्ने, पेय पदार्थको रूपमा प्रयोग गरिन्थ्यो।",
          "source": "acai"
        }
      ],
      "preferred_label": "नयाँ दाखमद्य"
    },
    "por": {
      "descriptions": [
        {
          "description": "Suco de uva recém-espremido, às vezes começando a fermentar, usado como bebida.",
          "source": "acai"
        }
      ],
      "preferred_label": "Mosto"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Свежевыжатый виноградный сок, иногда начинающий бродить, использовавшийся в качестве напитка.",
          "source": "acai"
        }
      ],
      "preferred_label": "Молодое вино"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Jugo de uva recién exprimido, a veces en inicio de fermentación, utilizado como bebida.",
          "source": "acai"
        }
      ],
      "preferred_label": "mosto"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Maji safi ya zabibu yaliyokamuliwa hivi karibuni, wakati mwingine yakianza kuchacha, yakitumiwa kama kinywaji.",
          "source": "acai"
        }
      ],
      "preferred_label": "Divai mpya"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wara bilong grep ol i frestaim traim na mekim dring, sampela taim em i kirap tan i go long kamap wain.",
          "source": "acai"
        }
      ],
      "preferred_label": "Nupela wain"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Nước nho mới ép, đôi khi bắt đầu lên men, dùng làm đồ uống.",
          "source": "acai"
        }
      ],
      "preferred_label": "Rượu mới"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "刚榨出的葡萄汁，有时已开始发酵，用作饮料。",
          "source": "acai"
        }
      ],
      "preferred_label": "新酒"
    },
    "zht": {
      "descriptions": [
        {
          "description": "鮮榨的葡萄汁，有時剛開始發酵，用作飲料。",
          "source": "acai"
        }
      ],
      "preferred_label": "新酒"
    }
  },
