  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "آلة موسيقية نفخية معمولة من قصبة أو أنبوبة فيها فتحات، بتتعزف بالنفخ عبر فتحة وسد الفتحات لتغيير النغمات.",
          "source": "acai"
        }
      ],
      "preferred_label": "مزمار"
    },
    "arb": {
      "descriptions": [
        {
          "description": "آلة نفخ موسيقية تتكون من أنبوب ذي ثقوب، تُعزف بالنفخ عبر فتحة وسد الثقوب لتغيير النغمات.",
          "source": "acai"
        }
      ],
      "preferred_label": "ناي"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan instramen blong miusik we oli wokem long wan paep o bambu we i gat ol hol, we oli plei long hem taem oli blu i go long open ples blong hem mo oli kavremap ol hol blong jenisim saon blong hem.",
          "source": "acai"
        }
      ],
      "preferred_label": "bambu paep"
    },
    "eng": {
      "alternate_labels": [
        "Pipe",
        "Flutes",
        "Play a Flute",
        "Flutist"
      ],
      "descriptions": [
        {
          "article": "realia:Flute",
          "description": "A musical wind instrument made of a tube with holes, played by blowing across an opening and covering the holes to change the notes.",
          "gloss": "Flute",
          "source": "acai"
        }
      ],
      "preferred_label": "Flute"
    },
    "fas": {
      "descriptions": [
        {
          "description": "یک ساز بادی موسیقی ساخته‌شده از لوله‌ای با سوراخ‌ها، که با دمیدن بر دهانه و پوشاندن سوراخ‌ها برای تغییر نت‌ها نواخته می‌شود.",
          "source": "acai"
        }
      ],
      "preferred_label": "نی"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Instrument de musique à vent constitué d'un tube percé de trous, dont on joue en soufflant sur une ouverture et en bouchant les trous pour modifier les notes.",
          "source": "acai"
        }
      ],
      "preferred_label": "flûte"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Kayan kiɗa na busa da aka yi da bututu mai ramuka, wanda ake busawa ta bakinsa ana kuma rufe ramukan don canza sautin kiɗa.",
          "source": "acai"
        }
      ],
      "preferred_label": "sarewa"
    },
    "hin": {
      "descriptions": [
        {
          "description": "छेदों वाली नली से बना एक सुषिर (हवा से बजने वाला) वाद्य यंत्र, जिसे मुँह से फूँककर और सुर बदलने के लिए छेदों को उँगलियों से दबाकर बजाया जाता है।",
          "source": "acai"
        }
      ],
      "preferred_label": "बाँसुरी"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ngwa egwu e ji ifufe na-akpọ nke e ji okporo nwere oghere mee, nke a na-akpọ site nʼịfụ nʼọnụ ya na ikpuchi oghere ndị ahụ iji gbanwee ụda olu ya.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ọja"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Alat musik tiup yang terbuat dari tabung berlubang, dimainkan dengan meniup celah tiupan dan menutup lubang-lubangnya untuk mengubah nada.",
          "source": "acai"
        }
      ],
      "preferred_label": "suling"
    },
    "nep": {
      "descriptions": [
        {
          "description": "प्वालहरू भएको नलीबाट बनेको हावा फुकेर बजाइने एउटा साङ्गीतिक बाजा, जुन खुला मुखमा फुकेर र सुर फेर्न प्वालहरू थुनेर बजाइन्छ।",
          "source": "acai"
        }
      ],
      "preferred_label": "बाँसुरी"
    },
    "por": {
      "descriptions": [
        {
          "description": "Instrumento musical de sopro feito de um tubo com orifícios, tocado soprando através de uma abertura e cobrindo os orifícios para mudar as notas.",
          "source": "acai"
        }
      ],
      "preferred_label": "flauta"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Духовой музыкальный инструмент в виде трубки с отверстиями, звук на котором извлекается вдуванием воздуха через отверстие, а высота тона меняется закрыванием отверстий.",
          "source": "acai"
        }
      ],
      "preferred_label": "свирель"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Instrumento musical de viento compuesto por un tubo con orificios, que se toca soplando a través de una abertura y tapando los orificios para cambiar las notas.",
          "source": "acai"
        }
      ],
      "preferred_label": "flauta"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Ala ya muziki ya kupuliza iliyotengenezwa kwa mrija wenye matundu, inayopigwa kwa kupuliza hewa kwenye uwazi na kuziba matundu ili kubadilisha sauti.",
          "source": "acai"
        }
      ],
      "preferred_label": "filimbi"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela kain instramen bilong musik ol i mekim long mambu i gat ol hul, ol i save winim win i go insait long maus bilong en na pasim na opim ol hul long finga bilong senisim krai bilong en.",
          "source": "acai"
        }
      ],
      "preferred_label": "mambu"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một nhạc cụ hơi làm bằng ống có lỗ, được chơi bằng cách thổi qua một lỗ hở và bịt các lỗ để đổi nốt nhạc.",
          "source": "acai"
        }
      ],
      "preferred_label": "sáo"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "一种带有孔洞的管状吹奏乐器，通过在吹口处吹气并按住孔洞以改变音调来演奏。",
          "source": "acai"
        }
      ],
      "preferred_label": "笛"
    },
    "zht": {
      "descriptions": [
        {
          "description": "一種帶有孔洞管身的管樂器，透過向吹口吹氣並按放音孔改變音高來演奏。",
          "source": "acai"
        }
      ],
      "preferred_label": "笛"
    }
  },
