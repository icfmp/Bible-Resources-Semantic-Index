  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "زول شاطر وماهر في صناعة الحاجات من مواد زي الحجر أو الخشب أو المعدن، وغالباً بالنحت أو الحفر.",
          "source": "acai"
        }
      ],
      "preferred_label": "صنايعي"
    },
    "arb": {
      "descriptions": [
        {
          "description": "شخص ماهر في صنع الأشياء من مواد مثل الحجر أو الخشب أو المعدن، وغالبًا ما يكون ذلك بالنحت أو النقش.",
          "source": "acai"
        }
      ],
      "preferred_label": "حِرَفيّ"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan man we i gat gudhan blong mekem ol samting long ston, wud, no aean, plante taem long fasin blong katem no rekem.",
          "source": "acai"
        }
      ],
      "preferred_label": "man blong mekem ol samting"
    },
    "eng": {
      "alternate_labels": [
        "Engraving",
        "Carving"
      ],
      "descriptions": [
        {
          "article": "realia:Craftsman",
          "description": "A person skilled in making objects from materials like stone, wood, or metal often by carving or engraving.",
          "gloss": "Craftsman",
          "source": "acai"
        }
      ],
      "preferred_label": "Craftsman"
    },
    "fas": {
      "descriptions": [
        {
          "description": "شخصی ماهر در ساختن اشیاء از موادی مانند سنگ، چوب، یا فلز که اغلب با کنده‌کاری یا حکاکی کار می‌کند.",
          "source": "acai"
        }
      ],
      "preferred_label": "صنعتگر"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Une personne qualifiée pour fabriquer des objets à partir de matériaux tels que la pierre, le bois ou le métal, souvent par la taille ou la gravure.",
          "source": "acai"
        }
      ],
      "preferred_label": "artisan"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Mutumin da ya ƙware wajen yin abubuwa daga abubuwa kamar dutse, itace, ko ƙarfe, sau da yawa ta hanyar sassaƙa ko zane.",
          "source": "acai"
        }
      ],
      "preferred_label": "Mai sana’a"
    },
    "hin": {
      "descriptions": [
        {
          "description": "पत्थर, लकड़ी या धातु जैसी सामग्रियों से प्रायः तराशकर या नक्काशी करके वस्तुएँ बनाने में कुशल व्यक्ति।",
          "source": "acai"
        }
      ],
      "preferred_label": "कारीगर"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Onye nwere nkà nʼịkpụ ma ọ bụ ịkpụzi ihe site nʼihe ndị dị ka nkume, osisi, ma ọ bụ igwe, na-abụkarị site nʼịkpụ ma ọ bụ ịkwa nka.",
          "source": "acai"
        }
      ],
      "preferred_label": "Onye ǹka"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Seseorang yang terampil membuat benda-benda dari bahan seperti batu, kayu, atau logam, sering kali dengan cara mengukir atau memahat.",
          "source": "acai"
        }
      ],
      "preferred_label": "tukang"
    },
    "nep": {
      "descriptions": [
        {
          "description": "प्रायः खोपेर वा कुँदेर ढुङ्गा, काठ वा धातुजस्ता पदार्थहरूबाट वस्तुहरू बनाउनमा सीपालु मानिस।",
          "source": "acai"
        }
      ],
      "preferred_label": "कारीगर"
    },
    "por": {
      "descriptions": [
        {
          "description": "Pessoa habilitada na confecção de objetos a partir de materiais como pedra, madeira ou metal, frequentemente esculpindo ou gravando.",
          "source": "acai"
        }
      ],
      "preferred_label": "artesão"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Человек, искусный в изготовлении предметов из таких материалов, как камень, дерево или металл, часто путем резьбы или гравировки.",
          "source": "acai"
        }
      ],
      "preferred_label": "ремесленник"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Persona hábil en la elaboración de objetos a partir de materiales como piedra, madera o metal, a menudo mediante el tallado o grabado.",
          "source": "acai"
        }
      ],
      "preferred_label": "artesano"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mtu mwenye ustadi wa kutengeneza vitu kwa kutumia mawe, mbao, au metali, mara nyingi kwa kuchonga au kuandika nakshi.",
          "source": "acai"
        }
      ],
      "preferred_label": "fundi stadi"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela man i gat gutpela save bilong wokim ol samting long ston, diwai, o kapa ain, planti taim long rot bilong sapim o katim.",
          "source": "acai"
        }
      ],
      "preferred_label": "man bilong wokim ol samting"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một người khéo tay trong việc chế tác các đồ vật từ những vật liệu như đá, gỗ hoặc kim loại, thường bằng cách chạm trổ hoặc khắc.",
          "source": "acai"
        }
      ],
      "preferred_label": "thợ thủ công"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "擅长用石头、木头或金属等材料制作物品（常通过雕刻或镌刻）的人。",
          "source": "acai"
        }
      ],
      "preferred_label": "匠人"
    },
    "zht": {
      "descriptions": [
        {
          "description": "指熟練於使用石頭、木頭或金屬等材料製作器物的人，通常透過雕刻或刻鏤來完成。",
          "source": "acai"
        }
      ],
      "preferred_label": "工匠"
    }
  },
  "non_biblical": false,
