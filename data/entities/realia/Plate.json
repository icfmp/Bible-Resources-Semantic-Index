    "apd": {
      "descriptions": [
        {
          "description": "صفيحة دهب صغيرة ومسطحة، احتمال تكون معمولة على شكل زهرة، مربوطة في قدّام عمامة رئيس الكهنة.",
          "source": "acai"
        }
      ],
      "preferred_label": "صفيحة"
    },
    "arb": {
      "descriptions": [
        {
          "description": "صفيحة ذهبية مسطحة صغيرة، ربما على شكل زهرة، تُثبَّت على مقدمة عمامة رئيس الكهنة.",
          "source": "acai"
        }
      ],
      "preferred_label": "صَفِيحَة"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan smol flat gol plet, we ating i olsem stael blong wan flaoa, we oli fasem long fran blong spesel hat blong hae pris.",
          "source": "acai"
        }
      ],
      "preferred_label": "smol brasplet"
    },
    "eng": {
      "alternate_labels": [
        "Disk",
        "Frontlet",
        "Medallion"
      ],
      "descriptions": [
        {
          "article": "realia:Plate",
          "description": "A small gold flat dish, possibly flower-shaped, attached to the front of the high priest’s turban.",
          "gloss": "Plate",
          "source": "acai"
        }
      ],
      "preferred_label": "Plate"
    },
    "fas": {
      "descriptions": [
        {
          "description": "صفحهٔ مسطح و کوچک طلایی، احتمالاً به شکل گل، که به جلوی دستار کاهن اعظم متصل می‌شد.",
          "source": "acai"
        }
      ],
      "preferred_label": "نیم‌تاج"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Petite plaque d'or plat, peut-être en forme de fleur, fixée sur le devant du turban du grand prêtre.",
          "source": "acai"
        }
      ],
      "preferred_label": "lame"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Ƙaramin leɓe ko faranti na zinariya mai faɗi, wataƙila mai siffar fure, da ake maƙalawa a gaban rawanin babban firist.",
          "source": "acai"
        }
      ],
      "preferred_label": "Allo"
    },
    "hin": {
      "descriptions": [
        {
          "description": "सोने की एक छोटी चपटी पट्टी, जो संभवतः फूल के आकार की होती थी, और महायाजक की पगड़ी के सामने जोड़ी जाती थी।",
          "source": "acai"
        }
      ],
      "preferred_label": "टीका"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Obere efere ọlaedo dị larịị, nke nwere ike ịdị ka ifuru nʼọdịdị, nke a na-eke nʼihu akwa ike nʼisi nke nnukwu onye nchụàjà.",
          "source": "acai"
        }
      ],
      "preferred_label": "Efere ọlaedo"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Lempengan emas kecil yang rata, kemungkinan berbentuk bunga, yang dipasang pada bagian depan serban imam besar.",
          "source": "acai"
        }
      ],
      "preferred_label": "patam"
    },
    "nep": {
      "descriptions": [
        {
          "description": "प्रधान पूजाहारीको फेटाको अगाडिपट्टि बाँधिने सानो सुनको चेप्टो पाता, सायद फूलको आकारको।",
          "source": "acai"
        }
      ],
      "preferred_label": "पाता"
    },
    "por": {
      "descriptions": [
        {
          "description": "Uma lâmina plana de ouro, possivelmente em forma de flor, presa à parte frontal do turbante do sumo sacerdote.",
          "source": "acai"
        }
      ],
      "preferred_label": "lâmina"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Небольшая плоская золотая пластинка, возможно, в форме цветка, прикреплявшаяся к передней стороне кидара первосвященника.",
          "source": "acai"
        }
      ],
      "preferred_label": "Полированная дощечка"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Una pequeña placa plana de oro, posiblemente en forma de flor, sujeta a la parte delantera del turbante del sumo sacerdote.",
          "source": "acai"
        }
      ],
      "preferred_label": "lámina"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Bamba bapa dogo la dhahabu, huenda lenye umbo la ua, lililowekwa mbele ya kilemba cha kuhani mkuu.",
          "source": "acai"
        }
      ],
      "preferred_label": "Bamba"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela liklik plat plet gol, ating i luk olsem plaua, ol i pasim long fran bilong bikpela hetlaplap bilong hetpris.",
          "source": "acai"
        }
      ],
      "preferred_label": "medal gol"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một miếng kim loại dẹt nhỏ bằng vàng, có thể có hình hoa, được gắn vào phía trước khăn vấn của thầy tế lễ thượng phẩm.",
          "source": "acai"
        }
      ],
      "preferred_label": "thẻ vàng"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "一块平整的小金牌，可能呈花朵形状，系在大祭司裹头巾的前面。",
          "source": "acai"
        }
      ],
      "preferred_label": "金牌"
    },
    "zht": {
      "descriptions": [
        {
          "description": "一塊小型的扁平金牌，形狀可能如花朵，繫在大祭司裹頭巾的前面。",
          "source": "acai"
        }
      ],
      "preferred_label": "金牌"
    }
