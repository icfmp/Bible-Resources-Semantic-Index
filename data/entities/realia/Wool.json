  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "شعر ناعم ومموج من الخرفان بستعملوه عشان يعملوا منو قماش للملابس؛ وممكن يرمز للبياض والنقاء والنعومة.",
          "source": "acai"
        }
      ],
      "preferred_label": "صوف"
    },
    "arb": {
      "descriptions": [
        {
          "description": "الشعر الناعم المتموج المأخوذ من الغنم لصنع أقمشة الملابس؛ ويمكن أن يرمز إلى البياض والنقاء والنعومة.",
          "source": "acai"
        }
      ],
      "preferred_label": "صُوف"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Sop gras blong sipsip we oli yusum blong wokem kaliko blong werem; i save minim fasin blong waet gud, klin olgeta, mo sop.",
          "source": "acai"
        }
      ],
      "preferred_label": "wul"
    },
    "eng": {
      "alternate_labels": [
        "Sheep-Shearing"
      ],
      "descriptions": [
        {
          "article": "realia:Wool",
          "description": "The soft, wavy hair from sheep used to make fabric for clothing; it can symbolize whiteness, purity, and softness.",
          "gloss": "Wool",
          "source": "acai"
        }
      ],
      "preferred_label": "Wool"
    },
    "fas": {
      "descriptions": [
        {
          "description": "موی نرم و مواج گوسفند که برای بافتن پارچهٔ لباس به کار می‌رود و می‌تواند نماد سفیدی، پاکی و لطافت باشد.",
          "source": "acai"
        }
      ],
      "preferred_label": "پشم"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Poils doux et ondulés du mouton utilisés pour fabriquer du tissu pour les vêtements ; elle peut symboliser la blancheur, la pureté et la douceur.",
          "source": "acai"
        }
      ],
      "preferred_label": "laine"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Taushin gashin tumaki da ake amfani da shi wajen yin yadi don tufafi; yana iya nuna fari, tsarki, da kuma taushi.",
          "source": "acai"
        }
      ],
      "preferred_label": "ulu"
    },
    "hin": {
      "descriptions": [
        {
          "description": "भेड़ों के मुलायम, घुंघराले बाल जिनसे वस्त्र बनाने के लिए कपड़ा तैयार किया जाता है; यह सफेदी, पवित्रता और कोमलता का प्रतीक हो सकता है।",
          "source": "acai"
        }
      ],
      "preferred_label": "ऊन"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ajị dị nro ma na-agbagọ agbagọ nke anụ atụrụ e ji akpa akwa maka iyi uwe; ọ nwere ike ịnọchite anya ịcha ọcha, ịdị ọcha, na ịdị nro.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ajị atụrụ"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Bulu domba yang halus dan bergelombang yang digunakan untuk membuat kain pakaian; dapat melambangkan keputihan, kemurnian, dan kelembutan.",
          "source": "acai"
        }
      ],
      "preferred_label": "bulu domba"
    },
    "nep": {
      "descriptions": [
        {
          "description": "लुगाको निम्ति कपडा बनाउन प्रयोग गरिने भेडाको नरम, घुम्रिएको रौं; यसले सेतोपन, शुद्धता र कोमलताको प्रतीक जनाउन सक्छ।",
          "source": "acai"
        }
      ],
      "preferred_label": "ऊन"
    },
    "por": {
      "descriptions": [
        {
          "description": "O pelo macio e ondulado de ovelhas usado para fazer tecido para roupas; pode simbolizar brancura, pureza e maciez.",
          "source": "acai"
        }
      ],
      "preferred_label": "lã"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Мягкая волнистая шерсть овец, используемая для изготовления ткани для одежды; может символизировать белизну, чистоту и мягкость.",
          "source": "acai"
        }
      ],
      "preferred_label": "Шерсть"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Pelo suave y ondulado de las ovejas utilizado para confeccionar telas para prendas de vestir; puede simbolizar blancura, pureza y suavidad.",
          "source": "acai"
        }
      ],
      "preferred_label": "lana"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Manyoya laini yenye mawimbi kutoka kwa kondoo yanayotumiwa kutengeneza kitambaa cha nguo; yanaweza kuashiria weupe, usafi, na ulaini.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sufu"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Waitpela na sof gras bilong sipsip ol i save wokim laplap long en; em inap makim waitpela, klinpela, na sofpela pasin.",
          "source": "acai"
        }
      ],
      "preferred_label": "Gras bilong sipsip"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Bộ lông mềm, quăn của chiên dùng để dệt vải may quần áo; có thể tượng trưng cho sự trắng trẻo, thanh sạch và mềm mại.",
          "source": "acai"
        }
      ],
      "preferred_label": "Lông chiên"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "来自绵羊的柔软卷曲毛发，用于制作衣物面料；可象征洁白、纯洁与柔软。",
          "source": "acai"
        }
      ],
      "preferred_label": "羊毛"
    },
    "zht": {
      "descriptions": [
        {
          "description": "綿羊身上柔軟、微曲的毛，用於製作衣物面料；可象徵潔白、純潔與柔軟。",
          "source": "acai"
        }
      ],
      "preferred_label": "羊毛"
    }
  },
