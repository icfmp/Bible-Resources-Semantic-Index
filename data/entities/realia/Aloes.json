  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "صمغ عطري بيجي من نبات بشبه الزنبق، كان بيستعمل كتير في تحنيط الأجسام وتكفينها.",
          "source": "acai"
        }
      ],
      "preferred_label": "عود الصندل (صبر)"
    },
    "arb": {
      "descriptions": [
        {
          "description": "صَمغٌ عِطريٌّ يُستَخرَجُ مِن نَباتٍ شَبِيهٍ بالزَّنبَقِ، وكانَ يُستَخدَمُ كَثيرًا في تَكفِينِ وتَحنِيطِ الأَجسادِ.",
          "source": "acai"
        }
      ],
      "preferred_label": "عُود"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan oel no jus we i gat gudfala smel we oli tekem long wan plant, we plante taem oli stap yusum blong berem dedbodi.",
          "source": "acai"
        }
      ],
      "preferred_label": "Alos"
    },
    "eng": {
      "alternate_labels": [
        "Aromatic Salves",
        "Perfumed Ointment"
      ],
      "descriptions": [
        {
          "article": "realia:Aloes",
          "description": "An aromatic resin from a lily-like plant, often used for embalming bodies.",
          "gloss": "Aloes",
          "source": "acai"
        }
      ],
      "preferred_label": "Aloes"
    },
    "fas": {
      "descriptions": [
        {
          "description": "صمغی معطر از گیاهی شبیه به سوسن که اغلب برای حنوط کردن بدن مردگان به کار می‌رفت.",
          "source": "acai"
        }
      ],
      "preferred_label": "عود"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Résine aromatique issue d'une plante de type liliacée, souvent utilisée pour l'embaumement des corps.",
          "source": "acai"
        }
      ],
      "preferred_label": "aloès"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Kakin itace mai ƙamshi da ake samu daga wata tsiro mai kama da lili, wanda galibi ake amfani da shi wajen shirya gawarwaki don binnewa.",
          "source": "acai"
        }
      ],
      "preferred_label": "Aloyes"
    },
    "hin": {
      "descriptions": [
        {
          "description": "लिली जैसे पौधे से प्राप्त एक सुगंधित राल, जिसका उपयोग अक्सर शवों को दफनाने के लिए लेप लगाने में किया जाता था।",
          "source": "acai"
        }
      ],
      "preferred_label": "एलवा"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Mkpụrụ resin na-esi ísì ụtọ sitere nʼosisi yiri lili, nke a na-ejikarị eme ihe nʼịgba ozu mmanụ.",
          "source": "acai"
        }
      ],
      "preferred_label": "Aloos"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Damar wangi dari tanaman sejenis bakung, sering digunakan untuk membaluri mayat.",
          "source": "acai"
        }
      ],
      "preferred_label": "Gaharu"
    },
    "nep": {
      "descriptions": [
        {
          "description": "कमलजस्तै देखिने वनस्पतिबाट प्राप्त हुने सुगन्धित खोटो, जुन प्रायः शवहरूमा लेप लगाउन प्रयोग गरिन्थ्यो।",
          "source": "acai"
        }
      ],
      "preferred_label": "एलवा"
    },
    "por": {
      "descriptions": [
        {
          "description": "Uma resina aromática de uma planta semelhante ao lírio, frequentemente usada para embalsamar corpos.",
          "source": "acai"
        }
      ],
      "preferred_label": "aloés"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Ароматическая смола лилиеподобного растения, часто использовавшаяся для бальзамирования тел.",
          "source": "acai"
        }
      ],
      "preferred_label": "Алой"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Resina aromática de una planta similar al lirio, utilizada a menudo para embalsamar cadáveres.",
          "source": "acai"
        }
      ],
      "preferred_label": "áloe"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Ulimbo wenye harufu nzuri kutoka kwa mmea unaofanana na yungiyungi, mara nyingi ulitumiwa kwa ajili ya kutayarisha miili kwa mazishi.",
          "source": "acai"
        }
      ],
      "preferred_label": "Udi"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Kain sanda i gat gutpela smel i kam long blut bilong wanpela kain diwai, ol i save yusim planti taim bilong redim ol bodi bilong man i dai pinis.",
          "source": "acai"
        }
      ],
      "preferred_label": "Aloes"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một loại nhựa thơm lấy từ một loài cây giống hoa huệ (hoa loa kèn), thường dùng để ướp xác.",
          "source": "acai"
        }
      ],
      "preferred_label": "trầm hương"
    },
    "zhs": {
      "descriptions": [
