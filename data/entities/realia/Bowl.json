        {
          "description": "إناء غريق وكبير بستعملوهو للنظافة والغسيل أو في طقوس العبادة، وغالباً بكون مصنوع من معدن أو فخار.",
          "source": "acai"
        }
      ],
      "preferred_label": "طشت"
    },
    "arb": {
      "descriptions": [
        {
          "description": "إناء عميق كبير يُستخدم للغسيل أو لأغراض دينية طقسية، وغالبًا ما يُصنع من المعدن أو الطين.",
          "source": "acai"
        }
      ],
      "preferred_label": "طَسْت"
    },
    "bis": {
      "descriptions": [
        {
