  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "الأوضة الجوانية في خيمة الاجتماع وهيكل أورشليم الكانت بتتعمل فيها الطقوس المقدسة.",
          "source": "acai"
        }
      ],
      "preferred_label": "القدس"
    },
    "arb": {
      "descriptions": [
        {
          "description": "الحجرة الداخلية في المسكن وفي هيكل أورشليم حيث كانت تُقام الطقوس والشعائر المقدسة.",
          "source": "acai"
        }
      ],
      "preferred_label": "القدس"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Rum insaed long Haos Tapolen mo Haos blong God long Jerusalem we oli stap mekem ol tabu kastom wosip long hem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Rum we i Tabu"
    },
    "eng": {
      "alternate_labels": [
        "Holy Place"
      ],
      "descriptions": [
        {
          "article": "realia:TheHolyPlace",
          "description": "The inner room of the Tabernacle and Jerusalem Temple where sacred rituals were performed.",
          "gloss": "The Holy Place",
          "source": "acai"
        }
      ],
      "preferred_label": "The Holy Place"
    },
    "fas": {
      "descriptions": [
        {
          "description": "اتاق درونی خیمهٔ عبادت و معبد اورشلیم که آیین‌های مقدّس در آن به جا آورده می‌شد.",
          "source": "acai"
        }
      ],
      "preferred_label": "مکان مقدّس"
    },
    "fra": {
      "descriptions": [
        {
          "description": "La pièce intérieure du tabernacle et du temple de Jérusalem où étaient accomplis les rituels sacrés.",
          "source": "acai"
        }
      ],
      "preferred_label": "le lieu saint"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Ɗakin ciki na Tabanakul da Haikalin Urushalima inda aka gudanar da bukukuwa masu tsarki.",
          "source": "acai"
        }
      ],
      "preferred_label": "Wuri Mai Tsarki"
    },
    "hin": {
      "descriptions": [
        {
          "description": "निवास-स्थान (तम्बू) और यरूशलेम के मन्दिर का भीतरी कक्ष जहाँ पवित्र अनुष्ठान किए जाते थे।",
          "source": "acai"
        }
      ],
      "preferred_label": "पवित्र स्थान"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ọnụụlọ dị nʼime nke Ụlọ Nzute na Ụlọnsọ Ukwu Jerusalem ebe a na-anọ arụ emume dị nsọ dị iche iche.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ebe Nsọ"
    },
    "ind": {
      "descriptions": [
