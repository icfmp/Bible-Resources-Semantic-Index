  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "مكيال عبري للحبوب، حجمه حوالي اتناشر لتر أو أقل شوية من نص بوشل.",
          "source": "acai"
        }
      ],
      "preferred_label": "صاع"
    },
    "arb": {
      "descriptions": [
        {
          "description": "مِكْيَالٌ عِبْرَانِيٌّ لِلْحُبُوبِ، يَبْلُغُ نَحْوَ ٱثْنَيْ عَشَرَ لِتْرًا أَوْ أَقَلَّ قَلِيلًا مِنْ نِصْفِ بُوشِل.",
          "source": "acai"
        }
      ],
      "preferred_label": "كَيْلَة"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan skelem blong ol Hibru blong kakae olsem wit o flaoa, we i klosap twelvfala lita.",
          "source": "acai"
        }
      ],
      "preferred_label": "saton"
    },
    "eng": {
      "alternate_labels": [
        "Measure",
        "Batch"
      ],
      "descriptions": [
        {
          "article": "realia:Saton",
          "description": "A Hebrew measure of grain, about twelve liters or a little less than half a bushel.",
          "gloss": "Saton",
          "source": "acai"
        }
      ],
      "preferred_label": "Saton"
    },
    "fas": {
      "descriptions": [
        {
          "description": "یک واحد اندازه‌گیری عبرانی برای غلات، در حدود دوازده لیتر یا اندکی کمتر از نیم بوشل.",
          "source": "acai"
        }
      ],
      "preferred_label": "ساتون"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Mesure hébraïque de grain d'environ douze litres, soit un peu moins d'un demi-boisseau.",
          "source": "acai"
        }
      ],
      "preferred_label": "saton"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Ma’aunin hatsi na Ibraniyawa, wajen lita goma sha biyu ko ƙasa da rabin bushel kaɗan.",
          "source": "acai"
        }
      ],
      "preferred_label": "Saton"
    },
    "hin": {
      "descriptions": [
        {
          "description": "अनाज का एक इब्रानी माप, जो लगभग बारह लीटर या आधे बुशेल से थोड़ा कम होता है।",
          "source": "acai"
        }
      ],
      "preferred_label": "साटोन"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Ihe ọtụtụ ndị Hibru e ji atụ ọka, nke ruru ihe dị ka lita iri na abụọ ma ọ bụ ihe na-erughị obere ọkara bushel.",
          "source": "acai"
        }
      ],
      "preferred_label": "saton"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Satuan ukuran gandum Ibrani, sekitar dua belas liter atau sedikit kurang dari setengah gantang.",
          "source": "acai"
        }
      ],
      "preferred_label": "sukat"
    },
    "nep": {
      "descriptions": [
        {
          "description": "अन्‍न नाप्‍ने एक हिब्रू नाप, जुन लगभग बाह्र लिटर वा आधा बुसेलभन्दा अलिकति कम हुन्थ्यो।",
          "source": "acai"
        }
      ],
      "preferred_label": "साटोन"
