  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "كاهن في زمن المملكة الموحدة في إسرائيل، وهو ولد أبياثار.",
          "source": "acai"
        }
      ],
      "preferred_label": "يوناثان"
    },
    "arb": {
      "descriptions": [
        {
          "description": "كاهن في زمن المملكة الموحدة في إسرائيل وابن أبياثار.",
          "source": "acai"
        }
      ],
      "preferred_label": "يُونَاثَانُ"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan pris long taem we ol laen blong Isrel oli joen wanples olsem wan neson mo pikinini boe blong Abiata.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jonatan"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Jonathan.4",
          "description": "A priest during the time of Israel’s united kingdom and a son of Abiathar.",
          "gloss": "Jonathan",
          "source": "acai"
        }
      ],
      "preferred_label": "Jonathan"
    },
    "fas": {
      "descriptions": [
        {
          "description": "کاهنی در دوران پادشاهی متحد اسرائیل و پسر ابیاتار.",
          "source": "acai"
        }
      ],
      "preferred_label": "یوناتان"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Prêtre à l’époque du royaume uni d’Israël et fils d’Abiathar.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jonathan"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani firist a zamanin haɗin kan masarautar Isra’ila kuma ɗan Abiyatar.",
          "source": "acai"
        }
      ],
      "preferred_label": "Yonatan"
    },
    "hin": {
      "descriptions": [
        {
          "description": "इस्राएल के संयुक्त राज्य के समय का एक याजक और एब्यातार का पुत्र।",
          "source": "acai"
        }
      ],
      "preferred_label": "योनातान"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Onye nchụaja n'oge alaeze dị n'otu nke Izrel na nwa Abịata.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jonatan"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Seorang imam pada masa kerajaan bersatu Israel dan anak dari Abyatar.",
          "source": "acai"
        }
      ],
      "preferred_label": "Yonatan"
    },
    "nep": {
      "descriptions": [
        {
          "description": "इस्राएलको संयुक्त अधिराज्यको समयका एक पुजारी र अबियाथारका छोरा।",
          "source": "acai"
        }
      ],
      "preferred_label": "जोनाथन"
    },
    "por": {
      "descriptions": [
        {
          "description": "Um sacerdote durante o período da monarquia unida de Israel e filho de Abiatar.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jônatas"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Священник во времена единого Израильского царства, сын Авиафара.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ионафан"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Sacerdote durante el período de la monarquía unida de Israel e hijo de Abiatar.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jonatán"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Kuhani wakati wa ufalme wa umoja wa Israeli na mwana wa Abiathari.",
          "source": "acai"
        }
      ],
      "preferred_label": "Yonathani"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela pris long taim bilong wanbel kingdom bilong Israel na pikinini man bilong Abiatar.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jonatan"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một thầy tế lễ trong thời vương quốc thống nhất của Y-sơ-ra-ên và là con trai của A-bia-tha.",
          "source": "acai"
        }
      ],
      "preferred_label": "Giô-na-than"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "以色列联合王国时期的一名祭司，是亚比亚他的儿子。",
          "source": "acai"
        }
      ],
      "preferred_label": "约拿单"
    },
    "zht": {
      "descriptions": [
        {
          "description": "以色列聯合王國時期的一名祭司，是亞比亞他的兒子。",
          "source": "acai"
        }
      ],
      "preferred_label": "約拿單"
    }
