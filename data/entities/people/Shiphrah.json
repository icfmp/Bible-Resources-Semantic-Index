  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "شفرة كانت قابلة (داية) في مصر ساعدت في إنقاذ أطفال العبرانيين، ومذكورة في خروج 1: 15.",
          "source": "acai"
        }
      ],
      "preferred_label": "شفرة"
    },
    "arb": {
      "descriptions": [
        {
          "description": "شِفْرَةُ كانَتْ قابِلَةً في مِصْرَ ساعَدَتْ في إِنْقاذِ أَطْفالِ العِبْرانِيِّينَ، وذُكِرَتْ في سِفْرِ الخُروجِ 1: 15.",
          "source": "acai"
        }
      ],
      "preferred_label": "شِفْرَة"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Sifraha hem i wan woman blong givhan long bonem pikinini long Isip we i bin givhan blong sevem ol bebi blong ol Hibru, we Eksodas 1:15 i tokbaot hem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sifraha"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Shiphrah",
          "description": "Shiphrah was a midwife in Egypt who helped save Hebrew babies, mentioned in Exodus 1:15.",
          "gloss": "Shiphrah",
          "source": "acai"
        }
      ],
      "preferred_label": "Shiphrah"
    },
    "fas": {
      "descriptions": [
        {
          "description": "شِفره قابله‌ای در مصر بود که به نجات نوزادان عبرانی کمک کرد، و در خروج ۱۵:۱ از او نام برده شده است.",
          "source": "acai"
        }
      ],
      "preferred_label": "شِفره"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Schiphra était une sage-femme en Égypte qui aida à sauver des bébés hébreux, mentionnée dans Exode 1.15.",
          "source": "acai"
        }
      ],
      "preferred_label": "Schiphra"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Shofra wata ungozoma ce a Masar wadda ta taimaka wajen ceton jariran Ibraniyawa, an ambace ta a cikin Fitowa 1:15.",
          "source": "acai"
        }
      ],
      "preferred_label": "Shofra"
    },
    "hin": {
      "descriptions": [
        {
          "description": "शिप्रा मिस्र में एक दाई थी जिसने इब्री बालकों को बचाने में सहायता की, जिसका उल्लेख निर्गमन 1:15 में है।",
          "source": "acai"
        }
      ],
      "preferred_label": "शिप्रा"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Shifra bụ nwanyị na-aghọ nwa nʼIjipt nke nyeere aka zọpụta ụmụaka ndị Hibru, a kpọtụrụ ya aha nʼỌpụpụ 1:15.",
          "source": "acai"
        }
      ],
      "preferred_label": "Shifra"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Sifra adalah seorang bidan di Mesir yang membantu menyelamatkan bayi-bayi orang Ibrani, yang disebutkan dalam Keluaran 1:15.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sifra"
    },
    "nep": {
      "descriptions": [
        {
          "description": "शिप्रा मिश्रमा रहेकी एक सुँडिनी थिइन् जसले हिब्रू शिशुहरूलाई बचाउन मद्दत गरिन्, जसको उल्लेख प्रस्थान १:१५ मा गरिएको छ।",
          "source": "acai"
        }
      ],
      "preferred_label": "शिप्रा"
    },
    "por": {
      "descriptions": [
        {
          "description": "Sifrá foi uma parteira no Egito que ajudou a salvar bebês hebreus, mencionada em Êxodo 1:15.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sifrá"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Шифра была повитухой в Египте, которая помогла спасти еврейских младенцев; упоминается в Исход 1:15.",
          "source": "acai"
        }
      ],
      "preferred_label": "Шифра"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Sifrá fue una partera en Egipto que ayudó a salvar a los bebés hebreos, mencionada en Éxodo 1:15.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sifrá"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Shifra alikuwa mkunga huko Misri aliyesaidia kuokoa watoto wa Kiebrania, anayetajwa katika Kutoka 1:15.",
          "source": "acai"
        }
      ],
      "preferred_label": "Shifra"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Sifra em i wanpela meri bilong helpim ol meri long karim pikinini long Isip, em i bin helpim long sevim ol pikinini bilong lain Hibru, na Kisim Bek 1:15 i stori long em.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sifra"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Siếp-ra là một bà mụ tại Ai Cập đã giúp cứu các bé trai Hê-bơ-rơ, được nhắc đến trong Xuất Ai Cập Ký 1:15.",
          "source": "acai"
        }
      ],
      "preferred_label": "Siếp-ra"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "施弗拉是埃及的一位收生婆，曾帮助拯救希伯来男婴，见于出埃及记1:15。",
          "source": "acai"
        }
      ],
      "preferred_label": "施弗拉"
