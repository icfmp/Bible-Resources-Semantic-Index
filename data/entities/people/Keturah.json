        }
      ],
      "preferred_label": "Cetura"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mwanamke aliyeolewa na mzee wa imani Abrahamu. Alikuwa mama wa Zimrani, Yokshani, Medani, Midiani, Ishbaki, na Shua.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ketura"
    },
    "tpi": {
      "descriptions": [
