  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "مَرة اتزوجت أبونا إبراهيم. وهي أم زمران، ويقشان، ومدان، ومديان، ويشباق، وشوحا.",
          "source": "acai"
        }
      ],
      "preferred_label": "قطورة"
    },
    "arb": {
      "descriptions": [
        {
          "description": "امرأة تزوّجها أبونا إبراهيم. وكانت أمّ زِمْرَان ويَقْشَان ومَدَان ومِدْيَان ويِشْبَاق وشُوحَا.",
          "source": "acai"
        }
      ],
      "preferred_label": "قَطُورَة"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan woman we i mared long stamba bubu Ebraham. Hem i mama blong Simran, Joksan, Medan, Midian, Jisbak, mo Suaha.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ketura"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Keturah",
          "description": "A woman married to the patriarch Abraham. She was the mother of Zimran, Jokshan, Medan, Midian, Ishbak, and Shuah.",
          "gloss": "Keturah",
          "source": "acai"
        }
      ],
      "preferred_label": "Keturah"
    },
    "fas": {
      "descriptions": [
        {
          "description": "زنی که با ابراهیم پدر قوم ازدواج کرد. او مادر زمران، یقشان، مدان، مدیان، یشباق و شوعه بود.",
          "source": "acai"
        }
      ],
      "preferred_label": "قِطوره"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Femme mariée au patriarche Abraham. Elle était la mère de Zimran, Jokschan, Medan, Madian, Jischbak et Schuach.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ketura"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wata mata da ta auri babban uba Ibrahim. Ita ce mahaifiyar Zimran, Yokshan, Medan, Midiyan, Ishbak, da Shuwa.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ketura"
    },
    "hin": {
      "descriptions": [
        {
          "description": "कुलपिता अब्राहम से ब्याही गई एक स्त्री। वह जिम्रान, योक्षान, मेदान, मिद्यान, यिशबाक और शूह की माता थी।",
          "source": "acai"
        }
      ],
      "preferred_label": "कतूरा"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Nwanyị lụrụ nna nna ochie bụ́ Ebraham. Ọ bụ nne Zimran, Jokshan, Medan, Midian, Ishbak, na Shua.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ketura"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Seorang wanita yang menikah dengan bapa leluhur Abraham. Ia adalah ibu dari Zimran, Yoksan, Medan, Midian, Isybak, dan Suah.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ketura"
    },
    "nep": {
      "descriptions": [
        {
          "description": "कुलपिता अब्राहामसँग विवाह गरेकी एक स्त्री। उनी जिम्रान, योक्षान, मदान, मिद्यान, यिशबाक र शूहकी आमा थिइन्।",
          "source": "acai"
        }
      ],
      "preferred_label": "कतूरा"
    },
    "por": {
      "descriptions": [
        {
          "description": "Uma mulher casada com o patriarca Abraão. Ela foi mãe de Zinrã, Jocsã, Medã, Midiã, Isbaque e Suá.",
          "source": "acai"
        }
      ],
      "preferred_label": "Quetura"
    },
    "rus": {
      "descriptions": [
        {
