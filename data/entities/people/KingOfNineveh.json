    "apd": {
      "descriptions": [
        {
          "description": "ملك نينوى زي ما اتذكر في سفر يونان.",
          "source": "acai"
        }
      ],
      "preferred_label": "ملك نينوى"
    },
    "arb": {
      "descriptions": [
        {
          "description": "مَلِكُ نِينَوَى كَمَا وَرَدَ ذِكْرُهُ فِي سِفْرِ يُونَانَ.",
          "source": "acai"
        }
      ],
      "preferred_label": "مَلِكُ نِينَوَى"
    },
    "bis": {
      "descriptions": [
        {
          "description": "King blong Nineve we Buk blong Jona i tokbaot hem.",
          "source": "acai"
        }
      ],
      "preferred_label": "King blong Nineve"
    },
    "eng": {
      "descriptions": [
        {
          "description": "The king of Nineveh as represented in the book of Jonah.",
          "gloss": "King of Nineveh",
          "source": "acai"
        }
      ],
      "preferred_label": "King of Nineveh"
    },
    "fas": {
      "descriptions": [
        {
          "description": "پادشاه نینوا آن‌چنان که در کتاب یونس توصیف شده است.",
          "source": "acai"
        }
      ],
      "preferred_label": "پادشاه نینوا"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Le roi de Ninive tel qu’il est représenté dans le livre de Jonas.",
          "source": "acai"
        }
      ],
      "preferred_label": "roi de Ninive"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Sarkin Ninebe kamar yadda aka nuna a littafin Yunana.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sarkin Ninebe"
    },
    "hin": {
      "descriptions": [
        {
          "description": "योना की पुस्तक में दर्शाया गया नीनवे का राजा।",
          "source": "acai"
        }
      ],
      "preferred_label": "नीनवे का राजा"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Eze Ninive dịka e gosipụtara nʼakwụkwọ Jona.",
          "source": "acai"
        }
      ],
      "preferred_label": "Eze Ninive"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Raja Niniwe seperti yang digambarkan dalam kitab Yunus.",
          "source": "acai"
        }
      ],
      "preferred_label": "Raja Niniwe"
    },
    "nep": {
      "descriptions": [
        {
          "description": "योनाको पुस्तकमा उल्लेख गरिएका निनवेका राजा ।",
          "source": "acai"
        }
      ],
      "preferred_label": "निनवेका राजा"
    },
    "por": {
      "descriptions": [
        {
          "description": "O rei de Nínive conforme representado no livro de Jonas.",
