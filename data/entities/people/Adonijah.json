  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "واحد من أولاد داود، حاول يبقى ملك بدل أخوه سليمان.",
          "source": "acai"
        }
      ],
      "preferred_label": "أدونيا (ولد داود)"
    },
    "arb": {
      "descriptions": [
        {
          "description": "أَحَدُ أَبْنَاءِ دَاوُدَ، حَاوَلَ أَنْ يَصِيرَ مَلِكًا بَدَلًا مِنْ أَخِيهِ سُلَيْمَانَ.",
          "source": "acai"
        }
      ],
      "preferred_label": "أَدُونِيَّا (ابن داود)"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan pikinini boe blong Deved we i traem blong kam king i tekem ples blong brata blong hem Solomon.",
          "source": "acai"
        }
      ],
      "preferred_label": "Adonia (Pikinini boe blong Deved)"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Adonijah",
          "description": "One of David’s sons who tried to become king instead of his brother Solomon.",
          "gloss": "Adonijah (Son of David)",
          "source": "acai"
        }
      ],
      "preferred_label": "Adonijah (Son of David)"
    },
    "fas": {
      "descriptions": [
        {
          "description": "یکی از پسران داوود که کوشید به جای برادرش سلیمان پادشاه شود.",
          "source": "acai"
        }
      ],
      "preferred_label": "ادونیا (پسر داوود)"
    },
    "fra": {
      "descriptions": [
        {
          "description": "L’un des fils de David qui tenta de devenir roi à la place de son frère Salomon.",
          "source": "acai"
        }
      ],
      "preferred_label": "Adonija (fils de David)"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Ɗaya daga cikin ’ya’yan Dawuda maza wanda ya yi ƙoƙarin zama sarki a maimakon ɗan’uwansa Solomon.",
          "source": "acai"
        }
      ],
      "preferred_label": "Adoniya (Ɗan Dawuda)"
    },
    "hin": {
      "descriptions": [
        {
          "description": "दाऊद के पुत्रों में से एक जिसने अपने भाई सुलैमान के स्थान पर राजा बनने का प्रयास किया था।",
          "source": "acai"
        }
      ],
      "preferred_label": "अदोनिय्याह (दाऊद का पुत्र)"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Otu n'ime ụmụ ndị ikom Devid nke nwara ịghọ eze n'ọnọdụ nwanne ya nwoke bụ Solomọn.",
          "source": "acai"
        }
      ],
      "preferred_label": "Adonaịja (Nwa Devid)"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Salah seorang putra Daud yang berusaha menjadi raja menggantikan saudaranya, Salomo.",
          "source": "acai"
        }
      ],
      "preferred_label": "Adonia (anak Daud)"
    },
    "nep": {
      "descriptions": [
        {
          "description": "दाऊदका छोराहरूमध्ये एक जसले आफ्ना भाइ सोलोमनको सट्टामा राजा बन्ने प्रयास गरे।",
          "source": "acai"
        }
      ],
      "preferred_label": "अदोनियाह (दाऊदका छोरा)"
    },
    "por": {
      "descriptions": [
        {
          "description": "Um dos filhos de Davi que tentou se tornar rei no lugar de seu irmão Salomão.",
          "source": "acai"
        }
      ],
      "preferred_label": "Adonias (filho de Davi)"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Один из сыновей Давида, попытавшийся стать царем вместо своего брата Соломона.",
          "source": "acai"
        }
      ],
      "preferred_label": "Адония (сын Давида)"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Uno de los hijos de David que intentó convertirse en rey en lugar de su hermano Salomón.",
          "source": "acai"
        }
      ],
      "preferred_label": "Adonías (hijo de David)"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mmoja wa wana wa Daudi aliyejaribu kuwa mfalme badala ya nduguye Sulemani.",
          "source": "acai"
        }
      ],
      "preferred_label": "Adoniya (Mwana wa Daudi)"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela pikinini man bilong Devit em i bin traim long kamap king na kisim ples bilong brata bilong en Solomon.",
          "source": "acai"
        }
      ],
      "preferred_label": "Adoniya (Pikinini Man Bilong Devit)"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một trong các con trai của Đa-vít, người đã tìm cách làm vua thay cho em trai mình là Sa-lô-môn.",
          "source": "acai"
        }
      ],
      "preferred_label": "A-đô-ni-gia (con trai Đa-vít)"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "大卫的儿子之一，曾企图取代其兄弟所罗门作王。",
          "source": "acai"
        }
      ],
      "preferred_label": "亚多尼雅 (大卫之子)"
    },
    "zht": {
      "descriptions": [
        {
          "description": "大衛的兒子之一，曾企圖篡位代替其弟所羅門作王。",
          "source": "acai"
        }
      ],
      "preferred_label": "亞多尼雅 (大衛的兒子)"
    }
  },
