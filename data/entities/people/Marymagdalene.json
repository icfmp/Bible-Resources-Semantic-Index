      "preferred_label": "Maria Magdalena"
    },
    "nep": {
      "descriptions": [
        {
          "description": "येशूकी एक चेली जो अत्तर लिएर चिहानमा जाने स्‍त्रीहरूमध्ये एक थिइन्।",
          "source": "acai"
        }
      ],
      "preferred_label": "मरियम मग्दलिनी"
    },
    "por": {
      "descriptions": [
