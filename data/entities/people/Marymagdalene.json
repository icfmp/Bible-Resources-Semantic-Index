        }
      ],
      "preferred_label": "मरियम मगदलीनी"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Onye na-eso ụzọ Jisọs nke so nʼụmụ nwanyị ndị bu mmanụ na-esi ísì ụtọ gaa nʼili ya.",
          "source": "acai"
        }
      ],
      "preferred_label": "Meri Magdalin"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Seorang murid Yesus yang merupakan salah satu perempuan pembawa mur.",
