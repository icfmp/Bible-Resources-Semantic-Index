  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "ملك صور في زمن حكم داود وسليمان، قدم مواد ودعم لمشاريع البناء.",
          "source": "acai"
        }
      ],
      "preferred_label": "حورام (حيرام)"
    },
    "arb": {
      "descriptions": [
        {
          "description": "مَلِكُ صُورَ خِلَالَ عَهْدَيْ دَاوُدَ وَسُلَيْمَانَ، قَدَّمَ مَوَادَّ وَدَعْمًا لِمَشَارِيعِ ٱلْبِنَاءِ.",
          "source": "acai"
        }
      ],
      "preferred_label": "حورَام (حِيرَام)"
    },
    "bis": {
      "descriptions": [
        {
          "description": "King blong Taea long taem we Deved mo Solomon tufala i king, we hem i givim ol timba mo samting blong bildim ol haos.",
          "source": "acai"
        }
      ],
      "preferred_label": "Huram (Hiram)"
    },
    "eng": {
      "alternate_labels": [
        "Hiram"
      ],
      "descriptions": [
        {
          "article": "person:Huram",
          "description": "The king of Tyre during the reigns of David and Solomon, providing materials and support for building projects.",
          "gloss": "Hiram",
          "source": "acai"
        }
      ],
      "preferred_label": "Huram (Hiram)"
    },
    "fas": {
      "descriptions": [
        {
          "description": "پادشاه صور در دوران سلطنت داوود و سلیمان که مصالح و پشتیبانی لازم را برای پروژه‌های ساختمانی فراهم می‌کرد.",
          "source": "acai"
        }
      ],
      "preferred_label": "حورام (حیرام)"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Roi de Tyr sous les règnes de David et Salomon, ayant fourni des matériaux et apporté son soutien à des projets de construction.",
          "source": "acai"
        }
      ],
      "preferred_label": "Huram (Hiram)"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Sarkin Taya a lokacin mulkin Dawuda da Solomon, wanda ya ba da kayayyaki da taimako domin ayyukan gini.",
          "source": "acai"
        }
      ],
      "preferred_label": "Huram (Hiram)"
    },
    "hin": {
      "descriptions": [
        {
          "description": "दाऊद और सुलैमान के शासनकाल के दौरान सोर का राजा, जिसने निर्माण परियोजनाओं के लिए सामग्री और सहायता प्रदान की।",
          "source": "acai"
        }
      ],
      "preferred_label": "हूराम (हीराम)"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Eze Taya nʼoge ọchịchị Devid na Solomọn, onye nyere ngwongwo na nkwado maka ọrụ owuwu dị iche iche.",
          "source": "acai"
        }
      ],
      "preferred_label": "Huram (Hiram)"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Raja Tirus pada masa pemerintahan Daud dan Salomo, yang menyediakan bahan-bahan dan dukungan untuk proyek-proyek pembangunan.",
          "source": "acai"
        }
      ],
      "preferred_label": "Huram (Hiram)"
    },
    "nep": {
      "descriptions": [
        {
          "description": "दाऊद र सोलोमनको शासनकालमा टायरका राजा, जसले निर्माण परियोजनाहरूका लागि सामग्री र सहयोग उपलब्ध गराएका थिए।",
          "source": "acai"
        }
      ],
      "preferred_label": "हूराम (हीराम)"
    },
    "por": {
      "descriptions": [
        {
