          "source": "acai"
        }
      ],
      "preferred_label": "جِيرَا"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan man blong laen blong Benjamin mo papa blong Simei, we i laef long taem we olgeta laen blong Isrel oli joen wanples olsem wan neson nomo.",
          "source": "acai"
        }
      ],
      "preferred_label": "Geraha"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Gera.2",
          "description": "A man from the tribe of Benjamin and father of Shimei, who lived during the time of Israel’s united kingdom.",
          "gloss": "Gera",
          "source": "acai"
        }
      ],
      "preferred_label": "Gera"
    },
    "fas": {
      "descriptions": [
        {
          "description": "مردی از سبط بنیامین و پدر شِمعی که در دوران پادشاهی متحد اسرائیل زندگی می‌کرد.",
          "source": "acai"
        }
      ],
      "preferred_label": "جیرا"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Homme de la tribu de Benjamin et père de Schimeï, qui vivait à l'époque du royaume uni d'Israël.",
          "source": "acai"
        }
      ],
      "preferred_label": "Guéra"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani mutum daga kabilar Benyamin kuma mahaifin Shimeyi, wanda ya rayu a zamanin haɗaɗɗiyar masarautar Isra’ila.",
          "source": "acai"
        }
      ],
      "preferred_label": "Gera"
    },
    "hin": {
      "descriptions": [
        {
          "description": "बिन्यामीन के गोत्र का एक पुरुष और शिमी का पिता, जो इस्राएल के संयुक्त राज्य के समय जीवित था।",
          "source": "acai"
        }
      ],
      "preferred_label": "गेरा"
    },
    "ibo": {
      "descriptions": [
        {
