  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "ملك في مملكة إسرائيل الشمالية، وهو ولد أخاب.",
          "source": "acai"
        }
      ],
      "preferred_label": "أخزيا"
    },
    "arb": {
      "descriptions": [
        {
          "description": "مَلِكٌ مِنَ ٱلْمَمْلَكَةِ ٱلشَّمَالِيَّةِ (إِسْرَائِيلَ)، وَهُوَ ٱبْنُ أَخْآبَ.",
          "source": "acai"
        }
      ],
      "preferred_label": "أَخَزْيَا"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan king blong not kingdom blong Isrel, wan pikinini boe blong Ehab.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ahasia"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Ahaziah",
          "description": "A king of the northern kingdom of Israel, a son of Ahab.",
          "gloss": "Ahaziah",
          "source": "acai"
        }
      ],
      "preferred_label": "Ahaziah"
    },
    "fas": {
      "descriptions": [
        {
          "description": "پادشاهی از پادشاهی شمالی اسرائیل، پسر اَخاب.",
          "source": "acai"
        }
      ],
      "preferred_label": "اخزیا"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Roi du royaume du Nord d’Israël, fils d’Achab.",
          "source": "acai"
        }
      ],
      "preferred_label": "Achazia"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Sarkin masarautar arewa ta Isra’ila, ɗan Ahab.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ahaziya"
    },
    "hin": {
      "descriptions": [
        {
          "description": "इस्राएल के उत्तरी राज्य का एक राजा, अहाब का पुत्र।",
          "source": "acai"
        }
      ],
      "preferred_label": "अहज्याह"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Eze nke alaeze ugwu nke Izrel, nwa Ehab.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ahazaya"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Seorang raja dari kerajaan utara Israel, anak Ahab.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ahazia"
    },
    "nep": {
      "descriptions": [
        {
          "description": "इस्राएलको उत्तरी राज्यका एक राजा, आहाबका छोरा।",
