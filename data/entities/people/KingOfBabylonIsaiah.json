  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "ملك بابل زي ما اتذكر في سفر إشعياء.",
          "source": "acai"
        }
      ],
      "preferred_label": "ملك بابل (إشعياء)"
    },
    "arb": {
      "descriptions": [
        {
          "description": "مَلِكُ بَابِلَ كَمَا وَرَدَ ذِكْرُهُ فِي سِفْرِ إِشَعْيَاءَ.",
          "source": "acai"
        }
      ],
      "preferred_label": "مَلِكُ بَابِلَ (إِشَعْيَاء)"
    },
    "bis": {
      "descriptions": [
        {
          "description": "King blong Babilon we Buk blong Aesea i tokbaot hem.",
          "source": "acai"
        }
      ],
      "preferred_label": "King blong Babilon (Aesea)"
    },
    "eng": {
      "descriptions": [
        {
          "description": "The king of Babylon as represented in the book of Isaiah.",
          "gloss": "King of Babylon (Isaiah)",
          "source": "acai"
        }
      ],
      "preferred_label": "King of Babylon (Isaiah)"
    },
    "fas": {
      "descriptions": [
        {
          "description": "پادشاه بابل آن‌چنان که در کتاب اشعیا توصیف شده است.",
          "source": "acai"
        }
      ],
      "preferred_label": "پادشاه بابل (اشعیا)"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Le roi de Babylone tel qu’il est représenté dans le livre d’Ésaïe.",
          "source": "acai"
        }
      ],
      "preferred_label": "roi de Babylone (Ésaïe)"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Sarkin Babila kamar yadda aka nuna a littafin Ishaya.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sarkin Babila (Ishaya)"
    },
    "hin": {
      "descriptions": [
        {
          "description": "यशायाह की पुस्तक में दर्शाया गया बाबुल का राजा।",
          "source": "acai"
        }
      ],
      "preferred_label": "बाबुल का राजा (यशायाह)"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Eze Babịlọn dịka e gosipụtara nʼakwụkwọ Aịzaya.",
          "source": "acai"
        }
      ],
      "preferred_label": "Eze Babịlọn (Aịzaya)"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Raja Babel seperti yang digambarkan dalam kitab Yesaya.",
          "source": "acai"
        }
      ],
      "preferred_label": "Raja Babel (Yesaya)"
    },
    "nep": {
      "descriptions": [
        {
          "description": "यशैयाको पुस्तकमा उल्लेख गरिएका बेबिलोनका राजा ।",
