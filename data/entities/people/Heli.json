  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "ابن متثات وأبو يوسف راجل مريم، في سلسلة نسب يسوع بحسب إنجيل لوقا.",
          "source": "acai"
        }
      ],
      "preferred_label": "هالي"
    },
    "arb": {
      "descriptions": [
        {
          "description": "ٱبْنُ مَتْثَاتَ وَوَالِدُ يُوسُفَ رَجُلِ مَرْيَمَ، فِي نَسَبِ يَسُوعَ بِحَسَبِ إِنْجِيلِ لُوقَا.",
          "source": "acai"
        }
      ],
      "preferred_label": "هَالِي"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Pikinini boe blong Matat mo papa blong Josef, we Josef ya hem i hasban blong Meri, long laen blong famle blong Jisas folem gospel blong Luk.",
          "source": "acai"
        }
      ],
      "preferred_label": "Heli"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Heli",
          "description": "Son of Matthat and the father of Joseph, Mary's husband, in Jesus's family tree according to Luke's gospel.",
          "gloss": "Heli",
          "source": "acai"
        }
      ],
      "preferred_label": "Heli"
    },
    "fas": {
      "descriptions": [
        {
          "description": "پسر متات و پدر یوسف، شوهر مریم، در شجره‌نامه عیسی طبق انجیل لوقا.",
          "source": "acai"
        }
      ],
      "preferred_label": "هالی"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Fils de Matthat et père de Joseph, l'époux de Marie, dans la généalogie de Jésus selon l'Évangile de Luc.",
          "source": "acai"
        }
      ],
      "preferred_label": "Héli"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Ɗan Mattat kuma mahaifin Yusuf, mijin Maryamu, a cikin tarihin zuriyar Yesu bisa ga bisharar Luka.",
          "source": "acai"
        }
      ],
      "preferred_label": "Heli"
    },
    "hin": {
      "descriptions": [
        {
          "description": "लूका के सुसमाचार के अनुसार यीशु की वंशावली में मत्तात का पुत्र और मरियम के पति यूसुफ का पिता।",
          "source": "acai"
        }
      ],
      "preferred_label": "एली"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Nwa Matat na nna Josef, bụ di Meri, nʼusoro ọmụmụ Jisọs dịka oziọma Luk si kwuo.",
          "source": "acai"
        }
      ],
      "preferred_label": "Heli"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Anak Matat dan ayah Yusuf, suami Maria, dalam silsilah Yesus menurut Injil Lukas.",
          "source": "acai"
        }
      ],
      "preferred_label": "Eli"
    },
    "nep": {
      "descriptions": [
        {
          "description": "लूकाको सुसमाचार अनुसार येशूको वंशावलीमा मत्ततका छोरा र मरियमका पति योसेफका पिता।",
          "source": "acai"
        }
      ],
      "preferred_label": "एली"
    },
    "por": {
      "descriptions": [
        {
          "description": "Filho de Matate e pai de José, esposo de Maria, na árvore genealógica de Jesus de acordo com o Evangelho de Lucas.",
          "source": "acai"
        }
      ],
      "preferred_label": "Eli"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Сын Матфата и отец Иосифа, мужа Марии, в родословии Иисуса согласно Евангелию от Луки.",
          "source": "acai"
        }
      ],
      "preferred_label": "Илий"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Hijo de Matat y padre de José, esposo de María, en la genealogía de Jesús según el evangelio de Lucas.",
          "source": "acai"
        }
      ],
      "preferred_label": "Elí"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mwana wa Mathati na baba yake Yosefu, mume wa Mariamu, katika ukoo wa Yesu kulingana na injili ya Luka.",
          "source": "acai"
        }
      ],
      "preferred_label": "Eli"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Pikinini man bilong Matat na papa bilong Josep, man bilong Maria, long lain tumbuna bilong Jisas olsem Gutnius bilong Luk i kamapim.",
          "source": "acai"
        }
      ],
      "preferred_label": "Heli"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Con trai của Mát-thát và là cha của Giô-sép, chồng của Ma-ri, trong gia phả Chúa Giê-xu theo Phúc âm Lu-ca.",
          "source": "acai"
        }
      ],
      "preferred_label": "Hê-li"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "根据路加福音中耶稣的家谱，希里是玛塔的儿子，也是玛利亚的丈夫约瑟的父亲。",
          "source": "acai"
        }
      ],
      "preferred_label": "希里"
    },
    "zht": {
      "descriptions": [
        {
          "description": "瑪塔的兒子，也是馬利亞的丈夫約瑟的父親，見於路加福音中耶穌的家譜。",
          "source": "acai"
        }
      ],
      "preferred_label": "希里"
    }
