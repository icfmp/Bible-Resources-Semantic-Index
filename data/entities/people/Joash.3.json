      ],
      "preferred_label": "يوآش"
    },
    "arb": {
      "descriptions": [
        {
          "description": "مَلِكُ يَهُوذَا خِلَالَ عَصْرِ الْمَمْلَكَةِ الْمُنْقَسِمَةِ، وَهُوَ ابْنُ أَخَزْيَا وَظَبْيَةَ.",
          "source": "acai"
        }
      ],
      "preferred_label": "يُوآش"
    },
    "bis": {
      "descriptions": [
        {
          "description": "King blong Juda long taem we kingdom i seraot, mo wan pikinini man blong Ahasia mo Jibia.",
          "source": "acai"
        }
      ],
      "preferred_label": "Joas"
    },
