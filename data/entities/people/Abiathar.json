  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "رئيس كهنة في زمن الملك داود. بعدين الملك سليمان رفضه وما خلاه يواصل ككاهن.",
          "source": "acai"
        }
      ],
      "preferred_label": "أبياثار"
    },
    "arb": {
      "descriptions": [
        {
          "description": "رئيس كهنة في زمن الملك داود. رفضه الملك سليمان لاحقاً من الكهنوت.",
          "source": "acai"
        }
      ],
      "preferred_label": "أَبِيَاثَار"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Hae pris long taem blong King Deved. Biaen King Solomon i sakemaot hem blong i no moa pris.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abiata"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Abiathar",
          "description": "High priest during the time of King David. Later King Solomon rejected him as priest.",
          "gloss": "Abiathar",
          "source": "acai"
        }
      ],
      "preferred_label": "Abiathar"
    },
    "fas": {
      "descriptions": [
        {
          "description": "کاهن اعظم در دوران پادشاهی داوود. بعدها سلیمان پادشاه او را از کهانت برکنار کرد.",
          "source": "acai"
        }
      ],
      "preferred_label": "اَبیاتار"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Souverain sacrificateur à l’époque du roi David. Plus tard, le roi Salomon le destitua de sa charge de prêtre.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abiathar"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Babban firist a zamanin Sarki Dawuda. Daga baya Sarki Sulemanu ya ƙi shi a matsayin firist.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abiyatar"
    },
    "hin": {
      "descriptions": [
        {
          "description": "राजा दाऊद के समय में महायाजक। बाद में राजा सुलैमान ने उसे याजक के पद से हटा दिया।",
          "source": "acai"
        }
      ],
      "preferred_label": "एब्यातार"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Onyeisi nchụaja nʼoge Eze Devid. Mgbe e mesịrị Eze Sọlọmọn jụrụ ya dị ka onye nchụaja.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abịata"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Imam besar pada zaman Raja Daud. Kemudian Raja Salomo menolaknya sebagai imam.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abyatar"
    },
    "nep": {
      "descriptions": [
        {
          "description": "राजा दाऊदको समयका प्रधान पुजारी। पछि राजा सुलेमानले उनलाई पुजारीको पदबाट निष्कासित गरे।",
          "source": "acai"
        }
      ],
      "preferred_label": "अबीयाथार"
    },
    "por": {
      "descriptions": [
        {
          "description": "Sumo sacerdote durante a época do rei Davi. Mais tarde, o rei Salomão o rejeitou como sacerdote.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abiatar"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Первосвященник во времена царя Давида. Позже царь Соломон отстранил его от священства.",
          "source": "acai"
        }
      ],
      "preferred_label": "Авиафар"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Sumo sacerdote durante la época del rey David. Más tarde, el rey Salomón lo destituyó del sacerdocio.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abiatar"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Kuhani mkuu wakati wa Mfalme Daudi. Baadaye Mfalme Solomoni alimkataa kuwa kuhani.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abiathari"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Nambawan hetpris long taim bilong King Devit. Bihain King Solomon i rausim em long wok pris.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abiatar"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Thầy tế lễ thượng phẩm vào thời Vua Đa-vít. Về sau Vua Sa-lô-môn đã bãi chức tế lễ của ông.",
          "source": "acai"
        }
      ],
      "preferred_label": "A-bia-tha"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "大卫王时期的大祭司。后来所罗门王革除了他的祭司职务。",
          "source": "acai"
        }
      ],
      "preferred_label": "亚比亚他"
    },
    "zht": {
      "descriptions": [
        {
          "description": "大衛王時期的大祭司。後來所羅門王革除了他的祭司職分。",
          "source": "acai"
        }
      ],
      "preferred_label": "亞比亞他"
    }
  },
