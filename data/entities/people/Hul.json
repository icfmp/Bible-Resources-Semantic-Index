    "apd": {
      "descriptions": [
        {
          "description": "خول، من نسل سام وولد أرام، كان راجل من زمن الآباء الأوائل.",
          "source": "acai"
        }
      ],
      "preferred_label": "خول"
    },
    "arb": {
      "descriptions": [
        {
          "description": "كان حول، وهو من نسل سام وابن أرام، رجلًا من زمن الآباء.",
          "source": "acai"
        }
      ],
      "preferred_label": "حُول"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Hul, wan laen blong Sem mo pikinini boe blong Aram, hem i wan man long taem blong ol olfala bubu blong bifo.",
          "source": "acai"
        }
      ],
      "preferred_label": "Hul"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Hul",
          "description": "Hul, a descendant of Shem and son of Aram, was a man from the time of the patriarchs.",
          "gloss": "Hul",
          "source": "acai"
        }
      ],
      "preferred_label": "Hul"
    },
    "fas": {
      "descriptions": [
        {
          "description": "حول، از نوادگان سام و پسر ارام، مردی از دوران پدران اولیه (پاتریارک‌ها) بود.",
          "source": "acai"
        }
      ],
      "preferred_label": "حول"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Hul, descendant de Sem et fils d'Aram, était un homme de l'époque des patriarches.",
          "source": "acai"
        }
      ],
      "preferred_label": "Hul"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Hul, zuriyar Shem kuma ɗan Aram, mutum ne daga zamanin kakanni.",
          "source": "acai"
        }
      ],
      "preferred_label": "Hul"
    },
    "hin": {
      "descriptions": [
        {
          "description": "हूल शेम का एक वंशज और अराम का पुत्र था, जो कुलपिताओं के समय का एक पुरुष था।",
          "source": "acai"
        }
      ],
      "preferred_label": "हूल"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Hul, nwa nwa Shem na nwa Aram, bụ nwoke biri nʼoge ndị nna ochie.",
          "source": "acai"
        }
      ],
      "preferred_label": "Hul"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Hul, seorang keturunan Sem dan anak Aram, adalah seorang pria dari zaman para bapa leluhur.",
          "source": "acai"
        }
      ],
      "preferred_label": "Hul"
    },
    "nep": {
      "descriptions": [
        {
          "description": "शेकका सन्तान र अरामका छोरा हुल, कुलपिताहरूको समयका एक मानिस थिए।",
          "source": "acai"
        }
      ],
      "preferred_label": "हुल"
    },
    "por": {
      "descriptions": [
        {
          "description": "Hul, descendente de Sem e filho de Arã, foi um homem do tempo dos patriarcas.",
          "source": "acai"
        }
      ],
      "preferred_label": "Hul"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Хул, потомок Сима и сын Арама, был человеком эпохи патриархов.",
          "source": "acai"
        }
      ],
      "preferred_label": "Хул"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Hul, descendiente de Sem e hijo de Aram, fue un hombre de la época de los patriarcas.",
          "source": "acai"
        }
      ],
      "preferred_label": "Hul"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Huli, mzao wa Shemu na mwana wa Aramu, alikuwa mwanamume kutoka wakati wa mababu wa imani.",
          "source": "acai"
        }
      ],
      "preferred_label": "Huli"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Hul, wanpela tumbuna pikinini bilong Siem na pikinini man bilong Aram, em i wanpela man bilong taim bilong ol bikman bilong lain tumbuna.",
          "source": "acai"
        }
      ],
      "preferred_label": "Hul"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Hu-lơ, hậu duệ của Sem và là con trai của A-ram, sống vào thời các tộc trưởng.",
          "source": "acai"
        }
      ],
      "preferred_label": "Hu-lơ"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "户勒是闪的后裔、亚兰的儿子，是先祖时代的人。",
          "source": "acai"
        }
      ],
      "preferred_label": "户勒"
    },
    "zht": {
      "descriptions": [
        {
          "description": "戶勒是閃的後裔、亞蘭的兒子，生活在族長時期。",
          "source": "acai"
        }
      ],
      "preferred_label": "戶勒"
    }
