  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "أبو هوشع، الكان تآمر على فقح ملك مملكة إسرائيل الشمالية وقتله وملك بداله.",
          "source": "acai"
        }
      ],
      "preferred_label": "أيلة"
    },
    "arb": {
      "descriptions": [
        {
          "description": "والد هوشَعَ الذي تآمر على فَقْحَ ملك مملكة إسرائيل الشمالية وقتله وملك عوضًا عنه.",
          "source": "acai"
        }
      ],
      "preferred_label": "أَيْلَة"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Papa blong Hosea, we i bin mekem plan blong kilim Peka, king blong not kingdom blong Isrel, mo hem i tekem ples blong hem i kam king.",
          "source": "acai"
        }
      ],
      "preferred_label": "Elaha"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Elah.3",
          "description": "The father of Hoshea, who assassinated Pekah, king of the northern kingdom of Israel, and reigned in his place. ",
          "gloss": "Elah",
          "source": "acai"
        }
      ],
      "preferred_label": "Elah"
    },
    "fas": {
      "descriptions": [
        {
          "description": "پدر هوشع، که فقح، پادشاه پادشاهی شمالی اسرائیل را ترور کرد و به جای او سلطنت نمود.",
          "source": "acai"
        }
      ],
      "preferred_label": "ایله"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Père d'Osée, qui assassina Pékach, roi du royaume du Nord d'Israël, et régna à sa place.",
          "source": "acai"
        }
      ],
      "preferred_label": "Éla"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Mahaifin Hosheya, wanda ya ƙulla maƙarƙashiya ya kashe Feka, sarkin masarautar arewa ta Isra’ila, ya kuma yi mulki a madadinsa.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ela"
    },
    "hin": {
      "descriptions": [
        {
          "description": "होशे का पिता, जिसने इस्राएल के उत्तरी राज्य के राजा पेकह की हत्या की और उसके स्थान पर राज्य किया।",
          "source": "acai"
        }
      ],
      "preferred_label": "एला"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Nna Hoshea, onye gburu Peka, eze alaeze ugwu Izrel, wee chịa nʼọnọdụ ya.",
          "source": "acai"
        }
      ],
      "preferred_label": "Elaa"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Ayah Hosea, yang berkomplot membunuh Pekah, raja kerajaan utara Israel, dan memerintah menggantikannya.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ela"
    },
    "nep": {
      "descriptions": [
        {
          "description": "होशियाका पिता, जसले इस्राएलको उत्तरी राज्यका राजा पेकहको हत्या गरे र तिनको ठाउँमा राज्य गरे।",
          "source": "acai"
        }
      ],
      "preferred_label": "एलाह"
    },
    "por": {
      "descriptions": [
        {
          "description": "Pai de Oseias, que assassinou Peca, rei do reino do norte de Israel, e reinou em seu lugar.",
          "source": "acai"
        }
      ],
      "preferred_label": "Elá"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Отец Осии, который составил заговор против Факея, царя северного царства Израиль, убил его и воцарился вместо него.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ила"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Padre de Oseas, quien asesinó a Pécaj, rey del reino del norte de Israel, y reinó en su lugar.",
          "source": "acai"
        }
      ],
      "preferred_label": "Elá"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Baba yake Hoshea, aliyemuua Peka, mfalme wa ufalme wa kaskazini wa Israeli, na kutawala mahali pake.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ela"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Papa bilong Hosea, husat i bin kilim Peka, king bilong hap not kingdom bilong Israel, i dai na kisim ples bilong en na kamap king.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ela"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Cha của Ô-sê, người đã ám sát Phê-ca, vua vương quốc phía bắc Ít-ra-ên, rồi lên ngôi kế vị.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ê-la"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "何细亚的父亲。何细亚刺杀了北国以色列王比加，并篡位接替他作王。",
          "source": "acai"
        }
      ],
      "preferred_label": "以拉"
    },
    "zht": {
      "descriptions": [
        {
          "description": "何細亞的父親；何細亞刺殺了以色列北國國王比加並篡了他的位。",
          "source": "acai"
        }
      ],
      "preferred_label": "以拉"
    }
