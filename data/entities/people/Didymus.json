        {
          "description": "ديديموس، المعروف كمان باسم توما أو التوأم، كان رسول عاش في أزمنة العهد الجديد.",
          "source": "acai"
        }
      ],
      "preferred_label": "ديديموس (توما)"
    },
    "arb": {
      "descriptions": [
        {
          "description": "ديديموس، المعروف أيضًا بتوما أو التوأم، كان رسولًا عاش في زمن العهد الجديد.",
          "source": "acai"
        }
      ],
      "preferred_label": "دِيدِيمُوس (تومَا)"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Didimus, we oli kolem hem tu Tomas o Twin, hem i wan aposol we i laef long taem blong Niu Testeman.",
          "source": "acai"
        }
      ],
      "preferred_label": "Didimus (Tomas)"
    },
    "eng": {
      "alternate_labels": [
        "Twin",
        "Thomas"
      ],
      "descriptions": [
        {
          "article": "person:Didymus",
          "description": "Didymus, also known as Thomas or the Twin, was an apostle living during the New Testament times.",
          "gloss": "Thomas",
          "source": "acai"
        }
      ],
      "preferred_label": "Didymus (Thomas)"
    },
    "fas": {
      "descriptions": [
        {
          "description": "دیدیموس، که با نام توما یا دوقلو نیز شناخته می‌شد، رسولی بود که در دوران عهد جدید زندگی می‌کرد.",
          "source": "acai"
        }
      ],
      "preferred_label": "دیدیموس (توما)"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Didyme, également connu sous le nom de Thomas ou le Jumeau, était un apôtre vivant à l'époque du Nouveau Testament.",
          "source": "acai"
        }
      ],
      "preferred_label": "Didyme (Thomas)"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Didaimus, wanda kuma aka sani da Toma ko Tagwaye, manzo ne da ya rayu a zamanin Sabon Alkawari.",
          "source": "acai"
        }
      ],
      "preferred_label": "Didaimus (Toma)"
    },
    "hin": {
      "descriptions": [
        {
          "description": "दिदुमुस, जिसे थोमा या जुड़वां भी कहा जाता है, नए नियम के समय का एक प्रेरित था।",
          "source": "acai"
        }
      ],
      "preferred_label": "दिदुमुस (थोमा)"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Didimọs, onye a makwaara dị ka Tọmọs ma ọ bụ Ejima, bụ otu onye nʼime ndị ozi biri nʼoge Ọgbụgba Ndụ Ọhụrụ.",
          "source": "acai"
        }
      ],
      "preferred_label": "Didimọs (Tọmọs)"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Didimus, yang juga dikenal sebagai Tomas atau Si Kembar, adalah seorang rasul yang hidup pada zaman Perjanjian Baru.",
          "source": "acai"
        }
      ],
      "preferred_label": "Didimus (Tomas)"
    },
    "nep": {
      "descriptions": [
        {
          "description": "थोमा वा जुम्ल्याहा भनेर पनि चिनिने दिदुमस नयाँ नियमको समयमा बाँचेका एक प्रेरित थिए ।",
          "source": "acai"
        }
      ],
      "preferred_label": "दिदुमस (थोमा)"
    },
    "por": {
      "descriptions": [
        {
          "description": "Dídimo, também conhecido como Tomé ou o Gêmeo, foi um apóstolo que viveu durante a época do Novo Testamento.",
          "source": "acai"
        }
      ],
      "preferred_label": "Dídimo (Tomé)"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Дидим, также известный как Фома или Близнец, был апостолом, жившим в новозаветные времена.",
          "source": "acai"
        }
      ],
      "preferred_label": "Дидим (Фома)"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Dídimo, también conocido como Tomás o el Gemelo, fue un apóstol que vivió durante los tiempos del Nuevo Testamento.",
          "source": "acai"
        }
      ],
      "preferred_label": "Dídimo (Tomás)"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Didimasi, anayejulikana pia kama Tomaso au Pacha, alikuwa mtume aliyeishi wakati wa Agano Jipya.",
          "source": "acai"
        }
      ],
      "preferred_label": "Didimasi (Tomaso)"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Didimus, narapela nem bilong en Tomas o Kambang, em i bin wanpela apositol i stap long taim bilong Nupela Testamen.",
          "source": "acai"
        }
      ],
      "preferred_label": "Didimus (Tomas)"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Đi-đim, cũng được gọi là Thô-ma hay Song Sinh, là một sứ đồ sống trong thời Tân Ước.",
          "source": "acai"
        }
      ],
      "preferred_label": "Đi-đim (Thô-ma)"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "又名多马或“双胞胎”，是生活在新约时期的使徒。",
          "source": "acai"
        }
      ],
      "preferred_label": "低土马 (多马)"
    },
    "zht": {
      "descriptions": [
        {
          "description": "又名多馬或「雙生子」，是生活在新約時期的使徒。",
          "source": "acai"
        }
      ],
      "preferred_label": "低土馬（多馬）"
    }
