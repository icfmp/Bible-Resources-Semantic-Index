  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "راجل من زمن المملكة المنقسمة، أبو حموطل ومذكور في ملوك التاني 23: 31.",
          "source": "acai"
        }
      ],
      "preferred_label": "إرميا"
    },
    "arb": {
      "descriptions": [
        {
          "description": "رَجُلٌ مِنْ عَصْرِ ٱلْمَمْلَكَةِ ٱلْمُنْقَسِمَةِ، أَبُو حَمُوطَلَ، وَذُكِرَ فِي مُلُوكِ ٱلثَّانِي 23: 31.",
          "source": "acai"
        }
      ],
      "preferred_label": "إِرْمِيَا"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan man long taem we kingdom i seraot, papa blong Hamutal mo Baebol i tokbaot hem long 2 King 23:31.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jeremaea"
    },
    "eng": {
      "descriptions": [
