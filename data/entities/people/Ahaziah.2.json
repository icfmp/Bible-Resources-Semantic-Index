  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "ملك في مملكة يهوذا الجنوبية، وهو كان ولد يهورام وعثليا.",
          "source": "acai"
        }
      ],
      "preferred_label": "أخزيا (ولد يهورام)"
    },
    "arb": {
      "descriptions": [
        {
          "description": "مَلِكٌ مِنَ ٱلْمَمْلَكَةِ ٱلْجَنُوبِيَّةِ (يَهُوذَا)، وَهُوَ ٱبْنُ يَهُورَامَ وَعَثَلْيَا.",
          "source": "acai"
        }
      ],
      "preferred_label": "أَخَزْيَا (ابن يهورام)"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan king blong saot kingdom blong Juda. Hem i pikinini boe blong Jehoram mo Atalia.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ahasia (Pikinini boe blong Jehoram)"
    },
    "eng": {
      "alternate_labels": [
        "Jehoahaz",
        "Azariah"
      ],
      "descriptions": [
        {
          "article": "person:Ahaziah.2",
          "description": "A king of the southern kingdom of Judah. He was the son  of Jehoram and Athaliah.",
          "gloss": "Ahaziah (Son of Jehoram)",
          "source": "acai"
        }
      ],
      "preferred_label": "Ahaziah (Son of Jehoram)"
    },
    "fas": {
      "descriptions": [
        {
          "description": "پادشاهی از پادشاهی جنوبی یهودا. او پسر یهورام و عتلیا بود.",
          "source": "acai"
        }
      ],
      "preferred_label": "اخزیا (پسر یهورام)"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Roi du royaume du sud, Juda. Il était fils de Joram et d'Athalie.",
          "source": "acai"
        }
      ],
      "preferred_label": "Achazia (fils de Joram)"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Sarkin masarautar kudu ta Yahuda. Shi ɗan Yoram da Ataliya ne.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ahaziya (Ɗan Yoram)"
    },
    "hin": {
      "descriptions": [
        {
          "description": "यहूदा के दक्षिणी राज्य का एक राजा। वह यहोराम और अतल्याह का पुत्र था।",
          "source": "acai"
        }
      ],
      "preferred_label": "अहज्याह (यहोराम का पुत्र)"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Eze nke alaeze ndịda nke Juda. Ọ bụ nwa Jehoram na Atalaya.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ahazaya (Nwa Jehoram)"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Seorang raja dari kerajaan selatan Yehuda. Ia adalah anak Yoram dan Atalya.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ahazia (Anak Yoram)"
    },
    "nep": {
      "descriptions": [
        {
          "description": "यहूदाको दक्षिणी राज्यका एक राजा। तिनी यहोराम र अतल्याहका छोरा थिए।",
          "source": "acai"
        }
      ],
      "preferred_label": "अहज्याह (यहोरामका छोरा)"
    },
    "por": {
      "descriptions": [
        {
          "description": "Um rei do reino do sul, Judá. Ele era filho de Jeorão e Atalia.",
          "source": "acai"
        }
      ],
      "preferred_label": "Acazias (filho de Jeorão)"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Царь южного царства Иудеи, сын Иорама и Афалии.",
          "source": "acai"
        }
      ],
      "preferred_label": "Охозия (сын Иорама)"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Rey del reino del sur, Judá. Era hijo de Joram y Athalía.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ocozías (hijo de Joram)"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mfalme wa ufalme wa kusini wa Yuda. Alikuwa mwana wa Yehoramu na Athalia.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ahazia (Mwana wa Yehoramu)"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela king bilong sauten kingdom Juda. Em i pikinini man bilong Jehoram na Atalia.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ahasia (Pikinini man bilong Jehoram)"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một vị vua của vương quốc phía nam Giu-đa. Vua là con trai của Giô-ram và A-tha-li.",
          "source": "acai"
        }
      ],
      "preferred_label": "A-cha-xia (con của Giô-ram)"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "南国犹大的一位王，是约兰和亚他利雅的儿子。",
          "source": "acai"
        }
      ],
      "preferred_label": "亚哈谢 (约兰之子)"
    },
    "zht": {
      "descriptions": [
        {
          "description": "猶大南國的一位國王，是約蘭和亞她利雅的兒子。",
          "source": "acai"
        }
      ],
      "preferred_label": "亞哈謝 (約蘭的兒子)"
    }
  },
