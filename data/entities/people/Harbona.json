  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "حربونا، خصي في قصر الملك أحشويروش ملك فارس، مذكور في أستير 1: 10.",
          "source": "acai"
        }
      ],
      "preferred_label": "حربونا"
    },
    "arb": {
      "descriptions": [
        {
          "description": "حَرْبُونَا، خَصِيٌّ فِي بَلَاطِ ٱلْمَلِكِ أَحَشْوِيرُوشَ مَلِكِ فَارِسَ، ذُكِرَ فِي أَسْتِيرَ 1: 10.",
          "source": "acai"
        }
      ],
      "preferred_label": "حَرْبُونَا"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Habona, wan eunuk long haos blong King Ahasuerus blong Pesia, we Esta 1:10 i tokbaot hem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Habona"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Harbona",
          "description": "Harbona, a eunuch in the court of King Ahasuerus of Persia, mentioned in Esther 1:10.",
          "gloss": "Harbona",
          "source": "acai"
        }
      ],
      "preferred_label": "Harbona"
    },
    "fas": {
      "descriptions": [
        {
          "description": "حربونا، خواجه‌سرایی در دربار اخشورش، پادشاه فارس، که در استر ۱:۱۰ ذکر شده است.",
          "source": "acai"
        }
      ],
      "preferred_label": "حربونا"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Harbona, eunuque à la cour du roi Assuérus de Perse, mentionné dans Esther 1:10.",
          "source": "acai"
        }
      ],
      "preferred_label": "Harbona"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Harbona, wani bābā a fadar Sarki Ahaswerus na Farisa, wanda aka ambata a Esther 1:10.",
          "source": "acai"
        }
      ],
      "preferred_label": "Harbona"
    },
    "hin": {
      "descriptions": [
        {
          "description": "हर्बोना, फारस के राजा क्षयर्ष के दरबार में एक खोजा, जिसका उल्लेख एस्तेर 1:10 में है।",
          "source": "acai"
        }
      ],
      "preferred_label": "हर्बोना"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Habona, onye onozi nʼụlọ eze Ahasuerọs (Sekses) nke Peasia, nke a kpọtụrụ aha nʼakwụkwọ Esta 1:10.",
          "source": "acai"
        }
      ],
      "preferred_label": "Habona"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Harbona, seorang sida-sida di istana Raja Ahasyweros dari Persia, yang disebutkan dalam Ester 1:10.",
          "source": "acai"
        }
      ],
      "preferred_label": "Harbona"
    },
    "nep": {
      "descriptions": [
        {
          "description": "पर्सियाका राजा अहासूएरूसको दरबारका एक नपुंसक (अधिकारी), जसको उल्लेख एस्तर १:१० मा गरिएको छ।",
          "source": "acai"
        }
      ],
      "preferred_label": "हर्बोना"
    },
    "por": {
      "descriptions": [
        {
          "description": "Harbona, um eunuco na corte do rei Assuero da Pérsia, mencionado em Ester 1:10.",
          "source": "acai"
        }
      ],
      "preferred_label": "Harbona"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Харбона, евнух при дворе царя Артаксеркса в Персии, упомянутый в Есфирь 1:10.",
          "source": "acai"
        }
      ],
      "preferred_label": "Харбона"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Harbona, eunuco en la corte del rey Asuero de Persia, mencionado en Ester 1:10.",
          "source": "acai"
        }
      ],
      "preferred_label": "Harbona"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Harbona, towashi katika makao ya kifalme ya Mfalme Ahasuero wa Uajemi, anayetajwa katika Esta 1:10.",
          "source": "acai"
        }
      ],
      "preferred_label": "Harbona"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Harbona, wanpela wokman i no gat kakaruk bilong haus king bilong King Ahasuerus bilong Pesia, em Esta 1:10 i stori long em.",
          "source": "acai"
        }
      ],
      "preferred_label": "Harbona"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Hạc-bô-na, một thái giám trong triều đình của Vua A-suê-ru nước Ba Tư, được đề cập trong Ê-xơ-tê 1:10.",
          "source": "acai"
        }
      ],
      "preferred_label": "Hạc-bô-na"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "哈波拿，波斯王亚哈随鲁宫中的一名太监，见于以斯帖记1:10。",
          "source": "acai"
        }
      ],
      "preferred_label": "哈波拿"
    },
    "zht": {
      "descriptions": [
        {
          "description": "哈波拿，波斯王亞哈隨魯宮中的一名太監，見於以斯帖記 1:10。",
          "source": "acai"
        }
      ],
      "preferred_label": "哈波拿"
