      "descriptions": [
        {
          "description": "يهوذا، ولد يعقوب المذكور أول مرة في تكوين 29: 35، أسس سبط يهوذا وعاش في زمن الآباء.",
          "source": "acai"
        }
      ],
      "preferred_label": "داود (يهوذا)"
    },
    "arb": {
      "descriptions": [
        {
          "description": "يهوذا، ابن يعقوب المذكور لأول مرة في تكوين 29: 35، أسس سبط يهوذا وعاش في عصر الآباء.",
          "source": "acai"
        }
      ],
      "preferred_label": "داود (يهوذا)"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Juda, we i boe blong Jekob we Jenesis 29:35 i tokbaot hem fastaem, hem i stamba blong traeb blong Juda mo i laef long taem blong ol patriak.",
          "source": "acai"
        }
      ],
      "preferred_label": "Deved (Juda)"
    },
    "eng": {
      "alternate_labels": [
        "Judah"
      ],
      "descriptions": [
        {
          "article": "person:David.2",
          "description": "Judah, Jacob's son first mentioned in Genesis 29:35, founded the tribe of Judah and lived during the time of the patriarchs.",
          "gloss": "Judah",
          "source": "acai"
        }
      ],
      "preferred_label": "David (Judah)"
    },
    "fas": {
      "descriptions": [
        {
          "description": "یهودا، پسر یعقوب که نخستین بار در پیدایش ۲۹:۳۵ ذکر شده است، سبط یهودا را پایه‌گذاری کرد و در دوران پاتریارک‌ها زندگی می‌کرد.",
          "source": "acai"
        }
      ],
      "preferred_label": "داوود (یهودا)"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Juda, fils de Jacob mentionné pour la première fois dans la Genèse 29.35, a fondé la tribu de Juda et a vécu à l'époque des patriarches.",
          "source": "acai"
        }
      ],
      "preferred_label": "David (Juda)"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Yahuda, ɗan Yaƙub da aka fara ambata a Farawa 29:35, ya kafa ƙabilar Yahuda kuma ya rayu a zamanin kakanni.",
          "source": "acai"
        }
      ],
      "preferred_label": "Dawuda (Yahuda)"
    },
    "hin": {
      "descriptions": [
        {
          "description": "उत्पत्ति 29:35 में पहली बार उल्लिखित याकूब का पुत्र यहूदा, यहूदा के गोत्र का पूर्वज था और कुलपिताओं के समय में रहता था।",
          "source": "acai"
        }
      ],
      "preferred_label": "दाऊद (यहूदा)"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Juda, nwa Jekọb nke e bu ụzọ kpọtụrụ aha na Jenesis 29:35, hiwere ebo Juda ma bie nʼoge ndị nna ochie.",
          "source": "acai"
        }
      ],
      "preferred_label": "Devid (Juda)"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Yehuda, anak Yakub yang pertama kali disebutkan dalam Kejadian 29:35, mendirikan suku Yehuda dan hidup pada masa para bapa leluhur.",
          "source": "acai"
        }
      ],
      "preferred_label": "Daud (Yehuda)"
    },
    "nep": {
      "descriptions": [
        {
          "description": "उत्पत्ति २९:३५ मा पहिलो पटक उल्लेख गरिएका याकूबका छोरा यहूदाले यहूदा कुलको स्थापना गरे र कुलपिताहरूको समयमा बाँचेका थिए।",
          "source": "acai"
        }
      ],
      "preferred_label": "दाऊद (यहूदा)"
    },
    "por": {
      "descriptions": [
        {
          "description": "Judá, filho de Jacó mencionado pela primeira vez em Gênesis 29:35, fundou a tribo de Judá e viveu durante a época dos patriarcas.",
          "source": "acai"
        }
      ],
      "preferred_label": "Davi (Judá)"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Иуда, сын Иакова, впервые упомянутый в Бытии 29:35, основал колено Иуды и жил в эпоху патриархов.",
          "source": "acai"
        }
      ],
      "preferred_label": "Давид (Иуда)"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Judá, hijo de Jacob mencionado por primera vez en Génesis 29:35, fundó la tribu de Judá y vivió durante la época de los patriarcas.",
          "source": "acai"
        }
      ],
      "preferred_label": "David (Judá)"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Yuda, mwana wa Yakobo anayetajwa kwa mara ya kwanza katika Mwanzo 29:35, alianzisha kabila la Yuda na aliishi wakati wa wazee wa imani.",
          "source": "acai"
        }
      ],
      "preferred_label": "Daudi (Yuda)"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Juda, em pikinini man bilong Jekop em Baibel i stori pastaim long en long Stat 29:35, em i as bilong lain Juda na em i stap long taim bilong ol bikman tumbuna.",
          "source": "acai"
        }
      ],
      "preferred_label": "Devit (Juda)"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Giu-đa, con trai của Gia-cốp được nhắc đến lần đầu trong Sáng Thế Ký 29:35, là người sáng lập bộ tộc Giu-đa và sống trong thời kỳ các tổ phụ.",
          "source": "acai"
        }
      ],
      "preferred_label": "Đa-vít (Giu-đa)"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "犹大是雅各的儿子，在创世记29:35中首次被提及，建立了犹大支派，生活在先祖时期。",
          "source": "acai"
        }
      ],
      "preferred_label": "大卫 (犹大)"
    },
    "zht": {
      "descriptions": [
        {
