        {
          "description": "قائد مية (قائد بتاع 100 راجل) مشارك في نص كتابي.",
          "source": "acai"
        }
      ],
      "preferred_label": "قائد مية"
    },
    "arb": {
      "descriptions": [
        {
          "description": "قائِدُ مِئَةٍ (قائِدُ 100 رَجُلٍ) وَرَدَ ذِكْرُهُ فِي سِياقٍ كِتابِيٍّ.",
          "source": "acai"
        }
      ],
      "preferred_label": "قائِدُ مِئَةٍ"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan kapten blong ol soldia (komanda blong 100 soldia) we i stap insaed long wan vas.",
          "source": "acai"
        }
      ],
      "preferred_label": "Wan kapten"
    },
