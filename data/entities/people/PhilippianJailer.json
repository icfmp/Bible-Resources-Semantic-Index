        }
      ],
      "preferred_label": "फिलिप्पी का दरोगा"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Onye nche ụlọ mkpọrọ dị na Filipaị nke chebere Pọl na Saịlas.",
