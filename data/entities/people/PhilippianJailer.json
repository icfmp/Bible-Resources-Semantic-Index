          "description": "سجان في فيلبي كان يحرس بولس وسيلا.",
          "source": "acai"
        }
      ],
      "preferred_label": "سجان فيلبي"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan man blong lukaot long kalabus long Filipae we i lukaot long Pol mo Silas.",
          "source": "acai"
        }
      ],
      "preferred_label": "Man blong lukaot long kalabus long Filipae"
    },
    "eng": {
      "descriptions": [
        {
          "description": "A jailer in Philippi who guarded Paul and Silas.",
          "gloss": "Philippian Jailer",
          "source": "acai"
        }
      ],
      "preferred_label": "Philippian Jailer"
    },
    "fas": {
      "descriptions": [
        {
          "description": "زندان‌بانی در فیلیپی که از پولس و سیلاس محافظت می‌کرد.",
          "source": "acai"
        }
      ],
      "preferred_label": "زندان‌بان فیلیپی"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Geôlier à Philippes qui gardait Paul et Silas.",
