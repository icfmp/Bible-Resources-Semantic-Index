        }
      ],
      "preferred_label": "Kepala Penjara Filipi"
    },
    "nep": {
      "descriptions": [
        {
          "description": "फिलिप्पीका एक कारागारपाल जसले पावल र सीलासलाई पहरा दिएका थिए।",
          "source": "acai"
        }
