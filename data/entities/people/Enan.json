          "gloss": "Enan",
          "source": "acai"
        }
      ],
      "preferred_label": "Enan"
    },
    "fas": {
      "descriptions": [
        {
          "description": "پدر اخیرع، که در دوران سرگردانی بنی‌اسرائیل در بیابان، رئیس قبیله نفتالی بود.",
          "source": "acai"
        }
      ],
      "preferred_label": "عینان"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Père d’Ahira, qui était chef de la tribu de Nephthali à l’époque des pérégrinations des Israélites dans le désert.",
          "source": "acai"
        }
      ],
      "preferred_label": "Énan"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Uban Ahira, wanda shi ne shugaban kabilar Naftali a zamanin da Isra’ilawa suke yawo a cikin daji.",
          "source": "acai"
        }
      ],
      "preferred_label": "Enan"
    },
    "hin": {
      "descriptions": [
        {
          "description": "अहीरा का पिता, जो इस्राएलियों के जंगल में भटकने के समय नप्ताली के गोत्र का प्रधान था।",
          "source": "acai"
        }
      ],
      "preferred_label": "एनान"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Nna Ahira, onye bụ onye ndú ebo Naftalị nʼoge ụmụ Izrel nọ na-awagharị nʼọzara.",
          "source": "acai"
        }
      ],
      "preferred_label": "Enan"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Ayah dari Ahira, yang merupakan pemimpin suku Naftali pada masa pengembaraan bangsa Israel di padang gurun.",
