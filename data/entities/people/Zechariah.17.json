  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "ولد برخيا ونبي في زمن رجوع بني إسرائيل من السبي. في سفر في العهد القديم متسمي باسمه.",
          "source": "acai"
        }
      ],
      "preferred_label": "زكريا"
    },
    "arb": {
      "descriptions": [
        {
          "description": "ابنُ بَرَخْيَا ونَبِيٌّ في أَثناءِ رُجوعِ الإِسرائيلِيّينَ مِنَ السَّبيِ. وسُمِّيَ سِفرٌ في العَهدِ القَديمِ بِاسمِهِ.",
          "source": "acai"
        }
      ],
      "preferred_label": "زَكَرِيَّا"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan pikinini man blong Berekia mo wan profet long taem we ol man Isrel oli aot long kalabus oli kambak. Wan buk blong Oltesteman i karem nem blong hem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sekaraea"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Zechariah.17",
          "description": "A son of Berechiah and prophet during the time of Israelite return from exile. A book of the Old Testament is named for him.",
          "gloss": "Zechariah",
          "source": "acai"
        }
      ],
      "preferred_label": "Zechariah"
    },
    "fas": {
      "descriptions": [
        {
          "description": "پسر برکیا و پیامبری در دوران بازگشت بنی‌اسرائیل از تبعید بود. یکی از کتاب‌های عهد عتیق به نام او نام‌گذاری شده است.",
          "source": "acai"
        }
      ],
      "preferred_label": "زکریا"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Fils de Bérékia et prophète à l'époque du retour d'exil des Israélites. Un livre de l'Ancien Testament porte son nom.",
          "source": "acai"
        }
      ],
      "preferred_label": "Zacharie"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Ɗan Berekiya kuma annabi a lokacin da Isra’ilawa suka dawo daga zaman bauta. An sa wa wani littafi na Tsohon Alkawari sunansa.",
          "source": "acai"
        }
      ],
      "preferred_label": "Zakariya"
    },
    "hin": {
      "descriptions": [
        {
          "description": "बेरेक्याह का एक पुत्र और इस्राएलियों के बंधुआई से लौटने के समय का एक भविष्यद्वक्ता। पुराने नियम की एक पुस्तक का नाम उसके नाम पर रखा गया है।",
          "source": "acai"
        }
      ],
      "preferred_label": "जकर्याह"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Nwa Berekaya na onye amụma nʼoge ndị Izrel si na nchụpụ lọta. A gụrụ otu akwụkwọ nʼỌgbụgba Ndụ Ochie aha ya.",
          "source": "acai"
        }
      ],
      "preferred_label": "Zekaraya"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Anak Berekhya dan seorang nabi pada masa orang Israel kembali dari pembuangan. Sebuah kitab dalam Perjanjian Lama dinamai menurut namanya.",
          "source": "acai"
        }
      ],
      "preferred_label": "Zakharia"
    },
    "nep": {
      "descriptions": [
        {
          "description": "निर्वासनबाट इस्राएलीहरूको फिर्तीको समयका बेरेक्याहका छोरा र अगमवक्ता। पुरानो नियमको एउटा पुस्तकको नाम उनको नामबाट राखिएको छ।",
          "source": "acai"
        }
      ],
      "preferred_label": "जकरिया"
    },
    "por": {
      "descriptions": [
        {
          "description": "Filho de Berequias e profeta na época do retorno dos israelitas do exílio. Um livro do Antigo Testamento leva o seu nome.",
          "source": "acai"
        }
      ],
      "preferred_label": "Zacarias"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Сын Варахии и пророк во времена возвращения израильтян из плена. Его именем названа одна из книг Ветхого Завета.",
          "source": "acai"
        }
      ],
      "preferred_label": "Захария"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Hijo de Berequías y profeta durante la época del regreso de los israelitas del exilio. Un libro del Antiguo Testamento lleva su nombre.",
          "source": "acai"
        }
      ],
      "preferred_label": "Zacarías"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mwana wa Berekia na nabii wakati wa Waisraeli kurudi kutoka uhamishoni. Kitabu cha Agano la Kale kimepewa jina lake.",
          "source": "acai"
        }
      ],
      "preferred_label": "Zekaria"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Pikinini man bilong Berekia na profet long taim ol Israel i lusim kalabus na i kam bek. Wanpela buk bilong Olpela Testamen i kisim nem bilong em.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sekaraia"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Con trai của Bê-rê-kia và là nhà tiên tri trong thời kỳ dân Y-sơ-ra-ên trở về sau cuộc lưu đày. Một sách trong Cựu Ước được đặt theo tên ông.",
          "source": "acai"
        }
      ],
      "preferred_label": "Xa-cha-ri"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "比利家的儿子，以色列人被掳归回时期的先知。旧约的一卷书以他的名字命名。",
          "source": "acai"
        }
      ],
      "preferred_label": "撒迦利亚"
    },
    "zht": {
      "descriptions": [
        {
          "description": "比利家的兒子，以色列人被擄歸回時期的先知。舊約聖經的一卷書以他命名。",
          "source": "acai"
        }
      ],
      "preferred_label": "撒迦利亞"
    }
  },
