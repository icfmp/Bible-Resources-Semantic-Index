        }
      ],
      "preferred_label": "Nimrod"
    },
    "hin": {
      "descriptions": [
        {
          "description": "निम्रोद एक पराक्रमी शिकारी और शासक था, जिसे पृथ्वी पर पहला महान वीर बताया गया है।",
          "source": "acai"
        }
      ],
      "preferred_label": "निम्रोद"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Nimrọd bụ dike nʼịchụ nta na onye na-achị achị, onye a kọwara dị ka dike mbụ nʼụwa.",
