  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "نمرود كان صياد جبار وحاكم، ووصوف بأنه أول جبار في الأرض.",
          "source": "acai"
        }
      ],
      "preferred_label": "نمرود"
    },
    "arb": {
      "descriptions": [
        {
          "description": "نِمْرُودُ كَانَ جَبَّارَ صَيْدٍ وَحَاكِمًا، وَوُصِفَ بِأَنَّهُ ٱبْتَدَأَ يَكُونُ جَبَّارًا فِي ٱلْأَرْضِ.",
          "source": "acai"
        }
      ],
      "preferred_label": "نِمْرُود"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Nimrod hem i bin wan strong man blong lukaot anamol mo wan rula, we oli tokbaot hem olsem fas nambawan man blong faet long wol.",
          "source": "acai"
        }
      ],
      "preferred_label": "Nimrod"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Nimrod",
          "description": "Nimrod was a mighty hunter and ruler, described as the first great warrior on earth.",
          "gloss": "Nimrod",
          "source": "acai"
        }
      ],
      "preferred_label": "Nimrod"
    },
    "fas": {
      "descriptions": [
        {
          "description": "نمرود صیادی نیرومند و حکمرانی بود که به عنوان نخستین دلاور روی زمین توصیف شده است.",
          "source": "acai"
        }
      ],
      "preferred_label": "نمرود"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Nimrod était un puissant chasseur et souverain, décrit comme le premier héros sur la terre.",
          "source": "acai"
        }
      ],
      "preferred_label": "Nimrod"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Nimrod babban maharbi ne kuma mai mulki, wanda aka kwatanta a matsayin babban jarumin yaƙi na farko a duniya.",
