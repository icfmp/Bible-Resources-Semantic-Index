  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "راجل من فترة المملكة المنقسمة، ولد ركاب وجد الركابيين، ومذكور في ملوك التاني 10: 15.",
          "source": "acai"
        }
      ],
      "preferred_label": "يهوناداب (يوناداب)"
    },
    "arb": {
      "descriptions": [
        {
          "description": "رَجُلٌ مِنْ فَتْرَةِ المَمْلَكَةِ المُنْقَسِمَة، وهو ابنُ رَكَابٍ وجَدُّ الرَّكابِيِّينَ، ذُكِرَ في ملوك الثاني 10: 15.",
          "source": "acai"
        }
      ],
      "preferred_label": "يَهُونَادَاب (يونَادَاب)"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan man long taem we kingdom i seraot, pikinini boe blong Rekab, mo olfala bubu blong ol Rekabaet, we 2 King 10:15 i tokbaot hem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jehonadab (Jonadab)"
    },
    "eng": {
      "alternate_labels": [
        "Jonadab"
      ],
      "descriptions": [
        {
          "article": "person:Jehonadab",
          "description": "A man from the divided kingdom period, son of Rechab, and ancestor of the Rechabites, mentioned in 2 Kings 10:15.",
          "gloss": "Jonadab",
          "source": "acai"
        }
      ],
      "preferred_label": "Jehonadab (Jonadab)"
    },
    "fas": {
      "descriptions": [
        {
          "description": "مردی در دوران پادشاهی تقسیم‌شده، پسر رکاب، و جد رکابیان، ذکر شده در دوم پادشاهان ۱۰:۱۵.",
          "source": "acai"
        }
      ],
      "preferred_label": "یهوناداب (یوناتان)"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Homme de l'époque du royaume divisé, fils de Récab et ancêtre des Récabites, mentionné dans 2 Rois 10.15.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jonadab"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani mutum a lokacin rabuwar mulki, ɗan Rekab, kuma kakan Rekabawa, wanda aka ambata a 2 Sarakuna 10:15.",
          "source": "acai"
        }
      ],
      "preferred_label": "Yehonadab (Yonadab)"
    },
    "hin": {
      "descriptions": [
        {
          "description": "विभाजित राज्य काल का एक पुरुष, रेकाब का पुत्र, और रेकाबियों का पूर्वज, जिसका उल्लेख 2 राजा 10:15 में है।",
          "source": "acai"
        }
      ],
      "preferred_label": "यहोनादाब (योनादाब)"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Nwoke si n'oge alaeze kewara ekewa, nwa nwoke Rekab, na nna nna ndị Rekab, nke a kpọtụrụ aha na 2 Ndị Eze 10:15.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jehonadab (Jonadab)"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Seorang pria dari zaman kerajaan terpecah, anak Rekhab, dan leluhur orang Rekhab, disebutkan dalam 2 Raja-raja 10:15.",
          "source": "acai"
        }
      ],
      "preferred_label": "Yonadab (Yonadab)"
    },
    "nep": {
      "descriptions": [
        {
          "description": "विभाजित राज्य कालका एक व्यक्ति, रेकाबका छोरा र रेकाबीहरूका पूर्वज, जसको उल्लेख २ राजा १०:१५ मा गरिएको छ।",
          "source": "acai"
        }
      ],
      "preferred_label": "यहोनादाब (योनादाब)"
    },
    "por": {
      "descriptions": [
        {
          "description": "Um homem do período do reino dividido, filho de Recabe e antepassado dos recabitas, mencionado em 2 Reis 10:15.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jonadabe (Jonadabe)"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Человек периода разделенного царства, сын Рихава и предок рехавитов; упоминается в 4 Царств 10:15.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ионадав (Ионадав)"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Hombre del período del reino dividido, hijo de Recab y antepasado de los recabitas, mencionado en 2 Reyes 10:15.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jonadab (Jonadab)"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mtu aliyeishi wakati wa ufalme uliogawanyika, mwana wa Rekabu, na babu wa Warekabu, anayetajwa katika 2 Wafalme 10:15.",
          "source": "acai"
        }
      ],
      "preferred_label": "Yehonadabu (Yonadabu)"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela man long taim bilong kingdom i brukbruk, pikinini man bilong Rekap, na tumbuna papa bilong ol Rekap, em 2 King 10:15 i stori long en.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jehonadap (Jonadap)"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một người sống vào thời kỳ vương quốc phân chia, con trai của Rê-cáp, và là tổ phụ của người Rê-cáp, được đề cập trong 2 Các Vua 10:15.",
          "source": "acai"
        }
      ],
      "preferred_label": "Giê-hô-na-đáp (Giô-na-đáp)"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "王国分裂时期的人物，利甲的儿子，利甲族的先祖，见于列王纪下10:15。",
          "source": "acai"
        }
      ],
      "preferred_label": "约拿达 (约拿达)"
    },
    "zht": {
      "descriptions": [
        {
          "description": "分裂王國時期的人物，利甲的兒子，利甲族的先祖，記載於列王紀下 10:15。",
          "source": "acai"
        }
      ],
      "preferred_label": "約拿達"
    }
  },
