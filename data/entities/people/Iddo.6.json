          "source": "acai"
        }
      ],
      "preferred_label": "Iddo"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Babu yake nabii Zekaria na baba yake Berekia aliyeishi wakati wa uhamisho na kurudi kwa Waisraeli.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ido"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Tumbuna papa bilong profet Sekaraia na papa bilong Berekia, em i bin stap long taim ol Israel i stap kalabus na taim ol i go bek long graun bilong ol.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ido"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Ông nội của nhà tiên tri Xa-cha-ri và là cha của Bê-rê-kia, sống vào thời kỳ dân Y-sơ-ra-ên bị lưu đày và hồi hương.",
          "source": "acai"
        }
      ],
      "preferred_label": "Y-đô"
    },
    "zhs": {
