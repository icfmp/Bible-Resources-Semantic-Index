        }
      ],
      "preferred_label": "Ido"
    },
    "nep": {
      "descriptions": [
        {
          "description": "जकरिया अगमवक्ताका हजुरबुबा र बेरेक्याहका पिता, जो इस्राएलीहरूको निर्वासन र फिर्तीको समयमा बाँचेका थिए।",
          "source": "acai"
        }
      ],
      "preferred_label": "इद्दो"
    },
    "por": {
      "descriptions": [
