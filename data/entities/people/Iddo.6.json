        {
          "description": "جد زكريا النبي وأبو بركيا، عاش في زمن السبي والرجوع.",
          "source": "acai"
        }
      ],
      "preferred_label": "عدو"
    },
    "arb": {
      "descriptions": [
        {
          "description": "جدّ زكريا النبي وأبو برخيا، عاش في زمن سبي إسرائيل والرجوع منه.",
          "source": "acai"
        }
      ],
      "preferred_label": "عِدُّو"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Bubu man blong Profet Sekaraea mo papa blong Berekia, we i laef long taem we ol man Isrel oli aot long kalabus mo oli kambak.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ido"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Iddo.6",
          "description": "Grandfather of Zechariah the prophet and father of Berechiah who lived during the time of Israelite exile and return.",
          "gloss": "Iddo",
          "source": "acai"
        }
      ],
      "preferred_label": "Iddo"
    },
    "fas": {
      "descriptions": [
        {
          "description": "پدربزرگ زکریای نبی و پدر برکیا که در دوران اسارت و بازگشت بنی‌اسرائیل می‌زیست.",
          "source": "acai"
        }
      ],
      "preferred_label": "عِدّو"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Grand-père du prophète Zacharie et père de Bérékia ayant vécu à l’époque de l’exil et du retour des Israélites.",
          "source": "acai"
        }
      ],
      "preferred_label": "Iddo"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Kakan annabi Zakariya kuma mahaifin Berekiya wanda ya rayu a zamanin bautar Isra’ilawa da dawowarsu.",
          "source": "acai"
        }
      ],
      "preferred_label": "Iddo"
    },
    "hin": {
      "descriptions": [
        {
          "description": "जकर्याह नबी का दादा और बेरेक्याह का पिता, जो इस्राएलियों के बंधुवाई और वापसी के समय रहा।",
          "source": "acai"
        }
      ],
      "preferred_label": "इद्दो"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Nna nna nke Zekaraya onye amụma na nna Berekaya, onye biri nʼoge nchụpụ na nloghachi nke ndị Izrel.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ido"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Kakek dari nabi Zakharia dan ayah Berekhya yang hidup pada masa pembuangan dan kepulangan orang Israel.",
