  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "ابن دعوئيل (أو رعوئيل) وكان رئيس قبيلة جاد أثناء تيهان بني إسرائيل في البرية.",
          "source": "acai"
        }
      ],
      "preferred_label": "إلياساف"
    },
    "arb": {
      "descriptions": [
        {
          "description": "ابْنُ دَعُوئِيلَ (أَوْ رَعُوئِيلَ) وَكَانَ رَئِيسَ سِبْطِ جَادَ أَثْنَاءَ تِيهِ بَنِي إِسْرَائِيلَ فِي الْبَرِّيَّةِ.",
          "source": "acai"
        }
      ],
      "preferred_label": "أَلِيَاسَاف"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan pikinini man blong Dehuel (o Rehuel) we hem i lida blong laen blong Gad long taem we ol man Isrel oli stap wokbaot long despet.",
          "source": "acai"
        }
      ],
      "preferred_label": "Eliasaf"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Eliasaph",
          "description": "A son of Deuel (or Reuel) who was the chief of the tribe of Gad during the wilderness wandering of the Israelites.",
          "gloss": "Eliasaph",
          "source": "acai"
        }
      ],
      "preferred_label": "Eliasaph"
    },
    "fas": {
      "descriptions": [
        {
          "description": "پسری از دعوئیل (یا رعوئیل) که رئیس سبط جاد در دوران سرگردانی بنی‌اسرائیل در بیابان بود.",
          "source": "acai"
        }
      ],
      "preferred_label": "الیاساف"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Fils de Déuel (ou Réuel), qui était le prince de la tribu de Gad pendant l'errance des Israélites dans le désert.",
          "source": "acai"
        }
      ],
      "preferred_label": "Éliasaph"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Ɗan Deyuwel (ko Reyuwel) wanda ya kasance shugaban kabilar Gad a lokacin yawo a hamada na Isra’ilawa.",
          "source": "acai"
        }
      ],
      "preferred_label": "Eliyasaf"
    },
    "hin": {
      "descriptions": [
        {
          "description": "दूएल (या रूएल) का एक पुत्र जो इस्राएलियों के जंगल में भटकने के दौरान गाद के गोत्र का प्रधान था।",
          "source": "acai"
        }
      ],
      "preferred_label": "एल्यासाप"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Nwa Deuel (maọbụ Reuel) nke bụ onyeisi ebo Gad n'oge njem ndị Izrel n'ọzara.",
          "source": "acai"
        }
      ],
      "preferred_label": "Eliasaf"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Seorang putra Rehuel (atau Deuel) yang merupakan pemimpin suku Gad selama pengembaraan bangsa Israel di padang gurun.",
          "source": "acai"
        }
      ],
      "preferred_label": "Elyasaf"
    },
    "nep": {
      "descriptions": [
        {
          "description": "दूएल (वा रूएल) का छोरा, जो इस्राएलीहरूको उजाड-स्थानको यात्राको दौडान गादका कुलका अगुवा थिए।",
          "source": "acai"
        }
      ],
      "preferred_label": "एल्यासाप"
    },
    "por": {
      "descriptions": [
        {
          "description": "Um filho de Deuel (ou Reuel) que foi o líder da tribo de Gade durante a peregrinação dos israelitas pelo deserto.",
          "source": "acai"
        }
      ],
      "preferred_label": "Eliasafe"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Сын Деуила (или Регуила), который был начальником колена Гада во время странствования израильтян по пустыне.",
          "source": "acai"
        }
      ],
      "preferred_label": "Елиасаф"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Hijo de Deuel (o Reuel) que fue jefe de la tribu de Gad durante la travesía de los israelitas por el desierto.",
          "source": "acai"
        }
      ],
      "preferred_label": "Eliasaf"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mwana wa Deueli (au Reueli) aliyekuwa kiongozi wa kabila la Gadi wakati Waisraeli walipokuwa wakitangatanga jangwani.",
          "source": "acai"
        }
      ],
      "preferred_label": "Eliasafu"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela pikinini man bilong Duel (o Reuel) em i bin i stap hetman bilong lain Gat long taim ol Israel i bin wokabaut i go nabaut long ples drai nating.",
          "source": "acai"
        }
      ],
      "preferred_label": "Eliasap"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một người con trai của Đê-u-ên (hoặc Rê-u-ên), là thủ lĩnh của chi tộc Gát trong thời kỳ dân Y-sơ-ra-ên lưu lạc trong đồng vắng.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ê-li-a-sáp"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "丢珥（或作流珥）的儿子，以色列人旷野漂泊期间迦得支派的首领。",
          "source": "acai"
        }
      ],
      "preferred_label": "以利雅萨"
    },
    "zht": {
      "descriptions": [
        {
          "description": "丟珥（或勒友珥）的兒子，以色列人漂流曠野期間迦得支派的首領。",
          "source": "acai"
        }
      ],
      "preferred_label": "以利雅薩"
    }
  },
