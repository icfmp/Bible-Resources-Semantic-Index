  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "ميخا، المعروف كمان بميخايا، كان نبي عاش في زمن المملكة المنقسمة، ومذكور أول مرة في إرميا 26: 18.",
          "source": "acai"
        }
      ],
      "preferred_label": "ميخا (إرميا 26:18)"
    },
    "arb": {
      "descriptions": [
        {
          "description": "ميخا، ويُعرف أيضاً بميخايا، كان نبياً عاش في عهد المملكة المنقسمة، ذُكر أولاً في إرميا 26: 18.",
          "source": "acai"
        }
      ],
      "preferred_label": "مِيخَا (إرميا 26:18)"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Maeka, we oli kolem tu se Mikaha, hem i wan profet we i laef long taem we kingdom i seraot, we Jeremaea 26:18 i tokbaot hem fastaem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Maeka (Jeremaea 26:18)"
    },
    "eng": {
      "alternate_labels": [
        "Micaiah"
      ],
      "descriptions": [
        {
          "article": "person:Micah.6",
          "description": "Micah, also known as Micaiah, was a prophet living during the divided kingdom, first mentioned in Jeremiah 26:18.",
          "gloss": "Micah (Jeremiah 26:18)",
          "source": "acai"
        }
      ],
      "preferred_label": "Micah (Jeremiah 26:18)"
    },
    "fas": {
      "descriptions": [
        {
          "description": "میکاه (میخا)، که به نام میکایا نیز شناخته می‌شود، پیامبری در دوران پادشاهی تقسیم‌شده بود که نخستین بار در ارمیا ۲۶:۱۸ از او یاد شده است.",
          "source": "acai"
        }
      ],
      "preferred_label": "میکاه (ارمیا 26:18)"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Michée, également connu sous le nom de Michée ou Micaiah, était un prophète vivant à l'époque du royaume divisé, mentionné pour la première fois dans Jérémie 26:18.",
          "source": "acai"
        }
      ],
      "preferred_label": "Michée (Jérémie 26.18)"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Mika, wanda kuma aka sani da Mikahiya, annabi ne da ya rayu a zamanin rarrabuwar masarauta, wanda aka fara ambata a Irmiya 26:18.",
          "source": "acai"
        }
      ],
      "preferred_label": "Mika (Irmiya 26:18)"
    },
    "hin": {
      "descriptions": [
        {
          "description": "मीका, जिसे मीकायाह भी कहा जाता है, विभाजित राज्यकाल के दौरान जीवित एक नबी था, जिसका पहला उल्लेख यिर्मयाह 26:18 में मिलता है।",
          "source": "acai"
        }
      ],
      "preferred_label": "मीका (यिर्मयाह 26:18)"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Maịka, onye a makwaara dịka Mikaya, bụ onye amụma dịrị ndụ nʼoge alaeze kewara ekewa, nke e buru ụzọ kpọtụ aha na Jeremaya 26:18.",
          "source": "acai"
        }
      ],
      "preferred_label": "Maịka (Jeremaia 26:18)"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Mikha, yang juga dikenal sebagai Mikhaya, adalah seorang nabi yang hidup pada masa kerajaan terpecah, pertama kali disebutkan dalam Yeremia 26:18.",
          "source": "acai"
        }
      ],
      "preferred_label": "Mikha (Yeremia 26:18)"
    },
    "nep": {
      "descriptions": [
        {
          "description": "मीकाया पनि भनिने मीका, विभाजित राज्यको समयमा जिउने एक अगमवक्ता थिए, जसको पहिलो उल्लेख यर्मिया २६:१८ मा गरिएको छ।",
          "source": "acai"
        }
      ],
      "preferred_label": "मीका (यर्मिया 26:18)"
    },
    "por": {
      "descriptions": [
        {
          "description": "Miqueias, também conhecido como Micaías, foi um profeta que viveu durante o reino dividido, mencionado pela primeira vez em Jeremias 26:18.",
          "source": "acai"
        }
      ],
      "preferred_label": "Miqueias (Jeremias 26:18)"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Михей, также известный как Михаия, — пророк, живший во времена разделенного царства, впервые упомянутый в Иеремии 26:18.",
          "source": "acai"
        }
      ],
      "preferred_label": "Михей (Иеремия 26:18)"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Miqueas, también conocido como Micaías, fue un profeta que vivió durante el reino dividido, mencionado por primera vez en Jeremías 26:18.",
          "source": "acai"
        }
      ],
      "preferred_label": "Miqueas (Jeremías 26:18)"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mika, anayejulikana pia kama Mikaya, alikuwa nabii aliyeishi wakati wa ufalme uliogawanyika, aliyetajwa kwa mara ya kwanza katika Yeremia 26:18.",
          "source": "acai"
        }
      ],
      "preferred_label": "Mika (Yeremia 26:18)"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Maika, em narapela nem bilong en Mikaia, em i wanpela profet i bin stap long taim kingdom i bruk nabaut, na Buk Jeremaia 26:18 i kamapim nem bilong em pastaim.",
          "source": "acai"
        }
      ],
      "preferred_label": "Maika (Jeremia 26:18)"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Mi-ca, cũng được biết đến là Mai-cai, là một nhà tiên tri sống trong thời kỳ vương quốc phân chia, lần đầu tiên được nhắc đến trong Giê-rê-mi 26:18.",
          "source": "acai"
        }
      ],
      "preferred_label": "Mi-ca (Giê-rê-mi 26:18)"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "弥迦，也称米该亚，是生活在王国分裂时期的一位先知，在耶利米书26:18中首次被提及。",
          "source": "acai"
        }
      ],
      "preferred_label": "弥迦 (耶利米书 26:18)"
    },
    "zht": {
      "descriptions": [
        {
          "description": "彌迦，又稱米該亞，是生活在王國分裂時期的一位先知，最早在耶利米書26:18中被提及。",
          "source": "acai"
        }
      ],
      "preferred_label": "彌迦 (耶利米書 26:18)"
    }
  },
