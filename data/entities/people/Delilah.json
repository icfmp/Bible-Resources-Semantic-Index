    "apd": {
      "descriptions": [
        {
          "description": "حبيبة شمشون الفلسطينية، الساعدت الفلسطينيين عشان يقبضوا عليه.",
          "source": "acai"
        }
      ],
      "preferred_label": "دليلة"
    },
    "arb": {
      "descriptions": [
        {
          "description": "حبيبة شمشون الفلسطينية، التي ساعدت الفلسطينيين في القبض عليه.",
          "source": "acai"
        }
      ],
      "preferred_label": "دَلِيلَة"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Woman blong Filistia we Samson i laekem hem tumas, we i givhan long ol man Filistia blong holem Samson.",
          "source": "acai"
        }
      ],
      "preferred_label": "Delila"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Delilah",
          "description": "Samson’s Philistine lover, who helped the Philistines capture him.",
          "gloss": "Delilah",
          "source": "acai"
        }
      ],
      "preferred_label": "Delilah"
    },
    "fas": {
      "descriptions": [
        {
          "description": "معشوقه فلسطینی سامسون، که به فلسطینیان در دستگیری او کمک کرد.",
          "source": "acai"
        }
      ],
      "preferred_label": "دلیله"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Maîtresse philistine de Samson, qui aida les Philistins à le capturer.",
          "source": "acai"
        }
      ],
      "preferred_label": "Delila"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Kwarakwarar Samson Bafulistiya, wadda ta taimaki Filistiyawa su kama shi.",
          "source": "acai"
        }
      ],
      "preferred_label": "Delila"
    },
    "hin": {
      "descriptions": [
        {
          "description": "शिमशोन की पलिश्ती प्रेमिका, जिसने पलिश्तियों को उसे पकड़वाने में सहायता की।",
          "source": "acai"
        }
      ],
      "preferred_label": "दलीला"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Onye Filistia hụrụ Samsin nʼanya, onye nyeere ndị Filistia aka ijide ya.",
          "source": "acai"
        }
      ],
      "preferred_label": "Delaịla"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Kekasih Simson dari bangsa Filistin, yang membantu orang Filistin menangkapnya.",
          "source": "acai"
        }
      ],
      "preferred_label": "Delila"
    },
    "nep": {
      "descriptions": [
        {
          "description": "शिमशोनकी पलिश्ती प्रेमी, जसले पलिश्तीहरूलाई तिनलाई पक्रन सहायता गरिन् ।",
          "source": "acai"
        }
      ],
      "preferred_label": "दलीला"
    },
    "por": {
      "descriptions": [
        {
          "description": "Amante filisteia de Sansão, que ajudou os filisteus a capturá-lo.",
          "source": "acai"
        }
      ],
      "preferred_label": "Dalila"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Возлюбленная Самсона, филистимлянка, которая помогла филистимлянам схватить его.",
          "source": "acai"
        }
      ],
      "preferred_label": "Далида"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Amante filistea de Sansón, que ayudó a los filisteos a capturarlo.",
          "source": "acai"
        }
      ],
      "preferred_label": "Dalila"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mpenzi Mfilisti wa Samsoni, aliyewasaidia Wafilisti kumkamata.",
          "source": "acai"
        }
      ],
      "preferred_label": "Delila"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Meri Filistia em Samson i bin laikim em tru, na em i bin helpim ol Filistia long kalabusim Samson.",
          "source": "acai"
        }
      ],
      "preferred_label": "Delaila"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Người tình Phi-li-tin của Sam-sôn, người đã giúp dân Phi-li-tin bắt ông.",
          "source": "acai"
        }
      ],
      "preferred_label": "Đa-li-la"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "参孙的非利士爱人，曾协助非利士人捉拿参孙。",
          "source": "acai"
        }
      ],
      "preferred_label": "大利拉"
    },
    "zht": {
      "descriptions": [
        {
          "description": "參孫的非利士情人，曾協助非利士人捉拿他。",
          "source": "acai"
        }
      ],
      "preferred_label": "大利拉"
    }
