    "apd": {
      "descriptions": [
        {
          "description": "زبدي كان أبو الرسولين يعقوب ويوحنا، وعاش في فترة العهد الجديد.",
          "source": "acai"
        }
      ],
      "preferred_label": "زبدي"
    },
    "arb": {
      "descriptions": [
        {
          "description": "زَبْدِي كَانَ وَالِدَ الرَّسُولَيْنِ يَعْقُوبَ وَيُوحَنَّا، وَعَاشَ فِي عَصْرِ الْعَهْدِ الْجَدِيدِ.",
          "source": "acai"
        }
      ],
      "preferred_label": "زَبْدِي"
    },
    "bis": {
      "descriptions": [
        {
