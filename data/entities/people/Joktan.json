        }
      ],
      "preferred_label": "Joctán"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mwana wa mzee wa ukoo Eberi, ndugu wa Pelegi, na baba wa wana wengi akiwemo: Almodadi, Shelefu, Hasarmawethi, na Yera.",
