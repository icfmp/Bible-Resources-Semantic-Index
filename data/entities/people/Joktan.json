        }
      ],
      "preferred_label": "योक्तान"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Nwa nke nna ochie bụ Eba, nwanne Pelẹg, na nna nke ọtụtụ ụmụ ndị ikom gụnyere: Almodad, Shelef, Hazamavet, na Jera.",
          "source": "acai"
        }
      ],
      "preferred_label": "Joktan"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Anak laki-laki bapa leluhur Eber, saudara laki-laki Peleg, dan ayah dari banyak anak laki-laki termasuk: Almodad, Selef, Hazar-Mawet, dan Yerah.",
          "source": "acai"
        }
      ],
      "preferred_label": "Yoktan"
    },
    "nep": {
      "descriptions": [
