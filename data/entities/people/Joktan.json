      "descriptions": [
        {
          "description": "ولد لعابر، أخو فالغ، وأبو أولاد كتيرين من بينهم ألموداد وشالف وحضرموت ويارح.",
          "source": "acai"
        }
      ],
      "preferred_label": "يقطان"
    },
    "arb": {
      "descriptions": [
        {
          "description": "ابن لعابر، وأخو فالج، وأبو أبناء كثيرين من بينهم: ألموداد وشالف وحضرموت ويارح.",
          "source": "acai"
        }
      ],
      "preferred_label": "يَقْطَان"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan pikinini boe blong patriaka Eba, brata blong Peleg, mo papa blong plante pikinini boe we i inkludum: Almodad, Selef, Hajamavet, mo Sera.",
          "source": "acai"
        }
      ],
      "preferred_label": "Joktan"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Joktan",
          "description": "A son of the patriarch Eber, brother of Peleg, and father of many sons including: Almodad, Sheleph, Hazarmaveth, and Jerah.",
          "gloss": "Joktan",
          "source": "acai"
        }
      ],
      "preferred_label": "Joktan"
    },
    "fas": {
      "descriptions": [
        {
          "description": "پسری از عابر پاتریارک، برادر فلج و پدر پسران متعدد از جمله الموداد، شالف، حضرموت و یارح.",
          "source": "acai"
        }
      ],
      "preferred_label": "یقطان"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Fils du patriarche Héber, frère de Péleg, et père de nombreux fils dont Almodad, Schéleph, Hatsarmaveth et Jérach.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jokthan"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Ɗan kakan dā Eber, ɗan'uwan Feleg, kuma mahaifin ’ya’ya maza da yawa har da: Almodad, Shelef, Hazarmawet, da Yera.",
