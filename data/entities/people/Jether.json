  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "راجل من قبيلة أشير، ولد صوفح، وبيسموه كمان يثران، مذكور في أخبار الأيام الأول 7: 37-38.",
          "source": "acai"
        }
      ],
      "preferred_label": "يثر (يثران)"
    },
    "arb": {
      "descriptions": [
        {
          "description": "رجل من سبط أشير، وهو ابن صوفَح، ويُدعى أيضًا يِثْرَان ويَفُنّة، ذُكر في أخبار الأيام الأول 7: 37-38.",
          "source": "acai"
        }
      ],
      "preferred_label": "يَثَر (يِثْرَان)"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan man blong laen blong Asa, pikinini boe blong Sofa, we oli singaot hem tu se Itran mo Jefune, we 1 Kronikel 7:37-38 i tokbaot hem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jeta (Itran)"
    },
    "eng": {
      "alternate_labels": [
        "Ithran (1 Chronicles 7:37)",
        "Jephunneh"
      ],
      "descriptions": [
        {
          "article": "person:Jether",
          "description": "A man from the tribe of Asher, son of Zophah, and also called Ithran and Jephunneh, mentioned in 1 Chronicles 7:37-38.",
          "gloss": "Ithran (1 Chronicles 7:37)",
          "source": "acai"
        }
      ],
      "preferred_label": "Jether (Ithran)"
    },
    "fas": {
      "descriptions": [
        {
          "description": "مردی از قبیلهٔ اشیر، پسر صوفح، که یتران و یفنه نیز نامیده شده و در ۱ تواریخ ۷:۳۷-۳۸ ذکر شده است.",
          "source": "acai"
        }
      ],
      "preferred_label": "یتر (یتران)"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Homme de la tribu d'Aser, fils de Tsophach, également appelé Jithran et Jephunné, mentionné dans 1 Chroniques 7.37-38.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jéther (Jithran)"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani mutum daga kabilar Asher, ɗan Zofa, wanda kuma ake kira Itran da Yefunne, da aka ambata a 1 Labarbaru 7:37-38.",
          "source": "acai"
        }
      ],
      "preferred_label": "Yeter (Itran)"
    },
    "hin": {
      "descriptions": [
        {
          "description": "आशेर के गोत्र का एक पुरुष, सोपह का पुत्र, और जिसे यित्रान भी कहा गया है, जिसका उल्लेख 1 इतिहास 7:37-38 में है।",
          "source": "acai"
        }
      ],
      "preferred_label": "येतेर (यित्रान)"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Nwoke si nʼebo Asha, nwa Zofa, nke a na-akpọkwa Itran na Jefune, nke a kpọtụrụ aha na 1 Ihe E Mere 7:37-38.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jeta (Itran)"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Seorang pria dari suku Asyer, anak Zofah, dan juga disebut Yitran dan Yefune, yang disebutkan dalam 1 Tawarikh 7:37-38.",
          "source": "acai"
        }
      ],
      "preferred_label": "Yeter (Yitran)"
    },
    "nep": {
      "descriptions": [
        {
          "description": "१ इतिहास ७:३७-३८ मा उल्लेख गरिएका आशेर कुलका एक पुरुष, जो जोपहका छोरा थिए, र जसलाई इत्रान र यपुन्ने पनि भनिएको छ।",
          "source": "acai"
        }
      ],
      "preferred_label": "येतेर (इत्रान)"
    },
    "por": {
      "descriptions": [
        {
          "description": "Um homem da tribo de Aser, filho de Zofá, também chamado de Itrã e Jefoné, mencionado em 1 Crônicas 7:37-38.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jéter (Itrã)"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Человек из колена Асира, сын Цофаха, также называемый Ифраном и Иефунни, упомянутый в 1 Паралипоменон 7:37–38.",
          "source": "acai"
        }
      ],
      "preferred_label": "Иефер (Ифран)"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Un hombre de la tribu de Aser, hijo de Sopha, también llamado Ithrán y Jephone, mencionado en 1 Crónicas 7:37-38.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jéter (Ithrán)"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mwanaume wa kabila la Asheri, mwana wa Sofa, anayeitwa pia Ithrani na Yefune, anayetajwa katika 1 Mambo ya Nyakati 7:37-38.",
          "source": "acai"
        }
      ],
      "preferred_label": "Yetheri (Ithrani)"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela man bilong traip bilong Aser, pikinini man bilong Sofa, na ol i save kolim em tu Itran na Jefune, em 1 Stori 7:37-38 i kolim nem bilong en.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jeter (Itran)"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một người thuộc bộ tộc A-se, con trai của Sô-phách, cũng được gọi là Ít-ran và Giê-phu-nê, được chép trong 1 Sử ký 7:37-38.",
          "source": "acai"
        }
      ],
      "preferred_label": "Giê-the (Ít-ran)"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "亚设支派的一名男子，琐法的儿子，又名益兰和耶孚尼，见于历代志上7:37-38。",
          "source": "acai"
        }
      ],
      "preferred_label": "益帖 (益兰)"
    },
    "zht": {
      "descriptions": [
        {
          "description": "亞設支派的一個人，瑣法的兒子，又名以特蘭和耶孚尼，見於歷代志上7:37-38。",
          "source": "acai"
        }
      ],
      "preferred_label": "益帖 (以特蘭)"
    }
  },
