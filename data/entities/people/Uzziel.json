  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "ابن البطريرك قهات وأبو ميشائيل وأليصافان وسثري وميخا ويشيا. وكان عم رئيس الكهنة هارون.",
          "source": "acai"
        }
      ],
      "preferred_label": "عُزِّيئيل"
    },
    "arb": {
      "descriptions": [
        {
          "description": "ابن رئيس الآباء قَهَات، وأبو مِيشَائِيل وأَلِيصَافَان وسِتْرِي ومِيخَا ويِشِّيَّا. وكان عم رئيس الكهنة هَارون.",
          "source": "acai"
        }
      ],
      "preferred_label": "عُزِّيئِيل"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan pikinini boe blong patriaka ya Kohat mo papa blong Misael, Elijafan, Sitri, Mika, mo Isia. Hem i wan ankel blong hae pris ya Eron.",
          "source": "acai"
        }
      ],
      "preferred_label": "Usiel"
    },
    "eng": {
      "alternate_labels": [
        "Uzzielite"
      ],
      "descriptions": [
        {
          "article": "person:Uzziel",
          "description": "A son of the patriarch Kohath and father of Mishael, Elizaphan, Sithri, Micha, Isshiah. He was uncle of the high priest Aaron.",
          "gloss": "Uzziel",
          "source": "acai"
        }
      ],
      "preferred_label": "Uzziel"
    },
    "fas": {
      "descriptions": [
        {
          "description": "پسری از قهاتِ پدرسالار و پدر میشائیل، الیصافان، ستری، میکا و یشیا. او عموی هارون کاهن اعظم بود.",
          "source": "acai"
        }
      ],
      "preferred_label": "عزی‌ئیل"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Fils du patriarche Kehath et père de Mischaël, Élitsaphan, Sithri, Mika et Isshija. Il était l'oncle du grand prêtre Aaron.",
          "source": "acai"
        }
      ],
      "preferred_label": "Uziel"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Ɗan uban iyali Kohat kuma mahaifin Mishayel, Elizafan, Sitri, Mika, da Ishiya. Shi kawun babban firist Haruna ne.",
          "source": "acai"
        }
      ],
      "preferred_label": "Uzziyel"
    },
    "hin": {
      "descriptions": [
        {
          "description": "कुलपिता कहात का एक पुत्र और मीशाएल, एलीसापान, सित्री, मीका और यिशियाह का पिता। वह महायाजक हारून का चाचा था।",
          "source": "acai"
        }
      ],
      "preferred_label": "उज्जीएल"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Nwa nna ochie bụ Kohat na nna Mishael, Elizafan, Sitri, Maịka, na Ishaya. Ọ bụ nwanne nna nnukwu onye nchụàjà bụ Erọn.",
          "source": "acai"
        }
      ],
      "preferred_label": "Uziel"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Seorang putra dari bapa leluhur Kehat dan ayah dari Misael, Elisafan, Sitri, Mikha, Yisia. Ia adalah paman dari imam besar Harun.",
          "source": "acai"
        }
      ],
      "preferred_label": "Uziel"
    },
    "nep": {
      "descriptions": [
        {
          "description": "कुलपिता कहातका छोरा तथा मीशाएल, एलसाफान, सित्री, मीका र यश्शियाहका पिता। तिनी प्रधान पूजाहारी हारूनका काका थिए।",
          "source": "acai"
        }
      ],
      "preferred_label": "उज्जीएल"
    },
    "por": {
      "descriptions": [
        {
          "description": "Filho do patriarca Coate e pai de Misael, Elzafã, Sitri, Miqueias e Issias. Ele era tio do sumo sacerdote Arão.",
          "source": "acai"
        }
      ],
      "preferred_label": "Uziel"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Сын патриарха Каафа и отец Мисаила, Елицафана, Сифри, Михи, Ишшии. Он приходился дядей первосвященнику Аарону.",
          "source": "acai"
        }
      ],
      "preferred_label": "Узиил"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Hijo del patriarca Coath y padre de Misael, Elisaphán, Zithri, Michâs e Isías. Era tío del sumo sacerdote Aarón.",
          "source": "acai"
        }
      ],
      "preferred_label": "Uziel"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mwana wa mzee wa ukoo Kohathi na baba yao Mishaeli, Elisafani, Sithri, Mika, na Ishia. Alikuwa ami yake kuhani mkuu Haruni.",
          "source": "acai"
        }
      ],
      "preferred_label": "Uzieli"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela pikinini man bilong bikpela tumbuna Kohat na papa bilong Misael, Elisafan, Sitri, Maika na Isia. Em i smolpapa bilong bikpris Aron.",
          "source": "acai"
        }
      ],
      "preferred_label": "Usiel"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Con trai của tổ phụ Kê-hát và là cha của Mi-sa-ên, Ên-sa-phan, Sít-ri, Mi-ca, Y-si-gia. Ông là chú của thầy tế lễ thượng phẩm A-rôn.",
          "source": "acai"
        }
      ],
      "preferred_label": "U-xi-ên"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "先祖哥辖的儿子，米沙利、以利撒番、西提利、弥迦和以示雅的父亲。他是大祭司亚伦的叔父。",
          "source": "acai"
        }
      ],
      "preferred_label": "乌薛"
    },
    "zht": {
      "descriptions": [
        {
          "description": "族長哥轄的兒子，米沙利、以利撒反、細提利、米迦、以西雅的父親。他是大祭司亞倫的叔父。",
          "source": "acai"
        }
      ],
      "preferred_label": "烏薛"
    }
