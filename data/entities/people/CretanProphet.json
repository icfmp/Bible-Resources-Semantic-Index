          "source": "acai"
        }
      ],
      "preferred_label": "Cretan Prophet"
    },
    "fas": {
      "descriptions": [
        {
          "description": "پیامبری اهل کریت که بعدها به عنوان اپیمنیدس شناسایی شد.",
