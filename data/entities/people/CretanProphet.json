        }
      ],
      "preferred_label": "نبي كريتي"
    },
    "arb": {
      "descriptions": [
        {
          "description": "نبي من كريت، عُرف لاحقًا بإبيمينيدس.",
          "source": "acai"
        }
      ],
      "preferred_label": "نبي كريتي"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan profet we i kamaot long Krit, we biaen oli luksave se hem i Epimenides.",
          "source": "acai"
        }
      ],
      "preferred_label": "Profet man Krit"
    },
    "eng": {
      "descriptions": [
        {
          "description": "A prophet from Crete, later identified as Epimenides.",
