  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "ملك على يهوذا في زمن المملكة المنقسمة في إسرائيل. كان ابن أمصيا من يكلية، وزوج يروشا، وأبو يوثام. وهو مذكور في سلسلة نسب يسوع.",
          "source": "acai"
        }
      ],
      "preferred_label": "عُزيا"
    },
    "arb": {
      "descriptions": [
        {
          "description": "ملك يهوذا في عهد مملكة إسرائيل المنقسمة. كان ابن أَمَصْيَا من يَكلْيَا، وزوج يَروشَا، ووالد يوثَام. وهو مذكور في نسب يسوع.",
          "source": "acai"
        }
      ],
      "preferred_label": "عُزِّيَّا"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan king blong Juda long taem we kingdom blong Isrel i seraot. Hem i pikinini man blong Amajia wetem Jekolia, hasban blong Jerusa, mo papa blong Jotam. Baebol i raetem nem blong hem long laen blong Jisas.",
          "source": "acai"
        }
      ],
      "preferred_label": "Usia"
    },
    "eng": {
      "alternate_labels": [
        "Ozias",
        "Azariah"
      ],
      "descriptions": [
        {
          "article": "person:Uzziah",
          "description": "A king of Judah during the time of the divided kingdom of Israel. He was a son of Amaziah by Jecoliah, husband of Jerusha, and father of Jotham. He is listed in the family line of Jesus.",
          "gloss": "Uzziah",
          "source": "acai"
        }
      ],
      "preferred_label": "Uzziah"
    },
    "fas": {
      "descriptions": [
        {
          "description": "پادشاه یهودا در دوران پادشاهی تقسیم‌شدهٔ اسرائیل بود. او پسر امصیا از یکلیا، همسر یروشا و پدر یوتام بود. نام او در نسب‌نامهٔ عیسی آمده است.",
          "source": "acai"
        }
      ],
      "preferred_label": "عُزیا"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Roi de Juda à l'époque du royaume divisé d'Israël. Il était le fils d'Amatsia et de Jecolia, l'époux de Jeruscha et le père de Jotham. Il figure dans la généalogie de Jésus.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ozias"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Sarkin Yahuda a lokacin rarrabuwar mulkin Isra’ila. Ɗan Amaziya ne ta wurin Yekoliya, mijin Yerusha, kuma mahaifin Yotam. An lissafa shi a cikin layin iyalin Yesu.",
          "source": "acai"
        }
      ],
      "preferred_label": "Uzziya"
    },
    "hin": {
      "descriptions": [
        {
          "description": "इस्राएल के विभाजित राज्य के समय यहूदा का एक राजा। वह यकोल्याह के द्वारा अमस्याह का पुत्र, यरूशा का पति और योताम का पिता था। वह यीशु की वंशावली में सूचीबद्ध है।",
          "source": "acai"
        }
      ],
      "preferred_label": "उज्जियाह"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Otu eze Juda n'oge alaeze Izrel kewara ekewa. Ọ bụ nwa Amazaya site n'aka Jekolaya, di Jerusha, na nna Jotam. E depụtara ya n'usoro ọmụmụ Jisọs.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ụzaya"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Raja Yehuda pada masa kerajaan Israel terpecah. Ia adalah anak dari Amazia dan Yekholya, suami dari Yerusa, dan ayah dari Yotam. Ia terdaftar dalam garis keturunan Yesus.",
          "source": "acai"
        }
      ],
      "preferred_label": "Uzia"
    },
    "nep": {
      "descriptions": [
        {
          "description": "इस्राएलको विभाजित राज्यको समयका यहूदाका एक राजा। तिनी यकोल्याहद्वारा जन्मेका अमस्याहका छोरा, यरूशाका पति र योतामका पिता थिए। तिनी येशूको वंशावलीमा सूचीकृत छन्।",
          "source": "acai"
        }
      ],
      "preferred_label": "उज्जियाह"
    },
    "por": {
      "descriptions": [
        {
          "description": "Rei de Judá durante a época do reino dividido de Israel. Ele era filho de Amazias com Jecolias, marido de Jerusa e pai de Jotão. Ele está listado na genealogia de Jesus.",
          "source": "acai"
        }
      ],
      "preferred_label": "Uzias"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Царь Иудеи в период разделенного царства Израиля. Сын Амасии от Иехолии, муж Иеруши и отец Иофама. Он числится в родословии Иисуса.",
          "source": "acai"
        }
      ],
      "preferred_label": "Озия"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Rey de Judá durante la época del reino dividido de Israel. Fue hijo de Amasías y Jecolías, esposo de Jerusa y padre de Jotam. Figura en la genealogía de Jesús.",
          "source": "acai"
        }
      ],
      "preferred_label": "Uzías"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mfalme wa Yuda wakati wa ufalme uliogawanyika wa Israeli. Alikuwa mwana wa Amazia kupitia Yekolia, mume wa Yerusha, na baba yake Yothamu. Ameorodheshwa katika ukoo wa Yesu.",
          "source": "acai"
        }
      ],
      "preferred_label": "Uzia"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela king bilong Juda long taim kantri Israel i بروken i go long tupela hap. Em i pikinini man bilong Amasia tupela Jekolia, na em i man bilong Jerusa, na papa bilong Jotam. Nem bilong en i stap long lain tumbuna bilong Jisas.",
          "source": "acai"
        }
      ],
      "preferred_label": "Usia"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một vua của Giu-đa trong thời kỳ vương quốc Y-sơ-ra-ên phân chia. Ông là con trai của A-ma-xia với Giê-cô-lia, chồng của Giê-ru-sa, và là cha của Giô-tham. Ông được liệt kê trong dòng tộc của Chúa Giê-xu.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ô-xia"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "以色列王国分裂时期的犹大王。他是亚玛谢与耶可利雅的儿子，耶路沙的丈夫，约坦的父亲。他被列在耶稣的家谱中。",
          "source": "acai"
        }
      ],
      "preferred_label": "乌西雅"
    },
    "zht": {
      "descriptions": [
        {
          "description": "以色列王國分裂時期的一位猶大王。他是亞瑪謝與耶可利雅的兒子、耶路沙的丈夫，以及約坦的父親。他被列入耶穌的家譜中。",
          "source": "acai"
        }
      ],
      "preferred_label": "烏西雅"
    }
  },
