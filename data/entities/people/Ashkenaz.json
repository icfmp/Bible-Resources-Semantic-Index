        }
      ],
      "preferred_label": "亚实基拿"
    },
    "zht": {
      "descriptions": [
        {
          "description": "族長時期的一名男子，歌篾的兒子，雅弗的後裔，載於創世記10:3。",
          "source": "acai"
        }
      ],
      "preferred_label": "亞實基拿"
