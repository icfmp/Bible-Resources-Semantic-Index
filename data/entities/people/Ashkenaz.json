          "source": "acai"
        }
      ],
      "preferred_label": "Аскеназ"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Un hombre de la época de los patriarcas, hijo de Gómer y descendiente de Jafet, mencionado en Génesis 10:3.",
          "source": "acai"
        }
      ],
      "preferred_label": "Asquenaz"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mwanamume wa wakati wa wazee wa imani, mwana wa Gomeri na mzao wa Yafethi, anayetajwa katika Mwanzo 10:3.",
