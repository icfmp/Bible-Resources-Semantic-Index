        }
      ],
      "preferred_label": "Askenas"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một người sống vào thời các tổ phụ, con trai của Gô-me và là hậu duệ của Gia-phết, được đề cập trong Sáng Thế Ký 10:3.",
