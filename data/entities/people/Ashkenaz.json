      "descriptions": [
        {
          "description": "رجل من عصر الآباء، ابن جومر ومن نسل يافث، ورد ذكره في التكوين 10: 3.",
          "source": "acai"
        }
      ],
      "preferred_label": "أَشْكَنَاز"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan man long taem blong ol fas taem, pikinini boe blong Goma mo wan laen blong Jafet, we Jenesis 10:3 i tokbaot hem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Askenas"
    },
    "eng": {
      "alternate_labels": [
        "Ashchenaz"
      ],
      "descriptions": [
        {
          "article": "person:Ashkenaz",
          "description": "A man from the time of the patriarchs, son of Gomer and descendant of Japheth, mentioned in Genesis 10:3.",
          "gloss": "Ashkenaz",
          "source": "acai"
        }
      ],
      "preferred_label": "Ashkenaz"
    },
    "fas": {
      "descriptions": [
        {
          "description": "مردی از دوران نیاکان قوم، پسر جومر و از نوادگان یافث؛ ذکر شده در پیدایش ۱۰:۳.",
          "source": "acai"
        }
      ],
      "preferred_label": "اَشکناز"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Homme de l'époque des patriarches, fils de Gomer et descendant de Japhet, mentionné dans Genèse 10:3.",
          "source": "acai"
        }
      ],
      "preferred_label": "Aschkenaz"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani mutum daga zamanin kakannin farko, ɗan Gomer kuma zuriyar Yafet, an ambace shi a Farawa 10:3.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ashkenaz"
    },
    "hin": {
      "descriptions": [
        {
          "description": "कुलपिताओं के समय का एक पुरुष, गोमेर का पुत्र और येपेत का वंशज, जिसका उल्लेख उत्पत्ति 10:3 में मिलता है।",
          "source": "acai"
        }
      ],
      "preferred_label": "अश्कनज"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Otu nwoke sitere n'oge ndị nna ochie, nwa Goma na nwa nwa Jefet, nke a kpọtụrụ aha na Jenesis 10:3.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ashkenaz"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Seorang laki-laki dari zaman para bapa leluhur, putra Gomer dan keturunan Yafet, yang disebutkan dalam Kejadian 10:3.",
          "source": "acai"
        }
      ],
      "preferred_label": "Askenas"
    },
    "nep": {
      "descriptions": [
        {
          "description": "कुलपिताहरूको समयका एक पुरुष, गोमेरका छोरा र येपेतका वंशज, जसको उल्लेख उत्पत्ति १०:३ मा गरिएको छ।",
          "source": "acai"
        }
      ],
      "preferred_label": "अशकनज"
    },
    "por": {
      "descriptions": [
