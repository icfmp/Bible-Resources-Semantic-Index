    "apd": {
      "descriptions": [
        {
          "description": "طاحش، المذكور في التكوين 22: 24، كان ولد ناحور ورؤومة، وعاش في زمن الآباء الأولين.",
          "source": "acai"
        }
      ],
      "preferred_label": "طاحش"
    },
    "arb": {
      "descriptions": [
        {
          "description": "تَاحَش، المذكور في التكوين 22: 24، كان ابنًا لِنَاحور ورَؤومَة، وعاش في عصر الآباء.",
          "source": "acai"
        }
      ],
      "preferred_label": "تَاحَش"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Tahas, we Jenesis 22:24 i tokbaot hem, hem i wan boe blong Naho wetem Rumaha, mo i bin laef long taem blong ol olfala bubu blong bifo.",
          "source": "acai"
        }
      ],
      "preferred_label": "Tahas"
    },
    "eng": {
      "alternate_labels": [
        "Thahash"
      ],
      "descriptions": [
        {
          "article": "person:Tahash",
          "description": "Tahash, mentioned in Genesis 22:24, was a son of Nahor and Reumah, and lived during the time of the patriarchs.",
          "gloss": "Tahash",
          "source": "acai"
        }
      ],
      "preferred_label": "Tahash"
    },
    "fas": {
      "descriptions": [
        {
          "description": "تاحَش، که در پیدایش ۲۲:۲۴ ذکر شده است، پسری از ناحور و رِئومه بود و در دوران پدران اولیه زندگی می‌کرد.",
          "source": "acai"
        }
      ],
      "preferred_label": "تاحَش"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Tahasch, mentionné dans Genèse 22.24, était un fils de Nachor et de Réuma, qui vivait à l'époque des patriarches.",
          "source": "acai"
        }
      ],
      "preferred_label": "Tahasch"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Tahash, wanda aka ambata a Farawa 22:24, ɗan Nahor ne da Reyuma, kuma ya rayu a zamanin kakanni.",
          "source": "acai"
        }
      ],
      "preferred_label": "Tahash"
    },
    "hin": {
      "descriptions": [
        {
          "description": "उत्पत्ति 22:24 में उल्लिखित तहश, नाहोर और रूमा का पुत्र था, और कुलपिताओं के समय में रहता था।",
          "source": "acai"
        }
      ],
      "preferred_label": "तहश"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Tahash, nke a kpọtụrụ aha na Jenesis 22:24, bụ nwa Neho na Reuma, ma dịrị ndụ nʼoge ndị nna nna ochie.",
          "source": "acai"
        }
      ],
      "preferred_label": "Tahash"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Tahash, yang disebutkan dalam Kejadian 22:24, adalah anak laki-laki Nahor dan Reuma, dan hidup pada masa para bapa leluhur.",
          "source": "acai"
        }
      ],
      "preferred_label": "Tahash"
    },
    "nep": {
      "descriptions": [
        {
          "description": "उत्पत्ति २२:२४ मा उल्लेख गरिएका तहस नहोर र रूमाका छोरा थिए, र तिनी कुलपिताहरूको समयमा बाँचेका थिए।",
          "source": "acai"
        }
      ],
      "preferred_label": "तहस"
    },
    "por": {
      "descriptions": [
        {
          "description": "Taás, mencionado em Gênesis 22:24, foi filho de Naor e Reumá, e viveu durante a época dos patriarcas.",
          "source": "acai"
        }
      ],
      "preferred_label": "Taás"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Тахаш, упомянутый в Бытии 22:24, был сыном Нахора и Реумы и жил во времена патриархов.",
          "source": "acai"
        }
      ],
      "preferred_label": "Тахаш"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Tajás, mencionado en Génesis 22:24, fue hijo de Nacor y Reúma, y vivió durante la época de los patriarcas.",
          "source": "acai"
        }
      ],
      "preferred_label": "Tajás"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Tahashi, anayetajwa katika Mwanzo 22:24, alikuwa mwana wa Nahori na Reuma, na aliishi wakati wa wazee wa imani.",
          "source": "acai"
        }
      ],
      "preferred_label": "Tahashi"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Tahas, em Baibel i kolim nem bilong en long Stat 22:24, em i pikinini man bilong Nahor na Reuma, na em i bin stap long taim bilong ol bikbubu.",
          "source": "acai"
        }
      ],
      "preferred_label": "Tahas"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Ta-hách, được đề cập trong Sáng Thế Ký 22:24, là con trai của Na-cô và Rê-u-ma, sống vào thời kỳ các tổ phụ.",
          "source": "acai"
        }
      ],
      "preferred_label": "Ta-hách"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "他辖在创世记22:24中被提及，是拿鹤和流玛的儿子，生活在先祖时代。",
          "source": "acai"
        }
      ],
      "preferred_label": "他辖"
    },
    "zht": {
      "descriptions": [
        {
          "description": "創世記 22:24 提到的他轄，是拿鶴和流瑪的兒子，生活在族長時期。",
          "source": "acai"
        }
      ],
      "preferred_label": "他轄"
    }
