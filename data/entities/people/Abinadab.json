  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "راجل عاش في قرية يعاريم. تابوت العهد اتحفظ في بيته بعد ما رجعوه الفلسطينيين.",
          "source": "acai"
        }
      ],
      "preferred_label": "أبيناداب (من قرية يعاريم)"
    },
    "arb": {
      "descriptions": [
        {
          "description": "رجل عاش في قرية يعاريم، واستقر تابوت العهد في بيته بعد أن رده الفلسطينيون.",
          "source": "acai"
        }
      ],
      "preferred_label": "أَبِينَادَاب (من قرية يعاريم)"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan man we i bin stap laef long Kiriatsearim. Oli bin karem Bokis blong Kontrak i kam stap long haos blong hem afta we ol Filastin oli sanem i gobak.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abinadab (blong Kiriatsearim)"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Abinadab",
          "description": "Man who lived in Kiriath-Jearim. The ark of the covenant was kept at his house after it was returned by the Philistines.",
          "gloss": "Abinadab (of Kiriath-Jearim)",
          "source": "acai"
        }
      ],
      "preferred_label": "Abinadab (of Kiriath-jearim)"
    },
    "fas": {
      "descriptions": [
        {
          "description": "مردی که در قریهٔ یعاریم زندگی می‌کرد. پس از بازگردانده شدن صندوق عهد توسط فلسطینیان، صندوق در خانهٔ او نگهداری شد.",
          "source": "acai"
        }
      ],
      "preferred_label": "ابیناداب (اهل قریهٔ یعاریم)"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Homme qui habitait à Kirjath-Jearim. L’arche de l’alliance fut gardée dans sa maison après avoir été rendue par les Philistins.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abinadab (de Kirjath-Jearim)"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Mutumin da ya zauna a Kiriyat-Yeyarim. An ajiye akwatin alkawari a gidansa bayan da Filistiyawa suka dawo da shi.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abinadab (na Kiriyat-Yeyarim)"
    },
    "hin": {
      "descriptions": [
        {
          "description": "किर्यत्यारीम में रहने वाला एक व्यक्ति। पलिश्तियों द्वारा वाचा का सन्दूक लौटाए जाने के बाद उसे उसके घर में रखा गया था।",
          "source": "acai"
        }
      ],
      "preferred_label": "अबीनादाब (किर्यत्यारीम का)"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Nwoke bi na Kiriat Jearim. E debere igbe ọgbụgba ndụ ahụ nʼụlọ ya mgbe ndị Filistia weghachiri ya.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abinadab (nke Kiriat Jearim)"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Pria yang tinggal di Kiryat-Yearim. Tabut perjanjian disimpan di rumahnya setelah dikembalikan oleh orang Filistin.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abinadab (dari Kiryat-Yearim)"
    },
    "nep": {
      "descriptions": [
        {
          "description": "किर्यत-यारीममा बस्‍ने एक पुरुष, जसको घरमा पलिश्‍तीहरूले फर्काएपछि करारको सन्दुक राखिएको थियो।",
          "source": "acai"
        }
      ],
      "preferred_label": "अबीनादाब (किर्यत-यारीमका)"
    },
    "por": {
      "descriptions": [
        {
          "description": "Homem que viveu em Quiriate-Jearim. A arca da aliança ficou guardada em sua casa depois de ter sido devolvida pelos filisteus.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abinadabe (de Quiriate-Jearim)"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Человек, живший в Кириаф-Иариме. В его доме хранился ковчег завета после того, как его возвратили филистимляне.",
          "source": "acai"
        }
      ],
      "preferred_label": "Аминадав (из Кириаф-Иарима)"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Hombre que vivía en Quiriat-jearim. El arca del pacto se guardó en su casa después de que los filisteos la devolvieran.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abinadab (de Quiriat-jearim)"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mtu aliyeishi Kiriath-Yearimu. Sanduku la agano lilihifadhiwa nyumbani mwake baada ya kurudishwa na Wafilisti.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abinadabu (wa Kiriath-Yearimu)"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Man i bin stap long Kiriat Jearim. Bokis Kontrak i bin stap long haus bilong em taim ol Filistia i salim i kam bek pinis.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abinadap (bilong Kiriat Jearim)"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Người đàn ông sống tại Ki-ri-át Giê-a-rim. Hòm Giao Ước được giữ tại nhà ông sau khi dân Phi-li-tin trả lại.",
          "source": "acai"
        }
      ],
      "preferred_label": "A-bi-na-đáp (người Ki-ri-át Giê-a-rim)"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "住在基列·耶琳的人。非利士人归还约柜后，约柜存放在他家中。",
          "source": "acai"
        }
      ],
      "preferred_label": "亚比拿达 (基列·耶琳)"
    },
    "zht": {
      "descriptions": [
        {
          "description": "住在基列‧耶琳的人。非利士人將約櫃送回後，約櫃便存放在他家中。",
          "source": "acai"
        }
      ],
      "preferred_label": "亞比拿達（基列‧耶琳）"
    }
