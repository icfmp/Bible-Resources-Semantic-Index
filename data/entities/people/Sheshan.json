        }
      ],
      "preferred_label": "Sheshan"
    },
    "hin": {
      "descriptions": [
        {
          "description": "यहूदा के गोत्र का यिशी का पुत्र और अहलै का पिता, जो इस्राएल के विभाजित राज्य के समय रहता था।",
          "source": "acai"
        }
      ],
      "preferred_label": "शेशान"
    },
    "ibo": {
      "descriptions": [
        {
