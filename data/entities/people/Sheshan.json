    "apd": {
      "descriptions": [
        {
          "description": "ابن يشعي وأبو أحلاي من قبيلة يهوذا، عاش في زمن المملكة المنقسمة في إسرائيل.",
          "source": "acai"
        }
      ],
      "preferred_label": "شيشان"
    },
    "arb": {
      "descriptions": [
        {
          "description": "ابن يَشْعِي وأبو أَحْلَايَ من سبط يَهوذَا، عاش في زمن انقسام مملكة إسرائيل.",
          "source": "acai"
        }
      ],
      "preferred_label": "شِيشَان"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Pikinini boe blong Jisi mo papa blong Ahilae we i kamaot long laen blong Juda, we i laef long taem we kingdom blong Isrel i seraot.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sesan"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Sheshan",
          "description": "The son of Ishi and the father of Ahlai from the tribe of Judah who lived during the time of the divided kingdom of Israel. ",
          "gloss": "Sheshan",
          "source": "acai"
        }
      ],
      "preferred_label": "Sheshan"
    },
    "fas": {
      "descriptions": [
        {
          "description": "پسر یشعی و پدر احلای از قبیلهٔ یهودا که در دوران پادشاهی تقسیم‌شدهٔ اسرائیل زندگی می‌کرد.",
          "source": "acai"
        }
      ],
      "preferred_label": "شیشان"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Fils de Jischeï et père d'Achlaï, issu de la tribu de Juda, qui a vécu à l'époque du royaume divisé d'Israël.",
          "source": "acai"
        }
      ],
      "preferred_label": "Schéschan"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Ɗan Ishi kuma mahaifin Alai daga kabilar Yahuda wanda ya rayu a lokacin rabuwar mulkin Isra’ila.",
