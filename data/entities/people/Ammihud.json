        }
      ],
      "preferred_label": "亚米忽"
    },
    "zht": {
      "descriptions": [
        {
          "description": "拉但的兒子，屬以法蓮支派，是以色列人領袖嫩的兒子約書亞的曾祖父。",
          "source": "acai"
        }
      ],
      "preferred_label": "亞米忽"
