  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "ابن كنعنة ونبي كذاب عاش في زمن مملكة إسرائيل المنقسمة.",
          "source": "acai"
        }
      ],
      "preferred_label": "صدقيا"
    },
    "arb": {
      "descriptions": [
        {
          "description": "ابْنُ كَنْعَنَةَ وَنَبِيٌّ كَاذِبٌ عَاشَ فِي عَصْرِ المَمْلَكَةِ المُنْقَسِمَةِ فِي إِسْرَائِيلَ.",
          "source": "acai"
        }
      ],
      "preferred_label": "صِدْقِيَّا"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan pikinini boe blong Kenahana mo giaman profet we i laef long taem we kingdom blong Isrel i seraot.",
          "source": "acai"
        }
      ],
      "preferred_label": "Jedekia"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Zedekiah.2",
          "description": "A son of Chenaanah and false prohet who living during the time of the divided kingdom of Israel.",
          "gloss": "Zedekiah",
          "source": "acai"
        }
      ],
      "preferred_label": "Zedekiah"
    },
    "fas": {
      "descriptions": [
        {
          "description": "پسر کنعنه و نبی کاذبی که در دوران پادشاهی تقسیم‌شدهٔ اسرائیل زندگی می‌کرد.",
          "source": "acai"
        }
      ],
      "preferred_label": "صدقیا"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Fils de Kenaana et faux prophète ayant vécu à l'époque du royaume divisé d'Israël.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sédécias"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Ɗan Kena'ana kuma annabin ƙarya da ya rayu a lokacin masarautar Isra'ila da ta rabu.",
          "source": "acai"
        }
      ],
      "preferred_label": "Zedekiya"
    },
    "hin": {
      "descriptions": [
        {
          "description": "कनाना का एक पुत्र और झूठा नबी जो इस्राएल के विभाजित राज्य के समय रहता था।",
          "source": "acai"
        }
      ],
      "preferred_label": "सिदकिय्याह"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Nwa nwoke Kenaana na onye amụma ụgha nke biri nʼoge alaeze kewara ekewa nke Izrel.",
          "source": "acai"
        }
      ],
      "preferred_label": "Zedekaya"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Anak Kenaana dan nabi palsu yang hidup pada masa kerajaan terpecah Israel.",
          "source": "acai"
        }
      ],
      "preferred_label": "Zedekia"
    },
    "nep": {
      "descriptions": [
        {
          "description": "केनानका छोरा र इस्राएलको विभाजित राज्यको समयमा जिउने एक झूटा अगमवक्ता।",
          "source": "acai"
        }
      ],
      "preferred_label": "सिदकियाह"
    },
    "por": {
      "descriptions": [
        {
          "description": "Filho de Quenaaná e falso profeta que viveu durante a época do reino dividido de Israel.",
          "source": "acai"
        }
      ],
      "preferred_label": "Zedequias"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Сын Хенааны и лжепророк, живший во времена разделенного царства Израиля.",
          "source": "acai"
        }
      ],
      "preferred_label": "Седекия"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Hijo de Quenaná y falso profeta que vivió durante la época del reino dividido de Israel.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sedequías"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mwana wa Kenaana na nabii wa uongo aliyeishi wakati wa ufalme uliogawanyika wa Israeli.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sedekia"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela pikinini man bilong Kenana na giaman profet em i bin stap long taim bilong hap kingdom bilong Israel.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sedekaia"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Con trai của Kê-na-na và là một tiên tri giả sống vào thời kỳ vương quốc phân chia của Y-sơ-ra-ên.",
          "source": "acai"
        }
      ],
      "preferred_label": "Sê-đê-kia"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "基拿拿的儿子，生活在以色列王国分裂时期的一位假先知。",
          "source": "acai"
        }
      ],
      "preferred_label": "西底家"
    },
    "zht": {
      "descriptions": [
        {
          "description": "基拿拿的兒子，生活在以色列王國分裂時期的假先知。",
          "source": "acai"
        }
      ],
      "preferred_label": "西底家"
    }
  },
