    "vie": {
      "descriptions": [
        {
          "description": "Một người bà con có quyền chuộc sản nghiệp của thân quyến đã qua đời.",
          "source": "acai"
        }
      ],
      "preferred_label": "Người chuộc sản nghiệp"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "有权赎回已故亲属产业的至亲。",
