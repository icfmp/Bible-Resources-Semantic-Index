        }
      ],
      "preferred_label": "pariente redentor"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Jamaa mwenye haki ya kukomboa nyumba ya jamaa aliyekufa.",
          "source": "acai"
        }
      ],
      "preferred_label": "Mkombozi wa Jamaa"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela wanblut i gat rait long baim bek ol samting bilong wanpela famili man i dai pinis.",
