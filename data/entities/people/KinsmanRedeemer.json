        }
      ],
      "preferred_label": "الولي الفادي"
    },
    "arb": {
      "descriptions": [
        {
          "description": "قَرِيبٌ لَهُ حَقُّ فِكَاكِ أَهْلِ بَيْتِ قَرِيبِهِ ٱلْمُتَوَفَّى.",
          "source": "acai"
        }
      ],
      "preferred_label": "ٱلْوَلِيُّ"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan famle we i gat raet blong pemaot graon mo laen blong wan famle we i ded finis.",
          "source": "acai"
        }
      ],
      "preferred_label": "Famle we i gat raet blong pemaot"
    },
    "eng": {
      "descriptions": [
        {
          "description": "A relative who has right of redemption of the household of a dead relative.",
          "gloss": "Kinsman Redeemer",
          "source": "acai"
        }
      ],
      "preferred_label": "Kinsman Redeemer"
    },
    "fas": {
      "descriptions": [
        {
          "description": "خویشاوندی که حق بازخرید خاندان خویشاوند درگذشتهٔ خود را دارد.",
          "source": "acai"
        }
      ],
      "preferred_label": "ولیّ بازخریدکننده"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Parent ayant le droit de rachat sur la maison d’un parent décédé.",
          "source": "acai"
        }
      ],
      "preferred_label": "ayant droit de rachat"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Wani dangi mai hakkin fansar iyalin danginsa da ya mutu.",
          "source": "acai"
        }
      ],
      "preferred_label": "Dangi Mai Fansa"
    },
    "hin": {
      "descriptions": [
        {
          "description": "एक रिश्तेदार जिसे किसी मृत सम्बन्धी के घराने को छुड़ाने का अधिकार होता है।",
          "source": "acai"
        }
      ],
      "preferred_label": "छुड़ानेवाला कुटुम्बी"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Onye ikwu nwere ikike ịgbapụta ezinụlọ nke onye ikwu ya nwụrụ anwụ.",
          "source": "acai"
        }
      ],
      "preferred_label": "Onye nchekwa mgbapụta"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Seorang kerabat yang memiliki hak penebusan atas keluarga seorang kerabat yang telah meninggal.",
          "source": "acai"
        }
      ],
      "preferred_label": "Kaum penebus"
    },
    "nep": {
      "descriptions": [
        {
          "description": "एक नातेदार जसलाई आफ्नो मृतक नातेदारको घरानामा छुटकारा दिने अधिकार हुन्छ।",
          "source": "acai"
        }
      ],
      "preferred_label": "नजिकको कुटुम्ब"
    },
    "por": {
      "descriptions": [
