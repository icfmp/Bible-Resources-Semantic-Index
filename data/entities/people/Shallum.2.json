    "apd": {
      "descriptions": [
        {
          "description": "ولد يابيش البقى ملك على مملكة إسرائيل الشمالية بعد ما اغتال زكريا ولد يربوعام.",
          "source": "acai"
        }
      ],
      "preferred_label": "شلوم"
    },
    "arb": {
      "descriptions": [
        {
          "description": "ابن يَابِيشَ الذي صار مَلِكًا على مملكة إسرائيل الشمالية بعد أن اغتال زَكَرِيَّا بنَ يَرُبْعَام.",
          "source": "acai"
        }
      ],
      "preferred_label": "شَلّوم"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Pikinini boe blong Jabes we i kam king blong not kingdom blong Isrel afta we hem i kilim Sekaraea i ded, pikinini boe blong Jeroboam.",
          "source": "acai"
        }
      ],
      "preferred_label": "Salum"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Shallum.2",
          "description": "The son of Jabesh who became king of the northern kingdom of Israel after he assassinated Zechariah, son of Jeroboam.",
          "gloss": "Shallum",
          "source": "acai"
        }
      ],
      "preferred_label": "Shallum"
    },
    "fas": {
      "descriptions": [
        {
          "description": "پسر یابیش که پس از ترور زکریا پسر یربعام، پادشاه پادشاهی شمالی اسرائیل شد.",
          "source": "acai"
        }
      ],
      "preferred_label": "شلوم"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Fils de Jabesch devenu roi du royaume du Nord d'Israël après avoir assassiné Zacharie, fils de Jéroboam.",
          "source": "acai"
        }
      ],
      "preferred_label": "Schallum"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Ɗan Yabesh wanda ya zama sarkin mulkin arewa na Isra’ila bayan ya kashe Zakariya, ɗan Yerobowam.",
