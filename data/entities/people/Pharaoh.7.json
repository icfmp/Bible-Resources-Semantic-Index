    "eng": {
      "descriptions": [
        {
          "article": "person:Pharaoh.7",
          "description": "Husband of Tahpenes who ruled the Egyptians during the time of Israel’s united kingdom.",
          "gloss": "Pharaoh",
          "source": "acai"
        }
      ],
      "preferred_label": "Pharaoh"
    },
    "fas": {
      "descriptions": [
        {
          "description": "شوهر تحفنیس که در دوران پادشاهی متحد اسرائیل بر مصریان فرمانروایی می‌کرد.",
          "source": "acai"
        }
      ],
      "preferred_label": "فرعون"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Mari de Thachpenès qui régnait sur les Égyptiens à l'époque de la monarchie unie d'Israël.",
          "source": "acai"
        }
      ],
      "preferred_label": "Pharaon"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Mijin Tafenes wanda ya mallaki Masarawa a zamanin haɗaɗɗiyar masarautar Isra’ila.",
