        }
      ],
      "preferred_label": "Fir’auna"
    },
    "hin": {
      "descriptions": [
        {
          "description": "तहपनेस का पति जिसने इस्राएल के संयुक्त राज्य के समय मिस्रियों पर शासन किया।",
          "source": "acai"
        }
      ],
      "preferred_label": "फ़िरौन"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Di Tapenes nke chịrị ndị Ijipt nʼoge alaeze dị nʼotu nke Izrel.",
          "source": "acai"
        }
      ],
      "preferred_label": "Fero"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Suami Tahpenes yang memerintah orang Mesir pada zaman kerajaan bersatu Israel.",
          "source": "acai"
        }
      ],
      "preferred_label": "Firaun"
    },
    "nep": {
      "descriptions": [
        {
          "description": "तहपेनसका पति जसले इस्राएलको संयुक्त राज्यको समयमा मिश्रीहरूमाथि शासन गरेका थिए।",
          "source": "acai"
        }
      ],
      "preferred_label": "फारो"
    },
    "por": {
      "descriptions": [
        {
          "description": "Marido de Tafnes que governou os egípcios durante o tempo do reino unificado de Israel.",
          "source": "acai"
        }
      ],
      "preferred_label": "Faraó"
    },
    "rus": {
      "descriptions": [
        {
