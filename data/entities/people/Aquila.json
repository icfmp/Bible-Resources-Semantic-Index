  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "راجل برسكلا وصديق الرسول بولس، كان في كنيسة في بيتهم وعلّم أبلوس الإيمان المسيحي.",
          "source": "acai"
        }
      ],
      "preferred_label": "أكيلا"
    },
    "arb": {
      "descriptions": [
        {
          "description": "زوج بريسكلا وصديق الرسول بولس، كان في بيتهما كنيسة، وقاما بتعليم أبلوس في الإيمان المسيحي.",
          "source": "acai"
        }
      ],
      "preferred_label": "أَكِيلَا"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Man blong Prisila mo fren blong Apositol Pol, we tufala i gat wan jos long haos blong tufala mo tufala i tijim Apolos long laef blong Kristin bilif.",
          "source": "acai"
        }
      ],
      "preferred_label": "Akwila"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Aquila",
          "description": "Husband of Priscilla and friend of the Apostle Paul, who had a church in their home and instructed Apollos in the Christian Faith. ",
          "gloss": "Aquila",
          "source": "acai"
        }
      ],
      "preferred_label": "Aquila"
    },
    "fas": {
      "descriptions": [
        {
          "description": "همسر پریسکیلا و دوست پولس رسول، که کلیسایی در خانه‌شان تشکیل می‌شد و اَپُلُس را در ایمان مسیحی تعلیم دادند.",
          "source": "acai"
        }
      ],
      "preferred_label": "آکیلا"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Époux de Priscille et ami de l'apôtre Paul, qui accueillait une Église dans sa maison et instruisit Apollos dans la foi chrétienne.",
          "source": "acai"
        }
      ],
      "preferred_label": "Aquilas"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Mijin Firiskila kuma abokin Manzo Bulus, wanda ikkisiya ta taru a gidansu kuma ya koyar da Afollos a kan bangaskiyar Kirista.",
          "source": "acai"
        }
      ],
      "preferred_label": "Akwila"
    },
    "hin": {
      "descriptions": [
        {
          "description": "प्रिस्किल्ला का पति और प्रेरित पौलुस का मित्र, जिनके घर में कलीसिया की सभा होती थी और जिन्होंने अपुल्लोस को मसीही विश्वास की शिक्षा दी।",
          "source": "acai"
        }
      ],
      "preferred_label": "अक्विला"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Di Prisila na ezigbo enyi nke Onyeozi Pọl, onye nwere nzukọ Kraịst n'ụlọ ha ma kụziere Apọlọs banyere okwukwe Kraịst.",
          "source": "acai"
        }
      ],
      "preferred_label": "Akwila"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Suami dari Priskila dan sahabat Rasul Paulus, yang memiliki jemaat di rumah mereka dan membimbing Apolos dalam iman Kristen.",
          "source": "acai"
        }
      ],
      "preferred_label": "Akwila"
    },
    "nep": {
      "descriptions": [
        {
          "description": "प्रिस्किलाका पति र प्रेरित पावलका साथी, जसको घरमा मण्डली सञ्चालन हुन्थ्यो र जसले अपोल्लोसलाई मसीही विश्वासमा सिकाएका थिए।",
          "source": "acai"
        }
      ],
      "preferred_label": "अकिला"
    },
    "por": {
      "descriptions": [
        {
          "description": "Marido de Priscila e amigo do apóstolo Paulo, que sediava uma igreja em sua casa e instruiu Apolo na fé cristã.",
          "source": "acai"
        }
      ],
      "preferred_label": "Áquila"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Муж Прискиллы и друг апостола Павла; в их доме собиралась церковь, и они наставляли Аполлоса в христианской вере.",
          "source": "acai"
        }
      ],
      "preferred_label": "Акила"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Esposo de Priscila y amigo del apóstol Pablo, que tenía una iglesia en su casa e instruyó a Apolos en la fe cristiana.",
          "source": "acai"
        }
      ],
      "preferred_label": "Aquila"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mume wa Priskila na rafiki wa Mtume Paulo, ambaye alikuwa na kanisa nyumbani mwao na aliyemfundisha Apolo katika Imani ya Kikristo.",
          "source": "acai"
        }
      ],
      "preferred_label": "Akila"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Man bilong Prisila na pren bilong Aposel Pol, em tupela i bin gat wanpela sios long haus bilong ol na skulim Apolos long bilip bilong Kristen.",
          "source": "acai"
        }
      ],
      "preferred_label": "Akwila"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Chồng của Bê-rít-sin và là bạn của Sứ đồ Phao-lô, người có Hội Thánh nhóm hiệp tại nhà mình và đã hướng dẫn A-bô-lô trong đức tin Cơ Đốc.",
          "source": "acai"
        }
      ],
      "preferred_label": "A-qui-la"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "百基拉的丈夫，使徒保罗的朋友，他们在家中建立了教会，并在基督信仰上教导亚波罗。",
          "source": "acai"
        }
      ],
      "preferred_label": "亚居拉"
    },
    "zht": {
      "descriptions": [
        {
          "description": "百基拉的丈夫，使徒保羅的朋友；他們家中有教會，並曾在基督信仰上教導亞波羅。",
          "source": "acai"
        }
      ],
      "preferred_label": "亞居拉"
    }
  },
