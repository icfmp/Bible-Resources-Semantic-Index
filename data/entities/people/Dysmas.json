  ],
  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "المجرم التائب المصلوب جنب يسوع. التقليد بيديهو اسم «ديسماس».",
          "source": "acai"
        }
      ],
      "preferred_label": "المجرم المصلوب (ديسماس)"
    },
    "arb": {
      "descriptions": [
        {
          "description": "المُجْرِمُ التَّائِبُ الَّذِي صُلِبَ بِجَانِبِ يَسُوعَ. وَيُطْلِقُ عَلَيْهِ التَّقْلِيدُ اسْمَ «دِيسْمَاس».",
          "source": "acai"
        }
      ],
      "preferred_label": "المجرم على الصليب (ديسماس)"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Man blong brekem loa we i tanem tingting blong hem, we oli nilim hem long kros klosap long Jisas. Kakae/kastom blong bifo i givim nem ya \\\"Dismas\\\" long hem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Man blong brekem loa we oli nilim long kros (Dismas)"
    },
    "eng": {
      "descriptions": [
        {
          "description": "The repentant criminal crucified next to Jesus. Tradition gives him the name \"Dysmas.\"",
          "gloss": "Criminal on the Cross (Dysmas)",
          "source": "acai"
        }
      ],
      "preferred_label": "Criminal on the Cross (Dysmas)"
    },
    "fas": {
      "descriptions": [
        {
          "description": "مجرم توبه‌کاری که در کنار عیسی مصلوب شد. بر اساس سنت نام او «دیسماس» دانسته شده است.",
          "source": "acai"
        }
      ],
      "preferred_label": "مجرم بر صلیب (دیسماس)"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Le malfaiteur repentant crucifié aux côtés de Jésus. La tradition lui donne le nom de « Dismas » (ou « Dysmas »).",
          "source": "acai"
        }
      ],
      "preferred_label": "Malfaiteur sur la croix (Dismas)"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Mai laifin da ya tuba wanda aka gicciye kusa da Yesu. Al'ada ta ba shi suna \\\"Dismas\\\".",
          "source": "acai"
        }
      ],
      "preferred_label": "Mai Laifi a kan Gicciye (Dismas)"
    },
    "hin": {
      "descriptions": [
        {
          "description": "यीशु के साथ क्रूस पर चढ़ाया गया पश्चातापी अपराधी। परंपरा उसे \\\"दिसमास\\\" नाम देती है।",
          "source": "acai"
        }
      ],
      "preferred_label": "क्रूस पर का अपराधी (दिसमास)"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Onye ohi ahụ chegharịrị echegharị nke a kpọgidere nʼobe nʼakụkụ Jisọs. Omenala kpọrọ ya aha \\\"Dismas\\\".",
          "source": "acai"
        }
      ],
      "preferred_label": "Onye omekome nʼelu Obe (Dismas)"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Penjahat yang bertobat yang disalibkan di samping Yesus. Tradisi memberinya nama \\\"Dismas\\\".",
          "source": "acai"
        }
      ],
      "preferred_label": "Penjahat di Kayu Salib (Dismas)"
    },
    "nep": {
      "descriptions": [
        {
          "description": "येशूको छेउमा क्रूसमा टाँगिएको पश्‍चात्तापी अपराधी। परम्पराले तिनलाई \\\"दिस्मास\\\" नाम दिन्छ।",
          "source": "acai"
        }
      ],
      "preferred_label": "क्रूसमा टाँगिएको अपराधी (दिस्मास)"
    },
    "por": {
      "descriptions": [
        {
          "description": "O criminoso arrependido crucificado ao lado de Jesus. A tradição lhe dá o nome de \\\"Dimas\\\".",
          "source": "acai"
        }
      ],
      "preferred_label": "Criminoso na cruz (Dimas)"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Раскаявшийся разбойник, распятый рядом с Иисусом. Предание дает ему имя «Дисмас».",
          "source": "acai"
        }
      ],
      "preferred_label": "Разбойник на кресте (Дисмас)"
    },
    "spa": {
      "descriptions": [
        {
          "description": "El criminal arrepentido crucificado junto a Jesús. La tradición le da el nombre de «Dimas».",
          "source": "acai"
        }
      ],
      "preferred_label": "Criminal en la cruz (Dimas)"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mhalifu aliyetubu aliyesulubiwa kando ya Yesu. Mapokeo yanampa jina \\\"Dismas\\\".",
          "source": "acai"
        }
      ],
      "preferred_label": "Mhalifu Msalabani (Dismas)"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Dispela man bilong mekim pasin nogut i bin tanim bel taim ol i nilim em long diwai kros wantaim Jisas. Ol stori bilong bipo i save kolim nem bilong em “Dismas”.",
          "source": "acai"
        }
      ],
      "preferred_label": "Man bilong mekim pasin nogut long diwai kros (Dismas)"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Tên trộm ăn năn bị đóng đinh bên cạnh Đức Chúa Jesus. Truyền thống đặt tên cho người này là “Đít-ma”.",
          "source": "acai"
        }
      ],
      "preferred_label": "Tội nhân trên thập tự giá (Đít-ma)"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "在耶稣身边同钉十字架、后来悔改的犯人。传统称他为“狄思玛斯”（Dysmas）。",
          "source": "acai"
        }
      ],
      "preferred_label": "十字架上的罪犯 (狄思玛斯)"
    },
    "zht": {
      "descriptions": [
        {
          "description": "與耶穌一同被釘十字架且悔改的罪犯。傳統賦予他「狄斯瑪斯」之名。",
          "source": "acai"
        }
      ],
      "preferred_label": "十字架上的罪犯（狄斯瑪斯）"
    }
  },
