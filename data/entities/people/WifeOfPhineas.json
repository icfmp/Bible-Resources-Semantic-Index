  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "مرت فينحاس الكاهن، وكنة عالي الكاهن كمان.",
          "source": "acai"
        }
      ],
      "preferred_label": "مرت فينحاس"
    },
    "arb": {
      "descriptions": [
        {
          "description": "زوجة فينحاس الكاهن، وكنّة عالي الكاهن أيضًا.",
          "source": "acai"
        }
      ],
      "preferred_label": "زوجة فينحاس"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Woman blong Finehas we i pris, mo dota long loa blong Ilai we i pris.",
          "source": "acai"
        }
      ],
      "preferred_label": "Woman blong Finehas"
    },
    "eng": {
      "descriptions": [
        {
          "description": "The wife of Phineas the priest, also the daughter-in-law of Eli the priest.",
          "gloss": "Wife of Phineas",
          "source": "acai"
        }
      ],
      "preferred_label": "Wife of Phineas"
    },
    "fas": {
      "descriptions": [
        {
          "description": "همسر فینحاسِ کاهن، و همچنین عروس عیلیِ کاهن.",
          "source": "acai"
        }
      ],
      "preferred_label": "همسر فینحاس"
    },
    "fra": {
      "descriptions": [
        {
          "description": "L'épouse du prêtre Phinées, également belle-fille du prêtre Éli.",
          "source": "acai"
        }
      ],
      "preferred_label": "femme de Phinées"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Matar Finehas firist, wadda kuma surukar Eli firist ce.",
          "source": "acai"
        }
      ],
      "preferred_label": "Matar Finehas"
    },
    "hin": {
      "descriptions": [
        {
          "description": "याजक पीनहास की पत्नी और याजक एली की बहू।",
          "source": "acai"
        }
      ],
      "preferred_label": "पीनहास की पत्नी"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Nwunye Finehaz onye nchụàjà, onye bụkwa nwunye nwa Ịlaị onye nchụàjà.",
          "source": "acai"
        }
      ],
      "preferred_label": "Nwunye Finehaz"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Istri imam Pinehas, yang juga merupakan menantu perempuan imam Eli.",
          "source": "acai"
        }
      ],
      "preferred_label": "Istri Pinehas"
    },
    "nep": {
      "descriptions": [
        {
          "description": "पुजारी पीनहासकी पत्‍नी, जो पूजाहारी एलीकी बुहारी पनि थिइन्।",
          "source": "acai"
        }
      ],
      "preferred_label": "पीनहासकी पत्‍नी"
    },
    "por": {
      "descriptions": [
        {
          "description": "A esposa do sacerdote Fineias, também nora do sacerdote Eli.",
          "source": "acai"
        }
      ],
      "preferred_label": "Mulher de Fineias"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Жена священника Финееса и сноха священника Илия.",
          "source": "acai"
        }
      ],
      "preferred_label": "Жена Финееса"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Esposa del sacerdote Finés y nuera del sacerdote Elí.",
          "source": "acai"
        }
      ],
      "preferred_label": "Esposa de Finés"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mke wa Finehasi kuhani, na pia mkwe wa Eli kuhani.",
          "source": "acai"
        }
      ],
      "preferred_label": "Mke wa Finehasi"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Meri bilong Finias em pris, na tu em i tambu meri bilong Eli em pris.",
          "source": "acai"
        }
      ],
      "preferred_label": "Meri bilong Finias"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Vợ của thầy tế lễ Phi-nê-a, đồng thời là con dâu của thầy tế lễ Hê-li.",
          "source": "acai"
        }
      ],
      "preferred_label": "Vợ của Phi-nê-a"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "祭司非尼哈的妻子，也是祭司以利的儿媳。",
          "source": "acai"
        }
      ],
      "preferred_label": "非尼哈的妻子"
    },
    "zht": {
      "descriptions": [
        {
          "description": "祭司非尼哈的妻子，也是祭司以利的兒婦。",
          "source": "acai"
        }
      ],
      "preferred_label": "非尼哈的妻子"
    }
  },
