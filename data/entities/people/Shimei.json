        }
      ],
      "preferred_label": "Simei (Obed-Edom)"
    },
    "nep": {
      "descriptions": [
        {
          "description": "यदूथूनका छोरा र लेवी कुलका एक गायक शिमी, इस्राएलको संयुक्त राज्यकालको समयमा बाँचेका थिए।",
          "source": "acai"
        }
      ],
      "preferred_label": "शिमी (ओबेद-एदोम)"
    },
    "por": {
      "descriptions": [
