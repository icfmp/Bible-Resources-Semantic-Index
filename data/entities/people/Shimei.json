  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "شمعي، ود يدوثون ومغني من سبط لاوي، عاش في زمن المملكة الموحدة في إسرائيل.",
          "source": "acai"
        }
      ],
      "preferred_label": "شمعي (عوبيد أدوم)"
    },
    "arb": {
      "descriptions": [
        {
          "description": "شِمْعِي، ابْنُ يَدُوثُونَ وَمُغَنٍّ مِنْ سِبْطِ لَاوِي، عَاشَ فِي عَصْرِ ٱلْمَمْلَكَةِ ٱلْمُوَحَّدَةِ فِي إِسْرَائِيلَ.",
          "source": "acai"
        }
      ],
      "preferred_label": "شِمْعِي (عُوبِيدَ أَدُومَ)"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Simei, pikinini boe blong Jedutun mo wan singa we i blong laen blong Levi, i bin laef long taem blong kingdom blong Isrel we i no seraot yet.",
          "source": "acai"
        }
      ],
      "preferred_label": "Simei (Obed-edom)"
    },
    "eng": {
      "alternate_labels": [
        "Obed-Edom"
      ],
      "descriptions": [
        {
          "article": "person:Shimei",
          "description": "Shimei, son of Jeduthun and a singer from the tribe of Levi, lived during the time of Israel's united kingdom.",
          "gloss": "Obed-Edom",
          "source": "acai"
        }
      ],
      "preferred_label": "Shimei (Obed-edom)"
    },
    "fas": {
      "descriptions": [
        {
          "description": "شمعی، پسر یدوتون و سراینده‌ای از سبط لاوی، در دوران پادشاهی متحد اسرائیل زندگی می‌کرد.",
          "source": "acai"
        }
      ],
      "preferred_label": "شمعی (عوبیدادوم)"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Schimeï, fils de Jeduthun et chantre issu de la tribu de Lévi, vécut à l'époque du royaume uni d'Israël.",
          "source": "acai"
        }
      ],
      "preferred_label": "Schimeï (Obed-Édom)"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Shimeyi, ɗan Yedutun kuma mawaƙi daga kabilar Lawiyawa, ya rayu a zamanin haɗaɗɗiyar masarautar Isra’ila.",
          "source": "acai"
        }
      ],
      "preferred_label": "Shimeyi (Obed-Edom)"
    },
    "hin": {
      "descriptions": [
        {
          "description": "शिमी, जो यदूतून का पुत्र और लेवी के गोत्र से एक गायक था, इस्राएल के संयुक्त राज्य के समय जीवित था।",
          "source": "acai"
        }
      ],
      "preferred_label": "शिमी (ओबेदेदोम)"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Shimei, nwa Jedutun na onye na-abụ abụ sitere n'ebo Livayị, biri n'oge alaeze dị n'otu nke Izrel.",
          "source": "acai"
        }
      ],
      "preferred_label": "Shimei (Obed-edọm)"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Simei, anak Yedutun dan seorang penyanyi dari suku Lewi, hidup pada masa kerajaan bersatu Israel.",
