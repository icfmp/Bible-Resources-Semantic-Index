    "vie": {
      "descriptions": [
        {
          "description": "Si-mê-i, con trai của Giê-đu-thun và là một người ca hát thuộc bộ tộc Lê-vi, sống vào thời kỳ vương quốc thống nhất của Y-sơ-ra-ên.",
