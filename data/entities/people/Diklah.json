  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "دقلة، راجل عاش في زمن الآباء الأولين، كان ابن يقطان ومن نسل سام.",
          "source": "acai"
        }
      ],
      "preferred_label": "دقلة"
    },
    "arb": {
      "descriptions": [
        {
          "description": "دقلة، رجل عاش في عصر الآباء، كان ابنًا ليقطان ومن نسل سام.",
          "source": "acai"
        }
      ],
      "preferred_label": "دِقْلَة"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Diklaha, we i wan man we i laef long taem blong ol olfala bubu blong bifo, hem i wan boe blong Joktan mo wan laen blong Sem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Diklaha"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Diklah",
          "description": "Diklah, a man living during the time of the patriarchs, was a son of Joktan and a descendant of Shem.",
          "gloss": "Diklah",
          "source": "acai"
        }
      ],
      "preferred_label": "Diklah"
    },
    "fas": {
      "descriptions": [
        {
          "description": "دقله، مردی در دوران شیوخ و نیاکان اولیه، پسر یَقطان و از نوادگان سام بود.",
          "source": "acai"
        }
      ],
      "preferred_label": "دقله"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Dikla, homme ayant vécu à l'époque des patriarches, était un fils de Jokthan et un descendant de Sem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Dikla"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Dikla, mutumin da ya rayu a zamanin kakanni, ɗan Yoktan ne kuma zuriyar Shem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Dikla"
    },
    "hin": {
      "descriptions": [
        {
          "description": "कुलपिताओं के समय का एक पुरुष दिक्ला, योक्तान का पुत्र और शेम का वंशज था।",
          "source": "acai"
        }
      ],
      "preferred_label": "दिक्ला"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Dikla, nwoke biri nʼoge ndị nna nna ochie, bụ nwa Joktan na nwa nwa Shem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Dikla"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Dikla, seorang pria yang hidup pada zaman para bapa leluhur, adalah anak dari Yoktan dan keturunan Sem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Dikla"
    },
    "nep": {
      "descriptions": [
        {
          "description": "कुलपिताहरूको समयमा बाँचेका मानिस दिक्ला योक्तानका छोरा र शेमका सन्तान थिए ।",
          "source": "acai"
        }
      ],
      "preferred_label": "दिक्ला"
    },
    "por": {
      "descriptions": [
        {
          "description": "Dicla, um homem que viveu durante o tempo dos patriarcas, era filho de Joctã e descendente de Sem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Dicla"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Дикла, живший во времена патриархов, был сыном Иоктана и потомком Сима.",
          "source": "acai"
        }
      ],
      "preferred_label": "Дикла"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Dicla, un hombre que vivió durante la época de los patriarcas, fue hijo de Joctán y descendiente de Sem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Dicla"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Dikla, mwanamume aliyeishi wakati wa wazee wa ukoo, alikuwa mwana wa Yoktani na mzao wa Shemu.",
          "source": "acai"
        }
      ],
      "preferred_label": "Dikla"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Dikla, wanpela man i bin stap long taim bilong ol bikman bilong bipo, em i bin pikinini man bilong Joktan na wanpela tumbuna pikinini bilong Sem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Dikla"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Điết-la, một người sống trong thời các tổ phụ, là con trai của Giốc-tan và là hậu tự của Sem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Điết-la"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "列祖时代的人物，约坍的儿子，闪的后裔。",
          "source": "acai"
        }
      ],
      "preferred_label": "德拉"
    },
    "zht": {
      "descriptions": [
        {
          "description": "族長時期的人物，是約坍的兒子，閃的後裔。",
          "source": "acai"
        }
      ],
      "preferred_label": "德拉"
    }
