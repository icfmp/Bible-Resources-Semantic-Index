          "description": "حفيد يعقوب من ابنه يوسف، وابن منسى، وأبو جلعاد.",
          "source": "acai"
        }
      ],
      "preferred_label": "مَاكِيرُ"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Smpikinini boe blong patriaka Josef, pikinini boe blong Manase, mo papa blong Gilead.",
          "source": "acai"
        }
      ],
      "preferred_label": "Makiri"
    },
    "eng": {
