      "descriptions": [
        {
          "article": "person:Machir",
          "description": "Grandson of the patriarch Joseph, son of Manasseh, and father of Gilead.",
          "gloss": "Machir",
          "source": "acai"
        }
      ],
      "preferred_label": "Machir"
    },
    "fas": {
      "descriptions": [
        {
          "description": "نوادهٔ یوسف پدرسالار، پسر مَنَسّی، و پدر جلعاد.",
          "source": "acai"
        }
      ],
      "preferred_label": "ماخیر"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Petit-fils du patriarche Joseph, fils de Manassé et père de Galaad.",
          "source": "acai"
        }
      ],
      "preferred_label": "Makir"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Jikan uban iyali Yusuf, ɗan Manasse, kuma mahaifin Gileyad.",
          "source": "acai"
        }
      ],
      "preferred_label": "Makir"
    },
    "hin": {
      "descriptions": [
        {
          "description": "कुलपिता यूसुफ का पोता, मनश्शे का पुत्र और गिलाद का पिता।",
          "source": "acai"
        }
      ],
      "preferred_label": "माकीर"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Nwa nwa nke nna ochie bụ Josef, nwa Manase, na nna Gilead.",
          "source": "acai"
        }
      ],
      "preferred_label": "Makia"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Cucu dari bapa leluhur Yusuf, anak Manasye, dan bapa Gilead.",
          "source": "acai"
        }
      ],
      "preferred_label": "Makhir"
    },
    "nep": {
      "descriptions": [
        {
          "description": "कुलपिता योसेफका नाति, मनश्शेका छोरा र गिलादका पिता।",
          "source": "acai"
        }
      ],
      "preferred_label": "माकीर"
    },
    "por": {
      "descriptions": [
        {
