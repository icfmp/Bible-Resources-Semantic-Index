        {
          "description": "ابن هوشع وجومر، واسمه يعني 'ما شعبي'، مذكور في هوشع 1: 9.",
          "source": "acai"
        }
      ],
      "preferred_label": "لو عَمّي"
    },
    "arb": {
      "descriptions": [
        {
          "description": "ابن هوشَعَ وجومَرَ، ومعنى اسمه «ليس شعبي»، ذُكر في هوشع 1: 9.",
          "source": "acai"
        }
      ],
      "preferred_label": "لُوعَمِّي"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Boe blong Hosea wetem Gomer, we nem blong hem i min se 'I no Man blong Mi,' we Hosea 1:9 i tokbaot hem.",
          "source": "acai"
        }
      ],
      "preferred_label": "Lo-ammi"
    },
    "eng": {
      "alternate_labels": [
        "Not My People"
      ],
      "descriptions": [
        {
          "article": "person:Lo-ammi",
          "description": "The son of Hosea and Gomer, whose name means 'Not My People,' mentioned in Hosea 1:9.",
          "gloss": "Lo-Ammi",
          "source": "acai"
        }
      ],
      "preferred_label": "Lo-ammi"
    },
    "fas": {
      "descriptions": [
        {
          "description": "پسر هوشع و گومر، که معنای نامش «قوم من نیست» می‌باشد و در هوشع ۱: ۹ ذکر شده است.",
          "source": "acai"
        }
      ],
      "preferred_label": "لوعمی"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Fils d'Osée et de Gomer, dont le nom signifie « Pas mon peuple », mentionné dans Osée 1.9.",
          "source": "acai"
        }
      ],
      "preferred_label": "Lo-Ammi"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Ɗan Hosiya da Gomer, wanda ma'anar sunansa ita ce 'Ba Mutanena Ba,' da aka ambata a Hosiya 1:9.",
          "source": "acai"
        }
      ],
      "preferred_label": "Lo-Ammi"
    },
    "hin": {
      "descriptions": [
        {
          "description": "होशे और गोमेर का पुत्र, जिसके नाम का अर्थ है 'मेरी प्रजा नहीं', और जिसका उल्लेख होशे 1:9 में है।",
          "source": "acai"
        }
      ],
      "preferred_label": "लोअम्मी"
    },
    "ibo": {
      "descriptions": [
        {
