          "source": "acai"
        }
      ],
      "preferred_label": "Lo-ammi"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Anak laki-laki Hosea dan Gomer, yang namanya berarti 'Bukan Umat-Ku', yang disebutkan dalam Hosea 1:9.",
