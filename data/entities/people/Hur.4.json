  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "حور، أبو رفّايا، عاش في زمن السبي والرجوع، ومذكور في سفر نحميا.",
          "source": "acai"
        }
      ],
      "preferred_label": "حور (نحميا 3:9)"
    },
    "arb": {
      "descriptions": [
        {
          "description": "حُور، أَبُو رَفَايَا، عَاشَ فِي زَمَنِ السَّبْيِ وَالرُّجُوعِ، وَوَرَدَ ذِكْرُهُ فِي سِفْرِ نَحَمْيَا.",
          "source": "acai"
        }
      ],
      "preferred_label": "حُور (نحميا 3:9)"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Huru, papa blong Refaea, i bin laef long taem we ol man Isrel oli aot long kalabus mo kambak, mo Baebol i tokbaot hem long Buk blong Nehemaea.",
          "source": "acai"
        }
      ],
      "preferred_label": "Huru (Nehemaea 3:9)"
    },
    "eng": {
      "descriptions": [
