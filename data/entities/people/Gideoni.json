          "source": "acai"
        }
      ],
      "preferred_label": "Gideoni"
    },
    "fas": {
      "descriptions": [
        {
          "description": "پسر او اخیدع (ابیدان) در دوران موسی رئیس قبیلهٔ بنیامین بود.",
          "source": "acai"
        }
      ],
      "preferred_label": "جدعونی"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Son fils Abidan était le chef de la tribu de Benjamin à l'époque de Moïse.",
          "source": "acai"
        }
      ],
      "preferred_label": "Guideoni"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Ɗansa Abidan shi ne shugaban kabilar Benyamin a zamanin Musa.",
