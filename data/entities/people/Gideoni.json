    "hin": {
      "descriptions": [
        {
          "description": "मूसा के समय में उसका पुत्र अबीदान बिन्यामीन के गोत्र का प्रधान था।",
          "source": "acai"
        }
      ],
      "preferred_label": "गिदोनी"
    },
    "ibo": {
      "descriptions": [
        {
