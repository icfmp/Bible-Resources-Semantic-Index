      "preferred_label": "يوسفيا"
    },
    "arb": {
      "descriptions": [
        {
          "description": "رَجُلٌ عَاشَ فِي زَمَنِ ٱلسَّبْيِ وَٱلرُّجُوعِ، وَهُوَ أَبُو شَلُومِيثَ، ذُكِرَ فِي عَزْرَا 8: 10.",
          "source": "acai"
        }
      ],
      "preferred_label": "يوشَفْيَا"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan man we i laef long taem we ol man Isrel oli aot long kalabus mo oli kambak, we hem i papa blong Selomit, we nem blong hem i stap long Esra 8:10.",
          "source": "acai"
        }
      ],
      "preferred_label": "Josifia"
    },
    "eng": {
      "descriptions": [
        {
