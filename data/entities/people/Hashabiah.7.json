        }
      ],
      "preferred_label": "Hasabías"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mzao wa Merari na kuhani kiongozi wakati wa kurejea kwa Waisraeli kutoka uhamishoni.",
