  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "واحد من نسل مراري وكاهن بارز في زمن رجوع بني إسرائيل من السبي.",
          "source": "acai"
        }
      ],
      "preferred_label": "حشبيا"
    },
    "arb": {
      "descriptions": [
        {
          "description": "مِنْ نَسْلِ مَرَارِي وَأَحَدُ كِبَارِ ٱلْكَهَنَةِ فِي زَمَنِ رُجُوعِ بَنِي إِسْرَائِيلَ مِنَ ٱلسَّبْيِ.",
          "source": "acai"
        }
      ],
      "preferred_label": "حَشَبْيَا"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan man long laen blong Merari mo wan lida blong ol pris long taem we ol man Isrel oli aot long eksael i kambak.",
          "source": "acai"
        }
      ],
      "preferred_label": "Hasabia"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Hashabiah.7",
          "description": "A descendant of Merari and leading priest during the time of the Israelite return from exile.",
          "gloss": "Hashabiah",
          "source": "acai"
        }
      ],
      "preferred_label": "Hashabiah"
    },
    "fas": {
      "descriptions": [
        {
          "description": "یکی از نوادگان مراری و از کاهنان برجسته در زمان بازگشت اسرائیلیان از تبعید بود.",
          "source": "acai"
        }
      ],
      "preferred_label": "حشبیا"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Un descendant de Merari et un des principaux sacrificateurs à l’époque du retour de l’exil des Israélites.",
          "source": "acai"
        }
      ],
      "preferred_label": "Haschabia"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Zuriyar Merari kuma babban firist a lokacin komowar Isra'ilawa daga bauta.",
          "source": "acai"
        }
      ],
      "preferred_label": "Hashabiya"
    },
    "hin": {
      "descriptions": [
        {
          "description": "मरारी का एक वंशज और इस्राएलियों की बंधुआई से वापसी के समय एक मुख्य याजक।",
          "source": "acai"
        }
      ],
      "preferred_label": "हशब्याह"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Onye sitere nʼikwu Merari na onyeisi nchụaja nʼoge ụmụ Izrel lọtara site nʼala ọzọ a dọọrọ ha nʼagha.",
          "source": "acai"
        }
      ],
      "preferred_label": "Hashabaya"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Keturunan Merari dan imam terkemuka pada masa kepulangan bangsa Israel dari pembuangan.",
          "source": "acai"
        }
      ],
      "preferred_label": "Hasabya"
    },
    "nep": {
      "descriptions": [
        {
          "description": "मरारीका सन्तान र इस्राएलीहरूको निर्वासनबाट फिर्तीको समयका एक मुख्य पूजाहारी।",
          "source": "acai"
        }
      ],
      "preferred_label": "हशब्याह"
    },
    "por": {
