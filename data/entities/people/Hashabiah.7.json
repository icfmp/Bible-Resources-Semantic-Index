        }
      ],
      "preferred_label": "Hashabia"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela bilong lain pikinini bilong Merari na wanpela bikpela pris long taim ol Israel i lusim kalabus na i go bek.",
          "source": "acai"
        }
      ],
      "preferred_label": "Hasabia"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một hậu duệ của Mê-ra-ri và là thầy tế lễ lãnh đạo vào thời dân Y-sơ-ra-ên hồi hương từ chốn lưu đày.",
