  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "ولد أخت الملك داود، وقائد من قادة أبطال داود.",
          "source": "acai"
        }
      ],
      "preferred_label": "أبيشاي"
    },
    "arb": {
      "descriptions": [
        {
          "description": "ابن أخت الملك داود، وأحد قادة أبطال داود.",
          "source": "acai"
        }
      ],
      "preferred_label": "أَبِيشَاي"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan pikinini boe blong sista blong King Deved, mo wan lida blong ol strongfala soldia blong Deved.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abisae"
    },
    "eng": {
      "descriptions": [
        {
          "article": "person:Abishai",
          "description": "A nephew of King David, and a leader of David’s mighty men.",
          "gloss": "Abishai",
          "source": "acai"
        }
      ],
      "preferred_label": "Abishai"
    },
    "fas": {
      "descriptions": [
        {
          "description": "خواهرزادهٔ داوود پادشاه و یکی از فرماندهان دلاوران داوود.",
          "source": "acai"
        }
      ],
      "preferred_label": "ابیشای"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Neveu du roi David et chef des vaillants guerriers de David.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abischaï"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Ɗan’uwan Sarki Dawuda na wajen ’yar’uwa, kuma shugaba a cikin jaruman Dawuda.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abishai"
    },
    "hin": {
      "descriptions": [
        {
          "description": "राजा दाऊद का भांजा, और दाऊद के शूरवीरों का एक अगुवा।",
          "source": "acai"
        }
      ],
      "preferred_label": "अबीशै"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Nwa nwanne Eze Devid, na onye ndú nke ndị dike Devid.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abishai"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Kemenakan laki-laki Raja Daud, dan seorang pemimpin para pahlawan Daud.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abisai"
    },
    "nep": {
      "descriptions": [
        {
          "description": "राजा दाऊदका भान्जा, र दाऊदका शक्तिशाली योद्धाहरूका एक जना अगुवा।",
          "source": "acai"
        }
      ],
      "preferred_label": "अबीशै"
    },
    "por": {
      "descriptions": [
        {
          "description": "Sobrinho do rei Davi e líder dos valentes de Davi.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abisai"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Племянник царя Давида и один из предводителей храбрых воинов Давида.",
          "source": "acai"
        }
      ],
      "preferred_label": "Авесса"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Sobrino del rey David y líder de los valientes de David.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abisai"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mwana wa dada yake Mfalme Daudi, na kiongozi wa mashujaa wa Daudi.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abishai"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Pikinini bilong susa bilong King Devit, na wanpela lida bilong ol strongpela soldia bilong Devit.",
          "source": "acai"
        }
      ],
      "preferred_label": "Abisai"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Cháu trai của Vua Đa-vít, và là một vị tướng lãnh trong các dũng sĩ của Đa-vít.",
          "source": "acai"
        }
      ],
      "preferred_label": "A-bi-sai"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "大卫王的外甥，大卫勇士的一位领袖。",
          "source": "acai"
        }
      ],
      "preferred_label": "亚比筛"
    },
    "zht": {
      "descriptions": [
        {
          "description": "大衛王的外甥，大衛勇士的首領之一。",
          "source": "acai"
        }
      ],
      "preferred_label": "亞比篩"
    }
  },
