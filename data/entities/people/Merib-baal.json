  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "حفيد الملك شاول وولد يوناثان من سبط بنيامين. عاش في زمن المملكة المتحدة لإسرائيل.",
          "source": "acai"
        }
      ],
      "preferred_label": "مَرِيبْبَعْل (مَفِيبُوشَث)"
    },
    "arb": {
      "descriptions": [
        {
          "description": "حَفِيدُ الْمَلِكِ شَاوُلَ وَابْنُ يُونَاثَانَ مِنْ سِبْطِ بَنْيَامِينَ. عَاشَ خِلَالَ عَهْدِ الْمَمْلَكَةِ الْمُوَحَّدَةِ لِإِسْرَائِيلَ.",
          "source": "acai"
        }
      ],
      "preferred_label": "مَرِيبْبَعَل (مَفِيبُوشَث)"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Smolbubun King Sol mo pikinini boe blong Jonatan we i kamaot long laen blong Benjamin. Hem i laef long taem we ol laen blong Isrel oli joen wanples.",
          "source": "acai"
        }
      ],
      "preferred_label": "Meribal (Mefiboset)"
    },
    "eng": {
      "alternate_labels": [
        "Mephibosheth"
      ],
      "descriptions": [
        {
          "article": "person:Merib-baal",
          "description": "Grandson of King Saul and son of Jonathan from the tribe of Benjamin. He lived during Israel’s united kingdom.",
          "gloss": "Mephibosheth",
          "source": "acai"
        }
      ],
      "preferred_label": "Merib-baal (Mephibosheth)"
    },
    "fas": {
      "descriptions": [
        {
          "description": "نوه شائول پادشاه و پسر یوناتان از قبیله بنیامین. او در دوران پادشاهی متحد اسرائیل می‌زیست.",
          "source": "acai"
        }
      ],
      "preferred_label": "مریب‌بَعل (مفیبوشت)"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Petit-fils du roi Saül et fils de Jonathan, de la tribu de Benjamin. Il vécut à l’époque de la monarchie unie d’Israël.",
          "source": "acai"
        }
      ],
      "preferred_label": "Merib-Baal (Mephiboscheth)"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Jikan Sarki Shawulu kuma ɗan Yonatan daga kabilar Benyamin. Ya rayu a lokacin haɗin kan masarautar Isra’ila.",
          "source": "acai"
        }
      ],
      "preferred_label": "Merib-Ba’al (Mefiboshet)"
    },
    "hin": {
      "descriptions": [
        {
          "description": "राजा शाऊल का पोता और बिन्यामीन के गोत्र से योनातान का पुत्र। वह इस्राएल के संयुक्त राजतंत्र के समय जीवित था।",
          "source": "acai"
        }
      ],
      "preferred_label": "मरीब्बाल (मपीबोशेत)"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Nwa nwa Eze Sọl na nwa nwoke Jonatan nke sitere nʼebo Benjamin. O biri nʼoge alaeze dị nʼotu nke Izrel.",
          "source": "acai"
        }
      ],
      "preferred_label": "Merib-Baal (Mefiboshet)"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Cucu Raja Saul dan anak Yonatan dari suku Benyamin. Ia hidup pada masa kerajaan bersatu Israel.",
          "source": "acai"
        }
      ],
      "preferred_label": "Meribaal (Mefiboset)"
    },
    "nep": {
      "descriptions": [
        {
          "description": "राजा शाऊलका नाति र बेन्यामीन कुलका जोनाथनका छोरा। उनी इस्राएलको संयुक्त अधिराज्यको समयमा बाँचेका थिए।",
          "source": "acai"
        }
      ],
      "preferred_label": "मरीब्बाल (मपीबोशेत)"
    },
    "por": {
      "descriptions": [
        {
          "description": "Neto do rei Saul e filho de Jônatas, da tribo de Benjamim. Ele viveu durante o reino unificado de Israel.",
          "source": "acai"
        }
      ],
      "preferred_label": "Meribe-Baal (Mefibosete)"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Внук царя Саула и сын Ионафана из колена Вениамина. Жил во времена единого царства Израиля.",
          "source": "acai"
        }
      ],
      "preferred_label": "Мериббаал (Мемфивосфей)"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Nieto del rey Saúl e hijo de Jonathán de la tribu de Benjamín. Vivió durante el reino unido de Israel.",
          "source": "acai"
        }
      ],
      "preferred_label": "Meribaal (Mephi-boseth)"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mjukuu wa Mfalme Sauli na mwana wa Yonathani kutoka kabila la Benyamini. Aliishi wakati wa ufalme wa umoja wa Israeli.",
          "source": "acai"
        }
      ],
      "preferred_label": "Merib-baali (Mefiboshethi)"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Tumbuna pikinini man bilong King Sol na pikinini man bilong Jonatan bilong lain Benjamin. Em i stap long taim bilong wanbel kingdom bilong Israel.",
          "source": "acai"
        }
      ],
      "preferred_label": "Meribal (Mefiboset)"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Cháu nội của Vua Sau-lơ và con trai của Giô-na-than thuộc bộ tộc Bên-gia-min. Ông sống vào thời vương quốc thống nhất của Y-sơ-ra-ên.",
          "source": "acai"
        }
      ],
      "preferred_label": "Mê-ri Ba-anh (Mê-phi-bô-sết)"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "扫罗王的孙子，便雅悯支派约拿单的儿子。他生活在以色列联合王国时期。",
          "source": "acai"
        }
      ],
      "preferred_label": "米力‧巴力 (米非波设)"
    },
    "zht": {
      "descriptions": [
        {
          "description": "掃羅王的孫子、約拿單的兒子，出自便雅憫支派。他生活在以色列聯合王國時期。",
          "source": "acai"
        }
      ],
      "preferred_label": "米力‧巴力 (米非波設)"
    }
