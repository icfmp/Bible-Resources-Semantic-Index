        }
      ],
      "preferred_label": "جشم"
    },
    "arb": {
      "descriptions": [
        {
          "description": "أَعْرَابِيٌّ قَاوَمَ نَحَمْيَا، عَاشَ بَعْدَ سَبْيِ إِسْرَائِيلَ.",
          "source": "acai"
        }
      ],
      "preferred_label": "جَشَمٌ"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan man Arebia we i bin agensem Nehemaea long taem afta we ol man Isrel oli aot long kalabus.",
          "source": "acai"
        }
      ],
      "preferred_label": "Gesem"
    },
    "eng": {
