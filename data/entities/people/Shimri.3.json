  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "شمري، المعروف برضو بسيمري، كان ود حوسة وعاش في زمن المملكة المنقسمة.",
          "source": "acai"
        }
      ],
      "preferred_label": "شمري (أخبار الأيام الأول 26:10)"
    },
    "arb": {
      "descriptions": [
        {
          "description": "شِمْرِي، ٱلْمَعْرُوفُ أَيْضًا بِـ«سِمْرِي»، كَانَ ابْنَ حُوسَةَ وَعَاشَ فِي عَصْرِ ٱلْمَمْلَكَةِ ٱلْمُنْقَسِمَةِ.",
          "source": "acai"
        }
      ],
      "preferred_label": "شِمْرِي (أخبار الأيام الأول 26:10)"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Simri, we nem blong hem tu Simri, hem i pikinini boe blong Hosaha mo i laef long taem blong dividet kingdom.",
          "source": "acai"
        }
      ],
      "preferred_label": "Simri (1 Kronikol 26:10)"
    },
    "eng": {
      "alternate_labels": [
        "Simri"
      ],
      "descriptions": [
        {
          "article": "person:Shimri.3",
          "description": "Shimri, also known as Simri, was the son of Hosah and lived during the time of the divided kingdom.",
          "gloss": "Shimri (1 Chronicles 26:10)",
          "source": "acai"
        }
      ],
      "preferred_label": "Shimri (1 Chronicles 26:10)"
    },
    "fas": {
      "descriptions": [
        {
          "description": "شمری، که به سمری نیز معروف است، پسر حوسه بود و در دوران پادشاهی تقسیم‌شده زندگی می‌کرد.",
          "source": "acai"
        }
      ],
      "preferred_label": "شمری (اول تواریخ 26:10)"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Schimri, également appelé Simri, était le fils de Hosa et vivait à l'époque du royaume divisé.",
          "source": "acai"
        }
      ],
      "preferred_label": "Schimri (1 Chroniques 26.10)"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Shimri, wanda aka fi sani da Simri, ɗan Hosa ne kuma ya rayu a lokacin rabuwar mulki.",
          "source": "acai"
        }
      ],
      "preferred_label": "Shimri (1 Tarihi 26:10)"
    },
    "hin": {
      "descriptions": [
        {
          "description": "शिम्री, जिसे सिम्री भी कहा जाता है, होसा का पुत्र था और विभाजित राज्य के समय जीवित था।",
          "source": "acai"
        }
      ],
      "preferred_label": "शिम्री (1 इतिहास 26:10)"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Shimri, nke a makwaara dị ka Simri, bụ nwa Hosa ma bie ndụ n'oge alaeze kewara ekewa.",
          "source": "acai"
        }
      ],
      "preferred_label": "Shimri (1 Akụkọ Ihe Gara Aga 26:10)"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Simri adalah anak Hosa dan hidup pada masa kerajaan terpecah.",
          "source": "acai"
        }
      ],
      "preferred_label": "Simri (1 Tawarikh 26:10)"
    },
    "nep": {
      "descriptions": [
        {
