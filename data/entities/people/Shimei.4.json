  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "حفيد موسى، وود جرشون، وأبو ياحث وزيزة ويعوش وبريعة. وهو مؤسس عشيرة الشمعيين.",
          "source": "acai"
        }
      ],
      "preferred_label": "شمعي"
    },
    "arb": {
      "descriptions": [
        {
          "description": "حَفِيدُ مُوسَى، وَٱبْنُ جَرْشُونَ، وَأَبُو يَحَثَ وَزِيزَةَ وَيَعِيشَ وَبَرِيعَةَ. وَكَانَ مُؤَسِّسَ عَشِيرَةِ ٱلشِّمْعِيِّينَ.",
          "source": "acai"
        }
      ],
      "preferred_label": "شِمْعِي"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Sipos boe blong Moses, pikinini boe blong Geson, mo papa blong Jahat, Sisa, Jeus, mo Beria. Hem nao i stamba blong klen blong ol man Simei.",
          "source": "acai"
        }
      ],
      "preferred_label": "Simei"
    },
    "eng": {
      "alternate_labels": [
        "Shimeite",
        "Shimi",
        "Shimite"
      ],
      "descriptions": [
        {
          "article": "person:Shimei.4",
          "description": "Grandson of Moses, son of Gershon, and father of Jahath, Zizah, Jeush, and Beriah. He was founder of the clan of the Shimeites.",
          "gloss": "Shimei",
          "source": "acai"
        }
      ],
      "preferred_label": "Shimei"
    },
    "fas": {
      "descriptions": [
        {
          "description": "نوه موسی، پسر جرشون، و پدر یحت، زیزا، یعوش و بریعه. او بنیان‌گذار خاندان شمعیان بود.",
          "source": "acai"
        }
      ],
      "preferred_label": "شمعی"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Petit-fils de Moïse, fils de Guerschon et père de Jachath, Zina, Yeoush et Beria. Il fut le fondateur du clan des Schimeïtes.",
          "source": "acai"
        }
      ],
      "preferred_label": "Schimeï"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Jikan Musa, ɗan Gershon, kuma mahaifin Yahat, Ziza, Yewush, da Beriya. Shi ne ya kafa kabilun Shimeyiyawa.",
          "source": "acai"
        }
      ],
      "preferred_label": "Shimeyi"
    },
    "hin": {
      "descriptions": [
        {
          "description": "मूसा का पोता, गेर्शोन का पुत्र, और यहत, जीजा, यूश तथा बरीआ का पिता। वह शिमियों के कुल का संस्थापक था।",
          "source": "acai"
        }
      ],
      "preferred_label": "शिमी"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Nwa nwa Mosis, nwa Geshọn, na nna Jahat, Ziza, Jeush, na Beraya. Ọ bụ ya tọrọ ntọala ezinụlọ ndị Shimei.",
          "source": "acai"
        }
      ],
      "preferred_label": "Shimei"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Cucu Musa, anak Gerson, dan ayah dari Yahat, Ziza, Yeush, dan Beria. Ia adalah pendiri kaum orang Simei.",
          "source": "acai"
        }
      ],
      "preferred_label": "Simei"
    },
    "nep": {
      "descriptions": [
        {
          "description": "मोशाका नाति, गेर्शोनका छोरा, र यहत, जीजा, येऊश र बरीयाका पिता। उनी शिमीहरूका कुलका संस्थापक थिए।",
          "source": "acai"
        }
      ],
      "preferred_label": "शिमी"
    },
    "por": {
      "descriptions": [
        {
          "description": "Neto de Moisés, filho de Gérson e pai de Jaate, Zizá, Jeús e Berias. Ele foi o fundador do clã dos simeítas.",
          "source": "acai"
        }
      ],
      "preferred_label": "Simei"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Внук Моисея, сын Гирсона и отец Иахава, Зизы, Иеуша и Берии. Он был основателем рода Шимея.",
          "source": "acai"
        }
      ],
      "preferred_label": "Шимей"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Nieto de Leví (e hijo de Gersón), y padre de Jahath, Zizah, Jeus y Berías. Fue fundador del clan de los simeítas.",
          "source": "acai"
        }
      ],
      "preferred_label": "Simei"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mjukuu wa Musa, mwana wa Gershoni, na baba ya Yahathi, Zina, Yeushi, na Beria. Alikuwa mwanzilishi wa ukoo wa Washimei.",
          "source": "acai"
        }
      ],
      "preferred_label": "Shimei"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Tumbuna pikinini bilong Moses, pikinini man bilong Gerson, na papa bilong Jahat, Sisa, Jeus, na Beria. Em i as bilong famili o klen bilong ol Simei.",
          "source": "acai"
        }
      ],
      "preferred_label": "Simei"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Cháu nội của Môi-se, con trai của Ghẹt-sôn, và là cha của Gia-hát, Xi-xa, Giê-út và Bê-ri-a. Ông là người sáng lập thị tộc Si-mê-i.",
          "source": "acai"
        }
      ],
      "preferred_label": "Si-mê-i"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "摩西的孙子，革顺的儿子，雅哈、细撒、耶乌施和比亚利的父亲。他是示每家族的建立者。",
          "source": "acai"
        }
      ],
      "preferred_label": "示每"
    },
    "zht": {
      "descriptions": [
        {
          "description": "摩西的孫子、革順的兒子，也是雅哈、細撒、耶烏施和比利亞的父親。他是示每家族的始祖。",
          "source": "acai"
        }
      ],
      "preferred_label": "示每"
    }
  },
