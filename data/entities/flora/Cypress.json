  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "شجرة دايمة الخضرة ورقها صغير ومدور ومخاريط بذورها ما بتتاكل، كتيرة في لبنان وبتستعمل في البنا.",
          "source": "acai"
        }
      ],
      "preferred_label": "سرو"
    },
    "arb": {
      "descriptions": [
        {
          "description": "شجرةٌ دائمةُ الخُضرةِ ذاتُ أوراقٍ صغيرةٍ ومُستديرةٍ ومَخاريطِ بذورٍ غيرِ صالحةٍ للأكلِ، غالبًا ما توجدُ في لُبنانَ وتُستخدَمُ في البِناءِ.",
          "source": "acai"
        }
      ],
      "preferred_label": "سَرْو"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan tri we lif blong hem i stap grin oltaem wetem smosmol raon lif mo ol kon blong sid we man i no save kakae, we oli faenem plante long Lebanon mo oli yusum blong bildim haos.",
          "source": "acai"
        }
      ],
      "preferred_label": "saepras"
    },
    "eng": {
      "alternate_labels": [
        "Fir",
        "Juniper",
        "Gopher"
      ],
      "descriptions": [
        {
          "article": "flora:Cypress",
          "description": "An evergreen tree with small, round leaves and inedible seed cones, often found in Lebanon and used building.",
          "gloss": "Cypress",
          "source": "acai"
        }
      ],
      "preferred_label": "Cypress"
    },
    "fas": {
      "descriptions": [
        {
          "description": "درختی همیشه‌سبز با برگ‌های ریز و گرد و مخروط‌های بذری غیرخوراکی که اغلب در لبنان یافت می‌شود و در ساختمان‌سازی به کار می‌رود.",
          "source": "acai"
        }
      ],
      "preferred_label": "سرو"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Arbre à feuilles persistantes, aux petites feuilles arrondies et aux cônes non comestibles, que l'on trouve souvent au Liban et qui est utilisé pour la construction.",
          "source": "acai"
        }
      ],
      "preferred_label": "cyprès"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Itace marar faɗuwar ganye mai ƙanana zagayayyun ganyaye da ƙwanson ’ya’ya marasa ci, wanda aka fi samu a Lebanon kuma ana amfani da shi wajen gini.",
          "source": "acai"
        }
      ],
      "preferred_label": "Saifires"
    },
    "hin": {
      "descriptions": [
        {
          "description": "छोटे, गोल पत्तों और अखाद्य बीज शंकुओं वाला एक सदाबहार वृक्ष, जो अक्सर लबानोन में पाया जाता है और भवन निर्माण में उपयोग किया जाता है।",
          "source": "acai"
        }
      ],
      "preferred_label": "सनोवर"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Osisi na-adị ndụ mgbe niile nke nwere obere akwụkwọ gburugburu na mkpụrụ a na-anaghị eri eri, nke a na-ahụkarị na Lebanọn ma na-eji ya ewu ụlọ.",
          "source": "acai"
        }
      ],
      "preferred_label": "saipres"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Pohon hijau abadi dengan daun kecil bulat dan runjung biji yang tidak dapat dimakan, sering ditemukan di Libanon dan digunakan untuk bangunan.",
          "source": "acai"
        }
      ],
      "preferred_label": "sanobar"
    },
    "nep": {
      "descriptions": [
        {
          "description": "एउटा सदाबहार रूख जसमा साना, गोलो पातहरू र नखाइने बिउका कोणहरू हुन्छन्, प्रायः लेबनानमा पाइने र भवन निर्माणमा प्रयोग गरिने रूख।",
          "source": "acai"
        }
      ],
      "preferred_label": "सल्ला"
    },
    "por": {
      "descriptions": [
        {
          "description": "Uma árvore perenifólia com folhas pequenas e arredondadas e cones de sementes não comestíveis, frequentemente encontrada no Líbano e usada em construções.",
          "source": "acai"
        }
      ],
      "preferred_label": "cipreste"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Вечнозеленое дерево с мелкой чешуевидной листвой и несъедобными шишками, часто встречающееся в Ливане и используемое в строительстве.",
          "source": "acai"
        }
      ],
      "preferred_label": "Кипарис"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Árbol de hoja perenne con hojas pequeñas y redondeadas y conos de semillas no comestibles, frecuente en el Líbano y utilizado para la construcción.",
          "source": "acai"
        }
      ],
      "preferred_label": "ciprés"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mti unaodumu na majani mabichi daima wenye majani madogo ya mviringo na matunda yenye mbegu yasiyoliwa, mara nyingi hupatikana Lebanoni na hutumika katika ujenzi.",
          "source": "acai"
        }
      ],
      "preferred_label": "Msanduku"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela kain diwai i save stap grin olgeta taim na i gat ol liklik raunpela lip na ol raunpela pikinini i no gat kaikai long en, na planti taim em i save stap long Lebanon na ol i save yusim bilong wokim haus o samting.",
          "source": "acai"
        }
      ],
      "preferred_label": "diwai saipres"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Loài cây thường xanh có lá nhỏ hình tròn và quả nón chứa hạt không ăn được, thường thấy ở Li-ban và được dùng trong xây dựng.",
          "source": "acai"
        }
      ],
      "preferred_label": "Cây bách"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "一种常绿乔木，叶小而圆，结不可食用的球果，常见于黎巴嫩，用于建筑。",
          "source": "acai"
        }
      ],
      "preferred_label": "柏树"
    },
    "zht": {
      "descriptions": [
        {
          "description": "一種常綠樹木，葉小而圓，結不可食用的毬果，常見於黎巴嫩，常作為建築材料。",
          "source": "acai"
        }
      ],
      "preferred_label": "柏樹"
    }
  },
