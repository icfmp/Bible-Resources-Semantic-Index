      "preferred_label": "Narsisas"
    },
    "hin": {
      "descriptions": [
        {
          "description": "एक डंठल पर कई फूलों वाला एक चमकीला सुनहरा पीला फूल; यह सुंदरता का प्रतीक है।",
          "source": "acai"
        }
