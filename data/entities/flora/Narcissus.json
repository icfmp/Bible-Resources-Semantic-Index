      ],
      "descriptions": [
        {
          "article": "flora:Narcissus",
          "description": "A bright golden yellow flower with several blooms on one stem; it symbolizes beauty.",
          "gloss": "Narcissus",
          "source": "acai"
        }
      ],
      "preferred_label": "Narcissus"
    },
    "fas": {
      "descriptions": [
        {
          "description": "گلی به رنگ زرد طلایی روشن با چندین شکوفه بر روی یک ساقه؛ نماد زیبایی است.",
          "source": "acai"
        }
      ],
      "preferred_label": "نرگس"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Fleur d'un jaune doré éclatant portant plusieurs corolles sur une même tige, qui symbolise la beauté.",
          "source": "acai"
        }
      ],
      "preferred_label": "narcisse"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Fure mai launin zinariya mai kyau wanda yake da furanni da yawa a kan kututture guda; yana nuna alamar kyau.",
