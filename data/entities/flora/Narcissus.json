      "preferred_label": "नरगिस"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Okoko osisi na-acha odo odo na-egbuke egbuke nke nwere ọtụtụ okoko nʼotu ogwe; ọ na-anọchi anya ịma mma.",
          "source": "acai"
        }
      ],
      "preferred_label": "Nasisọs"
    },
    "ind": {
      "descriptions": [
