  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "زهرة لونها أصفر دهبي فاقع مع كذا نوارة في ساق واحدة؛ وهي رمز للجمال.",
          "source": "acai"
        }
      ],
      "preferred_label": "نرجس"
    },
    "arb": {
      "descriptions": [
        {
          "description": "زَهْرَةٌ صَفْرَاءُ ذَهَبِيَّةٌ زَاهِيَةٌ، تَحْمِلُ سَاقُهَا عِدَّةَ أَزْهَارٍ، وَتَرْمُزُ إِلَى ٱلْجَمَالِ.",
          "source": "acai"
        }
      ],
      "preferred_label": "نَرْجِس"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan naesfala yelo flaoa we plante flaoa oli stap gru long wan stamba nomo; hem i makem olsem samting we i naes tumas.",
          "source": "acai"
        }
      ],
      "preferred_label": "Nasisas"
    },
    "eng": {
      "alternate_labels": [
