  "localizations": {
    "apd": {
      "descriptions": [
        {
          "description": "شجرة صغيرة، طولها بين 3 و 5 أمتار، فروعها فيها شوك وثمارها مدورة وحمراء ومليانة حبوب. غالباً بربطوها بالحب والجمال.",
          "source": "acai"
        }
      ],
      "preferred_label": "رمان"
    },
    "arb": {
      "descriptions": [
        {
          "description": "شجرة صغيرة يتراوح ارتفاعها بين 3 و5 أمتار، ذات أغصان شائكة وثمار حمراء مستديرة ممتلئة بالبذور. وغالبًا ما ترتبط بالحب والجمال.",
          "source": "acai"
        }
      ],
      "preferred_label": "رُمَّان"
    },
    "bis": {
      "descriptions": [
        {
          "description": "Wan smol tri, we i longfala kasem 3–5 meta, we i gat ol han we oli gat nil mo ol raon red frut we i fulap long sid. Plante taem oli joenem hem wetem lav mo naes fasin.",
          "source": "acai"
        }
      ],
      "preferred_label": "grenadin"
    },
    "eng": {
      "descriptions": [
        {
          "article": "flora:Pomegranate",
          "description": "A small tree, 3-5 meters tall, with thorny branches and red round fruits filled with seeds. It is often linked to love and beauty.",
          "gloss": "Pomegranate",
          "source": "acai"
        }
      ],
      "preferred_label": "Pomegranate"
    },
    "fas": {
      "descriptions": [
        {
          "description": "درختی کوچک به ارتفاع ۳ تا ۵ متر با شاخه‌های خاردار و میوه‌های سرخ و گردِ پر از دانه. این گیاه اغلب به عشق و زیبایی پیوند خورده است.",
          "source": "acai"
        }
      ],
      "preferred_label": "انار"
    },
    "fra": {
      "descriptions": [
        {
          "description": "Petit arbre de 3 à 5 mètres de haut, aux branches épineuses et aux fruits ronds rouges remplis de graines. Il est souvent associé à l'amour et à la beauté.",
          "source": "acai"
        }
      ],
      "preferred_label": "grenadier"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Ƙaramin itace ne, mai tsawon mita 3-5, mai ƙayoyin rassa da kuma jajayen ’ya’ya masu kewayaye cike da ƙwayoyi. Yakan kasance da alaƙa da ƙauna da kyawu.",
          "source": "acai"
        }
      ],
      "preferred_label": "Rumman"
    },
    "hin": {
      "descriptions": [
        {
          "description": "एक छोटा वृक्ष, 3-5 मीटर ऊँचा, काँटेदार शाखाओं वाला और बीजों से भरे लाल गोल फलों वाला। इसे अक्सर प्रेम और सुंदरता से जोड़ा जाता है।",
          "source": "acai"
        }
      ],
      "preferred_label": "अनार"
    },
    "ibo": {
      "descriptions": [
        {
          "description": "Obere osisi, dị mita 3 ruo 5 nʼogologo, nke nwere alaka nwere ogwu na mkpụrụ gburugburu na-acha ọbara ọbara juputara na mkpụrụ. A na-ejikọtakarị ya na ịhụnanya na ịma mma.",
          "source": "acai"
        }
      ],
      "preferred_label": "pomegranet"
    },
    "ind": {
      "descriptions": [
        {
          "description": "Pohon kecil, setinggi 3–5 meter, dengan cabang-cabang berduri dan buah bulat merah yang penuh biji. Pohon ini sering kali dikaitkan dengan cinta dan keindahan.",
          "source": "acai"
        }
      ],
      "preferred_label": "delima"
    },
    "nep": {
      "descriptions": [
        {
          "description": "३-५ मिटर अग्लो हुने, काँडेदार हाँगाहरू र बीउले भरिएका राता गोलो फलहरू फल्ने एउटा सानो रूख। यो प्रायः प्रेम र सुन्दरतासँग सम्बन्धित छ।",
          "source": "acai"
        }
      ],
      "preferred_label": "अनार"
    },
    "por": {
      "descriptions": [
        {
          "description": "Uma árvore pequena, de 3 a 5 metros de altura, com ramos espinhosos e frutos vermelhos e redondos cheios de sementes. É frequentemente associada ao amor e à beleza.",
          "source": "acai"
        }
      ],
      "preferred_label": "romãzeira"
    },
    "rus": {
      "descriptions": [
        {
          "description": "Небольшое дерево высотой 3–5 метров с колючими ветвями и круглыми красными плодами, наполненными семенами. Оно часто ассоциируется с любовью и красотой.",
          "source": "acai"
        }
      ],
      "preferred_label": "Гранат"
    },
    "spa": {
      "descriptions": [
        {
          "description": "Árbol pequeño, de 3 a 5 metros de altura, con ramas espinosas y frutos redondos y rojos llenos de semillas. A menudo se asocia con el amor y la belleza.",
          "source": "acai"
        }
      ],
      "preferred_label": "granado"
    },
    "swh": {
      "descriptions": [
        {
          "description": "Mti mdogo, wenye urefu wa mita 3-5, wenye matawi yenye miiba na matunda mekundu ya mviringo yaliyojaa mbegu. Mara nyingi unahusishwa na upendo na uzuri.",
          "source": "acai"
        }
      ],
      "preferred_label": "Mkomamanga"
    },
    "tpi": {
      "descriptions": [
        {
          "description": "Wanpela liklik diwai, inap 3 i go inap 5 mita longpela, i gat ol han i gat nil wantaim ol retpela raunpela pikinini i pulap long sid. Planti taim ol i save bungim wantaim pasin bilong lav na naispela lukluk.",
          "source": "acai"
        }
      ],
      "preferred_label": "pomigranet"
    },
    "vie": {
      "descriptions": [
        {
          "description": "Một loại cây nhỏ cao từ 3–5 mét, có cành đầy gai và quả tròn màu đỏ chứa nhiều hạt. Nó thường được liên hệ với tình yêu và vẻ đẹp.",
          "source": "acai"
        }
      ],
      "preferred_label": "Cây lựu"
    },
    "zhs": {
      "descriptions": [
        {
          "description": "一种高3至5米的小乔木，枝条带刺，结有红色多籽的圆形果实。它常常与爱情和美丽联系在一起。",
          "source": "acai"
        }
      ],
      "preferred_label": "石榴"
    },
    "zht": {
      "descriptions": [
        {
          "description": "一種高3至5公尺的小喬木，枝條帶刺，果實圓形、紅色且滿含種子，常與愛情和美麗相聯結。",
          "source": "acai"
        }
      ],
      "preferred_label": "石榴"
    }
  },
