        }
      ],
      "preferred_label": "chardon"
    },
    "hau": {
      "descriptions": [
        {
          "description": "Tsiro mai ƙaya wanda yake girma a cikin daji, kuma ana ɗaukan sa a matsayin mara amfani kuma mara kyau.",
